set shell := ["bash", "-uc"]

kubectl := "kubectl -n blog"

db-backup:
    #!/usr/bin/env bash
    set -euo pipefail
    : "${PORTFOLIO_PRODUCTION_BACKUP_DIR:?set PORTFOLIO_PRODUCTION_BACKUP_DIR outside the repository}"
    mkdir -p "$PORTFOLIO_PRODUCTION_BACKUP_DIR"
    primary_pod=$({{kubectl}} get pods -l cnpg.io/cluster=postgres -o jsonpath='{range .items[*]}{.metadata.name}{" "}{.metadata.labels.cnpg\\.io/instanceRole}{"\\n"}{end}' | awk '$2 == "primary" { print $1; exit }')
    test -n "$primary_pod"
    db_user=$({{kubectl}} get secret postgres-app -o jsonpath='{.data.user}' | base64 -d)
    db_password=$({{kubectl}} get secret postgres-app -o jsonpath='{.data.password}' | base64 -d)
    db_name=$({{kubectl}} get secret postgres-app -o jsonpath='{.data.dbname}' | base64 -d)
    dump_file="$PORTFOLIO_PRODUCTION_BACKUP_DIR/postgres-$(date -u +%Y%m%dT%H%M%SZ).dump"
    {{kubectl}} exec "$primary_pod" -- env PGPASSWORD="$db_password" pg_dump --format=custom --no-owner --no-acl --username="$db_user" --dbname="$db_name" > "$dump_file"
    test -s "$dump_file"
    echo "wrote $dump_file"

db-update:
    #!/usr/bin/env bash
    set -euo pipefail
    just -f deploy/justfile db-backup
    {{kubectl}} port-forward svc/postgres-rw 5432:5432 &
    forward_pid=$!
    trap 'kill $forward_pid' EXIT
    sleep 2
    db_user=$({{kubectl}} get secret postgres-app -o jsonpath='{.data.user}' | base64 -d)
    db_password=$({{kubectl}} get secret postgres-app -o jsonpath='{.data.password}' | base64 -d)
    db_name=$({{kubectl}} get secret postgres-app -o jsonpath='{.data.dbname}' | base64 -d)
    cd ../
    docker compose -f .docker/compose.yaml run --rm --no-deps \
        --add-host=host.docker.internal:host-gateway \
        -e DB_CONNECTION=pgsql \
        -e DB_HOST=host.docker.internal \
        -e DB_PORT=5432 \
        -e DB_DATABASE="$db_name" \
        -e DB_USERNAME="$db_user" \
        -e DB_PASSWORD="$db_password" \
        laravel php artisan migrate --force

popularity-refresh *args:
    #!/usr/bin/env bash
    set -euo pipefail
    {{kubectl}} port-forward svc/postgres-rw 5432:5432 &
    forward_pid=$!
    trap 'kill $forward_pid' EXIT
    sleep 2
    db_user=$({{kubectl}} get secret postgres-app -o jsonpath='{.data.user}' | base64 -d)
    db_password=$({{kubectl}} get secret postgres-app -o jsonpath='{.data.password}' | base64 -d)
    db_name=$({{kubectl}} get secret postgres-app -o jsonpath='{.data.dbname}' | base64 -d)
    connection="Host=localhost;Port=5432;Database=$db_name;Username=$db_user;Password=$db_password"
    cd ../
    docker compose -f .docker/compose.yaml run --rm --entrypoint sh -e PORTFOLIO_DB_CONNECTION="$connection" -e GITHUB_TOKEN="${GITHUB_TOKEN:-}" web -lc \
        'dotnet run --project src/Blog/Blog.Blazor.Popularity/Blog.Blazor.Popularity.csproj --configuration Release -- {{args}}'

status:
    {{kubectl}} get pods
    kubectl -n argocd get application blog cloudflared network-policies postgres

webhook-register url:
    gh api repos/guesant/blog/hooks -f name=web -f active=true \
        -f config[url]="{{url}}/api/webhook" \
        -f config[content_type]=json \
        -f config[secret]="$ARGOCD_GITHUB_WEBHOOK_SECRET" \
        -f events[]=push
