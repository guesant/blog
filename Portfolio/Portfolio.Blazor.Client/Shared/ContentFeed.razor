@inherits ListPageBase
@using Microsoft.AspNetCore.Components
@using Portfolio.Blazor.Core

<PageTitle>@Headline</PageTitle>
<SeoHead Title="@Headline" Description="@Subline" CanonicalPath="@CanonicalPath" />

<SitePage Template="@(FixedKind is null ? "home" : "feed")">
    @if (FixedKind is null)
    {
        <SiteBreadcrumb CurrentLabel="@Text("home_label", L["legacy_ddc150008e2f"])"
            ShowHomeLink="false" />
    }
    else
    {
        <SiteBreadcrumb HomeUrl="@LocalizedUrls.Current("/")"
            HomeLabel="@(L["legacy_ddc150008e2f"])"
            CurrentLabel="@CrumbLabel(FixedRoute, KindLabel(FixedKind!))" />
    }

    <SiteHero Title="@Headline" Lead="@Subline" />

    @if (Snapshot is null || AllFeedItems.Count == 0)
    {
        <SiteListingShell HasResults="false"
            CurrentPage="@CurrentPage"
            TotalPages="@PageCount"
            PaginationLabel="@Text("pagination", L["legacy_ce41390e654d"] )"
            PreviousLabel="@Text("previous", L["legacy_c3b535ded088"] )"
            NextLabel="@Text("next", L["legacy_a6c78a6436e2"] )"
            Href="@(page => QueryUrl(ViewMode, page))">
            <EmptyContent>
                <SiteEmptyState Message="@(Snapshot is null ? L["legacy_59fa21acd9e0"] : Text("nothing_here_yet", L["legacy_39e15a1b7ac5"]))" />
            </EmptyContent>
        </SiteListingShell>
    }
    else
    {
        <SiteListingShell HasResults="@(PagedFeedItems.Count > 0)"
            Summary="@ListingSummary(PagedFeedItems.Count, SortedFeedItems.Count, CurrentPage, PageCount)"
            CurrentPage="@CurrentPage"
            TotalPages="@PageCount"
            PaginationLabel="@Text("pagination", L["legacy_ce41390e654d"])"
            PreviousLabel="@Text("previous", L["legacy_c3b535ded088"])"
            NextLabel="@Text("next", L["legacy_a6c78a6436e2"])"
            Href="@(page => QueryUrl(ViewMode, page))">
        <FilterContent>
            <SiteListingFilterBar Action="@Action"
                ApplyLabel="@Text("apply", L["legacy_c975d2551cc4"])"
                ClearLabel="@Text("clear", L["legacy_5262517729fc"])"
                ClearHref="@Action"
                OnApply="@HandleApply">
                <PrimaryFields>
                    @if (FixedKind is null)
                    {
                        <SiteFilterSelect Icon="tag"
                            Label="@Text("filter_category_label", L["legacy_4d729bbc84d4"])"
                            Id="feed-kind-filter"
                            Name="kind"
                            @bind-Value="KindValue"
                            Options="@KindSelectOptions"
                            Placeholder="@Text("filter_all", L["legacy_f8bcc40c7cea"])"
                            EmptyText="@(L["legacy_e0c29bb7c5a6"])" />
                    }
                    <SiteFilterSelect Icon="hash"
                        Label="@Text("filter_topic_short_label", L["legacy_567a7d89cea9"])"
                        Id="feed-topic-filter"
                        Name="topic"
                        @bind-Value="TopicValue"
                        Options="@TopicSelectOptions"
                        Placeholder="@Text("filter_all_topics", L["legacy_4d99c9f9761a"])"
                        EmptyText="@(L["legacy_2cceba119716"])" />
                    <SiteFilterSelect Icon="arrow-up-down"
                        Label="@Text("filter_sort_label", L["legacy_6541e97b7c64"])"
                        Id="feed-sort-filter"
                        Name="sort"
                        @bind-Value="SortValue"
                        Options="@SortSelectOptions"
                        Placeholder="@(L["newest"])"
                        EmptyText="@(L["legacy_3259c09e8ab3"])" />
                </PrimaryFields>
                <SearchField>
                    <SiteSearchField Label="@Text("search_short_label", L["legacy_6bb12bff6f09"])"
                        Id="feed-search"
                        Name="q"
                        Value="@PendingSearch"
                        ValueChanged="@((string v) => PendingSearch = v)"
                        Placeholder="@Text("search_placeholder", L["legacy_5cf08e892eb3"])" />
                </SearchField>
            </SiteListingFilterBar>
        </FilterContent>

        <EmptyContent>
            <SiteEmptyState Message="@Text("filter_no_results", L["legacy_1422f873bd4b"])" />
        </EmptyContent>
        <ResultContent>
            @if (FilteredFeedItems.Count > 0)
            {
                <SiteCardGrid id="view-spacious"
                    aria-label="@Text("feed_label", L["legacy_6e49eb44fd64"])"
                    data-layout-region="items">
                    @foreach (var item in PagedFeedItems)
                    {
                        <SiteGridColumn>
                            <SiteFeedCard KindLabel="@KindLabel(item.Kind)"
                                Date="@(FormatHumanDate(item.Date) is { } date && date != "·" ? date : null)"
                                ReadingTime="@item.ReadingTime"
                                Title="@item.Title"
                                Href="@LocalizedUrl(item.Url)"
                                Preview="@item.Preview.Text"
                                Truncated="@item.Preview.Truncated"
                                ViewLabel="@(L["read_more"])"
                                ExternalUrl="@item.ExternalUrl"
                                ExternalLabel="@(string.IsNullOrWhiteSpace(item.ExternalLabel) ? null : $"via {item.ExternalLabel}")">
                                <Tags>
                                    @if (item.Topics.Count > 0)
                                    {
                                        <SiteChipGroup>
                                            @foreach (var topic in item.Topics)
                                            {
                                                <SiteChip Label="@topic.Name"
                                                    Href="@(string.IsNullOrWhiteSpace(topic.Url) ? null : LocalizedUrl(topic.Url))" />
                                            }
                                        </SiteChipGroup>
                                    }
                                </Tags>
                            </SiteFeedCard>
                        </SiteGridColumn>
                    }
                </SiteCardGrid>
            }
        </ResultContent>
        </SiteListingShell>
    }
    <ExploreSection HeadingId="home-explore-heading" />
</SitePage>
