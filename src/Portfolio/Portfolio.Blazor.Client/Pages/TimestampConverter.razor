@inherits LocalizedComponentBase
@page "/tools/timestamp-converter"
@page "/pt-BR/tools/timestamp-converter"
@using System.Globalization
@using Portfolio.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    @if (RendererInfo.IsInteractive)
    {
        <SiteFormCard Class="site-block">
            <SiteFormField Label="@TimestampInputLabel"
                For="timestamp-value"><SiteInput id="timestamp-value"
                    type="text"
                    placeholder="1735689600"
                    autocomplete="off"
                    @bind-Value="TimestampText" /></SiteFormField>
                        <SiteButton Variant="SiteButtonVariant.Default"
                        @onclick="SetNow"><SiteIcon Name="clock"
                            Size="14" />@NowLabel</SiteButton>@if (!Result.IsValid) { <SiteErrorMessage>@ErrorLabel</SiteErrorMessage> }<SiteFormActions>
                <SiteFormField Label="@UtcLabel"
                    For="timestamp-utc"><SiteInput id="timestamp-utc"
                        readonly
                        value="@Result.Utc" />
                    </SiteFormField>
                    <SiteFormField Label="@LocalLabel"
                        For="timestamp-local"><SiteInput id="timestamp-local"
                            readonly
                            value="@Result.Local" />
                        </SiteFormField>
                </SiteFormActions>
                    <SiteFormField Label="@DateLabel"
                        For="timestamp-date"><SiteInput id="timestamp-date"
                            type="datetime-local"
                            step="1"
                            @bind="DateValue" /></SiteFormField>
                        <SiteFormField Label="@DateResultLabel"
                            For="timestamp-result"><SiteInput id="timestamp-result"
                                readonly
                                value="@Result.TimestampFromDate" /></SiteFormField>
                    </SiteFormCard>
    }
    else
    {
        <SiteFilterCard Action="@Action"
            DataLayoutRegion="tool-form"
            FormClass="d-grid gap-3"
            Class="site-block">
            <SiteFormField Label="@TimestampInputLabel"
                For="timestamp-value"><SiteInput id="timestamp-value"
                    name="timestamp"
                    type="text"
                    value="@TimestampText"
                    placeholder="1735689600" /></SiteFormField>
                        <SiteButton Variant="SiteButtonVariant.Default"
                        Type="SiteButtonType.Submit"><SiteIcon Name="arrow-right-left"
                            Size="14" />@ConvertLabel</SiteButton>
                                <SiteText>@UtcLabel: @Result.Utc</SiteText>
                                    <SiteText>@LocalLabel: @Result.Local</SiteText>
                                        <SiteFormField Label="@DateLabel" For="timestamp-date">
                                            <SiteInput id="timestamp-date"
                                                name="date"
                                                type="datetime-local"
                                                step="1"
                                                value="@DateValueText" />
                                    </SiteFormField>
                                        <SiteText>@DateResultLabel: @Result.TimestampFromDate</SiteText>
                                    </SiteFilterCard>
    }
</ToolPage>
