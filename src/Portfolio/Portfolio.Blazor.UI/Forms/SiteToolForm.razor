<CascadingValue Name="SiteToolFormBanded" Value="true" IsFixed="true">
@if (ResolvedInteractive)
{
    <SiteFormCard AriaLabel="@AriaLabel" Class="@RootClass">
        @ChildContent
        @if (Submit == SiteToolFormSubmit.Always)
        {
            <SiteButton Variant="SiteButtonVariant.Default"
                OnClick="HandleSubmit"><SiteIcon Name="play" Size="14" />@SubmitLabel</SiteButton>
        }
        @Actions
    </SiteFormCard>
}
else
{
    <SiteForm Action="@Action" Method="@Method" Region="@Region">
        <SiteFormCard AriaLabel="@AriaLabel" Class="@RootClass">
            @ChildContent
            @if (Submit != SiteToolFormSubmit.Never)
            {
                <SiteButton Variant="SiteButtonVariant.Default"
                    Type="SiteButtonType.Submit"><SiteIcon Name="play"
                        Size="14" />@SubmitLabel</SiteButton>
            }
            @Actions
        </SiteFormCard>
    </SiteForm>
}
</CascadingValue>
