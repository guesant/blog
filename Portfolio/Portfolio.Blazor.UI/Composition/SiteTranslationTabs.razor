<div class="site-translation-tabs" data-slot="translation-tabs">
    <BlazorBlueprint.Primitives.Tabs.BbTabs Value="@ActiveLocale"
        ValueChanged="ActiveLocaleChanged">
        <BlazorBlueprint.Primitives.Tabs.BbTabsList AdditionalAttributes="@TabListAttributes">
            @foreach (var locale in Locales)
            {
                <BlazorBlueprint.Primitives.Tabs.BbTabsTrigger Value="@locale.Code"
                    AdditionalAttributes="@TabTriggerAttributes">
                    @locale.Label
                </BlazorBlueprint.Primitives.Tabs.BbTabsTrigger>
            }
        </BlazorBlueprint.Primitives.Tabs.BbTabsList>
        @foreach (var locale in Locales)
        {
            <BlazorBlueprint.Primitives.Tabs.BbTabsContent Value="@locale.Code"
                ForceMount="true"
                AdditionalAttributes="@PanelAttributes">
                @Panel(locale.Code)
            </BlazorBlueprint.Primitives.Tabs.BbTabsContent>
        }
    </BlazorBlueprint.Primitives.Tabs.BbTabs>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<SiteLocaleTab> Locales { get; set; } = [];
    [Parameter, EditorRequired]
    public string ActiveLocale { get; set; } = string.Empty;
    [Parameter, EditorRequired]
    public EventCallback<string> ActiveLocaleChanged { get; set; }
    [Parameter, EditorRequired]
    public RenderFragment<string> Panel { get; set; } = default!;
    [Parameter]
    public string TabListLabel { get; set; } = "translations";
    [Parameter]
    public string IdPrefix { get; set; } = "translation";

    private Dictionary<string, object> TabListAttributes => new()
    {
        ["class"] = "site-translation-tablist",
        ["aria-label"] = TabListLabel,
    };

    private Dictionary<string, object> TabTriggerAttributes => new()
    {
        ["class"] = "site-translation-tab",
    };

    private Dictionary<string, object> PanelAttributes => new()
    {
        ["class"] = "site-translation-panel",
    };
}
