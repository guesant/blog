@inherits LocalizedComponentBase
@page "/tools/roman-numeral-converter"
@page "/pt-BR/tools/roman-numeral-converter"
@using Blog.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action" SubmitLabel="@ConvertLabel" AriaLabel="@NumberLabel">
        <SiteFormField Label="@NumberLabel"
            For="roman-number"><SiteInput Id="roman-number"
                Name="number"
                Type="number"
                min="1"
                max="3999"
                Value="@NumberText"
                ValueChanged="@(v => NumberText = v)" /></SiteFormField>
        @if (RendererInfo.IsInteractive)
        {
            @if (!NumberValid) { <SiteErrorMessage>@NumberError</SiteErrorMessage> }
        }
        else
        {
            <SiteText>@RomanLabel: @Result.RomanFromNumber</SiteText>
        }
        <SiteFormField Label="@RomanLabel"
            For="roman-value"><SiteInput Id="roman-value"
                Name="roman"
                Type="text"
                Value="@RomanText"
                ValueChanged="@(v => RomanText = v)" /></SiteFormField>
        @if (RendererInfo.IsInteractive)
        {
            @if (!RomanValid) { <SiteErrorMessage>@RomanError</SiteErrorMessage> }
        }
        else
        {
            <SiteText>@NumberLabel: @Result.NumberFromRoman</SiteText>
        }
    </SiteToolForm>
</ToolPage>
