@attribute [Stories("Composition/SiteFormShell")]

<Stories TComponent="SiteFormShell">

    <Story Name="Default">
        <Template>
            <SiteFormShell Title="Edit snippet"
                BackHref="/admin/snippets"
                BackLabel="Back to snippets">
                <SiteForm Model="@_model">
                    <SiteStack>
                        <SiteFormSection Title="Basics" Description="Identity of the record.">
                            <SiteFormField Label="Title" For="shell-title">
                                <SiteTextInput Id="shell-title" @bind-Value="_model.Title" />
                            </SiteFormField>
                            <SiteFormField Label="Slug"
                                For="shell-slug"
                                HelpText="Used in the public URL.">
                                <SiteTextInput Id="shell-slug" @bind-Value="_model.Slug" />
                            </SiteFormField>
                        </SiteFormSection>
                    </SiteStack>

                    <SiteSaveBar CancelHref="/admin/snippets" />
                </SiteForm>
            </SiteFormShell>
        </Template>
    </Story>

    <Story Name="Loading">
        <Template>
            <SiteFormShell Title="Edit snippet" Loading="true" LoadingLabel="Loading snippet…">
                <SiteText>never shown while loading</SiteText>
            </SiteFormShell>
        </Template>
    </Story>

    <Story Name="Error">
        <Template>
            <SiteFormShell Title="Edit snippet" Error="Could not save: the slug is already taken.">
                <SiteText>form body</SiteText>
            </SiteFormShell>
        </Template>
    </Story>

</Stories>

@code {
    private sealed class ShellModel
    {
        public string? Title { get; set; } = "Sample snippet";
        public string? Slug { get; set; } = "sample-snippet";
    }

    private readonly ShellModel _model = new();
}
