@using BlazorBlueprint.Primitives.Utilities

<button type="@TypeAttribute"
    class="@RootClass"
    disabled="@(Disabled || Loading)"
    @attributes="ButtonAttributes"
    @onclick="HandleClickAsync"
    @onmouseenter="HandleTriggerMouseEnter"
    @onmouseleave="HandleTriggerMouseLeave"
    @onfocus="HandleTriggerFocus"
    @onblur="HandleTriggerBlur"
    @ref="_elementRef">
    @if (Loading)
    {
        <span class="site-loading-spinner" aria-hidden="true">
        </span>
    }
    @ChildContent
</button>

@code {
    /// <summary>Visual style of the button.</summary>
    [Parameter]
    public SiteButtonVariant Variant { get; set; } = SiteButtonVariant.Outline;
    /// <summary>Height and density of the button.</summary>
    [Parameter]
    public SiteButtonSize Size { get; set; } = SiteButtonSize.Default;
    /// <summary>HTML button type.</summary>
    [Parameter]
    public SiteButtonType Type { get; set; } = SiteButtonType.Button;
    /// <summary>Disables the button.</summary>
    [Parameter]
    public bool Disabled { get; set; }
    /// <summary>Marks the button as busy; also disables it.</summary>
    [Parameter]
    public bool Loading { get; set; }
    /// <summary>Extra class applied to the root element.</summary>
    [Parameter]
    public string? Class { get; set; }
    /// <summary>Click handler.</summary>
    [Parameter]
    public EventCallback<Microsoft.AspNetCore.Components.Web.MouseEventArgs> OnClick { get; set; }
    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary> /// IMPORTANT: cascaded by a Popover/Dialog/DropdownMenu trigger wrapper (BlazorBlueprint.Primitives) when this /// button is used as its trigger. Wiring these callbacks directly onto our own native &lt;button&gt; gets the /// real open/close/keyboard behavior from the headless primitive layer without adopting its styled Button, /// which bakes in Tailwind utility classes we cannot suppress. /// </summary>
    /// <summary> /// IMPORTANT: BlazorBlueprint's AsChild-mode triggers (Tooltip confirmed live; Dropdown/Popover by /// the same decompiled pattern) cascade this value with an explicit Name="TriggerContext". Blazor's /// CascadingValue-to-CascadingParameter matching requires the consumer's Name to match exactly (an /// unnamed parameter never binds to a named provider) -- confirmed live via BbTooltipTrigger's own /// "TriggerContext rendered with AsChild=true but not consumed" dev warning until this was added. /// </summary>
    [CascadingParameter(Name = "TriggerContext")]
    private TriggerContext? Trigger { get; set; }

    private ElementReference _elementRef;

    private string? AriaBusy => Loading ? "true" : null;

    private string RootClass => SiteCss.Join("site-control", Class);

    private string TypeAttribute => Type switch
    {
        SiteButtonType.Submit => "submit",
        SiteButtonType.Reset => "reset",
        _ => "button",
    };

    private string VariantToken => Variant switch
    {
        SiteButtonVariant.Default => "default",
        SiteButtonVariant.Destructive => "destructive",
        SiteButtonVariant.Secondary => "secondary",
        SiteButtonVariant.Ghost => "ghost",
        SiteButtonVariant.Link => "link",
        SiteButtonVariant.Outline => "outline",
        _ => "outline",
    };

    private string SizeToken => Size switch
    {
        SiteButtonSize.Xs => "xs",
        SiteButtonSize.Sm => "sm",
        SiteButtonSize.Lg => "lg",
        SiteButtonSize.IconXs => "icon-xs",
        SiteButtonSize.IconSm => "icon-sm",
        SiteButtonSize.Icon => "icon",
        SiteButtonSize.IconLg => "icon-lg",
        _ => "default",
    };

    private Dictionary<string, object> BaseAttributes
    {
        get
        {
            var attributes = AdditionalAttributes is null
                ? new Dictionary<string, object>()
                : AdditionalAttributes.Where(attribute => !attribute.Key.Equals("type", StringComparison.OrdinalIgnoreCase)).ToDictionary(attribute => attribute.Key, attribute => attribute.Value);
            attributes["data-slot"] = "button";
            attributes["data-variant"] = VariantToken;
            attributes["data-size"] = SizeToken;
            if (Trigger is not null)
            {
                if (Trigger.TriggerId is not null)
                {
                    attributes["id"] = Trigger.TriggerId;
                }
                if (Trigger.AriaHasPopup is not null)
                {
                    attributes["aria-haspopup"] = Trigger.AriaHasPopup;
                }
                if (Trigger.AriaControls is not null)
                {
                    attributes["aria-controls"] = Trigger.AriaControls;
                }
                attributes["aria-expanded"] = Trigger.IsOpen ? "true" : "false";
            }
            return attributes;
        }
    }

    private Dictionary<string, object> ButtonAttributes
    {
        get
        {
            var attributes = BaseAttributes;
            if (AriaBusy is not null)
            {
                attributes["aria-busy"] = AriaBusy;
            }
            return attributes;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && Trigger is not null)
        {
            Trigger.SetTriggerElement?.Invoke(_elementRef);
            Trigger.NotifyConsumed();
        }
    }

    private async Task HandleClickAsync(Microsoft.AspNetCore.Components.Web.MouseEventArgs args)
    {
        Trigger?.Toggle?.Invoke();
        await OnClick.InvokeAsync(args);
    }

    /// <summary> /// IMPORTANT: also consumes a Tooltip's TriggerContext (same shared type as Dropdown/Popover). /// BbTooltipTrigger's AsChild mode renders no element of its own and expects the child to wire /// these itself; without this, using SiteButton as a tooltip's AsChild content would silently /// never open the tooltip on hover/focus. /// </summary>
    private void HandleTriggerMouseEnter() => Trigger?.OnMouseEnter?.Invoke();
    private void HandleTriggerMouseLeave() => Trigger?.OnMouseLeave?.Invoke();
    private void HandleTriggerFocus() => Trigger?.OnFocus?.Invoke();
    private void HandleTriggerBlur() => Trigger?.OnBlur?.Invoke();
}
