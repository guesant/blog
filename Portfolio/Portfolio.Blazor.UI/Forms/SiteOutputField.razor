<SiteFormField Label="@Label" For="@Id">
    @if (Multiline)
    {
        <SiteTextAreaInput Id="@Id" Value="@Value" readonly />
    }
    else
    {
        <SiteInput Id="@Id" Type="text" Value="@Value" readonly />
    }
    @if (Copyable)
    {
        <SiteCopyButton Value="@Value" Label="@CopyLabel" />
    }
</SiteFormField>

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;
    [Parameter]
    public string Value { get; set; } = string.Empty;
    [Parameter]
    public bool Copyable { get; set; } = true;
    [Parameter]
    public bool Multiline { get; set; }
    [Parameter]
    public string CopyLabel { get; set; } = "copy";
}
