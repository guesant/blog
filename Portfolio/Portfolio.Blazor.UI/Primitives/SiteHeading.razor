@switch (Level)
{
    case 1:
        <h1 class="@RootClass"
            data-slot="heading"
            data-visual="@ResolvedVisual"
            id="@Id"
            @attributes="ForwardedAttributes">@ChildContent</h1>
        break;
    case 2:
        <h2 class="@RootClass"
            data-slot="heading"
            data-visual="@ResolvedVisual"
            id="@Id"
            @attributes="ForwardedAttributes">@ChildContent</h2>
        break;
    case 3:
        <h3 class="@RootClass"
            data-slot="heading"
            data-visual="@ResolvedVisual"
            id="@Id"
            @attributes="ForwardedAttributes">@ChildContent</h3>
        break;
    case 4:
        <h4 class="@RootClass"
            data-slot="heading"
            data-visual="@ResolvedVisual"
            id="@Id"
            @attributes="ForwardedAttributes">@ChildContent</h4>
        break;
    case 5:
        <h5 class="@RootClass"
            data-slot="heading"
            data-visual="@ResolvedVisual"
            id="@Id"
            @attributes="ForwardedAttributes">@ChildContent</h5>
        break;
    default:
        <h6 class="@RootClass"
            data-slot="heading"
            data-visual="@ResolvedVisual"
            id="@Id"
            @attributes="ForwardedAttributes">@ChildContent</h6>
        break;
}
