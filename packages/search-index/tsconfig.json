{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["esnext"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "incremental": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.mts", "test/**/*.test.ts"],
  "exclude": ["node_modules"]
}
