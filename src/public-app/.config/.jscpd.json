{
  "mode": "strict",
  "threshold": 1,
  "minLines": 8,
  "minTokens": 100,
  "maxGapLines": 1,
  "similarity": 0.85,
  "ignoreIdentifiers": true,
  "ignoreLiterals": true,
  "ignoreAnnotations": true,
  "format": ["typescript", "tsx"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/index.ts",
    "**/routeTree.gen.ts",
    "src/data/api/generated/**",
    "src/data/api/public-site-source.ts",
    "src/data/services/content-service.ts"
  ],
  "reporters": ["console", "threshold"]
}
