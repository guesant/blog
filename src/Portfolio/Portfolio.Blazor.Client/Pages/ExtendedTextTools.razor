@inherits LocalizedComponentBase
@implements IDisposable
@page "/tools/text-case"
@page "/pt-BR/tools/text-case"
@page "/tools/case-style-converter"
@page "/pt-BR/tools/case-style-converter"
@page "/tools/dot-case-converter"
@page "/pt-BR/tools/dot-case-converter"
@page "/tools/duplicate-word-finder"
@page "/pt-BR/tools/duplicate-word-finder"
@page "/tools/palindrome-checker"
@page "/pt-BR/tools/palindrome-checker"
@page "/tools/word-frequency-counter"
@page "/pt-BR/tools/word-frequency-counter"
@page "/tools/line-sorter"
@page "/pt-BR/tools/line-sorter"
@page "/tools/reading-time-estimator"
@page "/pt-BR/tools/reading-time-estimator"
@page "/tools/invisible-char-remover"
@page "/pt-BR/tools/invisible-char-remover"
@page "/tools/lorem-ipsum-generator"
@page "/pt-BR/tools/lorem-ipsum-generator"
@page "/tools/pig-latin"
@page "/pt-BR/tools/pig-latin"
@page "/tools/leetspeak"
@page "/pt-BR/tools/leetspeak"
@page "/tools/uwu-speak"
@page "/pt-BR/tools/uwu-speak"
@using System.Globalization
@using Portfolio.Blazor.Core
@using Microsoft.JSInterop
@inject IJSRuntime JS

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action"
        SubmitLabel="@SubmitLabel"
        Submit="SiteToolFormSubmit.StaticOnly"
        OnSubmit="Recalculate"
        AriaLabel="@(Slug == "lorem-ipsum-generator" ? ParagraphLabel : InputLabel)">
        @if (Slug == "lorem-ipsum-generator")
        {
            <SiteFormField For="extended-text-count"
                Label="@ParagraphLabel"><SiteInput Id="extended-text-count"
                    Name="count"
                    Type="number"
                    min="1"
                    max="20"
                    Value="@NumberText"
                    ValueChanged="@(v => NumberText = v)" /></SiteFormField>
        }
        else
        {
            <SiteFormField For="extended-text-input"
                Label="@InputLabel"><SiteTextAreaInput Id="extended-text-input"
                    Name="text"
                    Rows="12"
                    Value="@Input"
                    ValueChanged="@(v => Input = v)" /></SiteFormField>
        }
        @if (Slug == "line-sorter")
        {
            <SiteFormField For="line-sort-mode"
                Label="@SortModeLabel"><SiteSelect @bind-Value="ModeText"
                    Options="@SortModeOptions"
                    Id="line-sort-mode"
                    Name="mode"
                    Placeholder="@SortModeLabel"
                    EmptyText="@SortModeLabel" /></SiteFormField>
        }
    </SiteToolForm>

    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (!Result.IsValid)
        {
            <SiteErrorMessage>@ErrorLabel</SiteErrorMessage>
        }
        else if (Slug == "palindrome-checker")
        {
            <SiteOutputField Id="extended-output"
                Label="@ResultLabel"
                Value="@(Result.Output == "true" ? YesLabel : NoLabel)"
                Copyable="false" />
        }
        else if (Slug == "reading-time-estimator")
        {
            <SiteOutputField Id="extended-output"
                Label="@ResultLabel"
                Value="@($"{Result.Count} {WordsLabel} · {ReadingTime}")"
                Copyable="false" />
        }
        else if (Slug is "duplicate-word-finder" or "word-frequency-counter")
        {
            <SiteCard Class="site-block" Label="@ResultLabel">
                @if (Result.Rows.Count == 0)
                {
                    <SiteText>@EmptyLabel</SiteText>
                }
                else
                {
                    @if (RendererInfo.IsInteractive)
                    {
                        <SiteJsMount Id="@FrequencyTableId"
                            Class="table-scroll"
                            AriaLabel="@ResultLabel" />
                    }
                    else
                    {
                        <SiteDataTable TItem="TextToolRow"
                            Items="@Result.Rows"
                            RowKey="@(row => row.Label)"
                            Caption="@ResultLabel"
                            EmptyText="@(L["no_results_found"])">
                            <Columns>
                                <SiteColumn TItem="TextToolRow"
                                    Header="@WordLabel"
                                    IsRowHeader="true">
                                    <Cell Context="row">@row.Label</Cell>
                                </SiteColumn>
                                <SiteColumn TItem="TextToolRow" Header="@CountLabel">
                                    <Cell Context="row">@row.Count</Cell>
                                </SiteColumn>
                            </Columns>
                        </SiteDataTable>
                    }
                }
            </SiteCard>
        }
        else
        {
            <SiteOutputField Id="extended-output"
                Label="@ResultLabel"
                Value="@Result.Output"
                Multiline="true"
                Copyable="true"
                CopyLabel="@CopyLabel" />
        }
    </SiteLiveRegion>
</ToolPage>
