# Public base URL the app uses to build absolute links (sitemap, PDF export,
# OpenGraph tags). Must match the domain served through the Cloudflare Tunnel.
PUBLIC_SITE_BASE_URL=https://www.guesant.net

# Production refuses to start when the persistent SQLite volume is missing
# or empty. Set to true only for an intentional first bootstrap, then remove
# it. Deploys never migrate the schema: run `just db-update` deliberately, after
# a backup, once a real copy of portfolio.sqlite is restored into the volume.
PORTFOLIO_ALLOW_EMPTY_BOOTSTRAP=false

TECTONIC_BUNDLE=https://data1.fullyjustified.net/tlextras-2022.0r0.tar

# Cloudflare Tunnel token (from the Cloudflare Zero Trust dashboard,
# when creating the tunnel that points to http://web:8080).
CLOUDFLARE_TUNNEL_TOKEN=

# OAuth client from Google Cloud Console (APIs & Services -> Credentials ->
# Create Credentials -> OAuth client ID -> Web application). Authorized
# redirect URI must be exactly {PUBLIC_SITE_BASE_URL}/signin-google, since
# the app never overrides the default CallbackPath.
PORTFOLIO_ADMIN_GOOGLE_CLIENT_ID=
PORTFOLIO_ADMIN_GOOGLE_CLIENT_SECRET=

# Only this Google account is allowed to sign in to /admin.
PORTFOLIO_ADMIN_GOOGLE_EMAIL=
