@inherits LocalizedComponentBase
@page "/tools/text-counter"
@page "/pt-BR/tools/text-counter"
@using Portfolio.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action"
        SubmitLabel="@SubmitLabel"
        Submit="SiteToolFormSubmit.StaticOnly"
        OnSubmit="HandleSubmit"
        AriaLabel="@InputLabel">
        <SiteFormField Label="@InputLabel" For="text-counter-input">
            <SiteTextAreaInput Id="text-counter-input"
                Name="text"
                Rows="12"
                Value="@Text"
                ValueChanged="@(v => Text = v)" />
        </SiteFormField>
    </SiteToolForm>

    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        <SiteStats>
            <SiteStatItem Label="@CharactersLabel">@Statistics.Characters</SiteStatItem>
            <SiteStatItem Label="@CharactersWithoutSpacesLabel">@Statistics.CharactersWithoutSpaces</SiteStatItem>
            <SiteStatItem Label="@WordsLabel">@Statistics.Words</SiteStatItem>
            <SiteStatItem Label="@SentencesLabel">@Statistics.Sentences</SiteStatItem>
            <SiteStatItem Label="@LinesLabel">@Statistics.Lines</SiteStatItem>
            <SiteStatItem Label="@ParagraphsLabel">@Statistics.Paragraphs</SiteStatItem>
        </SiteStats>
    </SiteLiveRegion>
</ToolPage>

@code {
    private string CanonicalPath => RequestPath;
    private string _text = string.Empty;
    private TextStatistics _statistics;
    private bool _queryInitialized;

    [SupplyParameterFromQuery(Name = "text")]
    private string? QueryText { get; set; }

    private string Action => L["legacy_3078942a68c1"];
    private string Title => L["legacy_95a42b1ab997"];
    private string Description => L["text_counter_description"];
    private string InputLabel => L["legacy_a5b167e7baff"];
    private string SubmitLabel => L["legacy_718517a8ab26"];
    private string CharactersLabel => L["legacy_4947adb6830a"];
    private string CharactersWithoutSpacesLabel => L["legacy_2d0b5336dd9c"];
    private string WordsLabel => L["legacy_2badb3241476"];
    private string SentencesLabel => L["legacy_651fdc2bba19"];
    private string LinesLabel => L["legacy_fe63ef856ae5"];
    private string ParagraphsLabel => L["legacy_9252aae5ccfa"];

    private string Text
    {
        get => _text;
        set
        {
            _text = value;
            _statistics = TextStatisticsCalculator.Analyze(_text);
        }
    }

    private TextStatistics Statistics => _statistics;

    protected override void OnParametersSet()
    {
        if (!_queryInitialized)
        {
            Text = QueryText ?? string.Empty;
            _queryInitialized = true;
        }
    }

    private void HandleSubmit()
    {
        _statistics = TextStatisticsCalculator.Analyze(Text);
    }
}
