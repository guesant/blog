@using Portfolio.Blazor.Core
@inject IStringLocalizer<SharedResource> L

<SitePage Template="maintenance" Class="site-maintenance">
    <SiteCard Class="text-center">
        @if (!string.IsNullOrWhiteSpace(Snapshot.Chrome.Site.MaintenanceEyebrow))
        {
            <SiteText Variant="SiteTextVariant.SectionLabel">@Snapshot.Chrome.Site.MaintenanceEyebrow</SiteText>
        }
        <SiteHeading Level="1">@(Snapshot.Chrome.Site.MaintenanceTitle ?? L["back_soon"])</SiteHeading>
        <SiteText Variant="SiteTextVariant.Lead"
            Class="text-body-secondary">@(Snapshot.Chrome.Site.MaintenanceDescription ?? L["maintenance_description"])</SiteText>
        <SiteStack Gap="SiteSpace.None" Class="maintenance-cat">
            <pre aria-label="cat"> /\_/\\
( o.o )
 &gt; ^ &lt;</pre>
        </SiteStack>
        @if (Snapshot.Chrome.Profile is { Name: not null } profile)
        {
            <SiteText Class="text-body-secondary">@profile.Name</SiteText>
        }
    </SiteCard>
</SitePage>
