<div class="site-markdown-split-editor" data-slot="markdown-split-editor">
    <div class="site-markdown-split-editor-pane">
        <SiteText Variant="SiteTextVariant.Small">@EditorLabel</SiteText>
        <SiteTextAreaInput Id="@Id" Rows="@Rows" Value="@Value" ValueChanged="@ValueChanged" />
    </div>
    <div class="site-markdown-split-editor-pane">
        <SiteText Variant="SiteTextVariant.Small">@PreviewLabel</SiteText>
        <div class="rich-text">@((MarkupString)Render(Value))</div>
    </div>
</div>
