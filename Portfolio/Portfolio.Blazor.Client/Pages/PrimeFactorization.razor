@inherits LocalizedComponentBase
@implements IDisposable
@page "/tools/prime-factorization"
@page "/pt-BR/tools/prime-factorization"
@using System.Globalization
@using Portfolio.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action"
        SubmitLabel="@SubmitLabel"
        Submit="SiteToolFormSubmit.StaticOnly"
        OnSubmit="HandleSubmit"
        AriaLabel="@InputLabel">
        <SiteFormField Label="@NumberLabel" For="prime-factorization-number">
            <SiteInput Id="prime-factorization-number"
                Name="number"
                Type="number"
                min="-1000000000000"
                max="1000000000000"
                Value="@NumberText"
                ValueChanged="@(v => NumberText = v)" />
        </SiteFormField>
    </SiteToolForm>

    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (!Result.IsValid)
        {
            <SiteErrorMessage>@ErrorLabel</SiteErrorMessage>
        }
        else
        {
            <SiteCard Class="site-block" Label="@ResultLabel">
                <SiteText Variant="SiteTextVariant.Body">
                    <code>@Result.Number</code> = @string.Join(" × ", Result.Factors)</SiteText>
            </SiteCard>
        }
    </SiteLiveRegion>
</ToolPage>
