@inherits LocalizedComponentBase
@page "/tools/css-box-shadow-generator"
@page "/pt-BR/tools/css-box-shadow-generator"
@using Portfolio.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteCard Class="site-block" Label="@Title">
        @if (RendererInfo.IsInteractive)
        {
            <SiteStack Class="tool-stop-list">@foreach (var layer in Layers) { <SiteInline Class="tool-stop-row">
                <SiteFormField For="@($"shadow-x-{layer.Id}")"
                    Label="x"><SiteInput id="@($"shadow-x-{layer.Id}")"
                        type="number"
                        Value="@layer.X.ToString()"
                        OnInput="eventArgs => { if (int.TryParse(eventArgs.Value?.ToString(), out var value)) layer.X = value; }" /></SiteFormField>
                    <SiteFormField For="@($"shadow-y-{layer.Id}")"
                        Label="y"><SiteInput id="@($"shadow-y-{layer.Id}")"
                            type="number"
                            Value="@layer.Y.ToString()"
                            OnInput="eventArgs => { if (int.TryParse(eventArgs.Value?.ToString(), out var value)) layer.Y = value; }" /></SiteFormField>
                        <SiteFormField For="@($"shadow-blur-{layer.Id}")"
                            Label="@BlurLabel"><SiteInput id="@($"shadow-blur-{layer.Id}")"
                                type="number"
                                min="0"
                                Value="@layer.Blur.ToString()"
                                OnInput="eventArgs => { if (int.TryParse(eventArgs.Value?.ToString(), out var value)) layer.Blur = value; }" /></SiteFormField>
                            <SiteFormField For="@($"shadow-spread-{layer.Id}")"
                                Label="@SpreadLabel"><SiteInput id="@($"shadow-spread-{layer.Id}")"
                                    type="number"
                                    Value="@layer.Spread.ToString()"
                                    OnInput="eventArgs => { if (int.TryParse(eventArgs.Value?.ToString(), out var value)) layer.Spread = value; }" /></SiteFormField>
                                <SiteFormField For="@($"shadow-color-{layer.Id}")"
                                    Label="@ColorLabel"><SiteInput id="@($"shadow-color-{layer.Id}")"
                                        type="color"
                                        @bind="layer.Color" /></SiteFormField>
                                            <SiteCheckbox Label="@InsetLabel"
                                            @bind-Value="layer.Inset" /><SiteButton aria-label="@RemoveLabel"
                                                Disabled="@(Layers.Count <= 1)"
                                                @onclick="() => RemoveLayer(layer)"
                                                Variant="SiteButtonVariant.Default"
                                                Class="tool-action-btn"><SiteIcon Name="trash-2"
                                                    Size="14" /></SiteButton>
                                                    </SiteInline> }</SiteStack>
            <SiteButton @onclick="AddLayer"
                Variant="SiteButtonVariant.Default"
                Class="tool-action-btn"><SiteIcon Name="plus" Size="14" />@AddLabel</SiteButton>
        }
        else
        {
            <SiteFilterCard Action="@Action"
                DataLayoutRegion="tool-form"
                FormClass="d-grid gap-3"
                Class="site-block">
                <SiteStack Class="tool-stop-list">
                    <SiteInline Class="tool-stop-row">
                        <SiteFormField For="shadow-x"
                            Label="x"><SiteInput id="shadow-x"
                                name="x"
                                type="number"
                                value="@Layers[0].X.ToString()" />
                            </SiteFormField>
                            <SiteFormField For="shadow-y"
                                Label="y"><SiteInput id="shadow-y"
                                    name="y"
                                    type="number"
                                    value="@Layers[0].Y.ToString()" />
                                </SiteFormField>
                                <SiteFormField For="shadow-blur"
                                    Label="@BlurLabel"><SiteInput id="shadow-blur"
                                        name="blur"
                                        type="number"
                                        min="0"
                                        value="@Layers[0].Blur.ToString()" /></SiteFormField>
                                    <SiteFormField For="shadow-spread"
                                        Label="@SpreadLabel"><SiteInput id="shadow-spread"
                                            name="spread"
                                            type="number"
                                            value="@Layers[0].Spread.ToString()" /></SiteFormField>
                                        <SiteFormField For="shadow-color"
                                            Label="@ColorLabel"><SiteInput id="shadow-color"
                                                name="color"
                                                type="color"
                                                value="@Layers[0].Color" /></SiteFormField>
                                                    <SiteCheckbox Label="@InsetLabel"
                                                    Name="inset"
                                                    Value="@Layers[0].Inset"
                                                    HtmlValue="true" /></SiteInline>
                                    </SiteStack>
                                    <SiteButton Variant="SiteButtonVariant.Default"
                                        Type="SiteButtonType.Submit"><SiteIcon Name="sparkles"
                                            Size="14" />@GenerateLabel</SiteButton>
                                            </SiteFilterCard>
        }
        <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
            <SiteStack Class="tool-css-preview-wrap">
                <SitePreviewBox Class="tool-css-preview"
                    Style="@($"box-shadow: {ShadowValue}")"
                    AriaLabel="box shadow preview" />
            </SiteStack>
            <SiteOutputField Id="shadow-output"
                Label="@OutputLabel"
                Value="@CssValue"
                CopyLabel="@CopyLabel" />
        </SiteLiveRegion>
    </SiteCard>
</ToolPage>
