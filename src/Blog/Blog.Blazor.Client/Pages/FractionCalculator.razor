@inherits LocalizedComponentBase
@page "/tools/fraction-calculator"
@page "/pt-BR/tools/fraction-calculator"
@using System.Globalization
@using Blog.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action"
        SubmitLabel="@SubmitLabel"
        Submit="SiteToolFormSubmit.StaticOnly"
        OnSubmit="Calculate"
        AriaLabel="@OperationLabel">
        <SiteFormField Label="a"
            For="fraction-a"><SiteInput Id="fraction-a"
                Name="a"
                Type="number"
                step="1"
                Value="@NumeratorA"
                ValueChanged="@(v => NumeratorA = v)" /></SiteFormField>
        <SiteFormField Label="b"
            For="fraction-b"><SiteInput Id="fraction-b"
                Name="b"
                Type="number"
                step="1"
                Value="@DenominatorB"
                ValueChanged="@(v => DenominatorB = v)" /></SiteFormField>
        <SiteFormField Label="@OperationLabel"
            For="fraction-operation"><SiteSelect @bind-Value="OperationText"
                Options="@OperationOptions"
                Id="fraction-operation"
                Name="operation"
                Placeholder="@OperationLabel"
                EmptyText="@OperationLabel" /></SiteFormField>
        <SiteFormField Label="c"
            For="fraction-c"><SiteInput Id="fraction-c"
                Name="c"
                Type="number"
                step="1"
                Value="@NumeratorC"
                ValueChanged="@(v => NumeratorC = v)" /></SiteFormField>
        <SiteFormField Label="d"
            For="fraction-d"><SiteInput Id="fraction-d"
                Name="d"
                Type="number"
                step="1"
                Value="@DenominatorD"
                ValueChanged="@(v => DenominatorD = v)" /></SiteFormField>
    </SiteToolForm>
    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (!Result.IsValid) { <SiteErrorMessage>@ErrorLabel</SiteErrorMessage> }
        else { <SiteCard Class="site-block"
            Label="@ResultLabel"><SiteText Variant="SiteTextVariant.Body"
                Class="tool-result-value">@Result.Value = @Decimal(Result.Value)</SiteText>
                    <SiteList Variant="SiteListVariant.Steps"
                    Ordered="true">
            <SiteListItem>(@NumeratorA/@DenominatorB) @OperationText (@NumeratorC/@DenominatorD)</SiteListItem>
                <SiteListItem>@ResultLabel: @Result.Value</SiteListItem>
            </SiteList>
        </SiteCard> }
    </SiteLiveRegion>
</ToolPage>
