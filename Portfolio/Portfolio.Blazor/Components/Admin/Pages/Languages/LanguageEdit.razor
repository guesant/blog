@page "/admin/languages/create"
@page "/admin/languages/{Id:int}"
@inherits AdminEditPageBase<Language>
@layout AdminLayout

<PageTitle>@(IsEditing ? "Edit language" : "New language")</PageTitle>

<SiteFormShell Title="@(IsEditing ? "Edit language" : "New language")"
    Error="@SaveError"
    Loading="@IsLoading">
    <SiteForm EditContext="@_languageEditContext" OnValidSubmit="HandleSaveAsync">
        <SiteStack Gap="SiteSpace.Lg">
            <SiteFormField Label="Slug" For="slug" Required="true">
                <SiteTextInput Id="slug" @bind-Value="_language.Slug" />
                <SiteValidationMessage For="@(() => _language.Slug)" />
            </SiteFormField>

            <SiteFormField Label="Code"
                For="code"
                Required="true"
                HelpText="Locale code, e.g. en or pt-BR.">
                <SiteTextInput Id="code" @bind-Value="_language.Code" />
                <SiteValidationMessage For="@(() => _language.Code)" />
            </SiteFormField>


            <SiteFormSection Title="Translations">
                <SiteTranslationTabs Locales="@_locales"
                    ActiveLocale="@_activeLocale"
                    ActiveLocaleChanged="@((string locale) => _activeLocale = locale)"
                    IdPrefix="language-translation">
                    <Panel Context="locale">
                        @if (locale == "en")
                        {
                            <CascadingValue Value="_enEditContext"
                                TValue="EditContext"
                                IsFixed="true">
                                <DataAnnotationsValidator />
                                <SiteFormField Label="Name"
                                    For="name-en"
                                    HelpText="Leave blank to skip saving the English translation.">
                                    <SiteTextInput Id="name-en" @bind-Value="_translationEn.Name" />
                                </SiteFormField>
                            </CascadingValue>
                        }
                        else
                        {
                            <CascadingValue Value="_ptEditContext"
                                TValue="EditContext"
                                IsFixed="true">
                                <DataAnnotationsValidator />
                                <SiteFormField Label="Nome"
                                    For="name-pt"
                                    HelpText="Deixe em branco para não salvar a tradução em português.">
                                    <SiteTextInput Id="name-pt"
                                        @bind-Value="_translationPtBr.Name" />
                                </SiteFormField>
                            </CascadingValue>
                        }
                    </Panel>
                </SiteTranslationTabs>
            </SiteFormSection>
        </SiteStack>

        <SiteSaveBar Saving="@IsSaving" CancelHref="/admin/languages" />
    </SiteForm>
</SiteFormShell>
