@page "/admin/collections"
@page "/admin/collections/order"
@inherits AdminListPageBase<ReferenceCollection>
@layout AdminLayout

<PageTitle>Collections</PageTitle>

@if (IsOrderMode)
{
    <AdminOrderEditor TItem="ReferenceCollection"
        Title="Collections order"
        ListRoute="/admin/collections"
        Items="@Items"
        DisplayTitle="@DisplayTitle"
        IsLoading="@IsLoading"
        IsSaving="@IsSaving"
        Error="@Error"
        OnReordered="HandleReorder"
        OnSave="@(() => HandleSaveOrderAsync("/admin/collections"))" />
}
else
{
    <SitePageHeader Title="Collections">
        <Actions>
            <SiteInline Gap="SiteSpace.Sm">
                <SiteLink Variant="SiteButtonVariant.Outline" Href="/admin/collections/order">
                    <SiteIcon Name="arrow-up-down" Size="14" />Edit order</SiteLink>
                <SiteLink Variant="SiteButtonVariant.Default" Href="/admin/collections/create">
                    <SiteIcon Name="plus" Size="14" />New collection</SiteLink>
            </SiteInline>
        </Actions>
    </SitePageHeader>

    @if (Error is not null)
    {
        <SiteNotice Tone="SiteTone.Danger">@Error</SiteNotice>
    }

    @if (IsLoading)
    {
        <SiteLoading Label="Loading…" />
    }
    else
    {
        <SiteDataTable TItem="ReferenceCollection"
            Items="@PageItems"
            EmptyText="No collections yet."
            RowKey="@(collection => collection.Id)">
            <Columns>
                <SiteColumn TItem="ReferenceCollection"
                    Header="Title"
                    IsRowHeader="true"><Cell Context="collection">@DisplayTitle(collection)</Cell>
                    </SiteColumn>
                <SiteColumn TItem="ReferenceCollection" Header="Slug">
                    <Cell Context="collection">@collection.Slug</Cell>
                </SiteColumn>
                <SiteColumn TItem="ReferenceCollection" Header="Items">
                    <Cell Context="collection">@collection.Items.Count</Cell>
                </SiteColumn>
                <SiteColumn TItem="ReferenceCollection"
                    Header="Status"><Cell Context="collection">@if (collection.Hidden) { <SiteBadge Label="Hidden" /> }</Cell>
                    </SiteColumn>
                <SiteColumn TItem="ReferenceCollection"
                    Header="Published"><Cell Context="collection">@(collection.PublishedAt?.ToString("yyyy-MM-dd") ?? "·")</Cell>
                    </SiteColumn>
            </Columns>
            <Actions Context="collection">
                <SiteInline Gap="SiteSpace.Sm">
                    <SiteLink Variant="SiteButtonVariant.Outline"
                        Href="@($"/admin/collections/{collection.Id}")">
                        <SiteIcon Name="pencil" Size="14" />Edit</SiteLink>
                    <SiteButton Variant="SiteButtonVariant.Destructive"
                        @onclick="@(() => HandleDeleteAsync(collection))"><SiteIcon Name="trash-2"
                            Size="14" />Delete</SiteButton>
                </SiteInline>
            </Actions>
        </SiteDataTable>
        <SitePagination CurrentPage="@CurrentPage" TotalPages="@TotalPages" Href="@PageUrl" />
    }
}
