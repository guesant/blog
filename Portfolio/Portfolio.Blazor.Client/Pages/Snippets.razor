@inherits ListPageBase
@page "/snippets"
@page "/pt-BR/snippets"
@using Portfolio.Blazor.Core

<PageTitle>@Title</PageTitle>
<SeoHead Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath" />

<SitePage Template="snippets-index">
    <SiteBreadcrumb HomeUrl="@LocalizedPath("home")"
        HomeLabel="@(L["legacy_ddc150008e2f"])"
        CurrentLabel="@CrumbLabel("snippets", L["legacy_b87eedb8eefd"])" />
    @if (Snapshot is null)
    {
        <SiteHero Title="@LoadingLabel" />
        <SiteListingShell HasResults="false"
            CurrentPage="@CurrentPage"
            TotalPages="@PageCount"
            PaginationLabel="@(L["legacy_ce41390e654d"] )"
            PreviousLabel="@(L["legacy_c3b535ded088"] )"
            NextLabel="@(L["legacy_a6c78a6436e2"] )"
            Href="@(page => QueryUrl(ViewMode, page))">
            <EmptyContent>
                <SiteEmptyState Message="@LoadingLabel" />
            </EmptyContent>
        </SiteListingShell>
    }
    else
    {
        <SiteHero Title="@PageField("title", Title)"
            Lead="@PageField("description", Description)"/>

            <SiteListingShell HasResults="@(PagedSnippets.Count > 0)"
                Summary="@ListingSummary(PagedSnippets.Count, SortedSnippets.Count, CurrentPage, PageCount)"
                CurrentPage="@CurrentPage"
                TotalPages="@PageCount"
                PaginationLabel="@(L["legacy_ce41390e654d"])"
                PreviousLabel="@(L["legacy_c3b535ded088"])"
                NextLabel="@(L["legacy_a6c78a6436e2"])"
                Href="@(page => QueryUrl(ViewMode, page))">
            <FilterContent>
                <SiteListingFilterBar Action="@Action"
                    ApplyLabel="@(L["legacy_c975d2551cc4"])"
                    ClearLabel="@(L["legacy_5262517729fc"])"
                    ClearHref="@Action"
                    OnApply="@(() => HandleApply(Action, SortValue, Search, DenseView))">
                    <PrimaryFields>
                        <SiteFilterSelect Icon="arrow-up-down"
                            Label="@(L["legacy_6541e97b7c64"])"
                            Id="snippets-sort"
                            Name="sort"
                            @bind-Value="SortValue"
                            Options="@SortOptions"
                            Placeholder="@(L["legacy_d878d9136e0e"])"
                            EmptyText="@(L["legacy_0bb89437e6cb"])" />
                    </PrimaryFields>
                    <SearchField>
                        <SiteSearchField Label="@(L["legacy_6bb12bff6f09"])"
                            Id="snippets-search"
                            Name="q"
                            Value="@Search"
                            ValueChanged="@((string value) => Search = value)"
                            Placeholder="@(L["search_by_name"])" />
                    </SearchField>
                </SiteListingFilterBar>
            </FilterContent>
                <ResultContent>
            <SiteCardGrid id="view-spacious-snippets"
                aria-label="@Title"
                data-layout-region="items">
                @foreach (var snippet in PagedSnippets)
                {
                    <SiteGridColumn>
                        <SiteFeedCard KindLabel="@(L["kind_snippet"])"
                            Date="@(FormatDate(snippet.PublishedAt) is { } date && date != "·" ? date : null)"
                            Title="@snippet.Title"
                            Href="@LocalizedUrl(snippet.Url)"
                            Preview="@snippet.Description"
                            ViewLabel="@(L["open"])">
                            <MetaItems>
                                <SiteCardMetaItem Icon="file-code">@FileCount(snippet)</SiteCardMetaItem>
                            </MetaItems>
                        </SiteFeedCard>
                    </SiteGridColumn>
                }
            </SiteCardGrid>
            </ResultContent>
            <EmptyContent>
                <SiteEmptyState Message="@EmptyLabel" />
            </EmptyContent>
            </SiteListingShell>
    }
</SitePage>
