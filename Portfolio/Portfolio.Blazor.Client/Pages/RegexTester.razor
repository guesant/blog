@inherits LocalizedComponentBase
@page "/tools/regex-tester"
@page "/pt-BR/tools/regex-tester"
@using Microsoft.JSInterop
@using Portfolio.Blazor.Core
@inject IJSRuntime JS

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action" SubmitLabel="@TestLabel" AriaLabel="@PatternLabel">
        <SiteFormActions>
            <SiteFormField For="regex-pattern"
                Label="@PatternLabel"><SiteInput Id="regex-pattern"
                    Name="pattern"
                    autocomplete="off"
                    spellcheck="false"
                    Value="@Pattern"
                    ValueChanged="@(v => Pattern = v)" /></SiteFormField>
            @if (RendererInfo.IsInteractive)
            {
                <SiteCheckbox Label="@GlobalLabel"
                    Value="@Global"
                    ValueChanged="@(v => Global = v)" />
                <SiteCheckbox Label="@IgnoreCaseLabel"
                    Value="@IgnoreCase"
                    ValueChanged="@(v => IgnoreCase = v)" />
                <SiteCheckbox Label="@MultilineLabel"
                    Value="@Multiline"
                    ValueChanged="@(v => Multiline = v)" />
                <SiteCheckbox Label="@SinglelineLabel"
                    Value="@Singleline"
                    ValueChanged="@(v => Singleline = v)" />
            }
        </SiteFormActions>
        <SiteFormField For="regex-input"
            Label="@TestStringLabel"><SiteTextAreaInput Id="regex-input"
                Name="input"
                Rows="8"
                spellcheck="false"
                Value="@Input"
                ValueChanged="@(v => Input = v)" /></SiteFormField>
    </SiteToolForm>
    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (!Result.IsValid) { <SiteErrorMessage>@InvalidLabel</SiteErrorMessage> }
        <SiteCard Class="site-block"
            Label="@HighlightLabel"><SiteHtmlPreview Class="tool-highlight-preview">@((MarkupString)Result.HighlightHtml)</SiteHtmlPreview>
            </SiteCard>
        <SiteCard Class="site-block" Label="@MatchesLabel">
            <SiteList>@foreach (var match in Result.Matches) { <SiteListItem Class="list-group-item site-list-row tool-list-item">
                <SiteText Variant="SiteTextVariant.Meta"
                    Class="tool-list-value">@match.Value</SiteText>
                    <SiteText Variant="SiteTextVariant.Meta">@(match.Groups.Count > 0 ? string.Join(", ", match.Groups.Select((group, index) => $"#{index + 1}: {group ?? string.Empty}")) : $"#{match.Number}")</SiteText>
                </SiteListItem> }</SiteList>
        </SiteCard>
    </SiteLiveRegion>
</ToolPage>
@code {
    private string CanonicalPath => RequestPath; private string _pattern = string.Empty; private string _input = string.Empty; private bool _global = true; private bool _ignoreCase; private bool _multiline; private bool _singleline; private bool _queryInitialized; [SupplyParameterFromQuery(Name="pattern")] private string? QueryPattern { get; set; } [SupplyParameterFromQuery(Name="input")] private string? QueryInput { get; set; } private string Action => L["legacy_312eb91d9fd3"];  private string Title => L["legacy_9fadfadd9248"]; private string Description => L["legacy_eab2cc79e4d2"]; private string PatternLabel => L["legacy_5e995a75d37b"]; private string TestStringLabel => L["legacy_7e40ce38ac57"]; private string HighlightLabel => L["legacy_b93f00c414ef"]; private string MatchesLabel => L["legacy_7de298425b05"]; private string InvalidLabel => L["legacy_e5d2fa50a2dd"]; private string TestLabel => L["legacy_ff9e12d2239d"]; private string GlobalLabel => "g"; private string IgnoreCaseLabel => "i"; private string MultilineLabel => "m"; private string SinglelineLabel => "s"; private string Pattern { get => _pattern; set => _pattern = value; } private string Input { get => _input; set => _input = value; } private bool Global { get => _global; set => _global = value; } private bool IgnoreCase { get => _ignoreCase; set => _ignoreCase = value; } private bool Multiline { get => _multiline; set => _multiline = value; } private bool Singleline { get => _singleline; set => _singleline = value; } private RegexTestResult Result => RegexTesterEngine.Test(Pattern, Input, IgnoreCase, Multiline, Singleline); protected override void OnParametersSet() { if (_queryInitialized) return; _pattern = QueryPattern ?? string.Empty; _input = QueryInput ?? string.Empty; _queryInitialized = true; } }
