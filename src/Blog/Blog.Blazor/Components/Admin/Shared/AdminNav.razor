@inject NavigationManager Navigation

<ul>
    <li>
        <SiteNavLink Href="/admin"
            Class="admin-nav-link"
            AriaCurrent="@(IsActive("/admin") ? "page" : null)">
            <SiteIcon Name="layout-dashboard" Size="14" Class="icon nav-item-icon" />
            <SiteNavItemLabel>Dashboard</SiteNavItemLabel>
        </SiteNavLink>
    </li>
</ul>
@foreach (var group in NavGroups)
{
    <SiteNavDivider />
    <SiteNavGroup Label="@group.Label" Nested="true">
        @foreach (var item in group.Items)
        {
            <li>
                <SiteNavLink Href="@item.Href"
                    Class="admin-nav-link"
                    AriaCurrent="@(IsActive(item.Href) ? "page" : null)">
                    <SiteIcon Name="@item.Icon" Size="14" Class="icon nav-item-icon" />
                    <SiteNavItemLabel>@item.Label</SiteNavItemLabel>
                </SiteNavLink>
            </li>
        }
    </SiteNavGroup>
}
