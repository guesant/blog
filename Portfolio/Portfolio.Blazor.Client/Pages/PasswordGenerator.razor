@inherits LocalizedComponentBase
@page "/tools/password-generator"
@page "/pt-BR/tools/password-generator"
@using System.Globalization
@using Portfolio.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action"
        SubmitLabel="@GenerateLabel"
        Submit="SiteToolFormSubmit.StaticOnly"
        OnSubmit="Generate"
        AriaLabel="@InputLabel">
        <SiteFormField Label="@LengthLabel"
            For="password-length"><SiteRangeInput Id="password-length"
                Name="length"
                min="8"
                max="64"
                Value="@Length"
                ValueChanged="@(v => Length = v)" /><SiteText Variant="SiteTextVariant.Meta">@Length</SiteText>
                </SiteFormField>
        <SiteFormActions>
            <SiteCheckbox Label="@UppercaseLabel"
                Name="uppercase"
                Value="@Uppercase"
                ValueChanged="@(v => Uppercase = v)"
                HtmlValue="true" />
            <SiteCheckbox Label="@LowercaseLabel"
                Name="lowercase"
                Value="@Lowercase"
                ValueChanged="@(v => Lowercase = v)"
                HtmlValue="true" />
            <SiteCheckbox Label="@NumbersLabel"
                Name="numbers"
                Value="@Numbers"
                ValueChanged="@(v => Numbers = v)"
                HtmlValue="true" />
            <SiteCheckbox Label="@SymbolsLabel"
                Name="symbols"
                Value="@Symbols"
                ValueChanged="@(v => Symbols = v)"
                HtmlValue="true" />
        </SiteFormActions>
    </SiteToolForm>

    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        <SiteCard Class="site-block" Label="@OutputLabel">
            <SiteOutputField Id="password-value"
                Label="@OutputLabel"
                Value="@Result.Value"
                CopyLabel="@CopyLabel" />
            <SiteStack Gap="SiteSpace.None" Class="tool-strength-meter">
                <meter min="0"
                    max="100"
                    value="@Result.StrengthPercent"
                    aria-label="@StrengthLabel">
                </meter>
            </SiteStack>
            <SiteText>@Result.StrengthBits @StrengthLabel</SiteText>
        </SiteCard>
    </SiteLiveRegion>
</ToolPage>
