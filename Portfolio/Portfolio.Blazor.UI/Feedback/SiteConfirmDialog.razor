@implements IDisposable
@inject SiteDialogService Dialogs
@inject IJSRuntime JS

@if (Dialogs.Current is { } request)
{
    <div class="site-dialog-backdrop" data-slot="dialog-backdrop" @onclick="Cancel">
    </div>
    <div
        class="site-dialog"
        data-slot="dialog"
        role="alertdialog"
        aria-modal="true"
        aria-labelledby="site-dialog-title"
        aria-describedby="site-dialog-description"
        @onkeydown="HandleKeyDown"
        tabindex="-1"
        @ref="_dialogRef"
    >
        <SiteHeading Level="2" Id="site-dialog-title">@request.Title</SiteHeading>
        <SiteText Id="site-dialog-description">@request.Description</SiteText>
        <SiteFormActions>
            <SiteButton
                Variant="@(request.Destructive ? SiteButtonVariant.Destructive : SiteButtonVariant.Default)"
                OnClick="Confirm"
            >
                @request.ConfirmLabel
            </SiteButton>
            <SiteButton Variant="SiteButtonVariant.Outline" OnClick="Cancel">
                @request.CancelLabel
            </SiteButton>
        </SiteFormActions>
    </div>
}
