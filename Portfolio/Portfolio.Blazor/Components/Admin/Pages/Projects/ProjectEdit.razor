@page "/admin/projects/create"
@page "/admin/projects/{Id:int}"
@using System.Globalization
@using Portfolio.Blazor.Components.Admin.Shared
@inherits AdminEditPageBase<Project>
@layout AdminLayout

<PageTitle>@(IsEditing ? "Edit project" : "New project")</PageTitle>

<SiteFormShell Title="@(IsEditing ? "Edit project" : "New project")"
    Error="@SaveError"
    Loading="@IsLoading">
    <SiteForm EditContext="@_projectEditContext" OnValidSubmit="HandleSaveAsync">
        <SiteStack Gap="SiteSpace.Lg">
            <SiteFormField Label="Slug"
                For="slug"
                Required="true"
                HelpText="Used in the public project URL.">
                <SiteTextInput Id="slug" @bind-Value="_project.Slug" />
                <SiteValidationMessage For="@(() => _project.Slug)" />
            </SiteFormField>


            <SiteFormField Label="Href"
                For="href"
                HelpText="External link override, if this project points elsewhere.">
                <SiteTextInput Id="href"
                    Value="@(_project.Href ?? string.Empty)"
                    ValueChanged="@(value => _project.Href = string.IsNullOrWhiteSpace(value) ? null : value)" />
            </SiteFormField>

            <SiteFormField Label="Published at"
                For="published-at"
                HelpText="Leave empty if not yet published.">
                <SiteDateInput Id="published-at" @bind-Value="_project.PublishedAt" />
            </SiteFormField>

            <SiteInline Gap="SiteSpace.Lg">
                <SiteCheckbox Label="Hidden" @bind-Value="_project.Hidden" />
                <SiteCheckbox Label="NDA" @bind-Value="_project.Nda" />
                <SiteCheckbox Label="External" @bind-Value="_project.External" />
                <SiteCheckbox Label="Show history" @bind-Value="_project.ShowHistory" />
            </SiteInline>

            <SiteFormSection Title="Translations">
                <SiteTranslationTabs Locales="@_locales"
                    ActiveLocale="@_activeLocale"
                    ActiveLocaleChanged="@((string locale) => _activeLocale = locale)"
                    IdPrefix="project-translation">
                    <Panel Context="locale">
                        @if (locale == "en")
                        {
                            <CascadingValue Value="_enEditContext"
                                TValue="EditContext"
                                IsFixed="true">
                                <DataAnnotationsValidator />
                                <SiteFormField Label="Name"
                                    For="name-en"
                                    HelpText="Leave blank to skip saving the English translation.">
                                    <SiteTextInput Id="name-en" @bind-Value="_translationEn.Name" />
                                </SiteFormField>

                                <SiteFormField Label="Purpose" For="purpose-en">
                                    <SiteTextInput Id="purpose-en"
                                        @bind-Value="_translationEn.Purpose" />
                                </SiteFormField>

                                <SiteFormField Label="Problem" For="problem-en">
                                    <SiteTextAreaInput Id="problem-en"
                                        Rows="3"
                                        Value="@(_translationEn.Problem ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Problem = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Current focus" For="current-focus-en">
                                    <SiteTextInput Id="current-focus-en"
                                        Value="@(_translationEn.CurrentFocus ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.CurrentFocus = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Status" For="status-en">
                                    <SiteTextInput Id="status-en"
                                        Value="@(_translationEn.Status ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Status = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Metrics"
                                    For="metrics-en"
                                    HelpText="One entry per metric, with a label and a value, e.g. label &quot;users&quot; / value &quot;10k&quot;. Leave empty if not applicable.">
                                    <SiteJsonArrayInput Id="metrics-en"
                                        Fields="@MetricFields"
                                        Value="@(_translationEn.Metrics ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Metrics = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationEn.Metrics)" />
                                </SiteFormField>

                                <SiteFormField Label="SEO"
                                    For="seo-en"
                                    HelpText="Standard meta fields for this page; add any extra tag under other fields. Leave empty if not applicable.">
                                    <SitePageFieldsInput Id="seo-en"
                                        Slug="PageFieldSlug.Seo"
                                        Locale="en"
                                        Value="@(_translationEn.Seo ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Seo = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationEn.Seo)" />
                                </SiteFormField>

                                <SiteFormField Label="Body (Markdown)" For="body-en">
                                    <SiteMarkdownSplitEditor Id="body-en"
                                        Rows="12"
                                        Value="@(_translationEn.Body ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Body = NullIfBlank(value))"
                                        Render="MarkdownRenderer.ToHtml" />
                                </SiteFormField>
                            </CascadingValue>
                        }
                        else
                        {
                            <CascadingValue Value="_ptEditContext"
                                TValue="EditContext"
                                IsFixed="true">
                                <DataAnnotationsValidator />
                                <SiteFormField Label="Nome"
                                    For="name-pt"
                                    HelpText="Deixe em branco para não salvar a tradução em português.">
                                    <SiteTextInput Id="name-pt"
                                        @bind-Value="_translationPtBr.Name" />
                                </SiteFormField>

                                <SiteFormField Label="Propósito" For="purpose-pt">
                                    <SiteTextInput Id="purpose-pt"
                                        @bind-Value="_translationPtBr.Purpose" />
                                </SiteFormField>

                                <SiteFormField Label="Problema" For="problem-pt">
                                    <SiteTextAreaInput Id="problem-pt"
                                        Rows="3"
                                        Value="@(_translationPtBr.Problem ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Problem = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Foco atual" For="current-focus-pt">
                                    <SiteTextInput Id="current-focus-pt"
                                        Value="@(_translationPtBr.CurrentFocus ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.CurrentFocus = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Status" For="status-pt">
                                    <SiteTextInput Id="status-pt"
                                        Value="@(_translationPtBr.Status ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Status = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Métricas"
                                    For="metrics-pt"
                                    HelpText="Um item por métrica, com um rótulo e um valor, ex.: rótulo &quot;usuários&quot; / valor &quot;10k&quot;. Deixe vazio se não for aplicável.">
                                    <SiteJsonArrayInput Id="metrics-pt"
                                        Fields="@MetricFields"
                                        Value="@(_translationPtBr.Metrics ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Metrics = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationPtBr.Metrics)" />
                                </SiteFormField>

                                <SiteFormField Label="SEO"
                                    For="seo-pt"
                                    HelpText="Campos meta padrão desta página; tags extras entram em outros campos. Deixe vazio se não for aplicável.">
                                    <SitePageFieldsInput Id="seo-pt"
                                        Slug="PageFieldSlug.Seo"
                                        Locale="pt-BR"
                                        Value="@(_translationPtBr.Seo ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Seo = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationPtBr.Seo)" />
                                </SiteFormField>

                                <SiteFormField Label="Corpo (Markdown)" For="body-pt">
                                    <SiteMarkdownSplitEditor Id="body-pt"
                                        Rows="12"
                                        Value="@(_translationPtBr.Body ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Body = NullIfBlank(value))"
                                        Render="MarkdownRenderer.ToHtml" />
                                </SiteFormField>
                            </CascadingValue>
                        }
                    </Panel>
                </SiteTranslationTabs>
            </SiteFormSection>

            <SiteFormSection Title="Technologies">
                <SiteEntityChecklist TItem="Technology"
                    Items="_allTechnologies"
                    Key="@(technology => technology.Id)"
                    Label="@TechnologyDisplayName"
                    Selected="_selectedTechnologyIds"
                    SelectedChanged="HandleSelectedTechnologiesChanged"
                    SearchPlaceholder="Search technologies…"
                    EmptyText="@(search => $"No technologies match \"{search}\".")" />
            </SiteFormSection>
        </SiteStack>

        <SiteSaveBar Saving="@IsSaving" CancelHref="/admin/projects" />
    </SiteForm>
</SiteFormShell>

@code {
    private static readonly string[] MetricFields = ["label", "value"];
    [Parameter]
    public int? Id { get; set; }

    private static readonly IReadOnlyList<SiteLocaleTab> _locales = [new(
        "en",
        "English"
    ), new("pt-BR", "Português")];

    private Project _project = new();
    private ProjectTranslation _translationEn = new() { Locale = "en" };
    private ProjectTranslation _translationPtBr = new() { Locale = "pt-BR" };
    private List<Technology> _allTechnologies = [];
    private HashSet<int> _selectedTechnologyIds = [];

    private static string TechnologyDisplayName(Technology technology) =>
        TranslationLookup.Resolve(technology.Translations, translation => translation.Locale, translation => translation.Name, "en")
        ?? technology.Slug;
    private string _activeLocale = "en";

    private EditContext _projectEditContext = default!;
    private EditContext _enEditContext = default!;
    private EditContext _ptEditContext = default!;

    private bool IsEditing => Id.HasValue;
    protected override string EntityLabel => "project";
    protected override string ListRoute => "/admin/projects";

    protected override async Task LoadAsync(PortfolioAdminDbContext dbContext)
    {
        _allTechnologies = await dbContext.Technologies
            .Include(technology => technology.Translations)
            .AsNoTracking()
            .OrderBy(technology => technology.Order)
            .ThenBy(technology => technology.Id)
            .ToListAsync();

        if (Id is int id)
        {
            var project = await dbContext.Projects
                .Include(candidate => candidate.Translations)
                .Include(candidate => candidate.ProjectTechnologies)
                .AsNoTracking()
                .FirstOrDefaultAsync(candidate => candidate.Id == id);

            if (project is null)
            {
                ToastService.Error("Project not found.");
                Navigation.NavigateTo("/admin/projects");
                return;
            }

            _project = project;
            _translationEn = project.Translations.FirstOrDefault(translation => translation.Locale == "en")
                ?? new ProjectTranslation { ProjectId = project.Id, Locale = "en" };
            _translationPtBr = project.Translations.FirstOrDefault(translation => translation.Locale == "pt-BR")
                ?? new ProjectTranslation { ProjectId = project.Id, Locale = "pt-BR" };
            _selectedTechnologyIds = project.ProjectTechnologies
                .Select(projectTechnology => projectTechnology.TechnologyId)
                .ToHashSet();
        }

        _projectEditContext = new EditContext(_project);
        _enEditContext = new EditContext(_translationEn);
        _ptEditContext = new EditContext(_translationPtBr);
    }

    private Task HandleSelectedTechnologiesChanged(HashSet<int> selected)
    {
        _selectedTechnologyIds = selected;
        return Task.CompletedTask;
    }

    protected override Task<bool> ValidateAsync()
    {
        var englishHasContent = !string.IsNullOrWhiteSpace(_translationEn.Name);
        var portugueseHasContent = !string.IsNullOrWhiteSpace(_translationPtBr.Name);
        var englishValid = !englishHasContent || _enEditContext.Validate();
        var portugueseValid = !portugueseHasContent || _ptEditContext.Validate();

        if (!englishValid || !portugueseValid)
        {
            return Task.FromResult(false);
        }

        if (!englishHasContent && !portugueseHasContent)
        {
            SaveError = "Provide a name in at least one language.";
            return Task.FromResult(false);
        }

        return Task.FromResult(true);
    }

    protected override async Task ApplyChangesAsync(PortfolioAdminDbContext dbContext)
    {
        var englishHasContent = !string.IsNullOrWhiteSpace(_translationEn.Name);
        var portugueseHasContent = !string.IsNullOrWhiteSpace(_translationPtBr.Name);

        var orderedSelectedTechnologyIds = _allTechnologies
            .OrderBy(technology => technology.Order)
            .ThenBy(technology => technology.Id)
            .Select(technology => technology.Id)
            .Where(technologyId => _selectedTechnologyIds.Contains(technologyId))
            .ToList();

        if (Id is int id)
        {
            var project = await dbContext.Projects
                .Include(candidate => candidate.Translations)
                .Include(candidate => candidate.ProjectTechnologies)
                .FirstAsync(candidate => candidate.Id == id);

            ApplyProjectFields(project, _project);
            ApplyTranslation(project, "en", _translationEn, englishHasContent);
            ApplyTranslation(project, "pt-BR", _translationPtBr, portugueseHasContent);

            dbContext.ProjectTechnologies.RemoveRange(project.ProjectTechnologies);
            for (var index = 0; index < orderedSelectedTechnologyIds.Count; index++)
            {
                dbContext.ProjectTechnologies.Add(new ProjectTechnology
                {
                    ProjectId = project.Id,
                    TechnologyId = orderedSelectedTechnologyIds[index],
                    Order = index,
                });
            }
        }
        else
        {
            var project = new Project();
            ApplyProjectFields(project, _project);

            if (englishHasContent)
            {
                project.Translations.Add(CloneTranslation(_translationEn, "en"));
            }

            if (portugueseHasContent)
            {
                project.Translations.Add(CloneTranslation(_translationPtBr, "pt-BR"));
            }

            for (var index = 0; index < orderedSelectedTechnologyIds.Count; index++)
            {
                project.ProjectTechnologies.Add(new ProjectTechnology
                {
                    TechnologyId = orderedSelectedTechnologyIds[index],
                    Order = index,
                });
            }

            project.Order = await NextOrderAsync(dbContext.Projects, entity => entity.Order);
            project.PublicId = PublicIds.New();
            dbContext.Projects.Add(project);
        }
    }

    private static void ApplyProjectFields(Project target, Project source)
    {
        target.Slug = source.Slug;
        target.Hidden = source.Hidden;
        target.Order = source.Order;
        target.Href = source.Href;
        target.External = source.External;
        target.Nda = source.Nda;
        target.PublishedAt = source.PublishedAt;
        target.ShowHistory = source.ShowHistory;
    }

    private static void ApplyTranslation(
        Project project,
        string locale,
        ProjectTranslation source,
        bool hasContent
    )
    {
        if (!hasContent)
        {
            return;
        }

        var existing = project.Translations.FirstOrDefault(translation => translation.Locale == locale);
        if (existing is null)
        {
            project.Translations.Add(CloneTranslation(source, locale));
            return;
        }

        existing.Name = source.Name;
        existing.Purpose = source.Purpose;
        existing.Problem = source.Problem;
        existing.CurrentFocus = source.CurrentFocus;
        existing.Status = source.Status;
        existing.Metrics = source.Metrics;
        existing.Body = source.Body;
        existing.Seo = source.Seo;
    }

    private static ProjectTranslation CloneTranslation(
        ProjectTranslation source,
        string locale
    ) => new()
    {
        Locale = locale,
        Name = source.Name,
        Purpose = source.Purpose,
        Problem = source.Problem,
        CurrentFocus = source.CurrentFocus,
        Status = source.Status,
        Metrics = source.Metrics,
        Body = source.Body,
        Seo = source.Seo,
    };
}
