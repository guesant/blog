@page "/admin/pages"
@inherits AdminListPageBase<Page>
@layout AdminLayout

<PageTitle>Pages</PageTitle>

<SitePageHeader Title="Pages">
    <Actions>
        <SiteLink Variant="SiteButtonVariant.Default" Href="/admin/pages/create">
            <SiteIcon Name="plus" Size="14" />New page</SiteLink>
        </Actions>
</SitePageHeader>

@if (Error is not null)
{
    <SiteNotice Tone="SiteTone.Danger">@Error</SiteNotice>
}

@if (IsLoading)
{
    <SiteLoading Label="Loading…" />
}
else
{
    <SiteDataTable TItem="Page"
        Items="@PageItems"
        EmptyText="No pages yet."
        RowKey="@(sitePage => sitePage.Id)">
        <Columns>
            <SiteColumn TItem="Page" Header="Slug" IsRowHeader="true">
                <Cell Context="sitePage">@sitePage.Slug</Cell>
            </SiteColumn>
            <SiteColumn TItem="Page" Header="Locales">
                <Cell Context="sitePage">@Locales(sitePage)</Cell>
            </SiteColumn>
        </Columns>
        <Actions Context="sitePage">
            <SiteInline Gap="SiteSpace.Sm">
                <SiteLink Variant="SiteButtonVariant.Outline"
                    Href="@($"/admin/pages/{sitePage.Id}")">
                    <SiteIcon Name="pencil" Size="14" />Edit</SiteLink>
                <SiteButton Variant="SiteButtonVariant.Destructive"
                    @onclick="@(() => HandleDeleteAsync(sitePage))"><SiteIcon Name="trash-2"
                        Size="14" />Delete</SiteButton>
            </SiteInline>
        </Actions>
    </SiteDataTable>
    <SitePagination CurrentPage="@CurrentPage" TotalPages="@TotalPages" Href="@PageUrl" />
}

@code {
    protected override string EntityLabel => "page";

    protected override async Task<List<Page>> LoadEntitiesAsync(PortfolioAdminDbContext dbContext) =>
        await dbContext.Pages
            .Include(sitePage => sitePage.Translations)
            .AsNoTracking()
            .OrderBy(sitePage => sitePage.Slug)
            .ToListAsync();

    protected override Task<Page?> FindTrackedAsync(PortfolioAdminDbContext dbContext, int id) =>
        dbContext.Pages.FirstOrDefaultAsync(candidate => candidate.Id == id);

    protected override string DisplayTitle(Page sitePage) => sitePage.Slug;

    protected override int GetId(Page sitePage) => sitePage.Id;

    protected override string DeleteConfirmDescription(Page entity) =>
        "This permanently removes the page and its translations. This cannot be undone.";

    private static string Locales(Page sitePage) =>
        sitePage.Translations.Count == 0
            ? "—"
            : string.Join(", ", sitePage.Translations.Select(translation => translation.Locale).OrderBy(locale => locale));
}
