@inherits LocalizedComponentBase
@page "/tools/css-clamp-calculator"
@page "/pt-BR/tools/css-clamp-calculator"
@using Blog.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action" SubmitLabel="@CalculateLabel" AriaLabel="@MinSizeLabel">
        <SiteFormActions>
            <SiteFormField Label="@MinSizeLabel"
                For="clamp-min-size"><SiteNumberInput TValue="double"
                    Id="clamp-min-size"
                    Name="minSize"
                    Value="@MinSize"
                    ValueChanged="@(value => MinSize = value)"
                    Step="1"
                    EnableMinMax="true"
                    Min="1" /></SiteFormField>
            <SiteFormField Label="@MaxSizeLabel"
                For="clamp-max-size"><SiteNumberInput TValue="double"
                    Id="clamp-max-size"
                    Name="maxSize"
                    Value="@MaxSize"
                    ValueChanged="@(value => MaxSize = value)"
                    Step="1"
                    EnableMinMax="true"
                    Min="1" /></SiteFormField>
        </SiteFormActions>
        <SiteFormActions>
            <SiteFormField Label="@MinViewportLabel"
                For="clamp-min-vw"><SiteNumberInput TValue="double"
                    Id="clamp-min-vw"
                    Name="minVw"
                    Value="@MinViewport"
                    ValueChanged="@(value => MinViewport = value)"
                    Step="1"
                    EnableMinMax="true"
                    Min="1" /></SiteFormField>
            <SiteFormField Label="@MaxViewportLabel"
                For="clamp-max-vw"><SiteNumberInput TValue="double"
                    Id="clamp-max-vw"
                    Name="maxVw"
                    Value="@MaxViewport"
                    ValueChanged="@(value => MaxViewport = value)"
                    Step="1"
                    EnableMinMax="true"
                    Min="1" /></SiteFormField>
        </SiteFormActions>
    </SiteToolForm>
    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (!Result.IsValid) { <SiteErrorMessage>@InvalidLabel</SiteErrorMessage> }
        <SiteStack Class="tool-css-preview-wrap">
            <SitePreviewBox Class="tool-clamp-preview"
                Style="@($"font-size: {Result.Value}")">@PreviewText</SitePreviewBox>
        </SiteStack>
        <SiteOutputField Id="clamp-output"
            Label="@OutputLabel"
            Value="@Result.Value"
            Copyable="@Result.IsValid"
            CopyLabel="@CopyLabel" />
    </SiteLiveRegion>
</ToolPage>
