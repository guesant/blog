<BlazorBlueprint.Primitives.Label.BbLabel For="@Context.Id" AdditionalAttributes="@LabelAttributes">
    @ChildContent
    @if (Context.Required)
    {
        <span aria-hidden="true"> *</span>
    }
</BlazorBlueprint.Primitives.Label.BbLabel>

@code {
    [CascadingParameter]
    private SiteFieldContext Context { get; set; } = default!;
    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;

    private Dictionary<string, object> LabelAttributes => new()
    {
        ["class"] = "form-label",
        ["data-slot"] = "field-label",
        ["id"] = LabelId(Context.Id),
    };

    /// <summary> /// IMPORTANT: BbCombobox generates its own internal id for the actual interactive trigger /// button, distinct from the id passed to it as a parameter -- so a native `label for="Id"` /// silently stops pointing at the real element once hydrated. SiteSelect references this /// same id via aria-labelledby instead, which doesn't depend on which element ends up /// holding the plain `id` attribute. /// </summary>
    internal static string LabelId(string fieldId) => $"{fieldId}-label";
}
