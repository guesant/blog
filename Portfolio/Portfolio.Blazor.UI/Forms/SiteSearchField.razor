<SiteFormField Label="@Label" For="@Id" Class="flex-grow-1">
    <div class="site-search-wrap">
        <SiteIcon Name="search" Size="14" Class="icon search-field-icon" />
        @if (RendererInfo.IsInteractive)
        {
            <SiteInput class="form-control site-search-input"
                Id="@Id"
                Name="@Name"
                Type="search"
                Value="@Value"
                ValueChanged="@ValueChanged"
                placeholder="@Placeholder" />
        }
        else
        {
            <SiteInput class="form-control site-search-input"
                Id="@Id"
                Name="@Name"
                Type="search"
                Value="@Value"
                placeholder="@Placeholder" />
        }
    </div>
</SiteFormField>
