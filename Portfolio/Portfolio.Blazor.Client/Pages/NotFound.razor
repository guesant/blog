@inherits LocalizedComponentBase
@page "/not-found"
@page "/pt-BR/not-found"
@using Portfolio.Blazor.Core.Localization
@inject ILocalizedUrlBuilder Urls

<PageTitle>@Title</PageTitle>

<SitePage Template="not-found">
    <SiteBreadcrumb HomeUrl="@HomeUrl" HomeLabel="@L["home"]" CurrentLabel="@Title" />
    <SiteHero Title="@Title" Lead="@L["not_found_description"]">
        <ChildContent>
            <SiteLink Class="site-inline-action" Href="@HomeUrl">
                <SiteIcon Name="house" Size="14" />@L["return_home"]</SiteLink>
        </ChildContent>
    </SiteHero>
</SitePage>

@code {
    private string Title => L["not_found_title"];
    private string HomeUrl => Urls.ForCulture("/", CurrentLocale);
}
