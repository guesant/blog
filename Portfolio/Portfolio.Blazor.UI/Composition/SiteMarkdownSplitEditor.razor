<div class="site-markdown-split-editor" data-slot="markdown-split-editor">
    <div class="site-markdown-split-editor-pane">
        <SiteText Variant="SiteTextVariant.Small">@EditorLabel</SiteText>
        <SiteTextAreaInput Id="@Id" Rows="@Rows" Value="@Value" ValueChanged="@ValueChanged" />
    </div>
    <div class="site-markdown-split-editor-pane">
        <SiteText Variant="SiteTextVariant.Small">@PreviewLabel</SiteText>
        <div class="rich-text">@((MarkupString)Render(Value))</div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;
    [Parameter]
    public string Value { get; set; } = string.Empty;
    [Parameter, EditorRequired]
    public EventCallback<string> ValueChanged { get; set; }
    [Parameter]
    public int Rows { get; set; } = 12;
    [Parameter, EditorRequired]
    public Func<string?, string> Render { get; set; } = default!;
    [Parameter]
    public string EditorLabel { get; set; } = "Editor";
    [Parameter]
    public string PreviewLabel { get; set; } = "Preview";
}
