# Connection string for the PostgreSQL database that holds the app's schema
# and content. Required.
PORTFOLIO_DB_CONNECTION=Host=localhost;Database=portfolio;Username=portfolio;Password=portfolio

# Optional separate connection for the public read path (e.g. a read replica
# or a role with SELECT-only grants). Falls back to PORTFOLIO_DB_CONNECTION.
PORTFOLIO_DB_READ_CONNECTION=

# Public base URL the app uses to build absolute links (sitemap, PDF export,
# OpenGraph tags).
PUBLIC_SITE_BASE_URL=https://example.invalid

TECTONIC_BUNDLE=https://data1.fullyjustified.net/tlextras-2022.0r0.tar

# OAuth client from Google Cloud Console (APIs & Services -> Credentials ->
# Create Credentials -> OAuth client ID -> Web application). Authorized
# redirect URI must be exactly {PUBLIC_SITE_BASE_URL}/signin-google, since
# the app never overrides the default CallbackPath.
PORTFOLIO_ADMIN_GOOGLE_CLIENT_ID=
PORTFOLIO_ADMIN_GOOGLE_CLIENT_SECRET=

# Only this Google account is allowed to sign in to /admin.
PORTFOLIO_ADMIN_GOOGLE_EMAIL=
