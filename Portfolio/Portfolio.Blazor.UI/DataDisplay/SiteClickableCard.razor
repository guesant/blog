<SiteCard Label="@Label" Icon="@Icon" LabelContent="@LabelContent" Class="@CardClass">
    @if (HeadingLevel == 3)
    {
        <h3 class="@TitleClass">
            <SiteLink Class="stretched-link"
                Href="@Href"
                Target="@Target"
                Rel="@Rel"
                aria-label="@Title">@Title</SiteLink>
        </h3>
    }
    else
    {
        <h2 class="@TitleClass">
            <SiteLink Class="stretched-link"
                Href="@Href"
                Target="@Target"
                Rel="@Rel"
                aria-label="@Title">@Title</SiteLink>
        </h2>
    }
    @ChildContent
</SiteCard>
