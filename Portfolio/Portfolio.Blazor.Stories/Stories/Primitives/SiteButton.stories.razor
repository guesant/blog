    <Story Name="Variant Secondary">
        <Template>
            <SiteButton Variant="SiteButtonVariant.Secondary">Secondary</SiteButton>
        </Template>
    </Story>

    <Story Name="Variant Ghost">
        <Template>
            <SiteButton Variant="SiteButtonVariant.Ghost">Ghost</SiteButton>
        </Template>
    </Story>

    <Story Name="Variant Link">
        <Template>
            <SiteButton Variant="SiteButtonVariant.Link">Link</SiteButton>
        </Template>
    </Story>

