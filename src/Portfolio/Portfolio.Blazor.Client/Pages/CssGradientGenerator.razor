@inherits LocalizedComponentBase
@page "/tools/css-gradient-generator"
@page "/pt-BR/tools/css-gradient-generator"
@using Portfolio.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteCard Class="site-block" Label="@Title">
        <SiteToolForm Action="@Action" SubmitLabel="@GenerateLabel" AriaLabel="@TypeLabel">
            <SiteFormActions>
                <SiteFormField Label="@TypeLabel"
                    For="gradient-type"><SiteSelect @bind-Value="Type"
                        Options="@TypeOptions"
                        Id="gradient-type"
                        Name="type"
                        Placeholder="@TypeLabel"
                        EmptyText="@TypeLabel" /></SiteFormField>
                @if (Type == "linear")
                {
                    <SiteFormField Label="@AngleLabel"
                        For="gradient-angle"><SiteInput Id="gradient-angle"
                            Name="angle"
                            Type="number"
                            min="0"
                            max="360"
                            Value="@Angle.ToString()"
                            ValueChanged="@(v => { if (int.TryParse(v, out var value)) Angle = value; })" /></SiteFormField>
                }
            </SiteFormActions>
        </SiteToolForm>
        @if (RendererInfo.IsInteractive)
        {
            <SiteStack Class="tool-stop-list">@foreach (var stop in Stops) { <SiteInline Class="tool-stop-row">
                <SiteFormField Label="@ColorLabel"
                    For="@($"gradient-color-{stop.Id}")"><SiteInput id="@($"gradient-color-{stop.Id}")"
                        type="color"
                        @bind="stop.Color" /></SiteFormField>
                    <SiteFormField Label="@PositionLabel"
                        For="@($"gradient-position-{stop.Id}")"><SiteInput id="@($"gradient-position-{stop.Id}")"
                            type="number"
                            min="0"
                            max="100"
                            Value="@stop.Position.ToString()"
                            OnInput="eventArgs => { if (int.TryParse(eventArgs.Value?.ToString(), out var value)) stop.Position = value; }" /></SiteFormField>
                                <SiteButton aria-label="@RemoveLabel"
                                Disabled="@(Stops.Count <= 2)"
                                @onclick="() => RemoveStop(stop)"
                                Variant="SiteButtonVariant.Default"
                                Class="tool-action-btn"><SiteIcon Name="trash-2" Size="14" />
                                </SiteButton>
                                </SiteInline> }</SiteStack>
            <SiteButton @onclick="AddStop"
                Variant="SiteButtonVariant.Default"
                Class="tool-action-btn"><SiteIcon Name="plus" Size="14" />@AddLabel</SiteButton>
        }
        <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
            <SitePreviewBox Class="tool-css-preview"
                Style="@($"background: {GradientValue}")"
                AriaLabel="@(L["gradient_preview"])" />
            <SiteOutputField Id="gradient-output"
                Label="@OutputLabel"
                Value="@CssValue"
                CopyLabel="@CopyLabel" />
        </SiteLiveRegion>
    </SiteCard>
</ToolPage>
