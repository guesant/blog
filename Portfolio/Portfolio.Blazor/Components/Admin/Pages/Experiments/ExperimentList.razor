@page "/admin/experiments"
@page "/admin/experiments/order"
@inherits AdminListPageBase<Experiment>
@layout AdminLayout

<PageTitle>Experiments</PageTitle>

@if (IsOrderMode)
{
    <AdminOrderEditor TItem="Experiment"
        Title="Experiments order"
        ListRoute="/admin/experiments"
        Items="@Items"
        DisplayTitle="@DisplayTitle"
        IsLoading="@IsLoading"
        IsSaving="@IsSaving"
        Error="@Error"
        OnReordered="HandleReorder"
        OnSave="@(() => HandleSaveOrderAsync("/admin/experiments"))" />
}
else
{
    <SitePageHeader Title="Experiments">
        <Actions>
            <SiteInline Gap="SiteSpace.Sm">
                <SiteLink Variant="SiteButtonVariant.Outline" Href="/admin/experiments/order">
                    <SiteIcon Name="arrow-up-down" Size="14" />Edit order</SiteLink>
                <SiteLink Variant="SiteButtonVariant.Default" Href="/admin/experiments/create">
                    <SiteIcon Name="plus" Size="14" />New experiment</SiteLink>
            </SiteInline>
        </Actions>
    </SitePageHeader>

    @if (Error is not null)
    {
        <SiteNotice Tone="SiteTone.Danger">@Error</SiteNotice>
    }

    @if (IsLoading)
    {
        <SiteLoading Label="Loading…" />
    }
    else
    {
        <SiteDataTable TItem="Experiment"
            Items="@PageItems"
            EmptyText="No experiments yet."
            RowKey="@(experiment => experiment.Id)">
            <Columns>
                <SiteColumn TItem="Experiment"
                    Header="Name"
                    IsRowHeader="true"><Cell Context="experiment">@DisplayTitle(experiment)</Cell>
                    </SiteColumn>
                <SiteColumn TItem="Experiment" Header="Slug">
                    <Cell Context="experiment">@experiment.Slug</Cell>
                </SiteColumn>
                <SiteColumn TItem="Experiment"
                    Header="Status"><Cell Context="experiment">@if (experiment.Hidden) { <SiteBadge Label="Hidden" /> }</Cell>
                    </SiteColumn>
            </Columns>
            <Actions Context="experiment">
                <SiteInline Gap="SiteSpace.Sm">
                    <SiteLink Variant="SiteButtonVariant.Outline"
                        Href="@($"/admin/experiments/{experiment.Id}")">
                        <SiteIcon Name="pencil" Size="14" />Edit</SiteLink>
                    <SiteButton Variant="SiteButtonVariant.Destructive"
                        @onclick="@(() => HandleDeleteAsync(experiment))"><SiteIcon Name="trash-2"
                            Size="14" />Delete</SiteButton>
                </SiteInline>
            </Actions>
        </SiteDataTable>
        <SitePagination CurrentPage="@CurrentPage" TotalPages="@TotalPages" Href="@PageUrl" />
    }
}

@code {
    protected override string EntityLabel => "experiment";

    protected override void SetOrder(Experiment entity, int order) => entity.Order = order;

    protected override async Task<List<Experiment>> LoadEntitiesAsync(PortfolioAdminDbContext dbContext) =>
        await dbContext.Experiments
            .Include(experiment => experiment.Translations)
            .AsNoTracking()
            .OrderBy(experiment => experiment.Order)
            .ThenBy(experiment => experiment.Slug)
            .ToListAsync();

    protected override Task<Experiment?> FindTrackedAsync(
        PortfolioAdminDbContext dbContext,
        int id
    ) =>
        dbContext.Experiments.FirstOrDefaultAsync(candidate => candidate.Id == id);

    protected override string DisplayTitle(Experiment experiment) =>
        TranslationLookup.Resolve(experiment.Translations, translation => translation.Locale, translation => translation.Name, "en")
        ?? experiment.Slug;

    protected override int GetId(Experiment experiment) => experiment.Id;

    protected override string DeleteConfirmDescription(Experiment entity) =>
        "This permanently removes the experiment, its translations and its technology links. This cannot be undone.";
}
