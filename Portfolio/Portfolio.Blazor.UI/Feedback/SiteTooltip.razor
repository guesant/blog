@using BlazorBlueprint.Primitives

<BlazorBlueprint.Primitives.Tooltip.BbTooltip DelayDuration="300" HideDelay="100">
    <BlazorBlueprint.Primitives.Tooltip.BbTooltipTrigger AsChild="true">
        @ChildContent
    </BlazorBlueprint.Primitives.Tooltip.BbTooltipTrigger>
    <BlazorBlueprint.Primitives.Tooltip.BbTooltipContent Side="@Side"
        AdditionalAttributes="@ContentAttributes">
        @Text
    </BlazorBlueprint.Primitives.Tooltip.BbTooltipContent>
</BlazorBlueprint.Primitives.Tooltip.BbTooltip>

@code {
    /// <summary>Tooltip content text.</summary>
    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;
    /// <summary>Preferred placement relative to the trigger.</summary>
    [Parameter]
    public PopoverSide? Side { get; set; }
    /// <summary>The trigger element the tooltip is attached to.</summary>
    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;

    private Dictionary<string, object> ContentAttributes { get; } = new()
    {
        ["class"] = "site-tooltip-content",
        ["data-slot"] = "tooltip-content",
    };
}
