@inherits LocalizedComponentBase
@page "/tools/uuid-generator"
@page "/pt-BR/tools/uuid-generator"
@using System.Globalization
@using Microsoft.JSInterop
@using Portfolio.Blazor.Core
@inject IJSRuntime JS

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action"
        SubmitLabel="@GenerateLabel"
        Submit="SiteToolFormSubmit.Always"
        OnSubmit="Generate"
        AriaLabel="@CountLabel">
        <ChildContent>
            <SiteFormField Label="@CountLabel" For="uuid-count">
                <SiteInput Id="uuid-count"
                    Name="count"
                    Type="number"
                    min="1"
                    max="50"
                    Value="@CountText"
                    ValueChanged="@(v => CountText = v)" />
            </SiteFormField>
        </ChildContent>
        <Actions>
            @if (RendererInfo.IsInteractive)
            {
                <SiteButton Variant="SiteButtonVariant.Default"
                    @onclick="CopyAllAsync"
                    Disabled="@(Result.Count == 0)"><SiteIcon Name="copy"
                        Size="14" />@CopyAllLabel</SiteButton>
            }
        </Actions>
    </SiteToolForm>
    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        <SiteCard Class="site-block" Label="@ResultLabel">
            <SiteList>@foreach (var value in Result) { <SiteListItem Class="list-group-item site-list-row tool-list-item">
                <SiteText Variant="SiteTextVariant.Meta"
                    Class="tool-list-value">@value</SiteText>@if (RendererInfo.IsInteractive) { <SiteButton Variant="SiteButtonVariant.Outline"
                        @onclick="() => CopyAsync(value)">
                    <SiteIcon Name="copy"
                        Size="14" />@CopyLabel</SiteButton> }</SiteListItem> }</SiteList>
        </SiteCard>
    </SiteLiveRegion>
</ToolPage>
