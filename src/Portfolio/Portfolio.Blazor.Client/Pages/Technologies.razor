@inherits ListPageBase
@page "/technologies"
@page "/pt-BR/technologies"
@using Portfolio.Blazor.Core

<PageTitle>@PageField("technologies", "title", Title)</PageTitle>
<SeoHead Title="@SeoTitle" Description="@SeoDescription" CanonicalPath="@CanonicalPath" />

<SitePage Template="technologies-index">
    <SiteBreadcrumb HomeUrl="@LocalizedPath("home")"
        HomeLabel="@(L["home"])"
        CurrentLabel="@CrumbLabel("technologies", L["technologies"])" />
    @if (Snapshot is null)
    {
        <SiteHero Title="@Title" Lead="@Description" />
        <SiteListingShell HasResults="false"
            CurrentPage="@CurrentPage"
            TotalPages="@PageCount"
            PaginationLabel="@(L["pagination"])"
            PreviousLabel="@(L["previous"])"
            NextLabel="@(L["next"])"
            Href="@(page => QueryUrl(ViewMode, page))">
            <EmptyContent>
                <SiteEmptyState Message="@(L["public_content_is_temporarily_unavailable"])" />
            </EmptyContent>
        </SiteListingShell>
    }
    else
    {
        <SiteHero Title="@PageField("technologies", "title", Title)"
            Lead="@PageField("technologies", "description", Description)"/>
        @if (Snapshot.Technologies.Count == 0)
        {
            <SiteListingShell HasResults="false"
                CurrentPage="@CurrentPage"
                TotalPages="@PageCount"
                PaginationLabel="@(L["pagination"] )"
                PreviousLabel="@(L["previous"] )"
                NextLabel="@(L["next"] )"
                Href="@(page => QueryUrl(ViewMode, page))">
                <EmptyContent>
                    <SiteEmptyState Message="@EmptyLabel" />
                </EmptyContent>
            </SiteListingShell>
        }
        else
        {
            <SiteListingShell HasResults="@(PagedTechnologies.Count > 0)"
                Summary="@ListingSummary(PagedTechnologies.Count, SortedTechnologies.Count, CurrentPage, PageCount)"
                CurrentPage="@CurrentPage"
                TotalPages="@PageCount"
                PaginationLabel="@(L["pagination"])"
                PreviousLabel="@(L["previous"])"
                NextLabel="@(L["next"])"
                Href="@(page => QueryUrl(page))">
            <FilterContent>
                <SiteListingFilterBar Action="@Action"
                    ApplyLabel="@(L["apply"])"
                    ClearLabel="@(L["clear"])"
                    ClearHref="@Action"
                    OnApply="@(() => HandleApply(Action, SortValue, Search, DenseView))">
                    <PrimaryFields>
                        <SiteFilterSelect Icon="arrow-up-down"
                            Label="@(L["sort_by"])"
                            Id="technologies-sort"
                            Name="sort"
                            @bind-Value="SortValue"
                            Options="@SortOptions"
                            Placeholder="@(L["sort"])"
                            EmptyText="@(L["default"])" />
                    </PrimaryFields>
                    <SearchField>
                        <SiteSearchField Label="@(L["search"])"
                            Id="technologies-search"
                            Name="q"
                            Value="@Search"
                            ValueChanged="@((string value) => Search = value)"
                            Placeholder="@(L["search_by_name"])" />
                    </SearchField>
                </SiteListingFilterBar>
            </FilterContent>
            <ResultContent>
                <SiteCardGrid id="view-spacious-technologies"
                    aria-label="@Title"
                    data-layout-region="items">
                    @foreach (var technology in PagedTechnologies)
                    {
                        <SiteGridColumn>
                            <SiteFeedCard KindLabel="@(L["kind_technology"])"
                                Title="@technology.Name"
                                Href="@LocalizedUrl(technology.Url)"
                                ViewLabel="@null" />
                        </SiteGridColumn>
                    }
                </SiteCardGrid>
            </ResultContent>
            </SiteListingShell>
        }
    }
</SitePage>
