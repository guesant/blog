{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "react", "react-dom"],
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./*"],
      "@portfolio/content/protected-email": [
        "./content-runtime/src/domain/protected-email/index.ts"
      ],
      "@portfolio/content/protected-email/create": [
        "./content-runtime/src/domain/protected-email/create.server.ts"
      ],
      "@portfolio/content/*": ["./content-runtime/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "content/**/*.ts",
    "content/**/*.tsx",
    "i18n/**/*.ts",
    "i18n/**/*.tsx",
    "app/theme-registry.tsx",
    "app/tokens.css",
    "app/fonts.css",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": ["node_modules", ".next", "dist", "app/[locale]", "app/og"]
}
