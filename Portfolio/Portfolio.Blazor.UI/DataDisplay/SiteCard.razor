<div class="@RootClass" data-slot="card">
    @if (LabelContent is not null)
    {
        <div class="site-card-header bg-white">@LabelContent</div>
    }
    else if (!string.IsNullOrWhiteSpace(Label))
    {
        <div class="site-card-header bg-white">
            <span class="section-label">@if (!string.IsNullOrWhiteSpace(Icon)) { <SiteIcon Name="@Icon" Size="12" /> }@Label</span>
        </div>
    }
    <div class="site-card-body">
        @ChildContent
    </div>
</div>
