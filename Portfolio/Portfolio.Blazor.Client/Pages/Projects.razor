@inherits ListPageBase
@page "/projects"
@page "/pt-BR/projects"
@using Microsoft.AspNetCore.Components
@using Portfolio.Blazor.Core

<PageTitle>@PageField("projects", "title", Title)</PageTitle>
<SeoHead Title="@SeoTitle" Description="@SeoDescription" CanonicalPath="@CanonicalPath" />

<SitePage Template="projects-index">
    <SiteBreadcrumb HomeUrl="@LocalizedPath("home")"
        HomeLabel="@(L["legacy_ddc150008e2f"])"
        Links="@BreadcrumbLinks"
        CurrentLabel="@PageField("projects", "title", Title)" />

        <SiteHero Title="@SeoTitle"
            Lead="@SeoDescription" />

    @if (Snapshot is null || SortedProjects.Count == 0)
    {
        <SiteListingShell HasResults="false"
            CurrentPage="@CurrentPage"
            TotalPages="@PageCount"
            PaginationLabel="@(L["legacy_ce41390e654d"] )"
            PreviousLabel="@(L["legacy_c3b535ded088"] )"
            NextLabel="@(L["legacy_a6c78a6436e2"] )"
            Href="@(page => QueryUrl(ViewMode, page))">
            <EmptyContent>
                <SiteEmptyState Message="@(Snapshot is null ? UnavailableLabel : EmptyLabel)" />
            </EmptyContent>
        </SiteListingShell>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(PageField("projects", "selectedLabel", string.Empty))) { <SiteText Variant="SiteTextVariant.SectionLabel">
            <SiteIcon Name="star"
                Size="12" />@PageField("projects", "selectedLabel", string.Empty)</SiteText> }
        <SiteHeading Level="2"
            Class="visually-hidden"
            Id="projects-title">@PageField("projects", "title", Title)</SiteHeading>
        <ProjectListing TItem="PublicProject"
            Summary="@ListingSummary(PagedProjects.Count, SortedProjects.Count, CurrentPage, PageCount)"
            Items="@PagedProjects" CurrentPage="@CurrentPage" TotalPages="@PageCount" PaginationLabel="@(L["legacy_ce41390e654d"])" PreviousLabel="@(L["legacy_c3b535ded088"])" NextLabel="@(L["legacy_a6c78a6436e2"])" Href="@(page => QueryUrl(ViewMode, page))"
            Action="@Action" SortId="projects-sort" SortName="sort" SortLabel="@(L["legacy_6541e97b7c64"])" SortValue="@SortValue" SortValueChanged="@((string v) => SortValue = v)" SortOptions="@SortOptions" SortPlaceholder="@(L["legacy_77c78d92c603"])" SortEmptyText="@(L["legacy_0bb89437e6cb"])" ApplyLabel="@(L["legacy_c975d2551cc4"])" OnApply="@(() => HandleApply(Action, SortValue, Search, DenseView))"
            SearchLabel="@(L["legacy_6bb12bff6f09"])" SearchValue="@Search" SearchValueChanged="@((string v) => Search = v)" SearchPlaceholder="@(L["search_by_name"])" ClearLabel="@(L["legacy_5262517729fc"])" ClearHref="@Action"
            GridId="view-spacious-projects" GridAriaLabelledBy="projects-title" KindLabel="@(L["kind_project"])" ViewLabel="@(L["read_more"])"
            ItemHref="@(project => LocalizedUrl(project.Url))" ItemTitle="@(project => project.Name)" ItemStatusLabel="@(project => project.Status)" ItemDate="@(project => FormatDate(project.PublishedAt) is { } date && date != "·" ? date : null)"
            ItemPurpose="@(project => project.Purpose)" ItemProblem="@(project => project.Problem)" ItemTechnologies="@(project => project.Technologies)" TechnologyUrl="@LocalizedTechnologyUrl" />
    }

    <SiteSection Region="experiments"
        HeadingId="experiments-title"
        Label="@PageField("projects", "archiveLabel", string.Empty)"
        Title="@PageField("projects", "experimentsTitle", string.Empty)">
        @if (Snapshot?.Experiments is not { Count: > 0 })
        {
            <SiteListingShell HasResults="false"
                CurrentPage="@ExperimentCurrentPage"
                TotalPages="@ExperimentPageCount"
                PaginationLabel="@(L["legacy_ce41390e654d"] )"
                PreviousLabel="@(L["legacy_c3b535ded088"] )"
                NextLabel="@(L["legacy_a6c78a6436e2"] )"
                Href="@(page => ExperimentQueryUrl(ExperimentViewMode, page))">
                <EmptyContent>
                    <SiteEmptyState Message="@(L["legacy_11b1335776c9"])" />
                </EmptyContent>
            </SiteListingShell>
        }
        else
        {
            <ProjectListing TItem="PublicExperiment"
                Summary="@ListingSummary(PagedExperiments.Count, SortedExperiments.Count, ExperimentCurrentPage, ExperimentPageCount)"
                Items="@PagedExperiments" CurrentPage="@ExperimentCurrentPage" TotalPages="@ExperimentPageCount" PaginationLabel="@(L["legacy_ce41390e654d"])" PreviousLabel="@(L["legacy_c3b535ded088"])" NextLabel="@(L["legacy_a6c78a6436e2"])" Href="@(page => ExperimentQueryUrl(ExperimentViewMode, page))"
                Action="@Action" SortId="experiments-sort" SortName="sort_experiments" SortLabel="@(L["legacy_6541e97b7c64"])" SortValue="@ExperimentSortValue" SortValueChanged="@((string v) => ExperimentSortValue = v)" SortOptions="@SortOptions" SortPlaceholder="@(L["legacy_77c78d92c603"])" SortEmptyText="@(L["legacy_0bb89437e6cb"])" ApplyLabel="@(L["legacy_c975d2551cc4"])" OnApply="@HandleExperimentApply"
                SearchLabel="@(L["legacy_6bb12bff6f09"])" SearchName="q_experiments" SearchValue="@ExperimentSearch" SearchValueChanged="@((string v) => ExperimentSearch = v)" SearchPlaceholder="@(L["search_by_name"])" ClearLabel="@(L["legacy_5262517729fc"])" ClearHref="@Action"
                GridId="view-spacious-experiments" GridAriaLabelledBy="experiments-title" KindLabel="@(L["kind_experiment"])" ViewLabel="@(L["read_more"])"
                ItemHref="@(experiment => LocalizedUrl(experiment.Url))" ItemTitle="@(experiment => experiment.Name)" ItemStatusLabel="@(experiment => L["legacy_83f80c05505d"])" ItemDate="@(experiment => FormatDate(experiment.PublishedAt) is { } date && date != "·" ? date : null)"
                ItemPurpose="@(experiment => experiment.Purpose)" ItemTechnologies="@(experiment => experiment.Technologies)" TechnologyUrl="@LocalizedTechnologyUrl" />
        }
    </SiteSection>
</SitePage>
