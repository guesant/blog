@using System.Globalization
@inject IStringLocalizer<SharedResource> L

@if (!string.IsNullOrWhiteSpace(PublishedAt) || ShouldShowUpdated || !string.IsNullOrWhiteSpace(AdditionalText))
{
    <SiteInline Gap="SiteSpace.Md"
        Class="published-updated-meta"
        data-layout-region="published-updated">
        @if (!string.IsNullOrWhiteSpace(PublishedAt))
        {
            <SiteInline Gap="SiteSpace.Xs">
                <SiteIcon Name="calendar" Size="16" />
                <SiteText Variant="SiteTextVariant.Meta">@L["published_on", FormatDate(PublishedAt)]</SiteText>
            </SiteInline>
        }
        @if (ShouldShowUpdated)
        {
            <SiteInline Gap="SiteSpace.Xs">
                <SiteIcon Name="pencil" Size="16" />
                <SiteText Variant="SiteTextVariant.Meta">@L["updated_on", FormatDate(UpdatedAt)]</SiteText>
            </SiteInline>
        }
        @if (!string.IsNullOrWhiteSpace(AdditionalText))
        {
            <SiteText Variant="SiteTextVariant.Meta">@AdditionalText</SiteText>
        }
    </SiteInline>
}
