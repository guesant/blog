@inherits LocalizedComponentBase
@implements IDisposable
@page "/tools/correlation-calculator"
@page "/pt-BR/tools/correlation-calculator"
@page "/tools/linear-regression"
@page "/pt-BR/tools/linear-regression"
@using System.Globalization
@using Blog.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action"
        SubmitLabel="@SubmitLabel"
        Submit="SiteToolFormSubmit.StaticOnly"
        OnSubmit="HandleSubmit">
        <SiteFormField For="correlation-x"
            Label="@XLabel"><SiteTextAreaInput Id="correlation-x"
                Name="x"
                Rows="5"
                Value="@XText"
                ValueChanged="@(value => XText = value)" /></SiteFormField>
        <SiteFormField For="correlation-y"
            Label="@YLabel"><SiteTextAreaInput Id="correlation-y"
                Name="y"
                Rows="5"
                Value="@YText"
                ValueChanged="@(value => YText = value)" /></SiteFormField>
    </SiteToolForm>

    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (!Result.IsValid)
        {
            <SiteErrorMessage>@ErrorLabel</SiteErrorMessage>
        }
        else
        {
            <SiteStats>
                <SiteStatItem Label="@CountLabel">@Result.Count</SiteStatItem>
                <SiteStatItem Label="@CorrelationLabel">@Format(Result.Correlation)</SiteStatItem>
                <SiteStatItem Label="@SlopeLabel">@Format(Result.Slope)</SiteStatItem>
                <SiteStatItem Label="@InterceptLabel">@Format(Result.Intercept)</SiteStatItem>
                <SiteStatItem Label="@R2Label">@Format(Result.CoefficientOfDetermination)</SiteStatItem>
            </SiteStats>
            <SiteCard Class="site-block" Label="@ChartLabel">
                @if (RendererInfo.IsInteractive)
                {
                    <SiteChart ChartJsConfig="@ChartConfig" AriaLabel="@ChartLabel" />
                }
                else
                {
                    <SiteList Variant="SiteListVariant.Boxed"
                        AriaLabel="@ChartLabel">@foreach (var point in Result.Points) { <SiteListItem Class="site-text-list-item">@Format(point.X), @Format(point.Y)</SiteListItem> }</SiteList>
                }
            </SiteCard>
        }
    </SiteLiveRegion>
</ToolPage>
