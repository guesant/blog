@inherits LocalizedComponentBase
@page "/tools/resistor-network"
@page "/pt-BR/tools/resistor-network"
@using System.Globalization
@using Portfolio.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteNotice>@Note</SiteNotice>
    <SiteToolForm Action="@Action"
        SubmitLabel="@SubmitLabel"
        Submit="SiteToolFormSubmit.StaticOnly"
        OnSubmit="Calculate"
        AriaLabel="@InputLabel">
        <SiteFormField Label="@InputLabel"
            For="resistors-input"><SiteInput Id="resistors-input"
                Name="resistors"
                Type="text"
                Value="@ResistorsText"
                ValueChanged="@(v => ResistorsText = v)" /></SiteFormField>
        <SiteFormField Label="@ModeLabel" For="resistors-mode">
            @if (RendererInfo.IsInteractive)
            {
                <SiteSelect @bind-Value="ModeText"
                    Options="@ModeOptions"
                    Id="resistors-mode"
                    Name="mode"
                    Placeholder="@ModeLabel"
                    EmptyText="@ModeLabel" />
            }
            else
            {
                <SiteNativeSelect id="resistors-mode"
                    name="mode"><option value="series"
                        selected="@(ModeText == "series" ? "selected" : null)">@SeriesLabel</option>
                            <option value="parallel"
                            selected="@(ModeText == "parallel" ? "selected" : null)">@ParallelLabel</option>
                            </SiteNativeSelect>
            }
        </SiteFormField>
    </SiteToolForm>
    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (!Result.IsValid) { <SiteErrorMessage>@ErrorLabel</SiteErrorMessage> } else { <SiteCard Class="site-block" Label="@Title">
            <SiteText Variant="SiteTextVariant.MetricValue"
                Class="tool-result-value">R_eq = @Resistance(Result.Resistance) Ω</SiteText>
        </SiteCard> }
    </SiteLiveRegion>
</ToolPage>
