@page "/admin/technologies/create"
@page "/admin/technologies/{Id:int}"
@inherits AdminEditPageBase<Technology>
@layout AdminLayout

<PageTitle>@(IsEditing ? "Edit technology" : "New technology")</PageTitle>

<SiteFormShell Title="@(IsEditing ? "Edit technology" : "New technology")"
    Error="@SaveError"
    Loading="@IsLoading">
    <SiteForm EditContext="@_technologyEditContext" OnValidSubmit="HandleSaveAsync">
        <SiteStack Gap="SiteSpace.Lg">
            <SiteFormField Label="Slug"
                For="slug"
                Required="true"
                HelpText="Used in the public /technologies/{slug} URL.">
                <SiteTextInput Id="slug" @bind-Value="_technology.Slug" />
                <SiteValidationMessage For="@(() => _technology.Slug)" />
            </SiteFormField>

            <SiteFormField Label="Code"
                For="code"
                HelpText="Short identifier shown alongside the technology, e.g. ts, csharp.">
                <SiteTextInput Id="code"
                    Value="@(_technology.Code ?? string.Empty)"
                    ValueChanged="@(value => _technology.Code = NullIfBlank(value))" />
            </SiteFormField>


            <SiteFormSection Title="Translations">
                <SiteTranslationTabs Locales="@_locales"
                    ActiveLocale="@_activeLocale"
                    ActiveLocaleChanged="@((string locale) => _activeLocale = locale)"
                    IdPrefix="technology-translation">
                    <Panel Context="locale">
                        @if (locale == "en")
                        {
                            <CascadingValue Value="_enEditContext"
                                TValue="EditContext"
                                IsFixed="true">
                                <DataAnnotationsValidator />
                                <SiteFormField Label="Name"
                                    For="name-en"
                                    HelpText="Leave blank to skip saving the English translation.">
                                    <SiteTextInput Id="name-en" @bind-Value="_translationEn.Name" />
                                </SiteFormField>
                            </CascadingValue>
                        }
                        else
                        {
                            <CascadingValue Value="_ptEditContext"
                                TValue="EditContext"
                                IsFixed="true">
                                <DataAnnotationsValidator />
                                <SiteFormField Label="Nome"
                                    For="name-pt"
                                    HelpText="Deixe em branco para não salvar a tradução em português.">
                                    <SiteTextInput Id="name-pt"
                                        @bind-Value="_translationPtBr.Name" />
                                </SiteFormField>
                            </CascadingValue>
                        }
                    </Panel>
                </SiteTranslationTabs>
            </SiteFormSection>
        </SiteStack>

        <SiteSaveBar Saving="@IsSaving" CancelHref="/admin/technologies" />
    </SiteForm>
</SiteFormShell>
