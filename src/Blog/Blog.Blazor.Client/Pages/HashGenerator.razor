@inherits LocalizedComponentBase
@page "/tools/hash-generator"
@page "/pt-BR/tools/hash-generator"
@using Blog.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action" SubmitLabel="@CalculateLabel" AriaLabel="@InputLabel">
        <SiteFormField For="hash-input"
            Label="@InputLabel"><SiteTextAreaInput Id="hash-input"
                Name="input"
                Rows="6"
                Value="@Input"
                ValueChanged="@(v => Input = v)" /></SiteFormField>
    </SiteToolForm>
    <SiteNotice>@Md5Note</SiteNotice>
    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        <SiteCard Class="site-block"
            Label="@ResultLabel">@foreach (var hash in Hashes) { <SiteOutputField Id="@hash.Id"
                Label="@hash.Label"
                Value="@hash.Value"
                Copyable="@(!string.IsNullOrEmpty(hash.Value))"
                CopyLabel="@CopyLabel" /> }</SiteCard>
    </SiteLiveRegion>
</ToolPage>
