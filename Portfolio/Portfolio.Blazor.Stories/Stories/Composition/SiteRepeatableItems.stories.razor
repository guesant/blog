@attribute [Stories("Composition/SiteRepeatableItems")]

<Stories TComponent="SiteRepeatableItems<string>">

    <Story Name="Default">
        <Template>
            <SiteRepeatableItems TItem="string"
                                 Items="@_items"
                                 ItemTitle="@((item, index) => $"item {index + 1}")"
                                 AddLabel="add item"
                                 RemoveLabel="remove"
                                 OnAdd="AddItem"
                                 OnRemove="RemoveItem">
                <ItemTemplate Context="itemContext">
                    <SiteTextInput Value="@itemContext.Item" />
                </ItemTemplate>
            </SiteRepeatableItems>
        </Template>
    </Story>

</Stories>

@code {
    private readonly List<string> _items = ["first", "second"];

    private void AddItem() => _items.Add($"item {_items.Count + 1}");

    private void RemoveItem(int index) => _items.RemoveAt(index);
}
