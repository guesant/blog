@inherits ContentPageBase
@page "/about"
@page "/pt-BR/about"
@page "/portfolio"
@page "/pt-BR/portfolio"
@page "/now"
@page "/pt-BR/now"
@page "/license"
@page "/pt-BR/license"
@page "/follow"
@page "/pt-BR/follow"
@using Microsoft.AspNetCore.Components
@using System.Text.Json
@using System.Globalization
@using Portfolio.Blazor.Core

<PageTitle>@Title</PageTitle>
<SeoHead Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath" />

<SitePage Template="@Kind.ToString().ToLowerInvariant()">
    <SiteBreadcrumb HomeUrl="@(L[""])"
        HomeLabel="@(L["home"])"
        CurrentLabel="@CrumbLabel(Kind.ToString().ToLowerInvariant(), Title)" />
    @if (Kind == PageKind.Portfolio)
    {
        <SiteHero Title="@(Snapshot?.Chrome.Profile?.Name ?? "guesant.net")"
            Lead="@Field("heroExperience", Description)"
            BackHref="@(L[""])"
            BackLabel="@(L["home"])">
            <ChildContent>
                @if (!string.IsNullOrWhiteSpace(Field("heroCurrentFocus"))) { <SiteText>@Field("heroCurrentFocus")</SiteText> }
                <SiteFormActions>
                    @if (!string.IsNullOrWhiteSpace(PortfolioWorkTarget)) { <SiteLink Variant="SiteButtonVariant.Default"
                        Href="@PortfolioWorkTarget"><SiteIcon Name="briefcase"
                            Size="14" />@(L["view_work"])</SiteLink> }
                    <SiteLink Variant="SiteButtonVariant.Outline"
                        Href="@LocalizedPath("about")"><SiteIcon Name="user"
                            Size="14" />@(L["about_me"])</SiteLink>
                    <SiteLink Variant="SiteButtonVariant.Outline"
                        Href="@LocalizedPath("resume")"><SiteIcon Name="file-user"
                            Size="14" />@(L["resume"])</SiteLink>
                </SiteFormActions>
                @if (Snapshot?.Chrome.Site.ContactAvailable == true && !string.IsNullOrWhiteSpace(Field("availableLabel"))) { <AvailabilityIndicator Label="@Field("availableLabel")" /> }
            </ChildContent>
        </SiteHero>
        @if (Snapshot is not null)
        {
            @if (Snapshot.FeaturedCases is { Count: > 0 })
            {
                <SiteSection Icon="briefcase" Id="work"
                    Region="work"
                    HeadingId="work-heading"
                    Label="@Field("workEyebrow")"
                    Title="@Field("workTitle")"
                    Description="@Field("workDescription")"
                    ActionHref="@LocalizedPath("cases")"
                    ActionLabel="@(L["view_all_cases"])">
                    <SiteGrid>
                        @{ var caseNumber = 0; }
                        @foreach (var item in Snapshot.FeaturedCases)
                        {
                            caseNumber++;
                            <SiteGridColumn>
                                <SiteClickableCard Icon="star" Label="@($"{(L["selected_case"])} {caseNumber:00} · {item.Meta ?? item.Status}")"
                                    Class="h-100"
                                    Href="@LocalizedUrl(item.Url)"
                                    Title="@item.Title"
                                    TitleClass="h5"
                                    HeadingLevel="3">
                                    @if (!string.IsNullOrWhiteSpace(item.Summary)) { <SiteText Variant="SiteTextVariant.Meta">@item.Summary</SiteText> }
                                    @if (!string.IsNullOrWhiteSpace(item.Context) || !string.IsNullOrWhiteSpace(item.Role) || !string.IsNullOrWhiteSpace(item.Result))
                                    {
                                        <SiteKeyValueList Layout="SiteKeyValueLayout.Columns"
                                            Class="small mb-3">
                                            @if (!string.IsNullOrWhiteSpace(item.Context)) { <SiteKeyValueItem Icon="target"
                                                Label="@(L["context"])">@item.Context</SiteKeyValueItem> }
                                            @if (!string.IsNullOrWhiteSpace(item.Role)) { <SiteKeyValueItem Icon="user"
                                                Label="@(L["role"])">@item.Role</SiteKeyValueItem> }
                                            @if (!string.IsNullOrWhiteSpace(item.Result)) { <SiteKeyValueItem Icon="trending-up"
                                                Label="@(L["outcome"])">@item.Result</SiteKeyValueItem> }
                                        </SiteKeyValueList>
                                    }
                                    @if (item.Technologies is { Count: > 0 }) { <SiteChipGroup Class="mb-3">@foreach (var technology in item.Technologies) { <SiteChip Label="@technology.Name" Href="@LocalizedPath($"technologies/{technology.Slug}")" /> }</SiteChipGroup> }
                                    <SiteLink Variant="SiteButtonVariant.Outline"
                                        Size="SiteButtonSize.Sm"
                                        Href="@LocalizedUrl(item.Url)"><SiteIcon Name="book-open"
                                            Size="14" />@(L["read_full_case"])</SiteLink>
                                </SiteClickableCard>
                            </SiteGridColumn>
                        }
                    </SiteGrid>
                </SiteSection>
            }
            @if (Snapshot.FeaturedProjects is { Count: > 0 } || Snapshot.Experiments is { Count: > 0 })
            {
                <SiteSection Icon="folder-git-2" Id="projects"
                    Region="projects"
                    HeadingId="projects-heading"
                    Label="@Field("projectsEyebrow")"
                    Title="@Field("projectsTitle")"
                    Description="@Field("projectsDescription")"
                    ActionHref="@LocalizedPath("projects")"
                    ActionLabel="@(L["view_all_projects"])">
                    <SiteGrid>
                        @foreach (var item in Snapshot.FeaturedProjects ?? [])
                        {
                            <SiteGridColumn>
                                <SiteClickableCard Icon="folder-git-2" Label="@($"project · {item.Status}")"
                                    Class="h-100"
                                    Href="@LocalizedUrl(item.Url)"
                                    Title="@item.Name"
                                    TitleClass="h5"
                                    HeadingLevel="3">
                                    @if (!string.IsNullOrWhiteSpace(item.Purpose)) { <SiteText Variant="SiteTextVariant.Meta">@item.Purpose</SiteText> }
                                    @if (!string.IsNullOrWhiteSpace(item.Problem)) { <SiteText Variant="SiteTextVariant.Meta">@item.Problem</SiteText> }
                                    @if (item.Technologies is { Count: > 0 }) { <SiteChipGroup>@foreach (var technology in item.Technologies) { <SiteChip Label="@technology.Name" Href="@LocalizedPath($"technologies/{technology.Slug}")" /> }</SiteChipGroup> }
                                </SiteClickableCard>
                            </SiteGridColumn>
                        }
                    </SiteGrid>
                    @if (Snapshot.Experiments is { Count: > 0 } && !string.IsNullOrWhiteSpace(Field("experimentsSummary")))
                    {
                        <SiteText Variant="SiteTextVariant.Small">
                            <SiteLink Variant="SiteButtonVariant.Outline"
                                Href="@($"{LocalizedPath("projects")}#experiments")">
                                <SiteIcon Name="flask-conical"
                                    Size="14" />@Field("experimentsSummary").Replace("{count}", Snapshot.Experiments.Count.ToString())</SiteLink>
                            </SiteText>
                    }
                </SiteSection>
            }
        }
    }
    else if (Kind == PageKind.About)
    {
        <SiteHero Title="@Field("title")"
            Lead="@Field("lead", Description)"
            BackHref="@(L[""])"
            BackLabel="@(L["home"])">
            <ChildContent>
                @if (!string.IsNullOrWhiteSpace(Field("context"))) { <SiteText>@Field("context")</SiteText> }
                @if (!string.IsNullOrWhiteSpace(Field("description"))) { <SiteText>@Field("description")</SiteText> }
            </ChildContent>
        </SiteHero>
        @if (Snapshot?.Chrome.Profile is { } profile)
        {
            <SiteCard Icon="circle-user" Class="mb-4" Label="@(L["profile"])">
                <SiteHeading Level="3" Visual="5">@profile.Name</SiteHeading>
                <SiteText Variant="SiteTextVariant.Meta">
                    <SiteIcon Name="briefcase"
                        Size="12" />@string.Join(" · ", new[] { profile.Title, profile.Location }.Where(value => !string.IsNullOrWhiteSpace(value)))</SiteText>
                @if (!string.IsNullOrWhiteSpace(profile.BirthCity) || Age is not null) { <SiteText Variant="SiteTextVariant.Meta">@string.Join(" · ", new[] { Age is null ? null : L["years_old", Age.Value].Value, profile.BirthCity }.Where(value => !string.IsNullOrWhiteSpace(value)))</SiteText> }
                @if (!string.IsNullOrWhiteSpace(profile.Interests)) { <SiteText Variant="SiteTextVariant.SectionLabel">
                    <SiteIcon Name="heart" Size="12" />@(L["interests"])</SiteText>
                        <SiteText Variant="SiteTextVariant.Meta">@profile.Interests</SiteText> }
                @if (!string.IsNullOrWhiteSpace(profile.Learning)) { <SiteText Variant="SiteTextVariant.SectionLabel">
                    <SiteIcon Name="lightbulb" Size="12" />@(L["learning"])</SiteText>
                        <SiteText Variant="SiteTextVariant.Meta">@profile.Learning</SiteText> }
                @if (PersonalInterestLabels.Count > 0) { <SiteText Variant="SiteTextVariant.SectionLabel">
                    <SiteIcon Name="star" Size="12" />@(L["personal_interests"])</SiteText>
                        <SiteList Class="list-group-flush"
                            AriaLabel="@(L["personal_interests"])">@foreach (var interest in PersonalInterestLabels) { <SiteListItem Class="list-group-item">@interest</SiteListItem> }</SiteList> }
            </SiteCard>
        }
        @if (!string.IsNullOrWhiteSpace(Field("story")))
        {
            <SiteSection Icon="book-open"
                Region="story"
                HeadingId="about-story-heading"
                Label="@Field("storyEyebrow")"
                Title="@Field("storyTitle")">
                <SiteRichText Html="@((MarkupString)MarkdownRenderer.ToHtml(Field("story")))" />
            </SiteSection>
        }
        @if (HasNowEntries)
        {
            <SiteSection Icon="compass"
                Id="now"
                Region="now"
                HeadingId="about-now-heading"
                Label="@(L["update"])"
                Title="@(L["what_i_m_doing_now"])">
                <SiteStack Gap="SiteSpace.Md">
                    @foreach (var entry in NowEntries)
                    {
                        var value = SlugField(NowSlug, entry.Key);
                        if (!string.IsNullOrWhiteSpace(value))
                        {
                            <SiteCard>
                                <SiteHeading Level="3" Visual="5">@entry.Label</SiteHeading>
                                    <SiteText Variant="SiteTextVariant.Meta">@value</SiteText>
                                </SiteCard>
                        }
                    }
                </SiteStack>
            </SiteSection>
        }
        @if (ProfileMilestones.Count > 0)
        {
            <SiteSection Icon="milestone" Region="milestones"
                HeadingId="about-milestones-heading"
                Label="@(L["milestones"])"
                Title="@(L["key_milestones"])">
                <SiteGrid>
                    @foreach (var milestone in ProfileMilestones) { <SiteGridColumn>
                        <SiteCard Icon="calendar" Label="@milestone.Year"
                            Class="h-100"><SiteHeading Level="3"
                                Visual="5">@milestone.Title</SiteHeading>@if (!string.IsNullOrWhiteSpace(milestone.Description)) { <SiteText Variant="SiteTextVariant.Meta">@milestone.Description</SiteText> }</SiteCard>
                    </SiteGridColumn> }
                </SiteGrid>
            </SiteSection>
        }
        <SiteSection Icon="star"
            Region="highlights"
            HeadingId="about-highlights-heading"
            Label="@(L["selected_work"])"
            Title="@(L["about_highlights_title"])">
            <SiteGrid Columns="3"
                aria-labelledby="about-highlights-heading"
                data-layout-region="items">
                @foreach (var highlight in Highlights)
                {
                    <SiteClickableCard Icon="@highlight.Icon"
                        Class="h-100"
                        Href="@highlight.Href"
                        Title="@highlight.Title"
                        HeadingLevel="3">
                        <SiteText Variant="SiteTextVariant.Excerpt">@highlight.Description</SiteText>
                    </SiteClickableCard>
                }
            </SiteGrid>
        </SiteSection>
        <ExploreSection HeadingId="about-explore-heading" />
    }
    else if (Kind == PageKind.License)
    {
        <SiteHero Title="@Field("title")"
            Lead="@Description"
            BackHref="@(L[""])"
            BackLabel="@(L["home"])" />
        <SiteSection Region="license"
            HeadingId="license-heading"
            Label="@Field("section_label")"
            Title="@Field("section_title")">
            <SiteGrid>
                @foreach (var item in LicenseEntries.Where(entry => !string.IsNullOrWhiteSpace(Field(entry.Body)))) { <SiteGridColumn>
                    <SiteCard Class="h-100">
                        <SiteHeading Level="3"
                            Visual="5">@Field(item.Heading)</SiteHeading>
                            <SiteText Variant="SiteTextVariant.Meta">@Field(item.Body)</SiteText>
                        </SiteCard>
                </SiteGridColumn> }
            </SiteGrid>
        </SiteSection>
        @if (!string.IsNullOrWhiteSpace(Field("contact"))) { <SiteText>@Field("contact")</SiteText> }
        <ContactChannels Profiles="@(Snapshot?.Chrome.Site.ContactProfiles ?? [])"
            EmailChallenge="@Snapshot?.Chrome.Site.ProtectedEmail"
            EmailAvailable="@(Snapshot?.Chrome.Site.ContactAvailable == true)" />
    }
    else
    {
        <SiteHero Title="@Field("title")"
            Lead="@Description"
            BackHref="@(L[""])"
            BackLabel="@(L["home"])" />
        <SiteSection Region="follow"
            HeadingId="follow-heading"
            Label="@Field("section_label")"
            Title="@Field("section_title")">
            <SiteGrid>
                @foreach (var item in FollowEntries.Where(entry => !string.IsNullOrWhiteSpace(Field(entry.Title))))
                {
                    <SiteGridColumn>
                        @if (string.IsNullOrWhiteSpace(item.Url))
                        {
                            <SiteCard Class="h-100">
                                <SiteHeading Level="3"
                                    Visual="5">@Field(item.Title)</SiteHeading>
                                <SiteText Variant="SiteTextVariant.Meta">@Field(item.Description)</SiteText>
                            </SiteCard>
                        }
                        else
                        {
                            <SiteClickableCard Class="h-100"
                                Href="@item.Url"
                                Title="@Field(item.Title)"
                                TitleClass="h5"
                                HeadingLevel="3">
                                <SiteText Variant="SiteTextVariant.Meta">@Field(item.Description)</SiteText>
                            </SiteClickableCard>
                        }
                    </SiteGridColumn>
                }
            </SiteGrid>
        </SiteSection>
        <SiteSection Region="follow-future"
            HeadingId="follow-future-heading"
            Label="@Field("future_label")"
            Title="@Field("future_title")">
            <SiteGrid>
                @foreach (var item in FutureFollowEntries.Where(entry => !string.IsNullOrWhiteSpace(Field(entry.Title)))) { <SiteGridColumn>
                    <SiteCard Label="@Field("planned_label")"
                        Class="h-100"><SiteHeading Level="3"
                            Visual="5">@Field(item.Title)</SiteHeading>
                                <SiteText Variant="SiteTextVariant.Meta">@Field(item.Description)</SiteText>
                            </SiteCard>
                </SiteGridColumn> }
            </SiteGrid>
        </SiteSection>
    }
</SitePage>
