@attribute [Stories("Composition/SiteEntityChecklist")]

<Stories TComponent="SiteEntityChecklist<string>">

    <Story Name="Default">
        <Template>
            <SiteEntityChecklist TItem="string"
                                 Items="@Technologies"
                                 Key="@(item => Array.IndexOf(Technologies, item))"
                                 Label="@(item => item)"
                                 Selected="@_selected"
                                 SelectedChanged="@(selected => _selected = selected)"
                                 SearchPlaceholder="search technologies…"
                                 Legend="technologies" />
        </Template>
    </Story>

</Stories>
