{
  "name": "portfolio",
  "dockerComposeFile": [
    "../.docker/compose.yaml",
    "../.docker/compose.dev.yaml"
  ],
  "service": "web",
  "workspaceFolder": "/src",
  "shutdownAction": "stopCompose",
  "overrideCommand": true,
  "forwardPorts": [
    8080,
    8081
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "csharpier.csharpier-vscode"
      ]
    }
  }
}
