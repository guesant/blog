{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "api:generate": "openapi-ts -f .config/openapi-ts.config.mjs",
    "audit:routes": "node audits/discover-routes.mjs",
    "audit:performance": "lhci autorun --config audits/.lighthouserc.cjs",
    "duplication": "jscpd --config .config/.jscpd.json .",
    "dead-code": "knip --config .config/knip.json",
    "format": "prettier --config ../../.config/prettierrc.json --ignore-path ../../.config/prettierignore --check '**/*.{css,js,jsx,ts,tsx,mjs,cjs,json,md}' '../packages/tools/**/*.mjs'",
    "format:fix": "prettier --config ../../.config/prettierrc.json --ignore-path ../../.config/prettierignore --write '**/*.{css,js,jsx,ts,tsx,mjs,cjs,json,md}' '../packages/tools/**/*.mjs'",
    "lint": "eslint --config .config/eslint.config.mjs . --max-warnings 0",
    "lint:fix": "eslint --config .config/eslint.config.mjs . --fix --max-warnings 0",
    "lint:architecture:test": "node --test ../packages/tools/eslint/*.test.mjs",
    "preview": "vite preview",
    "start": "node ../packages/tools/start-production.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource-variable/roboto-slab": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@icons-pack/react-simple-icons": "13.15.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.2.0",
    "@noble/ciphers": "2.0.1",
    "@tanstack/query-async-storage-persister": "^5.103.1",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-persist-client": "^5.103.1",
    "@tanstack/react-router": "1.170.35",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.52",
    "hash-wasm": "^4.11.0",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "nprogress": "^0.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "srvx": "0.11.22"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@babel/core": "7.29.6",
    "@babel/eslint-parser": "7.29.7",
    "@hey-api/openapi-ts": "0.99.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.2.0",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "9.39.1",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-sonarjs": "4.2.0",
    "jscpd": "5.2.0",
    "knip": "6.32.0",
    "prettier": "3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.0.14"
  },
  "packageManager": "pnpm@11.17.0"
}
