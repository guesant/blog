@inherits LocalizedComponentBase
@page "/tools/combinatorics"
@page "/pt-BR/tools/combinatorics"
@using System.Numerics
@using Blog.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action"
        SubmitLabel="@SubmitLabel"
        Submit="SiteToolFormSubmit.StaticOnly"
        OnSubmit="Calculate"
        AriaLabel="n">
        <SiteFormField For="combinatorics-n"
            Label="n"><SiteInput Id="combinatorics-n"
                Name="n"
                Type="number"
                min="0"
                max="500"
                Value="@NText"
                ValueChanged="@(value => NText = value)" /></SiteFormField>
        <SiteFormField For="combinatorics-r"
            Label="r"><SiteInput Id="combinatorics-r"
                Name="r"
                Type="number"
                min="0"
                max="500"
                Value="@RText"
                ValueChanged="@(value => RText = value)" /></SiteFormField>
    </SiteToolForm>
    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (!Result.IsValid) { <SiteErrorMessage>@ErrorLabel</SiteErrorMessage> }
        else
        {
            <SiteStats>
                <SiteStatItem Label="n!">@Result.Factorial</SiteStatItem>
                    <SiteStatItem Label="nPr">@Result.Permutation</SiteStatItem>
                        <SiteStatItem Label="nCr">@Result.Combination</SiteStatItem>
                    </SiteStats>
        }
    </SiteLiveRegion>
</ToolPage>
