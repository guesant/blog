@inherits SiteInputBase

<input type="range"
       id="@ResolvedId"
       name="@Name"
       value="@Value"
       class="@InputClass"
       aria-describedby="@FieldContext?.DescribedBy"
       aria-required="@(FieldContext?.Required == true ? "true" : null)"
       aria-invalid="@(FieldContext?.Invalid == true ? "true" : null)"
       @attributes="ForwardedAttributes"
       @oninput="HandleInput" />
@if (ShowValue)
{
    <output class="site-range-input-value" for="@ResolvedId">@Value</output>
}

@code {
    [Parameter]
    public int Value { get; set; }
    [Parameter]
    public EventCallback<int> ValueChanged { get; set; }
    /// <summary>Renders the current numeric value next to the slider. Off by default since several
    /// callers already render their own value readout elsewhere in the page.</summary>
    [Parameter]
    public bool ShowValue { get; set; }

    protected override string BaseInputClass => "form-range";

    private Task HandleInput(ChangeEventArgs args) => int.TryParse(args.Value?.ToString(), out var value)
        ? ValueChanged.InvokeAsync(value)
        : Task.CompletedTask;
}
