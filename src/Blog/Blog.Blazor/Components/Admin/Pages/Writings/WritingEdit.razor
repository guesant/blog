@page "/admin/writings/create"
@page "/admin/writings/{Id:int}"
@using System.Globalization
@using Blog.Blazor.Components.Admin.Shared
@inherits AdminEditPageBase<Writing>
@layout AdminLayout

<PageTitle>@(IsEditing ? "Edit writing" : "New writing")</PageTitle>

<SiteFormShell Title="@(IsEditing ? "Edit writing" : "New writing")"
    Error="@SaveError"
    Loading="@IsLoading">
    <SiteForm EditContext="@_writingEditContext" OnValidSubmit="HandleSaveAsync">
        <SiteStack Gap="SiteSpace.Lg">
            <SiteFormField Label="Slug"
                For="slug"
                Required="true"
                HelpText="Used in the public writing URL.">
                <SiteTextInput Id="slug" @bind-Value="_writing.Slug" />
                <SiteValidationMessage For="@(() => _writing.Slug)" />
            </SiteFormField>

            <SiteFormField Label="Type" For="type" Required="true">
                <SiteSelect Id="type" @bind-Value="_writing.Type" Options="TypeOptions" />
            </SiteFormField>

            <SiteFormField Label="Date"
                For="date-iso"
                HelpText="Writings are listed most-recent first by this date.">
                <SiteDateInput Id="date-iso" @bind-Value="DateIsoValue" />
            </SiteFormField>

            <SiteInline Gap="SiteSpace.Lg">
                <SiteCheckbox Label="Hidden" @bind-Value="_writing.Hidden" />
                <SiteCheckbox Label="Show history" @bind-Value="_writing.ShowHistory" />
            </SiteInline>

            <SiteFormSection Title="Translations">
                <SiteTranslationTabs Locales="@_locales"
                    ActiveLocale="@_activeLocale"
                    ActiveLocaleChanged="@((string locale) => _activeLocale = locale)"
                    IdPrefix="writing-translation">
                    <Panel Context="locale">
                        @if (locale == "en")
                        {
                            <CascadingValue Value="_enEditContext"
                                TValue="EditContext"
                                IsFixed="true">
                                <DataAnnotationsValidator />
                                <SiteFormField Label="Title"
                                    For="title-en"
                                    HelpText="Leave blank to skip saving the English translation.">
                                    <SiteTextInput Id="title-en"
                                        @bind-Value="_translationEn.Title" />
                                </SiteFormField>

                                <SiteFormField Label="Excerpt" For="excerpt-en">
                                    <SiteTextAreaInput Id="excerpt-en"
                                        Rows="3"
                                        Value="@(_translationEn.Excerpt ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Excerpt = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Reading time"
                                    For="reading-time-en"
                                    HelpText="Free text, e.g. &quot;5 min&quot;.">
                                    <SiteTextInput Id="reading-time-en"
                                        Value="@(_translationEn.ReadingTime ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.ReadingTime = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="SEO"
                                    For="seo-en"
                                    HelpText="Standard meta fields for this page; add any extra tag under other fields. Leave empty if not applicable.">
                                    <SitePageFieldsInput Id="seo-en"
                                        Slug="PageFieldSlug.Seo"
                                        Locale="en"
                                        Value="@(_translationEn.Seo ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Seo = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationEn.Seo)" />
                                </SiteFormField>

                                <SiteFormField Label="Body (Markdown)" For="body-en">
                                    <SiteMarkdownSplitEditor Id="body-en"
                                        Rows="12"
                                        Value="@(_translationEn.Body ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Body = NullIfBlank(value))"
                                        Render="MarkdownRenderer.ToHtml" />
                                </SiteFormField>
                            </CascadingValue>
                        }
                        else
                        {
                            <CascadingValue Value="_ptEditContext"
                                TValue="EditContext"
                                IsFixed="true">
                                <DataAnnotationsValidator />
                                <SiteFormField Label="Título"
                                    For="title-pt"
                                    HelpText="Deixe em branco para não salvar a tradução em português.">
                                    <SiteTextInput Id="title-pt"
                                        @bind-Value="_translationPtBr.Title" />
                                </SiteFormField>

                                <SiteFormField Label="Resumo" For="excerpt-pt">
                                    <SiteTextAreaInput Id="excerpt-pt"
                                        Rows="3"
                                        Value="@(_translationPtBr.Excerpt ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Excerpt = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Tempo de leitura"
                                    For="reading-time-pt"
                                    HelpText="Texto livre, ex.: &quot;5 min&quot;.">
                                    <SiteTextInput Id="reading-time-pt"
                                        Value="@(_translationPtBr.ReadingTime ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.ReadingTime = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="SEO"
                                    For="seo-pt"
                                    HelpText="Campos meta padrão desta página; tags extras entram em outros campos. Deixe vazio se não for aplicável.">
                                    <SitePageFieldsInput Id="seo-pt"
                                        Slug="PageFieldSlug.Seo"
                                        Locale="pt-BR"
                                        Value="@(_translationPtBr.Seo ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Seo = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationPtBr.Seo)" />
                                </SiteFormField>

                                <SiteFormField Label="Corpo (Markdown)" For="body-pt">
                                    <SiteMarkdownSplitEditor Id="body-pt"
                                        Rows="12"
                                        Value="@(_translationPtBr.Body ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Body = NullIfBlank(value))"
                                        Render="MarkdownRenderer.ToHtml" />
                                </SiteFormField>
                            </CascadingValue>
                        }
                    </Panel>
                </SiteTranslationTabs>
            </SiteFormSection>

            <SiteFormSection Title="Topics">
                <SiteEntityChecklist TItem="Topic"
                    Items="_allTopics"
                    Key="@(topic => topic.Id)"
                    Label="@TopicDisplayName"
                    Selected="_selectedTopicIds"
                    SelectedChanged="HandleSelectedTopicsChanged"
                    SearchPlaceholder="Search topics…"
                    EmptyText="@(search => $"No topics match \"{search}\".")" />
            </SiteFormSection>
        </SiteStack>

        <SiteSaveBar Saving="@IsSaving" CancelHref="/admin/writings" />
    </SiteForm>
</SiteFormShell>
