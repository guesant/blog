<div class="site-dropdown content-actions-menu"
    data-slot="dropdown"
    data-align="@(AlignEnd ? "end" : "start")">
    @if (RendererInfo.IsInteractive)
    {
        <BlazorBlueprint.Primitives.DropdownMenu.BbDropdownMenu>
            <BlazorBlueprint.Primitives.DropdownMenu.BbDropdownMenuTrigger AdditionalAttributes="@TriggerAttributes">
                @ToggleContent
            </BlazorBlueprint.Primitives.DropdownMenu.BbDropdownMenuTrigger>
            <BlazorBlueprint.Primitives.DropdownMenu.BbDropdownMenuContent AdditionalAttributes="@ContentAttributes"
                Align="@(AlignEnd ? BlazorBlueprint.Primitives.PopoverAlign.End : BlazorBlueprint.Primitives.PopoverAlign.Start)"
                CloseOnEscape="true">
                @MenuContent
            </BlazorBlueprint.Primitives.DropdownMenu.BbDropdownMenuContent>
        </BlazorBlueprint.Primitives.DropdownMenu.BbDropdownMenu>
    }
    else
    {
        @* IMPORTANT: content detail routes (App.razor's PageRenderMode) render fully static for
           this component's tree, so BbDropdownMenu's open/close state -- plain Blazor C# state --
           can never react to a click; the trigger would render but the menu could never open.
           <details>/<summary> gets the same disclosure from the browser itself, no Blazor or
           JavaScript required, and content-actions.js already drives the items by plain DOM
           listeners so they keep working once the menu can open. *@
        <details class="site-dropdown-details" name="@ExclusiveGroup">
            <summary @attributes="TriggerAttributes">@ToggleContent</summary>
            <div @attributes="StaticContentAttributes">
                @MenuContent
            </div>
        </details>
    }
</div>
