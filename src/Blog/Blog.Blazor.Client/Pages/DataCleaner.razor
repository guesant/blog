@inherits LocalizedComponentBase
@page "/tools/data-cleaner"
@page "/pt-BR/tools/data-cleaner"
@using Blog.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteStack data-tool="data-cleaner">
        <SiteToolForm Action="@Action"
            SubmitLabel="@SubmitLabel"
            Submit="SiteToolFormSubmit.StaticOnly"
            OnSubmit="Recalculate"
            AriaLabel="@InputLabel">
            <SiteFormField For="data-cleaner-input"
                Label="@InputLabel"><SiteTextAreaInput Id="data-cleaner-input"
                    Name="csv"
                    Rows="12"
                    Value="@CsvText"
                    ValueChanged="@(v => CsvText = v)" /></SiteFormField>
            <SiteFieldSet Legend="@OptionsLabel">
                <SiteCheckbox Label="@TrimLabel" Name="trim" @bind-Value="TrimCells" />
                <SiteCheckbox Label="@EmptyRowsLabel" Name="empty" @bind-Value="RemoveEmptyRows" />
                <SiteCheckbox Label="@DuplicateRowsLabel"
                    Name="duplicates"
                    @bind-Value="RemoveDuplicateRows" />
            </SiteFieldSet>
        </SiteToolForm>

        <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
            @if (!Result.IsValid)
            {
                <SiteErrorMessage>@ErrorLabel</SiteErrorMessage>
            }
            else
            {
                <SiteCard Class="site-block" Label="@ResultLabel">
                    <SiteText Class="content-tags">@Result.InputRows → @Result.OutputRows · @Result.EmptyRowsRemoved @RemovedEmptyLabel · @Result.DuplicateRowsRemoved @RemovedDuplicateLabel</SiteText>
                    <SiteTextAreaInput readonly
                        rows="12"
                        aria-label="@ResultLabel">@Result.Output</SiteTextAreaInput>
                    <SiteText>
                        <SiteLink Variant="SiteButtonVariant.Outline"
                            Href="@DownloadUrl"
                            download="cleaned.csv">
                            <SiteIcon Name="download" Size="14" />@DownloadLabel</SiteLink>
                        </SiteText>
                </SiteCard>
            }
        </SiteLiveRegion>
    </SiteStack>
</ToolPage>
