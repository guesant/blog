@inherits LocalizedComponentBase
@page "/tools/mechanical-energy"
@page "/pt-BR/tools/mechanical-energy"
@using System.Globalization
@using Portfolio.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action"
        SubmitLabel="@SubmitLabel"
        Submit="SiteToolFormSubmit.StaticOnly"
        OnSubmit="Calculate"
        AriaLabel="@InputLabel">
        <SiteFormField For="energy-mass"
            Label="@MassLabel"><SiteNumberInput TValue="double?"
                Id="energy-mass"
                Name="mass"
                Value="@MassNumber"
                ValueChanged="@(v => MassNumber = v)"
                Step="0.01"
                EnableMinMax="true"
                Min="0" /></SiteFormField>
        <SiteFormField For="energy-speed"
            Label="@SpeedLabel"><SiteNumberInput TValue="double?"
                Id="energy-speed"
                Name="speed"
                Value="@SpeedNumber"
                ValueChanged="@(v => SpeedNumber = v)"
                Step="0.01"
                EnableMinMax="true"
                Min="0" /></SiteFormField>
        <SiteFormField For="energy-height"
            Label="@HeightLabel"><SiteNumberInput TValue="double?"
                Id="energy-height"
                Name="height"
                Value="@HeightNumber"
                ValueChanged="@(v => HeightNumber = v)"
                Step="0.01"
                EnableMinMax="true"
                Min="0" /></SiteFormField>
        <SiteFormField For="energy-gravity"
            Label="@GravityLabel"><SiteNumberInput TValue="double?"
                Id="energy-gravity"
                Name="gravity"
                Value="@GravityNumber"
                ValueChanged="@(v => GravityNumber = v)"
                Step="0.01"
                EnableMinMax="true"
                Min="0" /></SiteFormField>
    </SiteToolForm>
    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (!Result.IsValid) { <SiteErrorMessage>@ErrorLabel</SiteErrorMessage> }
        else { <SiteStats>
            <SiteStatItem Label="@KineticLabel">@Energy(Result.KineticEnergy)</SiteStatItem>
                <SiteStatItem Label="@PotentialLabel">@Energy(Result.PotentialEnergy)</SiteStatItem>
                    <SiteStatItem Label="@TotalLabel">@Energy(Result.TotalEnergy)</SiteStatItem>
                </SiteStats> }
    </SiteLiveRegion>
</ToolPage>
