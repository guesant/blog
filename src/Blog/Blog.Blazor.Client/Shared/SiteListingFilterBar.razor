<SiteFilterCard Action="@Action"
    Class="mb-4 site-toolbar-row"
    DataLayoutRegion="filters"
    OnApply="@OnApply">
    @PrimaryFields
    @if (AdvancedFields is not null)
    {
        <SiteDisclosure Class="filter-bar-details" Open="@AdvancedOpen" Summary="@AdvancedSummary">
            @AdvancedFields
        </SiteDisclosure>
    }
    <SiteInline Align="SiteAlign.End" Gap="SiteSpace.Md" Wrap="true" Class="site-search-action-row">
        @SearchField
        <SiteFormActions Fill="true">
            <SiteLink Variant="SiteButtonVariant.Outline"
                Href="@ClearHref"><SiteIcon Name="filter-x"
                    Size="14"
                    Class="icon" /><SiteText Variant="SiteTextVariant.Meta">@ClearLabel</SiteText>
                    </SiteLink>
            <SiteButton Variant="SiteButtonVariant.Default"
                Type="SiteButtonType.Submit"><SiteIcon Name="check"
                    Size="14"
                    Class="icon" /><SiteText Variant="SiteTextVariant.Meta">@ApplyLabel</SiteText>
                    </SiteButton>
        </SiteFormActions>
    </SiteInline>
</SiteFilterCard>
