<li class="@RootClass" data-slot="link-item">
    <a class="site-link-item-anchor"
        href="@Href"
        title="@Title"
        target="@(External ? "_blank" : null)"
        rel="@(External ? "noopener noreferrer" : null)">
        <SiteIcon Name="@Icon" Size="14" Class="icon site-link-item-icon" />
        <span class="site-link-item-text">
            <span class="site-link-item-label">@Label</span>
            @if (!string.IsNullOrWhiteSpace(Meta))
            {
                <span class="site-link-item-meta">@Meta</span>
            }
        </span>
        @if (!string.IsNullOrWhiteSpace(Badge))
        {
            <span class="site-link-item-badge">@Badge</span>
        }
        @if (External)
        {
            <SiteIcon Name="arrow-up-right" Size="12" Class="icon site-link-item-external" />
        }
    </a>
</li>
