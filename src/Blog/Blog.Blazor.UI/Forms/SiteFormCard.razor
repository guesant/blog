<div class="@RootClass"
    role="group"
    aria-label="@(HasLabel ? null : AriaLabel)"
    aria-labelledby="@(HasLabel ? _headingId : null)"
    data-slot="form-card">
    @if (LabelContent is not null)
    {
        <div class="site-form-card-header" id="@_headingId">@LabelContent</div>
    }
    else if (!string.IsNullOrWhiteSpace(Label))
    {
        <div class="site-form-card-header" id="@_headingId">@Label</div>
    }
    <div class="site-form-card-body">
        @ChildContent
    </div>
</div>
