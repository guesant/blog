@inherits LocalizedComponentBase
@page "/tools/image-dimension-calculator"
@page "/pt-BR/tools/image-dimension-calculator"
@using Microsoft.JSInterop
@using Blog.Blazor.Core
@inject IJSRuntime JS

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteStack data-tool="image-dimension-calculator">
        <SiteToolForm Action="@Action" SubmitLabel="@CalculateLabel" AriaLabel="@OptionalFileLabel">
            <SiteFormField For="image-dimension-file"
                Label="@OptionalFileLabel"><SiteFileInput type="file"
                    accept="image/*"
                    data-image-dimension-file
                    Id="image-dimension-file" /></SiteFormField>
            <SiteFormActions>
                <SiteFormField For="image-dimension-original-width"
                    Label="@OriginalWidthLabel"><SiteNumberInput TValue="int?"
                        Id="image-dimension-original-width"
                        Name="originalWidth"
                        Value="@OriginalWidth"
                        ValueChanged="@(v => OriginalWidth = v)"
                        Step="1"
                        EnableMinMax="true"
                        Min="1"
                        data-image-dimension-original-width /></SiteFormField>
                <SiteFormField For="image-dimension-original-height"
                    Label="@OriginalHeightLabel"><SiteNumberInput TValue="int?"
                        Id="image-dimension-original-height"
                        Name="originalHeight"
                        Value="@OriginalHeight"
                        ValueChanged="@(v => OriginalHeight = v)"
                        Step="1"
                        EnableMinMax="true"
                        Min="1"
                        data-image-dimension-original-height /></SiteFormField>
            </SiteFormActions>
            <SiteFormActions>
                <SiteFormField For="image-dimension-target-width"
                    Label="@TargetWidthLabel"><SiteNumberInput TValue="int?"
                        Id="image-dimension-target-width"
                        Name="targetWidth"
                        Value="@TargetWidth"
                        ValueChanged="@(v => TargetWidth = v)"
                        Step="1"
                        EnableMinMax="true"
                        Min="1" /></SiteFormField>
                <SiteFormField For="image-dimension-target-height"
                    Label="@TargetHeightLabel"><SiteNumberInput TValue="int?"
                        Id="image-dimension-target-height"
                        Name="targetHeight"
                        Value="@TargetHeight"
                        ValueChanged="@(v => TargetHeight = v)"
                        Step="1"
                        EnableMinMax="true"
                        Min="1" /></SiteFormField>
            </SiteFormActions>
        </SiteToolForm>
    </SiteStack>
    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        <SiteStats Grid="true">
            <SiteStatItem Label="@ResultWidthLabel">@(Result.Width?.ToString() ?? "-")</SiteStatItem>
                <SiteStatItem Label="@ResultHeightLabel">@(Result.Height?.ToString() ?? "-")</SiteStatItem>
            </SiteStats>
    </SiteLiveRegion>
</ToolPage>
