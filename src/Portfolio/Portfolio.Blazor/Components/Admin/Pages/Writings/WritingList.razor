@page "/admin/writings"
@inherits AdminListPageBase<Writing>
@layout AdminLayout

<PageTitle>Writings</PageTitle>

<SitePageHeader Title="Writings">
    <Actions>
        <SiteLink Variant="SiteButtonVariant.Default" Href="/admin/writings/create">
            <SiteIcon Name="plus" Size="14" />New writing</SiteLink>
        </Actions>
</SitePageHeader>

@if (Error is not null)
{
    <SiteNotice Tone="SiteTone.Danger">@Error</SiteNotice>
}

@if (IsLoading)
{
    <SiteLoading Label="Loading…" />
}
else
{
    <SiteDataTable TItem="Writing"
        Items="@PageItems"
        EmptyText="No writings yet."
        RowKey="@(writing => writing.Id)">
        <Columns>
            <SiteColumn TItem="Writing" Header="Title" IsRowHeader="true">
                <Cell Context="writing">@DisplayTitle(writing)</Cell>
            </SiteColumn>
            <SiteColumn TItem="Writing" Header="Slug">
                <Cell Context="writing">@writing.Slug</Cell>
            </SiteColumn>
            <SiteColumn TItem="Writing" Header="Type">
                <Cell Context="writing">@writing.Type</Cell>
            </SiteColumn>
            <SiteColumn TItem="Writing"
                Header="Status"><Cell Context="writing">@if (writing.Hidden) { <SiteBadge Label="Hidden" /> }</Cell>
                </SiteColumn>
            <SiteColumn TItem="Writing"
                Header="Date"><Cell Context="writing">@(writing.DateIso?.ToString("yyyy-MM-dd") ?? "·")</Cell>
                </SiteColumn>
        </Columns>
        <Actions Context="writing">
            <SiteInline Gap="SiteSpace.Sm">
                <SiteLink Variant="SiteButtonVariant.Outline"
                    Href="@($"/admin/writings/{writing.Id}")">
                    <SiteIcon Name="pencil" Size="14" />Edit</SiteLink>
                <SiteButton Variant="SiteButtonVariant.Destructive"
                    @onclick="@(() => HandleDeleteAsync(writing))"><SiteIcon Name="trash-2"
                        Size="14" />Delete</SiteButton>
            </SiteInline>
        </Actions>
    </SiteDataTable>
    <SitePagination CurrentPage="@CurrentPage" TotalPages="@TotalPages" Href="@PageUrl" />
}
