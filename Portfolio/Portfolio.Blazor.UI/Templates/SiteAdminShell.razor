<div class="admin-shell" data-layout-template="admin-sidebar">
    <aside class="admin-nav" data-layout-region="sidebar">
        <div class="admin-nav-brand">@Brand</div>
        <nav class="admin-nav-links" aria-label="@NavAriaLabel">
            @Nav
            @NavFooter
        </nav>
    </aside>
    <main class="admin-content" id="main-content" tabindex="-1" data-layout-region="content">
        <div class="site-content-max">
            @ChildContent
        </div>
    </main>
</div>
