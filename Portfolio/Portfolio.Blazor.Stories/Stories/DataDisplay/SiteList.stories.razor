@attribute [Stories("DataDisplay/SiteList")]

<Stories TComponent="SiteList">

    <Story Name="Plain">
        <Template>
            <SiteList Variant="SiteListVariant.Plain">
                <SiteListItem Class="list-group-item">First item</SiteListItem>
                <SiteListItem Class="list-group-item">Second item</SiteListItem>
            </SiteList>
        </Template>
    </Story>

    <Story Name="Surface">
        <Template>
            <SiteList Variant="SiteListVariant.Surface">
                <SiteListItem Href="#">First surfaced item</SiteListItem>
                <SiteListItem Href="#">Second surfaced item</SiteListItem>
            </SiteList>
        </Template>
    </Story>

    <Story Name="Boxed">
        <Template>
            <SiteList Variant="SiteListVariant.Boxed">
                <SiteListItem Class="site-text-list-item">x = 1, y = 2</SiteListItem>
                <SiteListItem Class="site-text-list-item">x = 2, y = 4</SiteListItem>
            </SiteList>
        </Template>
    </Story>

    <Story Name="Steps">
        <Template>
            <SiteList Variant="SiteListVariant.Steps" Ordered="true">
                <SiteListItem>First step</SiteListItem>
                <SiteListItem>Second step</SiteListItem>
            </SiteList>
        </Template>
    </Story>

</Stories>
