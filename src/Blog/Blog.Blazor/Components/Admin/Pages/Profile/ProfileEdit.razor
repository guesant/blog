@page "/admin/profile"
@using ProfileEntity = Blog.Blazor.Data.Entities.Profile
@using ProfileTranslationEntity = Blog.Blazor.Data.Entities.ProfileTranslation
@inherits AdminEditPageBase<ProfileEntity>
@layout AdminLayout

<PageTitle>Profile</PageTitle>

<SiteFormShell Title="Profile" Error="@SaveError" Loading="@IsLoading">
    <SiteForm EditContext="@_profileEditContext" OnValidSubmit="HandleSaveAsync">
        <SiteStack Gap="SiteSpace.Lg">
            <SiteFormField Label="Name" For="name">
                <SiteTextInput Id="name"
                    Value="@(_profile.Name ?? string.Empty)"
                    ValueChanged="@(value => _profile.Name = NullIfBlank(value))" />
            </SiteFormField>

            <SiteFormField Label="Birth date" For="birth-date">
                <SiteDateInput Id="birth-date" @bind-Value="_profile.BirthDate" />
            </SiteFormField>

            <SiteFormSection Title="Translations">
                <SiteTranslationTabs Locales="@_locales"
                    ActiveLocale="@_activeLocale"
                    ActiveLocaleChanged="@((string locale) => _activeLocale = locale)"
                    IdPrefix="profile-translation">
                    <Panel Context="locale">
                        @if (locale == "en")
                        {
                            <CascadingValue Value="_enEditContext"
                                TValue="EditContext"
                                IsFixed="true">
                                <DataAnnotationsValidator />

                                <SiteFormField Label="Title" For="title-en">
                                    <SiteTextInput Id="title-en"
                                        Value="@(_translationEn.Title ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Title = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Location" For="location-en">
                                    <SiteTextInput Id="location-en"
                                        Value="@(_translationEn.Location ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Location = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Birth city" For="birth-city-en">
                                    <SiteTextInput Id="birth-city-en"
                                        Value="@(_translationEn.BirthCity ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.BirthCity = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Description" For="description-en">
                                    <SiteTextAreaInput Id="description-en"
                                        Rows="6"
                                        Value="@(_translationEn.Description ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Description = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Interests" For="interests-en">
                                    <SiteTextAreaInput Id="interests-en"
                                        Rows="3"
                                        Value="@(_translationEn.Interests ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Interests = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Learning" For="learning-en">
                                    <SiteTextAreaInput Id="learning-en"
                                        Rows="3"
                                        Value="@(_translationEn.Learning ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Learning = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Personal interests"
                                    For="personal-interests-en"
                                    HelpText="One entry per interest. Leave empty if not applicable.">
                                    <SiteStringListInput Id="personal-interests-en"
                                        Value="@(_translationEn.PersonalInterests ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.PersonalInterests = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationEn.PersonalInterests)" />
                                </SiteFormField>

                                <SiteFormField Label="Trajectory"
                                    For="trajectory-en"
                                    HelpText="One entry per role: role/organization/period/highlights. Leave empty if not applicable.">
                                    <SiteJsonArrayInput Id="trajectory-en"
                                        Fields="@TrajectoryFields"
                                        Value="@(_translationEn.Trajectory ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Trajectory = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationEn.Trajectory)" />
                                </SiteFormField>

                                <SiteFormField Label="Milestones"
                                    For="milestones-en"
                                    HelpText="One entry per milestone, e.g. year/title/description. Leave empty if not applicable.">
                                    <SiteJsonArrayInput Id="milestones-en"
                                        Fields="@MilestoneFields"
                                        Value="@(_translationEn.Milestones ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Milestones = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationEn.Milestones)" />
                                </SiteFormField>

                                <SiteFormField Label="Fortunes"
                                    For="fortunes-en"
                                    HelpText="One entry per fortune/quote. Leave empty if not applicable.">
                                    <SiteStringListInput Id="fortunes-en"
                                        Value="@(_translationEn.Fortunes ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Fortunes = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationEn.Fortunes)" />
                                </SiteFormField>

                                <SiteFormField Label="Personal facts"
                                    For="personal-facts-en"
                                    HelpText="One entry per fact. Leave empty if not applicable.">
                                    <SiteStringListInput Id="personal-facts-en"
                                        Value="@(_translationEn.PersonalFacts ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.PersonalFacts = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationEn.PersonalFacts)" />
                                </SiteFormField>

                                <SiteFormField Label="Personal things"
                                    For="personal-things-en"
                                    HelpText="One entry per personal thing. Leave empty if not applicable.">
                                    <SiteStringListInput Id="personal-things-en"
                                        Value="@(_translationEn.PersonalThings ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.PersonalThings = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationEn.PersonalThings)" />
                                </SiteFormField>
                            </CascadingValue>
                        }
                        else
                        {
                            <CascadingValue Value="_ptEditContext"
                                TValue="EditContext"
                                IsFixed="true">
                                <DataAnnotationsValidator />

                                <SiteFormField Label="Título" For="title-pt">
                                    <SiteTextInput Id="title-pt"
                                        Value="@(_translationPtBr.Title ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Title = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Localização" For="location-pt">
                                    <SiteTextInput Id="location-pt"
                                        Value="@(_translationPtBr.Location ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Location = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Cidade natal" For="birth-city-pt">
                                    <SiteTextInput Id="birth-city-pt"
                                        Value="@(_translationPtBr.BirthCity ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.BirthCity = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Descrição" For="description-pt">
                                    <SiteTextAreaInput Id="description-pt"
                                        Rows="6"
                                        Value="@(_translationPtBr.Description ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Description = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Interesses" For="interests-pt">
                                    <SiteTextAreaInput Id="interests-pt"
                                        Rows="3"
                                        Value="@(_translationPtBr.Interests ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Interests = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Aprendizado" For="learning-pt">
                                    <SiteTextAreaInput Id="learning-pt"
                                        Rows="3"
                                        Value="@(_translationPtBr.Learning ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Learning = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Interesses pessoais"
                                    For="personal-interests-pt"
                                    HelpText="Um item por interesse. Deixe vazio se não for aplicável.">
                                    <SiteStringListInput Id="personal-interests-pt"
                                        Value="@(_translationPtBr.PersonalInterests ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.PersonalInterests = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationPtBr.PersonalInterests)" />
                                </SiteFormField>

                                <SiteFormField Label="Trajetória"
                                    For="trajectory-pt"
                                    HelpText="Um item por cargo: cargo/organização/período/destaques. Deixe vazio se não for aplicável.">
                                    <SiteJsonArrayInput Id="trajectory-pt"
                                        Fields="@TrajectoryFields"
                                        Value="@(_translationPtBr.Trajectory ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Trajectory = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationPtBr.Trajectory)" />
                                </SiteFormField>

                                <SiteFormField Label="Marcos"
                                    For="milestones-pt"
                                    HelpText="Um item por marco, ex.: ano/título/descrição. Deixe vazio se não for aplicável.">
                                    <SiteJsonArrayInput Id="milestones-pt"
                                        Fields="@MilestoneFields"
                                        Value="@(_translationPtBr.Milestones ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Milestones = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationPtBr.Milestones)" />
                                </SiteFormField>

                                <SiteFormField Label="Sortes"
                                    For="fortunes-pt"
                                    HelpText="Um item por sorte/frase. Deixe vazio se não for aplicável.">
                                    <SiteStringListInput Id="fortunes-pt"
                                        Value="@(_translationPtBr.Fortunes ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Fortunes = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationPtBr.Fortunes)" />
                                </SiteFormField>

                                <SiteFormField Label="Fatos pessoais"
                                    For="personal-facts-pt"
                                    HelpText="Um item por fato. Deixe vazio se não for aplicável.">
                                    <SiteStringListInput Id="personal-facts-pt"
                                        Value="@(_translationPtBr.PersonalFacts ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.PersonalFacts = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationPtBr.PersonalFacts)" />
                                </SiteFormField>

                                <SiteFormField Label="Coisas pessoais"
                                    For="personal-things-pt"
                                    HelpText="Um item por coisa pessoal. Deixe vazio se não for aplicável.">
                                    <SiteStringListInput Id="personal-things-pt"
                                        Value="@(_translationPtBr.PersonalThings ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.PersonalThings = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationPtBr.PersonalThings)" />
                                </SiteFormField>
                            </CascadingValue>
                        }
                    </Panel>
                </SiteTranslationTabs>
            </SiteFormSection>
        </SiteStack>

        <SiteSaveBar Saving="@IsSaving" CancelHref="/admin/profile" />
    </SiteForm>
</SiteFormShell>
