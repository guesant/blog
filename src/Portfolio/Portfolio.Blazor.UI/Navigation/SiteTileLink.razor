<SiteLink Variant="SiteButtonVariant.Outline"
    Href="@Href"
    Class="site-tile-link"
    @attributes="AdditionalAttributes">
    @if (CountFirst && !string.IsNullOrWhiteSpace(Count))
    {
        <SiteText Variant="SiteTextVariant.MetricValue" Class="site-tile-count">@Count</SiteText>
    }
    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <SiteIcon Name="@Icon" Size="16" />
    }
    @if (!CountFirst && !string.IsNullOrWhiteSpace(Count))
    {
        <SiteText Variant="SiteTextVariant.MetricValue" Class="site-tile-count">@Count</SiteText>
    }
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <SiteText Variant="SiteTextVariant.Small" Class="site-tile-label">@Label</SiteText>
    }
</SiteLink>
