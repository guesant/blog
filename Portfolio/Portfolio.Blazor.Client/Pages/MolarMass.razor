@inherits LocalizedComponentBase
@implements IDisposable
@page "/tools/molar-mass"
@page "/pt-BR/tools/molar-mass"
@using System.Globalization
@using Portfolio.Blazor.Core
@using Microsoft.JSInterop
@inject IJSRuntime JS

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action"
        SubmitLabel="@SubmitLabel"
        Submit="SiteToolFormSubmit.StaticOnly"
        OnSubmit="HandleSubmit"
        AriaLabel="@InputLabel">
        <SiteFormField For="molar-formula" Label="@InputLabel">
            <SiteInput Id="molar-formula"
                Name="formula"
                Value="@Formula"
                ValueChanged="@(v => Formula = v)" />
        </SiteFormField>
    </SiteToolForm>

    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (!Result.IsValid)
        {
            <SiteErrorMessage>@ErrorMessage</SiteErrorMessage>
        }
        else
        {
            <SiteCard Class="site-block" Label="@ResultLabel">
                <SiteText Variant="SiteTextVariant.Body">@MolarMassLabel: @Format(Result.MolarMass) g/mol</SiteText>
                @if (RendererInfo.IsInteractive)
                {
                    <SiteJsMount Id="@CompositionTableId"
                        Class="table-scroll"
                        AriaLabel="@CompositionLabel" />
                }
                else
                {
                    <SiteDataTable TItem="ElementComposition"
                        Items="@Result.Composition"
                        RowKey="@(element => element.Symbol)"
                        Caption="@CompositionLabel"
                        EmptyText="No elements.">
                        <Columns>
                            <SiteColumn TItem="ElementComposition"
                                Header="@ElementLabel"
                                IsRowHeader="true">
                                <Cell Context="element">@element.Symbol</Cell>
                            </SiteColumn>
                            <SiteColumn TItem="ElementComposition" Header="@AtomsLabel">
                                <Cell Context="element">@element.AtomCount</Cell>
                            </SiteColumn>
                            <SiteColumn TItem="ElementComposition" Header="@PercentageLabel">
                                <Cell Context="element">@Format(element.Percentage)%</Cell>
                            </SiteColumn>
                        </Columns>
                    </SiteDataTable>
                }
            </SiteCard>
        }
    </SiteLiveRegion>
</ToolPage>
