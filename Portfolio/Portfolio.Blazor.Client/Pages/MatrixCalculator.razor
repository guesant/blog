@inherits LocalizedComponentBase
@page "/tools/matrix-calculator"
@page "/pt-BR/tools/matrix-calculator"
@using System.Globalization
@using Portfolio.Blazor.Core
@using Microsoft.JSInterop
@inject IJSRuntime JS

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action"
        SubmitLabel="@SubmitLabel"
        Submit="SiteToolFormSubmit.StaticOnly"
        OnSubmit="Calculate"
        AriaLabel="@InputLabel">
        <SiteFormField For="matrix-input" Label="@InputLabel">
            <SiteTextAreaInput Id="matrix-input"
                Name="matrix"
                Rows="5"
                Value="@MatrixText"
                ValueChanged="@(v => MatrixText = v)" />
        </SiteFormField>
        <SiteFormField For="matrix-operation" Label="@OperationLabel">
            <SiteSelect @bind-Value="Operation"
                Options="@OperationOptions"
                Id="matrix-operation"
                Name="operation"
                Placeholder="@OperationLabel"
                EmptyText="@OperationLabel" />
        </SiteFormField>
    </SiteToolForm>
    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (!Result.IsValid) { <SiteErrorMessage>@ErrorLabel</SiteErrorMessage> }
        else if (Result.Scalar.HasValue) { <SiteStats>
            <SiteStatItem Label="@DeterminantLabel">@Format(Result.Scalar.Value)</SiteStatItem>
        </SiteStats> }
        else if (RendererInfo.IsInteractive) { <SiteJsMount Id="@MatrixTableId"
            Class="table-scroll"
            AriaLabel="@ResultLabel" /><SiteJsMount Id="@MatrixChartId"
                Class="data-chart"
                Role="img"
                AriaLabel="@ResultLabel" /> }
        else { <SiteTable Caption="@ResultLabel">
            <tbody>@foreach (var row in Result.Matrix) { <tr>@foreach (var cell in row) { <td>@Format(cell)</td> }</tr> }</tbody>
        </SiteTable> }
    </SiteLiveRegion>
</ToolPage>
