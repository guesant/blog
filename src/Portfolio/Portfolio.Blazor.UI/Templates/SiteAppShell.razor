<div class="page-shell" data-layout-template="sidebar-wrapper-aside">
    <header class="site-nav-topbar">
        @Brand
        @Toggle
    </header>
    <div class="site-nav-backdrop" data-nav-backdrop aria-hidden="true">
    </div>
    <div class="page-layout">
        <div class="site-nav-offcanvas" data-nav-panel="true">
            @SidebarLeft
            @SidebarRight
        </div>
        <div class="page-body" data-layout-region="layout">
            <div class="site-main-scroll" data-layout-region="wrapper">
                <div class="page-content site-content-max" data-layout-region="content">
                    @ChildContent
                </div>
                @Footer
            </div>
        </div>
    </div>
</div>
