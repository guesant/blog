<div id="@Id"
    class="@Class"
    role="@Role"
    aria-label="@AriaLabel"
    aria-busy="@(Busy ? "true" : "false")"
    @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    /// <summary>Element id a JS-interop script targets via document.getElementById.</summary>
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;
    [Parameter]
    public string? Class { get; set; }
    [Parameter]
    public string? Role { get; set; }
    [Parameter]
    public string? AriaLabel { get; set; }
    /// <summary>Whether the JS widget targeting this element has finished initializing. Defaults to
    /// true (empty region, waiting on JS) since Blazor has no visibility into the DOM once a JS
    /// widget mounts into it directly - callers that track their widget's ready state can pass
    /// Busy="false" once it reports ready.</summary>
    [Parameter]
    public bool Busy { get; set; } = true;
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
