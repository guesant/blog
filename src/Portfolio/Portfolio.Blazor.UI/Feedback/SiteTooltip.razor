@using BlazorBlueprint.Primitives

<BlazorBlueprint.Primitives.Tooltip.BbTooltip DelayDuration="300" HideDelay="100">
    <BlazorBlueprint.Primitives.Tooltip.BbTooltipTrigger AsChild="true">
        @ChildContent
    </BlazorBlueprint.Primitives.Tooltip.BbTooltipTrigger>
    <BlazorBlueprint.Primitives.Tooltip.BbTooltipContent Side="@Side"
        AdditionalAttributes="@ContentAttributes">
        @Text
    </BlazorBlueprint.Primitives.Tooltip.BbTooltipContent>
</BlazorBlueprint.Primitives.Tooltip.BbTooltip>
