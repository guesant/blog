<div class="invalid-feedback d-block"
    id="@($"{Context.Id}-error")"
    role="alert"
    data-slot="field-error">
    @ChildContent
</div>

@code {
    [CascadingParameter]
    private SiteFieldContext Context { get; set; } = default!;
    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;
}
