<div class="site-form-shell" data-slot="form-shell">
    <SitePageHeader Title="@Title" BackHref="@BackHref" BackLabel="@BackLabel" Actions="@Actions" />
    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <SiteNotice Tone="SiteTone.Danger">@Error</SiteNotice>
    }
    @if (Loading)
    {
        <SiteLoading Label="@LoadingLabel" />
    }
    else
    {
        @ChildContent
    }
</div>
