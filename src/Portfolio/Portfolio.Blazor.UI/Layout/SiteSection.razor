<div @attributes="SectionAttributes"
    class="@($"site-section section border {Class}")"
    data-layout-region="@Region"
    aria-labelledby="@(string.IsNullOrWhiteSpace(Title) ? null : HeadingId)">
    <div class="site-section-body">
    @if (!string.IsNullOrWhiteSpace(Label)) { <p class="section-label">@if (!string.IsNullOrWhiteSpace(Icon)) { <SiteIcon Name="@Icon" Size="12" /> }@Label</p> }
    @if (!string.IsNullOrWhiteSpace(Title)) { <h2 class="section-title h3"
        id="@HeadingId">@Title</h2> }
    @if (!string.IsNullOrWhiteSpace(Description)) { <p class="section-description text-body-secondary">@Description</p> }
    @if (!string.IsNullOrWhiteSpace(ActionHref) && !string.IsNullOrWhiteSpace(ActionLabel))
    {
        <SiteLink Variant="SiteButtonVariant.Outline"
            Class="section-action"
            Href="@ActionHref"><SiteIcon Name="arrow-right" Size="14" />@ActionLabel</SiteLink>
    }
    @ChildContent
    </div>
</div>
