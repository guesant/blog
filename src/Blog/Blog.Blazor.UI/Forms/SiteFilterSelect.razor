@using System.Linq.Expressions
@using Microsoft.Extensions.Localization
@using Blog.Blazor.Core.Localization
@inject IStringLocalizer<SharedResource> L

<SiteFormField Label="@Label" For="@Id">
    <div class="select-field-wrap">
        <SiteIcon Name="@Icon" Size="14" Class="icon select-field-icon" />
        @if (RendererInfo.IsInteractive)
        {
            <SiteSelect Value="@Value"
                ValueChanged="@HandleValueChanged"
                ValueExpression="@ResolvedValueExpression"
                Options="@Options"
                Id="@Id"
                Name="@Name"
                Placeholder="@Placeholder"
                EmptyText="@EmptyText"
                Clearable="@Clearable"
                ClearLabel="@Placeholder"
                ClearAriaLabel="@ResolvedClearAriaLabel" />
        }
        else
        {
            <SiteNativeSelect class="form-select" Id="@Id" Name="@Name">
                @foreach (var option in Options)
                {
                    <option value="@option.Value"
                        selected="@(option.Value.Equals(Value, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@option.Label</option>
                }
            </SiteNativeSelect>
        }
    </div>
</SiteFormField>
