@inherits ContentPageBase
@page "/knowledge-map"
@page "/pt-BR/knowledge-map"
@using System.Text.Json
@using Blog.Blazor.Core
@inject IPublicKnowledgeGraphProvider GraphProvider

<PageTitle>@PageField("knowledge-map", "title", Title)</PageTitle>
<SeoHead Title="@SeoTitle" Description="@SeoDescription" CanonicalPath="@CanonicalPath" />

<SitePage Template="knowledge-map">
    <SiteBreadcrumb HomeUrl="@(L[""])"
        HomeLabel="@(L["home"])"
        Links="@BreadcrumbLinks"
        CurrentLabel="@CrumbLabel("knowledge-map", L["knowledge_map"])" />
    @if (Snapshot is null || Graph is null)
    {
        <SiteHero Title="@LoadingLabel" Lead="@Description" />
    }
    else
    {
        <SiteHero Title="@SeoTitle"
            Lead="@PageField("knowledge-map", "intro", Description)"/>
        @if (Graph.Nodes.Count == 0) { <SiteEmptyState Message="@EmptyLabel" /> }
        else
        {
            <SiteSection Region="graph"
                HeadingId="knowledge-map-heading"
                Title="@VisualizationLabel"
                Class="knowledge-map-panel"><SiteText Class="content-tags">@Graph.Nodes.Count @NodesLabel · @Graph.Edges.Count @EdgesLabel</SiteText>
                    <SiteKnowledgeMap GraphJson="@GraphJson"
                        HeadingId="knowledge-map-heading"
                        Description="@Description"
                        LegendLabel="@LegendLabel"
                        PanelEmptyLabel="@PanelEmptyLabel"
                        PanelOpenLabel="@PanelOpenLabel"
                        ResetViewLabel="@ResetViewLabel"
                        NoResultsLabel="@NoResultsLabel"
                        ExpandViewLabel="@ExpandViewLabel"
                        CollapseViewLabel="@CollapseViewLabel" />
                </SiteSection>
            <SiteSection Region="text-fallback"
                HeadingId="knowledge-map-fallback-heading"
                Title="@TextFallbackLabel">
                @foreach (var group in Graph.Nodes.GroupBy(node => node.Kind))
                {
                    <SiteText Variant="SiteTextVariant.SectionLabel">@(Graph.Kinds.TryGetValue(group.Key, out var kind) ? kind.Label : group.Key)</SiteText>
                    <SiteChipGroup Class="mb-3">@foreach (var node in group) { <SiteChip Label="@node.Label" Href="@(string.IsNullOrWhiteSpace(node.Url) ? null : LocalizedUrl(node.Url))" /> }</SiteChipGroup>
                }
            </SiteSection>
            <SiteSection Region="relations"
                HeadingId="knowledge-map-relations-heading"
                Title="@RelationsLabel">
                @if (Graph.Edges.Count == 0)
                {
                    <SiteText Class="text-body-secondary">@NoRelationsLabel</SiteText>
                }
                else
                {
                    <SiteStack Gap="SiteSpace.Sm">
                        @foreach (var edge in Graph.Edges)
                        {
                            var source = Graph.Nodes.FirstOrDefault(node => node.Id == edge.Source);
                            var target = Graph.Nodes.FirstOrDefault(node => node.Id == edge.Target);
                            if (source is not null && target is not null)
                            {
                                <SiteRelationshipItem>
                                    <SiteChip Label="@source.Label"
                                        Href="@(string.IsNullOrWhiteSpace(source.Url) ? null : LocalizedUrl(source.Url))" />
                                    <SiteText Variant="SiteTextVariant.Meta">· @edge.Label ·</SiteText>
                                    <SiteChip Label="@target.Label"
                                        Href="@(string.IsNullOrWhiteSpace(target.Url) ? null : LocalizedUrl(target.Url))" />
                                </SiteRelationshipItem>
                            }
                        }
                    </SiteStack>
                }
            </SiteSection>
        }
    }
</SitePage>
