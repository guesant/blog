@inherits LocalizedComponentBase
@page "/tools/random-number-generator"
@page "/pt-BR/tools/random-number-generator"
@using System.Globalization
@using Portfolio.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action"
        SubmitLabel="@GenerateLabel"
        Submit="SiteToolFormSubmit.Always"
        OnSubmit="Generate"
        AriaLabel="@MinLabel">
        <SiteFormField Label="@MinLabel"
            For="random-min"><SiteInput Id="random-min"
                Name="min"
                Type="number"
                step="any"
                Value="@MinText"
                ValueChanged="@(v => MinText = v)" /></SiteFormField>
        <SiteFormField Label="@MaxLabel"
            For="random-max"><SiteInput Id="random-max"
                Name="max"
                Type="number"
                step="any"
                Value="@MaxText"
                ValueChanged="@(v => MaxText = v)" /></SiteFormField>
        <SiteFormField Label="@CountLabel"
            For="random-count"><SiteInput Id="random-count"
                Name="count"
                Type="number"
                min="1"
                max="50"
                Value="@CountText"
                ValueChanged="@(v => CountText = v)" /></SiteFormField>
        @if (RendererInfo.IsInteractive)
        {
            <SiteFormActions>
                <SiteButton Variant="SiteButtonVariant.Default"
                    aria-pressed="@(Mode == "integer")"
                    @onclick="SetInteger">@IntegerLabel</SiteButton>
                <SiteButton Variant="SiteButtonVariant.Default"
                    aria-pressed="@(Mode == "decimal")"
                    @onclick="SetDecimal">@DecimalLabel</SiteButton>
                <SiteCheckbox Label="@NoDuplicatesLabel"
                    Value="@NoDuplicates"
                    ValueChanged="@(v => NoDuplicates = v)"
                    Disabled="@(Mode != "integer")" />
            </SiteFormActions>
        }
        else
        {
            <SiteFormField Label="@ModeLabel"
                For="random-mode"><SiteNativeSelect Id="random-mode"
                    Name="mode"><option value="integer"
                        selected="@(Mode == "integer")">@IntegerLabel</option>
                            <option value="decimal"
                            selected="@(Mode == "decimal")">@DecimalLabel</option>
                            </SiteNativeSelect>
                            </SiteFormField>
            <SiteCheckbox Label="@NoDuplicatesLabel"
                Name="unique"
                Value="@NoDuplicates"
                HtmlValue="true" />
        }
    </SiteToolForm>
    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (Result.Error is not null) { <SiteErrorMessage>@ErrorLabel</SiteErrorMessage> }
        @if (Result.Note is not null) { <SiteErrorMessage Role="status">@Result.Note</SiteErrorMessage> }
        <SiteCard Class="site-block" Label="@ResultLabel">
            <SiteList>@foreach (var value in Result.Values) { <SiteListItem Class="list-group-item site-list-row d-flex flex-wrap justify-content-between align-items-start tool-list-item">
                <SiteText Variant="SiteTextVariant.Meta" Class="tool-list-value">@value</SiteText>
            </SiteListItem> }</SiteList>
        </SiteCard>
    </SiteLiveRegion>
</ToolPage>
