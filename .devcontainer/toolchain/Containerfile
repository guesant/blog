FROM debian:bookworm-slim AS base

ARG TARGETARCH
ARG HERMIT_VERSION=0.52.3
ARG HERMIT_SHA256_AMD64=006ad4201d0df178a0b856d50cd2304379e24a532883602dba0333e15f0e92e8
ARG HERMIT_SHA256_ARM64=0673dd0a1c136901e972f88afd57e4b342c561479a9cc93cfa0891a86a0fea76

ENV HOME=/tmp/portfolio-home
ENV PATH=/usr/local/hermit:/workspace/.config/hermit/bin:/workspace/node_modules/.bin:$PATH
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV COREPACK_ENABLE_NETWORK=0
ENV MOON_TELEMETRY=0
ENV MOON_TOOLCHAIN_FORCE_GLOBALS=true

COPY tools/toolchain/ /tmp/toolchain-packages/

RUN bash /tmp/toolchain-packages/install-packages.sh /tmp/toolchain-packages/packages-base.txt \
    && rm -rf /var/lib/apt/lists/* \
    && case "$TARGETARCH" in \
         amd64) hermit_arch=amd64; hermit_sha="$HERMIT_SHA256_AMD64" ;; \
         arm64) hermit_arch=arm64; hermit_sha="$HERMIT_SHA256_ARM64" ;; \
         *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
       esac \
    && mkdir -p /usr/local/hermit /workspace /tmp/portfolio-home \
    && curl --fail --location --show-error \
         "https://github.com/cashapp/hermit/releases/download/v${HERMIT_VERSION}/hermit-linux-${hermit_arch}.gz" \
         --output /tmp/hermit.gz \
    && echo "${hermit_sha}  /tmp/hermit.gz" | sha256sum --check --strict \
    && gzip --decompress --stdout /tmp/hermit.gz > /usr/local/hermit/hermit \
    && chmod 0755 /usr/local/hermit/hermit \
    && rm /tmp/hermit.gz \
    && chmod 0777 /tmp/portfolio-home

WORKDIR /workspace
COPY .devcontainer/toolchain/container-entrypoint.sh /usr/local/bin/portfolio-entrypoint
RUN chmod 0755 /usr/local/bin/portfolio-entrypoint

# trivy:ignore:AVD-DS-0002
USER root

ENTRYPOINT ["/usr/local/bin/portfolio-entrypoint"]

FROM base AS fonts

RUN bash /tmp/toolchain-packages/install-packages.sh /tmp/toolchain-packages/packages-fonts.txt \
    && rm -rf /var/lib/apt/lists/*

FROM fonts AS browser

RUN bash /tmp/toolchain-packages/install-packages.sh /tmp/toolchain-packages/packages-browser.txt \
    && rm -rf /var/lib/apt/lists/*
