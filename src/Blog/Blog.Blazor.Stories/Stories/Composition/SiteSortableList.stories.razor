@attribute [Stories("Composition/SiteSortableList")]

<Stories TComponent="SiteSortableList<string>">

    <Story Name="Default">
        <Template>
            <SiteStack Gap="SiteSpace.Md">
                <SiteSortableList TItem="string"
                    Items="@_items"
                    AriaLabel="fruits"
                    OnReordered="@(_ => _moves++)">
                    <ItemTemplate Context="item"><SiteText Variant="SiteTextVariant.Small">@item</SiteText></ItemTemplate>
                </SiteSortableList>
                <SiteText Variant="SiteTextVariant.Meta"
                    data-sortable-state>@string.Join(" > ", _items) (@_moves moves)</SiteText>
            </SiteStack>
        </Template>
    </Story>

</Stories>
