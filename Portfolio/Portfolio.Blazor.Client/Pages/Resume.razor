@inherits ContentPageBase
@page "/resume"
@page "/pt-BR/resume"
@using System.Text.Json
@using Portfolio.Blazor.Core
@using Portfolio.Blazor.Core.Localization

<PageTitle>@Title</PageTitle>
<SeoHead Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath" />

<SitePage Template="resume">
    <SiteBreadcrumb HomeUrl="@(L["legacy_0607643fd42c"])"
        HomeLabel="@(L["legacy_ddc150008e2f"])"
        CurrentLabel="@Title" />
    <SiteHero Title="@(Snapshot?.Chrome.Profile?.Name ?? Title)"
        Lead="@Snapshot?.Chrome.Profile?.Title">
        <ChildContent>
            @if (!string.IsNullOrWhiteSpace(Snapshot?.Chrome.Profile?.Location))
            {
                <SiteText Variant="SiteTextVariant.Meta">
                    <SiteIcon Name="map-pin"
                        Size="12" />@Snapshot.Chrome.Profile.Location</SiteText>
            }
            <ContactChannels Profiles="@(Snapshot?.Chrome.Site.ContactProfiles ?? [])"
                EmailChallenge="@Snapshot?.Chrome.Site.ProtectedEmail"
                EmailAvailable="@(Snapshot?.Chrome.Site.ContactAvailable == true)"
                Justify="SiteJustify.Center">
                <LeadingContent>
                    @foreach (var locale in ResumePdfLocales)
                    {
                        <SiteLink Variant="SiteButtonVariant.Outline"
                            Class="footer-action"
                            Href="@($"/storage/resume-{locale}.pdf")"
                            target="_blank"
                            rel="noopener"><SiteIcon Name="file-user"
                                Size="14" />@(L["legacy_01e8c335fb9e"]) (@PdfLabel(locale))<SiteIcon Name="external-link"
                                Size="12"
                                Class="icon icon-trailing" /></SiteLink>
                    }
                </LeadingContent>
            </ContactChannels>
        </ChildContent>
    </SiteHero>
    @if (!string.IsNullOrWhiteSpace(Field("summary")))
    {
        <SiteSection Icon="file-text" Region="summary"
            HeadingId="resume-summary-heading"
            Label="@(L["legacy_bda2b99b0c58"])"
            Title="@(L["legacy_ae8191ae0f53"])"><SiteText>@Field("summary")</SiteText>
            </SiteSection>
    }
    @if (VisibleRows("leadership").Count > 0)
    {
        <SiteSection Icon="users" Region="leadership"
            HeadingId="resume-leadership-heading"
            Label="@(L["legacy_470bf8aa72bb"])"
            Title="@(L["legacy_470bf8aa72bb"])">@Rows("leadership", "organization", "role")</SiteSection>
    }
    @if (VisibleRows("experience").Count > 0)
    {
        <SiteSection Icon="briefcase" Region="experience"
            HeadingId="resume-experience-heading"
            Label="@(L["legacy_8993804db56b"])"
            Title="@(L["legacy_951f183af8fe"])">@Rows("experience", "role", "organization")</SiteSection>
    }
    @if (SelectedCases.Count > 0)
    {
        <SiteSection Icon="star" Region="selected-work"
            HeadingId="resume-selected-work-heading"
            Label="@(L["legacy_94f205b8bbf6"])"
            Title="@(L["legacy_66c1052a2845"])">
            <SiteGrid>@{ var selectedNumber = 0; }@foreach (var item in SelectedCases) { selectedNumber++; <SiteGridColumn>
                <SiteClickableCard Label="@SelectedCaseMeta(item, selectedNumber)"
                    Class="h-100"
                    Href="@item.Url"
                    Title="@item.Title"
                    TitleClass="h5"
                    HeadingLevel="3">@if (!string.IsNullOrWhiteSpace(item.Summary)) { <SiteText Variant="SiteTextVariant.Excerpt">@item.Summary</SiteText> }</SiteClickableCard>
            </SiteGridColumn> }</SiteGrid>
        </SiteSection>
    }
    @if (Skills.Count > 0)
    {
        <SiteSection Icon="wrench" Region="skills"
            HeadingId="resume-skills-heading"
            Label="@(L["legacy_46c1b8b49845"])"
            Title="@(L["legacy_46c1b8b49845"])">
            <SiteGrid>@foreach (var skill in Skills) { <SiteGridColumn>
                <SiteCard Icon="wrench" Label="@skill.Name" Class="h-100">
                    <SiteChipGroup>@foreach (var technology in skill.Technologies) { <SiteChip Label="@technology.Name" Href="@LocalizedTechnologyUrl(technology)" /> }</SiteChipGroup>
                </SiteCard>
            </SiteGridColumn> }</SiteGrid>
        </SiteSection>
    }
    @if (VisibleRows("education").Count > 0)
    {
        <SiteSection Icon="graduation-cap" Region="education"
            HeadingId="resume-education-heading"
            Label="@(L["legacy_973379a72edb"])"
            Title="@(L["legacy_d575647144c5"])">@Rows("education", "institution", "degree")</SiteSection>
    }
    @if (Languages.Count > 0)
    {
        <SiteSection Icon="languages" Region="languages"
            HeadingId="resume-languages-heading"
            Label="@(L["legacy_0b432361f026"])"
            Title="@(L["legacy_2ac4037fa927"])">
            <SiteGrid>@foreach (var language in Languages) { <SiteGridColumn>
                <SiteCard Icon="languages" Label="@language.Proficiency"
                    Class="h-100"><SiteHeading Level="3" Visual="5">@language.Name</SiteHeading>
                    </SiteCard>
            </SiteGridColumn> }</SiteGrid>
        </SiteSection>
    }
</SitePage>
