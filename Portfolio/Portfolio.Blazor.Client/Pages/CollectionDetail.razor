@inherits ContentPageBase
@page "/collections/{Slug}"
@page "/pt-BR/collections/{Slug}"
@using Microsoft.AspNetCore.Components
@using Portfolio.Blazor.Core

<PageTitle>@Title</PageTitle>
<SeoHead Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath" />

<SitePage Template="collection-detail">
    <SiteBreadcrumb HomeUrl="@LocalizedPath("home")"
        HomeLabel="@(L["legacy_8eec0169bc59"])"
        Links="@BreadcrumbLinks"
        CurrentLabel="@Title" />

    @if (Snapshot is null)
    {
        <SiteHero Title="@LoadingLabel" />
    }
    else if (Collection is null)
    {
        <SiteHero Title="@NotFoundLabel"
            Lead="@NotFoundDescription"><ChildContent>
                <SiteLink Variant="SiteButtonVariant.Outline" Href="@IndexUrl">
                    <SiteIcon Name="arrow-left" Size="14" />@BackLabel</SiteLink>
                </ChildContent>
            </SiteHero>
    }
    else
    {
        <SiteHero Title="@Collection.Title"
            Lead="@Collection.Description"
            BackHref="@IndexUrl"
            BackLabel="@BackLabel">
            <PublishedUpdatedMeta PublishedAt="@Collection.PublishedAt"
                UpdatedAt="@Collection.UpdatedAt" />
        </SiteHero>

        @if (!string.IsNullOrWhiteSpace(Collection.Intro))
        {
            <SiteRichText Html="@((MarkupString)MarkdownRenderer.ToHtml(Collection.Intro))"
                Region="intro" />
        }

        @if (Collection.Resources is not { Count: > 0 })
        {
            <SiteEmptyState Message="@EmptyLabel" />
        }
        else
        {
            <SiteSection Region="resource-list"
                HeadingId="collection-items-heading"
                Title="@ItemsLabel">
                <SiteGrid>
                    @foreach (var item in Collection.Resources)
                    {
                        <SiteGridColumn>
                            <SiteClickableCard Label="@JoinMeta(TypeName(item.Type), RatingName(item.Rating))"
                                Class="h-100"
                                Href="@LocalizedUrl(item.Url)"
                                Title="@item.Title"
                                TitleClass="h5"
                                HeadingLevel="3">
                                @if (!string.IsNullOrWhiteSpace(item.Description)) { <SiteText Variant="SiteTextVariant.Excerpt">@item.Description</SiteText> }
                                @if (item.Topics is { Count: > 0 }) { <SiteChipGroup>@foreach (var topic in item.Topics.Take(3)) { <SiteChip Label="@(topic.Name ?? topic.Slug)" /> }</SiteChipGroup> }
                                @if (!string.IsNullOrWhiteSpace(item.Note)) { <SiteText Variant="SiteTextVariant.Meta">@item.Note</SiteText> }
                            </SiteClickableCard>
                        </SiteGridColumn>
                    }
                </SiteGrid>
            </SiteSection>
        }

        <ContentActions Title="@Collection.Title"
            Url="@CanonicalPath"
            Body="@(Collection.Intro ?? Collection.Description ?? string.Empty)" />
        <ContentRelations CurrentUrl="@CanonicalPath" />
        <RelatedContent Items="@Collection.Related" />
    }
</SitePage>
