<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BlazorBlueprint.Components" Version="3.16.0" />
    <ProjectReference Include="..\Blog.Blazor.Client\Blog.Blazor.Client.csproj" />
    <ProjectReference Include="..\Blog.Blazor.Core\Blog.Blazor.Core.csproj" />
    <ProjectReference Include="..\Blog.Blazor.UI\Blog.Blazor.UI.csproj" />
    <PackageReference
      Include="Microsoft.AspNetCore.Components.WebAssembly.Server"
      Version="10.0.11"
    />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 depends on EF Core 10.0.4; pinned
         explicitly to the 10.0.11 the rest of the SDK ships, matching Microsoft.EntityFrameworkCore.Design
         in Blog.Blazor.Database, or the runtime fails loading a mismatched assembly version. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Konscious.Security.Cryptography.Blake2" Version="1.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Components" />
    <Using Include="System.Net.Http.Json" />
    <Using Include="Microsoft.AspNetCore.Components.Forms" />
    <Using Include="Microsoft.AspNetCore.Components.Routing" />
    <Using Include="Microsoft.AspNetCore.Components.Web" />
    <Using Include="Microsoft.AspNetCore.Components.Web.Virtualization" />
    <Using Include="Microsoft.JSInterop" />
    <Using Include="Microsoft.EntityFrameworkCore" />
    <Using Include="Blog.Blazor" />
    <Using Include="Blog.Blazor.Client" />
    <Using Include="Blog.Blazor.Client.Shared" />
    <Using Include="Blog.Blazor.Components" />
    <Using Include="Blog.Blazor.Core" />
    <Using Include="Blog.Blazor.Data" />
    <Using Include="Blog.Blazor.Data.Entities" />
    <Using Include="Blog.Blazor.UI" />
    <Using Include="Blog.Blazor.UI.Foundations" />
    <Using Include="Blog.Blazor.UI.Primitives" />
    <Using Include="Blog.Blazor.UI.Layout" />
    <Using Include="Blog.Blazor.UI.Forms" />
    <Using Include="Blog.Blazor.UI.DataDisplay" />
    <Using Include="Blog.Blazor.UI.Feedback" />
    <Using Include="Blog.Blazor.UI.Navigation" />
    <Using Include="Blog.Blazor.UI.Composition" />
    <Using Include="Blog.Blazor.UI.Templates" />
    <Using Include="Blog.Blazor.Components.Admin.Shared" />
    <Using Include="BlazorBlueprint.Primitives.Services" />
    <Using Include="Microsoft.AspNetCore.Components.Web.RenderMode" Static="true" />
  </ItemGroup>
</Project>
