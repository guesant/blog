@inherits LocalizedComponentBase
@page "/tools/qr-code-generator"
@page "/pt-BR/tools/qr-code-generator"
@using Microsoft.JSInterop
@using Portfolio.Blazor.Core
@inject IJSRuntime JS

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action" SubmitLabel="@GenerateLabel" AriaLabel="@InputLabel">
        <SiteFormField Label="@InputLabel"
            For="qr-input"><SiteTextAreaInput Id="qr-input"
                Name="input"
                Class="tool-textarea"
                Rows="3"
                spellcheck="false"
                Value="@Input"
                ValueChanged="@(v => Input = v)" /></SiteFormField>
    </SiteToolForm>
    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (!string.IsNullOrEmpty(Input) && !Result.IsValid) { <SiteErrorMessage>@InvalidLabel</SiteErrorMessage> }
        @if (Result.IsValid) { <SiteCard Class="site-block" Label="@DownloadLabel">
            <SiteStack Class="tool-qr-preview"
                aria-label="@(L["qr_code"])">@((MarkupString)Result.Svg)</SiteStack>@if (RendererInfo.IsInteractive) { <SiteButton Variant="SiteButtonVariant.Default"
                    Class="tool-action-btn"
                    @onclick="DownloadAsync"><SiteIcon Name="download"
                        Size="14" />@DownloadLabel</SiteButton> } else { <SiteLink Variant="SiteButtonVariant.Default"
                        Class="tool-action-btn"
                        download="qr-code.svg"
                        Href="@DownloadHref"><SiteIcon Name="download"
                            Size="14" />@DownloadLabel</SiteLink> }</SiteCard> }
    </SiteLiveRegion>
</ToolPage>
