<div class="form-text" id="@($"{Context.Id}-help")" data-slot="field-description">
    @ChildContent
</div>

@code {
    [CascadingParameter]
    private SiteFieldContext Context { get; set; } = default!;
    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;
}
