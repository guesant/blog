@inherits LocalizedComponentBase
@page "/tools/nato-phonetic-alphabet"
@page "/pt-BR/tools/nato-phonetic-alphabet"
@using Portfolio.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action" SubmitLabel="@ConvertLabel" AriaLabel="@AlphabetLabel">
        <SiteFormField Label="@AlphabetLabel" For="phonetic-alphabet">
            <SiteSelect @bind-Value="Alphabet"
                Options="@AlphabetOptions"
                Id="phonetic-alphabet"
                Name="alphabet"
                Placeholder="@AlphabetLabel"
                EmptyText="@AlphabetLabel" />
        </SiteFormField>
        <SiteFormField Label="@InputLabel" For="phonetic-input">
            <SiteTextAreaInput Id="phonetic-input"
                Name="input"
                Rows="6"
                Value="@Input"
                ValueChanged="@(v => Input = v)" />
        </SiteFormField>
    </SiteToolForm>
    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        <SiteOutputField Id="phonetic-output"
            Label="@OutputLabel"
            Value="@Output"
            Multiline="true"
            CopyLabel="@CopyLabel" />
    </SiteLiveRegion>
</ToolPage>
