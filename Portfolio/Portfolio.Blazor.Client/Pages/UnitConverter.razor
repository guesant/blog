@inherits LocalizedComponentBase
@page "/tools/unit-converter"
@page "/pt-BR/tools/unit-converter"
@using Portfolio.Blazor.Core
<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
<SiteCard Class="site-block" Label="@Title">
    <SiteFormActions>@foreach(var c in Categories){<SiteButton Variant="@(Category==c.Id ? SiteButtonVariant.Default : SiteButtonVariant.Secondary)" OnClick="()=>SelectCategory(c.Id)">@c.Label</SiteButton>}</SiteFormActions>
    <SiteFormActions>
        <SiteFormField Label="@ValueLabel"
            For="unit-value"><SiteNumberInput TValue="double"
                id="unit-value"
                @bind-Value="Value"
                Step="0.01" />
            </SiteFormField>
            <SiteFormField Label="@FromLabel"
                For="unit-from"><SiteSelect @bind-Value="From"
                    Options="@UnitSelectOptions"
                    Id="unit-from"
                    Placeholder="@FromLabel"
                    EmptyText="@FromLabel" /></SiteFormField>
                <SiteFormField Label="@ToLabel"
                    For="unit-to"><SiteSelect @bind-Value="To"
                        Options="@UnitSelectOptions"
                        Id="unit-to"
                        Placeholder="@ToLabel"
                        EmptyText="@ToLabel" /></SiteFormField>
            </SiteFormActions>
    <SiteMetricCard Label="@Title">
        <SiteText Variant="SiteTextVariant.MetricValue"
            Class="tool-result-value">@ResultText</SiteText>
    </SiteMetricCard>
</SiteCard>
</ToolPage>
