@inherits LocalizedComponentBase
@implements IDisposable
@page "/tools/csv-chart"
@page "/pt-BR/tools/csv-chart"
@using System.Globalization
@using Portfolio.Blazor.Core
@using Microsoft.JSInterop
@inject IJSRuntime JS

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action"
        SubmitLabel="@SubmitLabel"
        Submit="SiteToolFormSubmit.StaticOnly"
        OnSubmit="Calculate">
        <SiteFormField Label="@InputLabel"
            For="csv-chart-input"><SiteTextAreaInput Id="csv-chart-input"
                Name="csv"
                Value="@CsvText"
                ValueChanged="@(v => CsvText = v)" /></SiteFormField>
        <SiteFormField Label="@DelimiterLabel" For="csv-chart-delimiter">
            <SiteSelect @bind-Value="DelimiterText"
                Options="@DelimiterOptions"
                Id="csv-chart-delimiter"
                Name="delimiter"
                Placeholder="@DelimiterLabel"
                EmptyText="@DelimiterLabel" />
        </SiteFormField>
        <SiteFormField Label="@ChartTypeLabel" For="csv-chart-type">
            <SiteSelect @bind-Value="ChartTypeText"
                Options="@ChartTypeOptions"
                Id="csv-chart-type"
                Name="type"
                Placeholder="@ChartTypeLabel"
                EmptyText="@ChartTypeLabel" />
        </SiteFormField>
        <SiteFormField Label="@XLabel" For="csv-chart-x">
            <SiteSelect @bind-Value="XIndexText"
                Options="@ColumnOptions"
                Id="csv-chart-x"
                Name="x"
                Placeholder="@XLabel"
                EmptyText="@XLabel" />
        </SiteFormField>
        <SiteFormField Label="@YLabel" For="csv-chart-y">
            <SiteSelect @bind-Value="YIndexText"
                Options="@ColumnOptions"
                Id="csv-chart-y"
                Name="y"
                Placeholder="@YLabel"
                EmptyText="@YLabel" />
        </SiteFormField>
        <SiteFormField Label="@FilterLabel"
            For="csv-chart-filter"><SiteInput Id="csv-chart-filter"
                Name="filter"
                Type="search"
                Value="@FilterText"
                ValueChanged="@(v => FilterText = v)" /></SiteFormField>
    </SiteToolForm>
    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (!Result.IsValid)
        {
            <SiteErrorMessage>@ErrorLabel</SiteErrorMessage>
        }
        else
        {
            <SiteCard Class="site-block" Label="@($"{Result.XLabel} · {Result.YLabel}")">
                <SiteText>@CountText · @SummaryText</SiteText>
                @if (RendererInfo.IsInteractive)
                {
                    <SiteChart Id="csv-chart-canvas-host"
                        ChartJsConfig="@ChartConfig"
                        AriaLabel="@($"{Result.XLabel} · {Result.YLabel}")" />
                    <SiteText>
                        <SiteButton Variant="SiteButtonVariant.Outline" OnClick="ExportPng">
                            <SiteIcon Name="file-down" Size="14" />@ExportPngLabel</SiteButton>
                        </SiteText>
                }
                else
                {
                    <SiteList Variant="SiteListVariant.Boxed"
                        Id="csv-chart-description">@foreach (var point in Result.Points) { <SiteListItem Class="site-text-list-item">@point.Label: @point.Y.ToString("G8", CultureInfo.InvariantCulture)</SiteListItem> }</SiteList>
                }
                <SiteTable Caption="@TableLabel" TableClass="table table-sm table-striped">
                    <thead>
                        <tr>@foreach (var header in Result.Headers) { <th scope="col">@header</th> }</tr>
                    </thead>
                    <tbody>@foreach (var row in Result.TableRows.Take(500)) { <tr>@foreach (var cell in row) { <td>@cell</td> } </tr> }</tbody>
                </SiteTable>
            </SiteCard>
        }
    </SiteLiveRegion>
</ToolPage>
