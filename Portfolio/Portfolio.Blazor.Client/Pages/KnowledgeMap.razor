@inherits LocalizedComponentBase
@page "/knowledge-map"
@page "/pt-BR/knowledge-map"
@using System.Text.Json
@using Portfolio.Blazor.Core
@inject IPublicKnowledgeGraphProvider GraphProvider
@inject IPublicSiteContentProvider ContentProvider

<PageTitle>@PageField("knowledge-map", "title", Title)</PageTitle>
<SeoHead Title="@SeoTitle" Description="@SeoDescription" CanonicalPath="@CanonicalPath" />

<SitePage Template="knowledge-map">
    <SiteBreadcrumb HomeUrl="@(L["legacy_0607643fd42c"])"
        HomeLabel="@(L["legacy_ddc150008e2f"])"
        Links="@BreadcrumbLinks"
        CurrentLabel="@Title" />
    @if (Snapshot is null || Graph is null)
    {
        <SiteHero Title="@LoadingLabel" Lead="@Description" />
    }
    else
    {
        <SiteHero Title="@SeoTitle"
            Lead="@PageField("knowledge-map", "intro", Description)"
            BackHref="@LocalizedUrl("/topics")"
            BackLabel="@(L["legacy_4ab0be41630a"])" />
        @if (Graph.Nodes.Count == 0) { <SiteEmptyState Message="@EmptyLabel" /> }
        else
        {
            <SiteSection Region="graph"
                HeadingId="knowledge-map-heading"
                Title="@VisualizationLabel"
                Class="knowledge-map-panel"><SiteText Class="content-tags">@Graph.Nodes.Count @NodesLabel · @Graph.Edges.Count @EdgesLabel</SiteText>
                    <SiteKnowledgeMap GraphJson="@GraphJson"
                        HeadingId="knowledge-map-heading"
                        Description="@Description"
                        LegendLabel="@LegendLabel"
                        PanelEmptyLabel="@PanelEmptyLabel"
                        PanelOpenLabel="@PanelOpenLabel"
                        ResetViewLabel="@ResetViewLabel"
                        NoResultsLabel="@NoResultsLabel"
                        ExpandViewLabel="@ExpandViewLabel"
                        CollapseViewLabel="@CollapseViewLabel" />
                </SiteSection>
            <SiteSection Region="text-fallback"
                HeadingId="knowledge-map-fallback-heading"
                Title="@TextFallbackLabel">
                @foreach (var group in Graph.Nodes.GroupBy(node => node.Kind))
                {
                    <SiteText Variant="SiteTextVariant.SectionLabel">@(Graph.Kinds.TryGetValue(group.Key, out var kind) ? kind.Label : group.Key)</SiteText>
                    <SiteChipGroup Class="mb-3">@foreach (var node in group) { <SiteChip Label="@node.Label" Href="@(string.IsNullOrWhiteSpace(node.Url) ? null : LocalizedUrl(node.Url))" /> }</SiteChipGroup>
                }
            </SiteSection>
            <SiteSection Region="relations"
                HeadingId="knowledge-map-relations-heading"
                Title="@RelationsLabel">
                @if (Graph.Edges.Count == 0)
                {
                    <SiteText Class="text-body-secondary">@NoRelationsLabel</SiteText>
                }
                else
                {
                    <SiteStack Gap="SiteSpace.Sm">
                        @foreach (var edge in Graph.Edges)
                        {
                            var source = Graph.Nodes.FirstOrDefault(node => node.Id == edge.Source);
                            var target = Graph.Nodes.FirstOrDefault(node => node.Id == edge.Target);
                            if (source is not null && target is not null)
                            {
                                <SiteRelationshipItem>
                                    <SiteChip Label="@source.Label"
                                        Href="@(string.IsNullOrWhiteSpace(source.Url) ? null : LocalizedUrl(source.Url))" />
                                    <SiteText Variant="SiteTextVariant.Meta">· @edge.Label ·</SiteText>
                                    <SiteChip Label="@target.Label"
                                        Href="@(string.IsNullOrWhiteSpace(target.Url) ? null : LocalizedUrl(target.Url))" />
                                </SiteRelationshipItem>
                            }
                        }
                    </SiteStack>
                }
            </SiteSection>
        }
    }
</SitePage>

@code {
    private PublicSiteSnapshot? Snapshot { get; set; }
    private PublicKnowledgeGraph? Graph { get; set; }
    private string Title => L["legacy_34a684f24942"];
    private string Description => L["legacy_0b5e5b9a5c97"];
    private string LoadingLabel => L["legacy_4766510b3100"];
    private string EmptyLabel => L["legacy_561b86366712"];
    private string VisualizationLabel => L["legacy_b071db3768f3"];
    private string TextFallbackLabel => L["legacy_fa4d8af51616"];
    private string RelationsLabel => L["legacy_34bb1362b84e"];
    private string NoRelationsLabel => L["legacy_1b8728f370cc"];
    private string NodesLabel => L["legacy_6d8a2f5c1bb2"];
    private string EdgesLabel => L["legacy_34bb1362b84e"];
    private string LegendLabel => L["knowledge_map_legend_label"];
    private string PanelEmptyLabel => L["knowledge_map_panel_empty_label"];
    private string PanelOpenLabel => L["knowledge_map_panel_open_label"];
    private string ResetViewLabel => L["knowledge_map_reset_view"];
    private string NoResultsLabel => L["knowledge_map_no_results"];
    private string ExpandViewLabel => L["knowledge_map_expand_view"];
    private string CollapseViewLabel => L["knowledge_map_collapse_view"];
    private string SeoTitle => PageField("knowledge-map", "title", Title);
    private string SeoDescription => PageField("knowledge-map", "description", Description);
    private string CanonicalPath => L["legacy_aee5ff166ae8"];
    private string GraphJson => JsonSerializer.Serialize(new { nodes = Graph?.Nodes.Select(node => new { data = new { id = node.Id, label = node.Label, kind = node.Kind, url = LocalizedUrl(node.Url) } }), edges = Graph?.Edges.Select(edge => new { data = new { id = $"{edge.Source}-{edge.Target}-{edge.RelationType}", source = edge.Source, target = edge.Target, label = edge.Label, relationType = edge.RelationType } }), kinds = Graph?.Kinds.ToDictionary(pair => pair.Key, pair => new { label = pair.Value.Label, color = pair.Value.Color }) });
    private IReadOnlyList<BreadcrumbLink> BreadcrumbLinks => [new(
        L["legacy_4ab0be41630a"],
        LocalizedUrl("/topics")
    )];
    protected override async Task OnInitializedAsync()
    {
        var locale = CurrentLocale;
        Snapshot = await ContentProvider.GetAsync(locale);
        Graph = await GraphProvider.GetAsync(locale);
    }
    private string PageField(
        string page,
        string field,
        string fallback
    ) { if (Snapshot?.Pages.TryGetValue(
        page,
        out var fields
    ) != true || fields.ValueKind != JsonValueKind.Object || !fields.TryGetProperty(field, out var value)) return fallback; return value.GetString() ?? fallback; }
    private string LocalizedUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return "#";
        var path = url.StartsWith(
            "/",
            StringComparison.Ordinal
        ) ? url : Uri.TryCreate(url, UriKind.Absolute, out var absolute) ? absolute.AbsolutePath : "#";
        return LocalizedUrls.Current(path);
    }
}
