@typeparam TItem

<SiteStack Gap="SiteSpace.Sm" Class="site-entity-checklist" data-slot="entity-checklist">
    @if (!string.IsNullOrWhiteSpace(Legend))
    {
        <SiteText Variant="SiteTextVariant.SectionLabel">@Legend</SiteText>
    }
    <SiteInline Gap="SiteSpace.Sm"
        Align="SiteAlign.Center"
        Wrap="false"
        Class="site-entity-checklist-add">
        <SiteSelect @bind-Value="_pending"
            Options="@AvailableOptions"
            Placeholder="@SearchPlaceholder"
            SearchPlaceholder="@SearchPlaceholder"
            EmptyText="@EmptyText(string.Empty)"
            PageSize="@PageSize"
            aria-label="@(Legend ?? SearchPlaceholder)" />
        <SiteButton Variant="SiteButtonVariant.Outline"
            Disabled="@(string.IsNullOrEmpty(_pending))"
            aria-label="@AddLabel"
            OnClick="HandleAddAsync"><SiteIcon Name="plus" Size="14" />@AddLabel</SiteButton>
    </SiteInline>
    @if (LinkedItems.Count == 0)
    {
        <SiteText Variant="SiteTextVariant.Small">@EmptyLinkedText</SiteText>
    }
    else
    {
        <SiteList Variant="SiteListVariant.Surface" AriaLabel="@(Legend ?? SearchPlaceholder)">
            @foreach (var item in LinkedItems)
            {
                var key = Key(item);
                <SiteListItem @key="key">
                    <SiteSplit Gap="SiteSpace.Sm">
                        <Start>
                            <SiteText Variant="SiteTextVariant.Small">@Label(item)</SiteText>
                        </Start>
                        <End>
                            <SiteButton Variant="SiteButtonVariant.Outline"
                            Size="SiteButtonSize.IconSm"
                            aria-label="@($"{RemoveLabel} {Label(item)}")"
                            OnClick="@(() => HandleToggleAsync(key, false))"><SiteIcon Name="x"
                                Size="14" />
                            </SiteButton>
                            </End>
                    </SiteSplit>
                </SiteListItem>
            }
        </SiteList>
    }
</SiteStack>
