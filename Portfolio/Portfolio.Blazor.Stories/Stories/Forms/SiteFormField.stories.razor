@attribute [Stories("Forms/SiteFormField")]

<Stories TComponent="SiteFormField">

    <Story Name="With Help Text">
        <Template>
            <SiteFormField Label="Email" For="email-help" HelpText="We'll never share your email.">
                <SiteTextInput Id="email-help" Placeholder="you@example.com" />
            </SiteFormField>
        </Template>
    </Story>

    <Story Name="With Error Text">
        <Template>
            <SiteFormField Label="Email"
                For="email-error"
                Required="true"
                ErrorText="Please enter a valid email address.">
                <SiteTextInput Id="email-error" Value="invalid-email" />
            </SiteFormField>
        </Template>
    </Story>

</Stories>
