<SiteStack Gap="SiteSpace.None" Class="@ToolbarClass">
    <SiteForm Mode="@(RendererInfo.IsInteractive && OnApply.HasDelegate ? SiteFormMode.Interactive : SiteFormMode.Static)"
        Action="@Action"
        Method="@Method"
        Class="@FormClass"
        Region="@DataLayoutRegion"
        OnSubmit="@HandleSubmit">
        @ChildContent
    </SiteForm>
</SiteStack>
