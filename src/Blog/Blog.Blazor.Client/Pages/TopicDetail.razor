@inherits ListPageBase
@page "/topics/{Slug}"
@page "/pt-BR/topics/{Slug}"
@using Microsoft.AspNetCore.Components
@using Blog.Blazor.Core

<PageTitle>@Title</PageTitle>
<SeoHead Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath" />

<SitePage Template="topic-detail">
    <SiteBreadcrumb HomeUrl="@LocalizedPath("home")"
        HomeLabel="@(L["home"])"
        Links="@BreadcrumbLinks"
        CurrentLabel="@Title" />

    @if (Snapshot is null)
    {
        <SiteHero Title="@LoadingLabel" />
    }
    else if (Topic is null)
    {
        <SiteHero Title="@NotFoundLabel"
            Lead="@NotFoundDescription"><ChildContent>
                <SiteLink Variant="SiteButtonVariant.Outline" Href="@IndexUrl">
                    <SiteIcon Name="arrow-left" Size="14" />@BackLabel</SiteLink>
                </ChildContent>
            </SiteHero>
    }
    else
    {
        <SiteHero Title="@Title" Lead="@Description" />
        @if (Writings.Count == 0 && SubtreeFindings.Count == 0 && Subcategories.Count == 0)
        {
            <SiteEmptyState Message="@EmptyLabel" />
        }
        else
        {
            @if (Subcategories.Count > 0)
            {
                <SiteSection Region="subcategories"
                    HeadingId="topic-subcategories-heading"
                    Title="@SubcategoriesLabel">
                    <SiteCardGrid aria-labelledby="topic-subcategories-heading"
                        data-layout-region="items">
                        @foreach (var child in Subcategories)
                        {
                            <SiteGridColumn>
                                <SiteClickableCard Title="@(child.Name ?? child.Slug)"
                                    Href="@LocalizedUrl(child.Url ?? $"/topics/{child.Slug}")">
                                    <SiteText Variant="SiteTextVariant.Meta">@L["count_findings_in_category", SubtreeFindingCount(child)]</SiteText>
                                </SiteClickableCard>
                            </SiteGridColumn>
                        }
                    </SiteCardGrid>
                </SiteSection>
            }

            @if (HighlightFindings.Count > 0)
            {
                <SiteSection Region="highlights"
                    HeadingId="topic-highlights-heading"
                    Title="@HighlightsLabel">
                    <SiteCardGrid aria-labelledby="topic-highlights-heading"
                        data-layout-region="items">
                        @foreach (var item in HighlightFindings)
                        {
                            <SiteGridColumn>
                                <SiteFeedCard KindLabel="@FindingKind(item.Type)"
                                    Date="@FormatDate(item.PublishedDate)"
                                    Title="@(item.Title ?? item.Slug)"
                                    Href="@LocalizedUrl(item.Url)"
                                    Preview="@item.Description"
                                    ViewLabel="@(L["read_more"])">
                                    <MetaItems>
                                        @if (PopularityLabel(item) is { } popularity) { <SiteCardMetaItem Icon="star">@popularity</SiteCardMetaItem> }
                                    </MetaItems>
                                </SiteFeedCard>
                            </SiteGridColumn>
                        }
                    </SiteCardGrid>
                </SiteSection>
            }

            @if (Writings.Count > 0)
            {
                <SiteSection Region="writing"
                    HeadingId="topic-writing-heading"
                    Title="@(L["writings"])">
                    <SiteCardGrid aria-labelledby="topic-writing-heading"
                        data-layout-region="items">
                        @foreach (var item in Writings)
                        {
                            <SiteGridColumn>
                                <SiteFeedCard KindLabel="@WritingKind(item.Type)"
                                    Date="@FormatDate(item.Date)"
                                    ReadingTime="@item.ReadingTime"
                                    Title="@item.Title"
                                    Href="@LocalizedUrl(item.Url)"
                                    Preview="@item.Excerpt"
                                    ViewLabel="@(L["read_more"])" />
                            </SiteGridColumn>
                        }
                    </SiteCardGrid>
                </SiteSection>
            }

            @if (SubtreeFindings.Count > 0)
            {
                <SiteSection Region="findings"
                    HeadingId="topic-findings-heading"
                    Title="@(L["findings"])">
                    <SiteListingShell HasResults="@(PagedFindings.Count > 0)"
                        Summary="@ListingSummary(PagedFindings.Count, SortedFindings.Count, CurrentPage, PageCount)"
                        CurrentPage="@CurrentPage"
                        TotalPages="@PageCount"
                        PaginationLabel="@(L["pagination"])"
                        PreviousLabel="@(L["previous"])"
                        NextLabel="@(L["next"])"
                        Href="@(page => QueryUrl(page))">
                        <FilterContent>
                            <SiteListingFilterBar Action="@CanonicalPath"
                                ApplyLabel="@(L["apply"])"
                                ClearLabel="@(L["clear"])"
                                ClearHref="@CanonicalPath"
                                OnApply="@HandleApply">
                                <PrimaryFields>
                                    <SiteFilterSelect Icon="tag"
                                        Label="@(L["filter_type_label"])"
                                        Id="topic-type-filter"
                                        Name="type"
                                        @bind-Value="TypeValue"
                                        Options="@TypeSelectOptions"
                                        Placeholder="@(L["all"])"
                                        EmptyText="@(L["no_category_found"])" />
                                    <SiteFilterSelect Icon="arrow-up-down"
                                        Label="@(L["sort_by"])"
                                        Id="topic-sort-filter"
                                        Name="sort"
                                        @bind-Value="SortValue"
                                        Options="@SortSelectOptions"
                                        Placeholder="@(L["featured"])"
                                        EmptyText="@(L["no_option_found"])" />
                                </PrimaryFields>
                                <SearchField>
                                    <SiteSearchField Label="@(L["search"])"
                                        Id="topic-search"
                                        Name="q"
                                        Value="@PendingSearch"
                                        ValueChanged="@((string v) => PendingSearch = v)"
                                        Placeholder="@(L["title_author_or_description"])" />
                                </SearchField>
                            </SiteListingFilterBar>
                        </FilterContent>
                        <EmptyContent>
                            <SiteEmptyState Message="@(L["no_item_matches_these_filters"])" />
                        </EmptyContent>
                        <ResultContent>
                            <SiteCardGrid aria-labelledby="topic-findings-heading"
                                data-layout-region="items">
                                @foreach (var item in PagedFindings)
                                {
                                    <SiteGridColumn>
                                        <SiteFeedCard KindLabel="@FindingKind(item.Type)"
                                            Date="@FormatDate(item.PublishedDate)"
                                            Title="@(item.Title ?? item.Slug)"
                                            Href="@LocalizedUrl(item.Url)"
                                            Preview="@item.Description"
                                            ViewLabel="@(L["read_more"])">
                                            <MetaItems>
                                                @if (!string.IsNullOrWhiteSpace(RatingName(item.Rating))) { <SiteCardMetaItem Icon="thumbs-up">@RatingName(item.Rating)</SiteCardMetaItem> }
                                                @if (PopularityLabel(item) is { } popularity) { <SiteCardMetaItem Icon="star">@popularity</SiteCardMetaItem> }
                                            </MetaItems>
                                            <Tags>
                                                <SiteChipGroup>
                                                    @if (item.Featured) { <SiteBadge Label="@(L["featured"])"
                                                        Tone="SiteTone.Info" /> }
                                                    @if (item.Topics is { Count: > 0 }) { @foreach (var topic in item.Topics.Take(3)) { <SiteChip Label="@(topic.Name ?? topic.Slug)"
                                                        Href="@LocalizedUrl(topic.Url ?? $"/topics/{topic.Slug}")" /> } }
                                                </SiteChipGroup>
                                            </Tags>
                                        </SiteFeedCard>
                                    </SiteGridColumn>
                                }
                            </SiteCardGrid>
                        </ResultContent>
                    </SiteListingShell>
                </SiteSection>
            }
        }
        <ContentRelations CurrentUrl="@CanonicalPath" />
    }
</SitePage>
