@inherits ContentPageBase
@page "/contact"
@page "/pt-BR/contact"
@using Portfolio.Blazor.Core

<PageTitle>@Title</PageTitle>
<SeoHead Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath" />

<SitePage Template="contact">
    <SiteBreadcrumb HomeUrl="@(L[""])"
        HomeLabel="@(L["home"])"
        CurrentLabel="@CrumbLabel("contact", L["contact"])" />
    <SiteHero Title="@Title"
        Lead="@Description"/>
    @if (!HasContact)
    {
        <SiteEmptyState Message="@(L["contact_channels_are_currently_unavailable"])" />
    }
    else
    {
        <SiteSection Region="channels"
            HeadingId="contact-channels-heading"
            Label="@(L["reach_me"])"
            Title="@(L["ways_to_get_in_touch"])">
            <ContactChannels Profiles="@Profiles"
                EmailChallenge="@Snapshot?.Chrome.Site.ProtectedEmail"
                EmailAvailable="@(Snapshot?.Chrome.Site.ContactAvailable == true)"
                Variant="grid" />
        </SiteSection>
    }
</SitePage>
