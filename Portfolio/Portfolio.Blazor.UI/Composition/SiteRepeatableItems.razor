@typeparam TItem

<div class="site-repeatable-items" data-slot="repeatable-items">
    @for (var index = 0; index < Items.Count; index++)
    {
        var itemIndex = index;
        var item = Items[itemIndex];
        <div class="site-repeatable-item" data-slot="repeatable-item">
            <SiteSplit Gap="SiteSpace.Sm">
                <Start>
                    <strong>@ItemTitle(item, itemIndex)</strong>
                </Start>
                <End>
                    <SiteButton Variant="SiteButtonVariant.Outline"
                        aria-label="@($"{RemoveLabel} {ItemTitle(item, itemIndex)}")"
                        @onclick="@(() => OnRemove.InvokeAsync(itemIndex))">
                        <SiteIcon Name="trash-2" Size="14" />@RemoveLabel</SiteButton>
                    </End>
            </SiteSplit>
            @ItemTemplate(new SiteRepeatableItemContext<TItem>(item, itemIndex))
        </div>
    }
    <SiteButton Variant="SiteButtonVariant.Outline"
        @onclick="@(() => OnAdd.InvokeAsync())"><SiteIcon Name="plus"
            Size="14" />@AddLabel</SiteButton>
</div>
