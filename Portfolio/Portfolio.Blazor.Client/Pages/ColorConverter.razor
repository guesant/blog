@inherits LocalizedComponentBase
@page "/tools/color-converter"
@page "/pt-BR/tools/color-converter"
@using Portfolio.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action" SubmitLabel="@SubmitLabel" AriaLabel="@InputLabel">
        <SiteFormField For="color-input"
            Label="@InputLabel"><SiteInput Id="color-input"
                Name="input"
                Type="text"
                placeholder="#4f46e5"
                autocomplete="off"
                spellcheck="false"
                Value="@Input"
                ValueChanged="@(v => Input = v)" /></SiteFormField>
    </SiteToolForm>

    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (Result.HasInput && !Result.IsValid)
        {
            <SiteErrorMessage>@InvalidLabel</SiteErrorMessage>
        }
        <SitePreviewBox Class="tool-color-swatch"
            Style="@($"background-color: {Result.CssColor}")"
            AriaLabel="@SwatchLabel" />
        <SiteFormActions>
            <SiteFormField For="color-hex" Label="@HexLabel">
                <SiteInput Id="color-hex" readonly Value="@Result.Hex" />
            </SiteFormField>
            <SiteFormField For="color-rgb" Label="@RgbLabel">
                <SiteInput Id="color-rgb" readonly Value="@Result.Rgb" />
            </SiteFormField>
            <SiteFormField For="color-hsl" Label="@HslLabel">
                <SiteInput Id="color-hsl" readonly Value="@Result.Hsl" />
            </SiteFormField>
        </SiteFormActions>
    </SiteLiveRegion>
</ToolPage>

@code {
    private string CanonicalPath => RequestPath;
    private string _input = string.Empty;
    private ColorConversionResult _result = ColorConversionCalculator.Convert(null);
    private bool _queryInitialized;
    [SupplyParameterFromQuery(Name = "input")]
    private string? QueryInput { get; set; }
    private string Action => L["legacy_df66e9cdaf90"];
    private string Title => L["legacy_c041764a8da9"];
    private string Description => L["legacy_3684f22a4a57"];
    private string InputLabel => L["legacy_cde7b59ed555"];
    private string SubmitLabel => L["legacy_1b13315a70e3"];
    private string InvalidLabel => L["legacy_f2c2bf99db31"];
    private string SwatchLabel => L["legacy_c7602f73e7c0"];
    private string HexLabel => "HEX";
    private string RgbLabel => "RGB";
    private string HslLabel => "HSL";
    private string Input { get => _input; set { _input = value; _result = ColorConversionCalculator.Convert(value); } }
    private ColorConversionResult Result => _result;
    protected override void OnParametersSet()
    {
        if (_queryInitialized) return;
        _input = QueryInput ?? _input;
        _result = ColorConversionCalculator.Convert(_input);
        _queryInitialized = true;
    }
}
