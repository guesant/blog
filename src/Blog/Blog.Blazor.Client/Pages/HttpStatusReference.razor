@inherits LocalizedComponentBase
@page "/tools/http-status-reference"
@page "/pt-BR/tools/http-status-reference"
@using Blog.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action" SubmitLabel="@SearchLabel" AriaLabel="@FilterLabel">
        <SiteFormField For="http-status-filter"
            Label="@FilterLabel"><SiteInput Id="http-status-filter"
                Name="filter"
                Type="text"
                autocomplete="off"
                spellcheck="false"
                Value="@Filter"
                ValueChanged="@(v => Filter = v)" /></SiteFormField>
    </SiteToolForm>
    <SiteCard Class="site-block" Label="@Title">
        <SiteList>
        @foreach (var status in Results)
        {
            <SiteListItem Class="list-group-item site-list-row d-flex flex-wrap justify-content-between align-items-start tool-list-item">
                <SiteText Variant="SiteTextVariant.Meta"
                    Class="tool-list-value">@status.Code @status.Name</SiteText>
                    <SiteText Variant="SiteTextVariant.Meta">@status.Description</SiteText>
                </SiteListItem>
        }
    </SiteList>
    </SiteCard>
    @if (Results.Count == 0)
    {
        <SiteNotice>@EmptyLabel</SiteNotice>
    }
</ToolPage>
