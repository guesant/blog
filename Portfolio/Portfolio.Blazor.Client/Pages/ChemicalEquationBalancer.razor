@inherits LocalizedComponentBase
@implements IDisposable
@page "/tools/chemical-equation-balancer"
@page "/pt-BR/tools/chemical-equation-balancer"
@using Portfolio.Blazor.Core
@using Microsoft.JSInterop
@inject IJSRuntime JS

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action"
        SubmitLabel="@SubmitLabel"
        Submit="SiteToolFormSubmit.StaticOnly"
        OnSubmit="Calculate"
        AriaLabel="@InputLabel">
        <SiteFormField Label="@InputLabel" For="chemical-equation">
            <SiteInput Id="chemical-equation"
                Name="equation"
                Type="text"
                autocomplete="off"
                spellcheck="false"
                Value="@EquationText"
                ValueChanged="@(v => EquationText = v)" />
        </SiteFormField>
    </SiteToolForm>
    @if (!Result.IsValid) { <SiteErrorMessage>@ErrorLabel</SiteErrorMessage> }
    else
    {
        <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
            <SiteCard Class="site-block"
                Label="@Title"><SiteText Variant="SiteTextVariant.Body"
                    Class="tool-result-value">@Result.Equation</SiteText>
                </SiteCard>
            @if (RendererInfo.IsInteractive)
            {
                <SiteJsMount Id="@TableId" Class="table-scroll" AriaLabel="@TableLabel" />
            }
            else
            {
                <SiteDataTable TItem="int"
                    Items="@RowIndexes"
                    RowKey="@(row => row)"
                    Caption="@TableLabel"
                    EmptyText="@(L["no_elements"])">
                    <Columns>
                        <SiteColumn TItem="int" Header="@ElementLabel" IsRowHeader="true">
                            <Cell Context="row">@Result.Elements[row]</Cell>
                        </SiteColumn>
                        @for (var column = 0; column < Result.Terms.Count; column++)
                        {
                            var currentColumn = column;
                            <SiteColumn TItem="int" Header="@Result.Terms[currentColumn]">
                                <Cell Context="row">@Result.Counts[row][currentColumn]</Cell>
                            </SiteColumn>
                        }
                    </Columns>
                </SiteDataTable>
            }
        </SiteLiveRegion>
    }
</ToolPage>
