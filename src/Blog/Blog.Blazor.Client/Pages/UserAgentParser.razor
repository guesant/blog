@inherits LocalizedComponentBase
@page "/tools/user-agent-parser"
@page "/pt-BR/tools/user-agent-parser"
@using Microsoft.JSInterop
@inject IJSRuntime JS
<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteNotice>@HeuristicNote</SiteNotice>
        <SiteFormCard Class="site-block">
            <SiteFormField For="user-agent-current"
                Label="@CurrentLabel"><SiteTextAreaInput id="user-agent-current"
                    Class="tool-textarea"
                    rows="3"
                    readonly>@CurrentUa</SiteTextAreaInput>
                    </SiteFormField>
                <SiteFormField For="user-agent-input"
                    Label="@InputLabel"><SiteTextAreaInput id="user-agent-input"
                        Class="tool-textarea"
                        rows="3"
                        @bind-Value="InputUa" /></SiteFormField>
            </SiteFormCard>
                <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
                    <SiteCard Class="site-block" Label="@Title">
                        <SiteStats Grid="true">
                            <SiteStatItem Label="@BrowserLabel">@Browser</SiteStatItem>
                                <SiteStatItem Label="@OsLabel">@Os</SiteStatItem>
                                    <SiteStatItem Label="@EngineLabel">@Engine</SiteStatItem>
                                </SiteStats>
                            </SiteCard>
                        </SiteLiveRegion>
                    </ToolPage>
