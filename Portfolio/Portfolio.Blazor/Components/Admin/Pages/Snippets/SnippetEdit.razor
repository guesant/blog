@page "/admin/snippets/create"
@page "/admin/snippets/{Id:int}"
@inherits AdminEditPageBase<Snippet>
@layout AdminLayout

<PageTitle>@(IsEditing ? "Edit snippet" : "New snippet")</PageTitle>

<SiteFormShell Title="@(IsEditing ? "Edit snippet" : "New snippet")"
    Error="@SaveError"
    Loading="@IsLoading">
    <SiteForm EditContext="@_snippetEditContext" OnValidSubmit="HandleSaveAsync">
        <SiteStack Gap="SiteSpace.Lg">
            <SiteFormField Label="Slug"
                For="slug"
                Required="true"
                HelpText="Used in the public snippet URL.">
                <SiteTextInput Id="slug" @bind-Value="_snippet.Slug" />
                <SiteValidationMessage For="@(() => _snippet.Slug)" />
            </SiteFormField>


            <SiteFormField Label="Published at"
                For="published-at"
                HelpText="Leave empty if not yet published.">
                <SiteDateInput Id="published-at" @bind-Value="_snippet.PublishedAt" />
            </SiteFormField>

            <SiteInline Gap="SiteSpace.Lg">
                <SiteCheckbox Label="Hidden" @bind-Value="_snippet.Hidden" />
                <SiteCheckbox Label="Show history" @bind-Value="_snippet.ShowHistory" />
            </SiteInline>

            <SiteFormSection Title="Translations">
                <SiteTranslationTabs Locales="@_locales"
                    ActiveLocale="@_activeLocale"
                    ActiveLocaleChanged="@((string locale) => _activeLocale = locale)"
                    IdPrefix="snippet-translation">
                    <Panel Context="locale">
                        @if (locale == "en")
                        {
                            <CascadingValue Value="_enEditContext"
                                TValue="EditContext"
                                IsFixed="true">
                                <DataAnnotationsValidator />
                                <SiteFormField Label="Title"
                                    For="title-en"
                                    HelpText="Leave blank to skip saving the English translation.">
                                    <SiteTextInput Id="title-en"
                                        @bind-Value="_translationEn.Title" />
                                </SiteFormField>
                                <SiteFormField Label="Description" For="description-en">
                                    <SiteTextAreaInput Id="description-en"
                                        Rows="3"
                                        Value="@(_translationEn.Description ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Description = NullIfBlank(value))" />
                                </SiteFormField>
                            </CascadingValue>
                        }
                        else
                        {
                            <CascadingValue Value="_ptEditContext"
                                TValue="EditContext"
                                IsFixed="true">
                                <DataAnnotationsValidator />
                                <SiteFormField Label="Título"
                                    For="title-pt"
                                    HelpText="Deixe em branco para não salvar a tradução em português.">
                                    <SiteTextInput Id="title-pt"
                                        @bind-Value="_translationPtBr.Title" />
                                </SiteFormField>
                                <SiteFormField Label="Descrição" For="description-pt">
                                    <SiteTextAreaInput Id="description-pt"
                                        Rows="3"
                                        Value="@(_translationPtBr.Description ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Description = NullIfBlank(value))" />
                                </SiteFormField>
                            </CascadingValue>
                        }
                    </Panel>
                </SiteTranslationTabs>
            </SiteFormSection>

            <SiteFormSection Title="Files" Description="@FilesDescription">
                <SiteRepeatableItems TItem="SnippetFileFormModel"
                    Items="@_files"
                    ItemTitle="@((file, index) => $"File {index + 1}")"
                    AddLabel="Add file"
                    RemoveLabel="Remove"
                    OnAdd="HandleAddFile"
                    OnRemove="HandleRemoveFile">
                    <ItemTemplate Context="fileContext">
                        <SiteFormField Label="Path"
                            For="@($"file-path-{fileContext.Index}")"
                            Required="true">
                            <SiteTextInput Id="@($"file-path-{fileContext.Index}")"
                                Value="@fileContext.Item.Path"
                                ValueChanged="@(value => fileContext.Item.Path = value)" />
                        </SiteFormField>

                        <SiteFormField Label="Language"
                            For="@($"file-language-{fileContext.Index}")">
                            <SiteSelectWithCustom Id="@($"file-language-{fileContext.Index}")"
                                Value="@(fileContext.Item.Language ?? string.Empty)"
                                ValueChanged="@(value => fileContext.Item.Language = NullIfBlank(value))"
                                Choices="@FileLanguages"
                                Placeholder="No language" />
                        </SiteFormField>

                        <SiteFormField Label="Content"
                            For="@($"file-content-{fileContext.Index}")"
                            Required="true">
                            <SiteTextAreaInput Id="@($"file-content-{fileContext.Index}")"
                                Rows="15"
                                Value="@fileContext.Item.Content"
                                ValueChanged="@(value => fileContext.Item.Content = value)" />
                        </SiteFormField>
                    </ItemTemplate>
                </SiteRepeatableItems>
            </SiteFormSection>
        </SiteStack>

        <SiteSaveBar Saving="@IsSaving" CancelHref="/admin/snippets" />
    </SiteForm>
</SiteFormShell>
