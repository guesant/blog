@inherits ListPageBase
@page "/projects"
@page "/pt-BR/projects"
@using Microsoft.AspNetCore.Components
@using Blog.Blazor.Core

<PageTitle>@PageField("projects", "title", Title)</PageTitle>
<SeoHead Title="@SeoTitle" Description="@SeoDescription" CanonicalPath="@CanonicalPath" />

<SitePage Template="projects-index">
    <SiteBreadcrumb HomeUrl="@LocalizedPath("home")"
        HomeLabel="@(L["home"])"
        Links="@BreadcrumbLinks"
        CurrentLabel="@CrumbLabel("projects", L["projects"])" />

        <SiteHero Title="@SeoTitle"
            Lead="@SeoDescription" />

    @if (Snapshot is null || SortedProjects.Count == 0)
    {
        <SiteListingShell HasResults="false"
            CurrentPage="@CurrentPage"
            TotalPages="@PageCount"
            PaginationLabel="@(L["pagination"] )"
            PreviousLabel="@(L["previous"] )"
            NextLabel="@(L["next"] )"
            Href="@(page => QueryUrl(ViewMode, page))">
            <EmptyContent>
                <SiteEmptyState Message="@(Snapshot is null ? UnavailableLabel : EmptyLabel)" />
            </EmptyContent>
        </SiteListingShell>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(PageField("projects", "selectedLabel", string.Empty))) { <SiteText Variant="SiteTextVariant.SectionLabel">
            <SiteIcon Name="star"
                Size="12" />@PageField("projects", "selectedLabel", string.Empty)</SiteText> }
        <SiteHeading Level="2"
            Class="visually-hidden"
            Id="projects-title">@PageField("projects", "title", Title)</SiteHeading>
        <ProjectListing TItem="PublicProject"
            Summary="@ListingSummary(PagedProjects.Count, SortedProjects.Count, CurrentPage, PageCount)"
            Items="@PagedProjects" CurrentPage="@CurrentPage" TotalPages="@PageCount" PaginationLabel="@(L["pagination"])" PreviousLabel="@(L["previous"])" NextLabel="@(L["next"])" Href="@(page => QueryUrl(ViewMode, page))"
            Action="@Action" SortId="projects-sort" SortName="sort" SortLabel="@(L["sort_by"])" SortValue="@SortValue" SortValueChanged="@((string v) => SortValue = v)" SortOptions="@SortOptions" SortPlaceholder="@(L["default"])" SortEmptyText="@(L["default"])" ApplyLabel="@(L["apply"])" OnApply="@(() => HandleApply(Action, SortValue, Search, DenseView))"
            SearchLabel="@(L["search"])" SearchValue="@Search" SearchValueChanged="@((string v) => Search = v)" SearchPlaceholder="@(L["search_by_name"])" ClearLabel="@(L["clear"])" ClearHref="@Action"
            GridId="view-spacious-projects" GridAriaLabelledBy="projects-title" KindLabel="@(L["kind_project"])" ViewLabel="@(L["read_more"])"
            ItemHref="@(project => LocalizedUrl(project.Url))" ItemTitle="@(project => project.Name)" ItemStatusLabel="@(project => project.Status)" ItemDate="@(project => FormatDate(project.PublishedAt) is { } date && date != "·" ? date : null)"
            ItemPurpose="@(project => project.Purpose)" ItemProblem="@(project => project.Problem)" ItemTechnologies="@(project => project.Technologies)" TechnologyUrl="@LocalizedTechnologyUrl" />
    }

    <SiteSection Region="experiments"
        HeadingId="experiments-title"
        Label="@PageField("projects", "archiveLabel", string.Empty)"
        Title="@PageField("projects", "experimentsTitle", string.Empty)">
        @if (Snapshot?.Experiments is not { Count: > 0 })
        {
            <SiteListingShell HasResults="false"
                CurrentPage="@ExperimentCurrentPage"
                TotalPages="@ExperimentPageCount"
                PaginationLabel="@(L["pagination"] )"
                PreviousLabel="@(L["previous"] )"
                NextLabel="@(L["next"] )"
                Href="@(page => ExperimentQueryUrl(ExperimentViewMode, page))">
                <EmptyContent>
                    <SiteEmptyState Message="@(L["no_experiments_available"])" />
                </EmptyContent>
            </SiteListingShell>
        }
        else
        {
            <ProjectListing TItem="PublicExperiment"
                Summary="@ListingSummary(PagedExperiments.Count, SortedExperiments.Count, ExperimentCurrentPage, ExperimentPageCount)"
                Items="@PagedExperiments" CurrentPage="@ExperimentCurrentPage" TotalPages="@ExperimentPageCount" PaginationLabel="@(L["pagination"])" PreviousLabel="@(L["previous"])" NextLabel="@(L["next"])" Href="@(page => ExperimentQueryUrl(ExperimentViewMode, page))"
                Action="@Action" SortId="experiments-sort" SortName="sort_experiments" SortLabel="@(L["sort_by"])" SortValue="@ExperimentSortValue" SortValueChanged="@((string v) => ExperimentSortValue = v)" SortOptions="@SortOptions" SortPlaceholder="@(L["default"])" SortEmptyText="@(L["default"])" ApplyLabel="@(L["apply"])" OnApply="@HandleExperimentApply"
                SearchLabel="@(L["search"])" SearchName="q_experiments" SearchValue="@ExperimentSearch" SearchValueChanged="@((string v) => ExperimentSearch = v)" SearchPlaceholder="@(L["search_by_name"])" ClearLabel="@(L["clear"])" ClearHref="@Action"
                GridId="view-spacious-experiments" GridAriaLabelledBy="experiments-title" KindLabel="@(L["kind_experiment"])" ViewLabel="@(L["read_more"])"
                ItemHref="@(experiment => LocalizedUrl(experiment.Url))" ItemTitle="@(experiment => experiment.Name)" ItemStatusLabel="@(experiment => L["experiments"])" ItemDate="@(experiment => FormatDate(experiment.PublishedAt) is { } date && date != "·" ? date : null)"
                ItemPurpose="@(experiment => experiment.Purpose)" ItemTechnologies="@(experiment => experiment.Technologies)" TechnologyUrl="@LocalizedTechnologyUrl" />
        }
    </SiteSection>
</SitePage>
