@inherits LocalizedComponentBase
@implements IDisposable
@page "/tools/function-plotter"
@page "/pt-BR/tools/function-plotter"
@using System.Globalization
@using Portfolio.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action"
        SubmitLabel="@SubmitLabel"
        Submit="SiteToolFormSubmit.StaticOnly"
        OnSubmit="Calculate">
        <SiteFormField For="function-expression"
            Label="@ExpressionLabel"><SiteInput Id="function-expression"
                Name="expression"
                Type="text"
                Value="@ExpressionText"
                ValueChanged="@(v => ExpressionText = v)" /></SiteFormField>
        <SiteFormField For="function-min"
            Label="@MinimumLabel"><SiteInput Id="function-min"
                Name="min"
                Type="number"
                step="any"
                Value="@MinimumText"
                ValueChanged="@(v => MinimumText = v)" /></SiteFormField>
        <SiteFormField For="function-max"
            Label="@MaximumLabel"><SiteInput Id="function-max"
                Name="max"
                Type="number"
                step="any"
                Value="@MaximumText"
                ValueChanged="@(v => MaximumText = v)" /></SiteFormField>
    </SiteToolForm>
    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (!Result.IsValid) { <SiteErrorMessage>@ErrorLabel</SiteErrorMessage> }
        else
        {
            <SiteStats>
                <SiteStatItem Label="@SamplesLabel">@Result.Points.Count</SiteStatItem>
                    <SiteStatItem Label="@($"f({Format(Result.Points[0].X)})")">@Format(Result.Points[0].Y)</SiteStatItem>
                </SiteStats>
            <SiteCard Class="site-block" Label="@ChartLabel">
                @if (RendererInfo.IsInteractive) { <SiteChart ChartJsConfig="@ChartConfig"
                    AriaLabelledBy="function-chart-title"
                    AriaDescribedBy="function-chart-description" /> } else { <SiteList Variant="SiteListVariant.Boxed"
                        Id="function-chart-description">@foreach (var point in Result.Points.Take(12)) { <SiteListItem Class="site-text-list-item">f(@Format(point.X)) = @Format(point.Y)</SiteListItem> }</SiteList> }
            </SiteCard>
        }
    </SiteLiveRegion>
</ToolPage>
