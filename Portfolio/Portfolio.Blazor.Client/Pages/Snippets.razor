@inherits ListPageBase
@page "/snippets"
@page "/pt-BR/snippets"
@using Portfolio.Blazor.Core

<PageTitle>@Title</PageTitle>
<SeoHead Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath" />

<SitePage Template="snippets-index">
    <SiteBreadcrumb HomeUrl="@LocalizedPath("home")"
        HomeLabel="@(L["legacy_ddc150008e2f"])"
        CurrentLabel="@Title" />
    @if (Snapshot is null)
    {
        <SiteHero Title="@LoadingLabel" />
        <SiteListingShell HasResults="false"
            CurrentPage="@CurrentPage"
            TotalPages="@PageCount"
            PaginationLabel="@(L["legacy_ce41390e654d"] )"
            PreviousLabel="@(L["legacy_c3b535ded088"] )"
            NextLabel="@(L["legacy_a6c78a6436e2"] )"
            Href="@(page => QueryUrl(ViewMode, page))">
            <EmptyContent>
                <SiteEmptyState Message="@LoadingLabel" />
            </EmptyContent>
        </SiteListingShell>
    }
    else
    {
        <SiteHero Title="@PageField("title", Title)"
            Lead="@PageField("description", Description)"
            BackHref="@(L["legacy_0607643fd42c"])"
            BackLabel="@(L["legacy_ddc150008e2f"])" />

            <SiteListingShell HasResults="@(PagedSnippets.Count > 0)"
                Summary="@ListingSummary(PagedSnippets.Count, SortedSnippets.Count, CurrentPage, PageCount)"
                CurrentPage="@CurrentPage"
                TotalPages="@PageCount"
                PaginationLabel="@(L["legacy_ce41390e654d"])"
                PreviousLabel="@(L["legacy_c3b535ded088"])"
                NextLabel="@(L["legacy_a6c78a6436e2"])"
                Href="@(page => QueryUrl(ViewMode, page))">
            <FilterContent>
                <SiteListingFilterBar Action="@Action"
                    ApplyLabel="@(L["legacy_c975d2551cc4"])"
                    ClearLabel="@(L["legacy_5262517729fc"])"
                    ClearHref="@Action"
                    OnApply="@(() => HandleApply(Action, SortValue, Search, DenseView))">
                    <PrimaryFields>
                        <SiteFilterSelect Icon="arrow-up-down"
                            Label="@(L["legacy_6541e97b7c64"])"
                            Id="snippets-sort"
                            Name="sort"
                            @bind-Value="SortValue"
                            Options="@SortOptions"
                            Placeholder="@(L["legacy_d878d9136e0e"])"
                            EmptyText="@(L["legacy_0bb89437e6cb"])" />
                    </PrimaryFields>
                    <SearchField>
                        <SiteSearchField Label="@(L["legacy_6bb12bff6f09"])"
                            Id="snippets-search"
                            Name="q"
                            Value="@Search"
                            ValueChanged="@((string value) => Search = value)"
                            Placeholder="@(L["search_by_name"])" />
                    </SearchField>
                </SiteListingFilterBar>
            </FilterContent>
                <ResultContent>
            <SiteCardGrid id="view-spacious-snippets"
                aria-label="@Title"
                data-layout-region="items">
                @foreach (var snippet in PagedSnippets)
                {
                    <SiteGridColumn>
                        <SiteFeedCard KindLabel="@(L["kind_snippet"])"
                            Date="@(FormatDate(snippet.PublishedAt) is { } date && date != "·" ? date : null)"
                            Title="@snippet.Title"
                            Href="@LocalizedUrl(snippet.Url)"
                            Preview="@snippet.Description"
                            ViewLabel="@(L["open"])">
                            <MetaItems>
                                <SiteCardMetaItem Icon="file-code">@FileCount(snippet)</SiteCardMetaItem>
                            </MetaItems>
                        </SiteFeedCard>
                    </SiteGridColumn>
                }
            </SiteCardGrid>
            </ResultContent>
            <EmptyContent>
                <SiteEmptyState Message="@EmptyLabel" />
            </EmptyContent>
            </SiteListingShell>
    }
</SitePage>

@code {
    private string Title => L["legacy_b87eedb8eefd"];
    private string Description => L["legacy_7bf683bdb7c8"];
    private string LoadingLabel => L["legacy_bfb6d168bf4a"];
    private string EmptyLabel => L["legacy_c691155905c0"];
    private string ResultsSummary => L["count_entries", SortedSnippets.Count];
    private string CanonicalPath => LocalizedUrls.Current("/snippets");
    private string Action => CanonicalPath;
    [SupplyParameterFromQuery(Name = "sort")]
    private string? QuerySort { get; set; }
    [SupplyParameterFromQuery(Name = "view")]
    private string? QueryView { get; set; }
    [SupplyParameterFromQuery(Name = "page")]
    private int? QueryPage { get; set; }
    [SupplyParameterFromQuery(Name = "q")]
    private string? QuerySearch { get; set; }
    private string _search = string.Empty;
    private string Search { get => _search; set => _search = value; }
    private string Sort => QuerySort is "asc" or "desc" or "alpha" ? QuerySort : string.Empty;
    private string _sortValue = string.Empty;
    private string SortValue { get => _sortValue; set => _sortValue = value is "asc" or "desc" or "alpha" ? value : string.Empty; }
    private IReadOnlyList<SiteSelectOption> SortOptions => [new(
        "",
        L["legacy_d878d9136e0e"]
    ), new("desc", L["legacy_77c78d92c603"]), new("asc", L["legacy_07b165cdd970"]), new("alpha", L["legacy_cc8d79d78bef"])];
    private string ViewMode => QueryView is "dense" ? "dense" : "spacious";
    private bool DenseView => ViewMode == "dense";
    private IReadOnlyList<PublicSnippet> MatchingSnippets => (Snapshot?.Snippets ?? [])
        .Where(item => MatchesSearch(QuerySearch, item.Title, item.Description))
        .ToArray();
    private IReadOnlyList<PublicSnippet> SortedSnippets => Sort switch
    {
        "alpha" => MatchingSnippets.OrderBy(item => item.Title, StringComparer.OrdinalIgnoreCase).ToArray(),
        "asc" => MatchingSnippets.AsEnumerable().Reverse().ToArray(),
        _ => MatchingSnippets,
    };
    private const int PageSize = 20;
    private int PageCount => PageCountFor(SortedSnippets.Count, PageSize);
    private int CurrentPage => CurrentPageFor(QueryPage, PageCount);
    private IReadOnlyList<PublicSnippet> PagedSnippets => ItemsForPage(
        SortedSnippets,
        CurrentPage,
        PageSize
    );

    protected override void OnParametersSet()
    {
        SortValue = Sort;
        _search = QuerySearch ?? string.Empty;
    }

    private string FileCount(PublicSnippet snippet)
    {
        var count = snippet.Files?.Count ?? 0;
        return L["count_files", count];
    }

    private static string FormatDate(string? value) => DateTime.TryParse(value, out var date) ? date.ToString("yyyy-MM-dd") : "·";
    private string QueryUrl(string view, int page = 1) =>
        ListingUrl(Action, Sort, QuerySearch, view is "dense", page);

    private string LocalizedUrl(string url)
    {
        if (!Uri.TryCreate(url, UriKind.Absolute, out var absolute)) return url;
        var path = absolute.AbsolutePath;
        return LocalizedUrls.Current(path);
    }

    private string LocalizedPath(string path) => path.Equals("home", StringComparison.OrdinalIgnoreCase) ? (L["legacy_0607643fd42c"]) : (LocalizedUrls.Current($"/{path}"));
    private string PageField(string field, string fallback)
    {
        if (Snapshot?.Pages.TryGetValue("snippets", out var page) != true || page.ValueKind != System.Text.Json.JsonValueKind.Object || !page.TryGetProperty(field, out var value)) return fallback;
        return value.GetString() ?? fallback;
    }
}
