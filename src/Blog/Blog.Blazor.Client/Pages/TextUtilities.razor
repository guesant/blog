@inherits LocalizedComponentBase
@page "/tools/text-reverser"
@page "/pt-BR/tools/text-reverser"
@page "/tools/line-break-remover"
@page "/pt-BR/tools/line-break-remover"
@page "/tools/whitespace-trimmer"
@page "/pt-BR/tools/whitespace-trimmer"
@page "/tools/duplicate-line-remover"
@page "/pt-BR/tools/duplicate-line-remover"
@page "/tools/accent-remover"
@page "/pt-BR/tools/accent-remover"
@page "/tools/slugify"
@page "/pt-BR/tools/slugify"
@page "/tools/text-repeater"
@page "/pt-BR/tools/text-repeater"
@using Blog.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action"
        SubmitLabel="@SubmitLabel"
        Submit="SiteToolFormSubmit.StaticOnly"
        OnSubmit="HandleSubmit"
        AriaLabel="@InputLabel">
        <SiteFormField For="text-utility-input"
            Label="@InputLabel"><SiteTextAreaInput Id="text-utility-input"
                Name="text"
                Rows="12"
                Value="@Input"
                ValueChanged="@(v => Input = v)" /></SiteFormField>
        @if (Mode == TextUtilityMode.Repeat)
        {
            <SiteFormField For="text-utility-count"
                Label="@CountLabel"><SiteInput Id="text-utility-count"
                    Name="count"
                    Type="number"
                    min="1"
                    max="100"
                    Value="@CountText"
                    ValueChanged="@(v => CountText = v)" /></SiteFormField>
        }
    </SiteToolForm>

    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (!Result.IsValid)
        {
            <SiteErrorMessage>@ErrorLabel</SiteErrorMessage>
        }
        else
        {
            <SiteCard Class="site-block" Label="@OutputLabel">
                <SiteTextAreaInput readonly
                    Rows="12"
                    aria-label="@OutputLabel">@Result.Output</SiteTextAreaInput>
            </SiteCard>
        }
    </SiteLiveRegion>
</ToolPage>
