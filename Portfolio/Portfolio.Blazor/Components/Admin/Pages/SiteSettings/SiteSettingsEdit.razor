@page "/admin/site-settings"
@using SiteSettingsEntity = Portfolio.Blazor.Data.Entities.SiteSettings
@using SiteSettingsTranslationEntity = Portfolio.Blazor.Data.Entities.SiteSettingsTranslation
@inherits AdminEditPageBase<SiteSettingsEntity>
@layout AdminLayout

<PageTitle>Site settings</PageTitle>

<SiteFormShell Title="Site settings" Error="@SaveError" Loading="@IsLoading">
    <SiteForm EditContext="@_settingsEditContext" OnValidSubmit="HandleSaveAsync">
        <SiteStack Gap="SiteSpace.Lg">
            <SiteFormField Label="Short name" For="short-name">
                <SiteTextInput Id="short-name"
                    Value="@(_settings.ShortName ?? string.Empty)"
                    ValueChanged="@(value => _settings.ShortName = NullIfBlank(value))" />
            </SiteFormField>

            <SiteFormField Label="Portfolio URL" For="portfolio-url">
                <SiteTextInput Id="portfolio-url"
                    Value="@(_settings.PortfolioUrl ?? string.Empty)"
                    ValueChanged="@(value => _settings.PortfolioUrl = NullIfBlank(value))" />
            </SiteFormField>

            <SiteFormField Label="Source repository URL" For="source-repository-url">
                <SiteTextInput Id="source-repository-url"
                    Value="@(_settings.SourceRepositoryUrl ?? string.Empty)"
                    ValueChanged="@(value => _settings.SourceRepositoryUrl = NullIfBlank(value))" />
            </SiteFormField>

            <SiteFormField Label="Contact email" For="contact-email">
                <SiteTextInput Id="contact-email"
                    Value="@(_settings.ContactEmail ?? string.Empty)"
                    ValueChanged="@(value => _settings.ContactEmail = NullIfBlank(value))" />
            </SiteFormField>

            <SiteInline Gap="SiteSpace.Lg">
                <SiteCheckbox Label="Maintenance enabled"
                    @bind-Value="_settings.MaintenanceEnabled" />
                <SiteCheckbox Label="Contact available" @bind-Value="_settings.ContactAvailable" />
            </SiteInline>

            <SiteFormSection Title="Translations">
                <SiteTranslationTabs Locales="@_locales"
                    ActiveLocale="@_activeLocale"
                    ActiveLocaleChanged="@((string locale) => _activeLocale = locale)"
                    IdPrefix="site-settings-translation">
                    <Panel Context="locale">
                        @if (locale == "en")
                        {
                            <CascadingValue Value="_enEditContext"
                                TValue="EditContext"
                                IsFixed="true">
                                <DataAnnotationsValidator />

                                <SiteFormField Label="Copyright template"
                                    For="copyright-template-en"
                                    HelpText="Supports {year} and {name} placeholders.">
                                    <SiteTextInput Id="copyright-template-en"
                                        Value="@(_translationEn.CopyrightTemplate ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.CopyrightTemplate = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Maintenance eyebrow"
                                    For="maintenance-eyebrow-en">
                                    <SiteTextInput Id="maintenance-eyebrow-en"
                                        Value="@(_translationEn.MaintenanceEyebrow ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.MaintenanceEyebrow = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Maintenance title" For="maintenance-title-en">
                                    <SiteTextInput Id="maintenance-title-en"
                                        Value="@(_translationEn.MaintenanceTitle ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.MaintenanceTitle = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Maintenance description"
                                    For="maintenance-description-en">
                                    <SiteTextAreaInput Id="maintenance-description-en"
                                        Rows="4"
                                        Value="@(_translationEn.MaintenanceDescription ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.MaintenanceDescription = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="SEO"
                                    For="seo-en"
                                    HelpText="Standard meta fields for this page; add any extra tag under other fields. Leave empty if not applicable.">
                                    <SitePageFieldsInput Id="seo-en"
                                        Slug="PageFieldSlug.Seo"
                                        Locale="en"
                                        Value="@(_translationEn.Seo ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Seo = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationEn.Seo)" />
                                </SiteFormField>
                            </CascadingValue>
                        }
                        else
                        {
                            <CascadingValue Value="_ptEditContext"
                                TValue="EditContext"
                                IsFixed="true">
                                <DataAnnotationsValidator />

                                <SiteFormField Label="Modelo de copyright"
                                    For="copyright-template-pt"
                                    HelpText="Aceita os marcadores {year} e {name}.">
                                    <SiteTextInput Id="copyright-template-pt"
                                        Value="@(_translationPtBr.CopyrightTemplate ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.CopyrightTemplate = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Chamada de manutenção"
                                    For="maintenance-eyebrow-pt">
                                    <SiteTextInput Id="maintenance-eyebrow-pt"
                                        Value="@(_translationPtBr.MaintenanceEyebrow ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.MaintenanceEyebrow = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Título de manutenção"
                                    For="maintenance-title-pt">
                                    <SiteTextInput Id="maintenance-title-pt"
                                        Value="@(_translationPtBr.MaintenanceTitle ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.MaintenanceTitle = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Descrição de manutenção"
                                    For="maintenance-description-pt">
                                    <SiteTextAreaInput Id="maintenance-description-pt"
                                        Rows="4"
                                        Value="@(_translationPtBr.MaintenanceDescription ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.MaintenanceDescription = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="SEO"
                                    For="seo-pt"
                                    HelpText="Campos meta padrão desta página; tags extras entram em outros campos. Deixe vazio se não for aplicável.">
                                    <SitePageFieldsInput Id="seo-pt"
                                        Slug="PageFieldSlug.Seo"
                                        Locale="pt-BR"
                                        Value="@(_translationPtBr.Seo ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Seo = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationPtBr.Seo)" />
                                </SiteFormField>
                            </CascadingValue>
                        }
                    </Panel>
                </SiteTranslationTabs>
            </SiteFormSection>

            <SiteFormSection Title="Contact profiles">
                <SiteRepeatableItems TItem="ContactProfileFormModel"
                    Items="@_contacts"
                    ItemTitle="@((contact, index) => $"Contact {index + 1}")"
                    AddLabel="Add contact"
                    RemoveLabel="Remove"
                    OnAdd="HandleAddContact"
                    OnRemove="HandleRemoveContact">
                    <ItemTemplate Context="contactContext">
                        <SiteFormField Label="Platform"
                            For="@($"contact-platform-{contactContext.Index}")"
                            Required="true">
                            <SiteSelectWithCustom Id="@($"contact-platform-{contactContext.Index}")"
                                Value="@contactContext.Item.Platform"
                                ValueChanged="@(value => contactContext.Item.Platform = value)"
                                Choices="@ContactPlatforms"
                                Placeholder="Select a platform" />
                        </SiteFormField>

                        <SiteFormField Label="Label"
                            For="@($"contact-label-{contactContext.Index}")">
                            <SiteTextInput Id="@($"contact-label-{contactContext.Index}")"
                                Value="@(contactContext.Item.Label ?? string.Empty)"
                                ValueChanged="@(value => contactContext.Item.Label = NullIfBlank(value))" />
                        </SiteFormField>

                        <SiteFormField Label="URL"
                            For="@($"contact-url-{contactContext.Index}")"
                            Required="true">
                            <SiteTextInput Id="@($"contact-url-{contactContext.Index}")"
                                Value="@contactContext.Item.Url"
                                ValueChanged="@(value => contactContext.Item.Url = value)" />
                        </SiteFormField>
                    </ItemTemplate>
                </SiteRepeatableItems>
            </SiteFormSection>
        </SiteStack>

        <SiteSaveBar Saving="@IsSaving" CancelHref="/admin/site-settings" />
    </SiteForm>
</SiteFormShell>

@code {
    private static readonly string[] ContactPlatforms =
    [
        "linkedin",
        "github",
        "gitlab",
        "lattes",
        "orcid",
        "mail",
    ];

    private sealed class ContactProfileFormModel
    {
        public string Platform { get; set; } = string.Empty;
        public string? Label
        {
            get; set;
        }
        public string Url { get; set; } = string.Empty;
    }

    private static readonly IReadOnlyList<SiteLocaleTab> _locales = [new(
        "en",
        "English"
    ), new("pt-BR", "Português")];

    private SiteSettingsEntity _settings = new();
    private SiteSettingsTranslationEntity _translationEn = new() { Locale = "en" };
    private SiteSettingsTranslationEntity _translationPtBr = new() { Locale = "pt-BR" };
    private List<ContactProfileFormModel> _contacts = [];
    private string _activeLocale = "en";

    private EditContext _settingsEditContext = default!;
    private EditContext _enEditContext = default!;
    private EditContext _ptEditContext = default!;

    protected override string EntityLabel => "site settings";
    protected override string ListRoute => "/admin/site-settings";

    protected override async Task LoadAsync(PortfolioAdminDbContext dbContext)
    {
        var settings = await dbContext.SiteSettings
            .Include(candidate => candidate.Translations)
            .Include(candidate => candidate.ContactProfiles)
            .AsNoTracking()
            .OrderBy(candidate => candidate.Id)
            .FirstOrDefaultAsync();

        if (settings is null)
        {
            ToastService.Error("Site settings not found.");
            Navigation.NavigateTo("/admin");
            return;
        }

        _settings = settings;
        _translationEn = settings.Translations.FirstOrDefault(translation => translation.Locale == "en")
            ?? new SiteSettingsTranslationEntity { SiteSettingsId = settings.Id, Locale = "en" };
        _translationPtBr = settings.Translations.FirstOrDefault(translation => translation.Locale == "pt-BR")
            ?? new SiteSettingsTranslationEntity { SiteSettingsId = settings.Id, Locale = "pt-BR" };

        _contacts = settings.ContactProfiles
            .OrderBy(contact => contact.Order)
            .ThenBy(contact => contact.Id)
            .Select(contact => new ContactProfileFormModel
            {
                Platform = contact.Platform,
                Label = contact.Label,
                Url = contact.Url,
            })
            .ToList();

        _settingsEditContext = new EditContext(_settings);
        _enEditContext = new EditContext(_translationEn);
        _ptEditContext = new EditContext(_translationPtBr);
    }

    private void HandleAddContact() => _contacts.Add(new ContactProfileFormModel());

    private void HandleRemoveContact(int index) => _contacts.RemoveAt(index);

    private static bool ContactHasContent(ContactProfileFormModel contact) =>
        !string.IsNullOrWhiteSpace(contact.Platform) || !string.IsNullOrWhiteSpace(contact.Label) || !string.IsNullOrWhiteSpace(contact.Url);

    protected override Task<bool> ValidateAsync()
    {
        if (!_enEditContext.Validate() || !_ptEditContext.Validate())
        {
            return Task.FromResult(false);
        }

        var effectiveContacts = _contacts.Where(ContactHasContent).ToList();
        if (effectiveContacts.Any(contact => string.IsNullOrWhiteSpace(contact.Platform) || string.IsNullOrWhiteSpace(contact.Url)))
        {
            SaveError = "Every contact needs a platform and a URL.";
            return Task.FromResult(false);
        }

        return Task.FromResult(true);
    }

    protected override async Task ApplyChangesAsync(PortfolioAdminDbContext dbContext)
    {
        var effectiveContacts = _contacts.Where(ContactHasContent).ToList();

        var settings = await dbContext.SiteSettings
            .Include(candidate => candidate.Translations)
            .Include(candidate => candidate.ContactProfiles)
            .FirstAsync(candidate => candidate.Id == _settings.Id);

        settings.ShortName = _settings.ShortName;
        settings.PortfolioUrl = _settings.PortfolioUrl;
        settings.SourceRepositoryUrl = _settings.SourceRepositoryUrl;
        settings.ContactEmail = _settings.ContactEmail;
        settings.MaintenanceEnabled = _settings.MaintenanceEnabled;
        settings.ContactAvailable = _settings.ContactAvailable;

        ApplyTranslation(settings, "en", _translationEn);
        ApplyTranslation(settings, "pt-BR", _translationPtBr);

        dbContext.ContactProfiles.RemoveRange(settings.ContactProfiles);
        for (var index = 0; index < effectiveContacts.Count; index++)
        {
            settings.ContactProfiles.Add(new ContactProfile
            {
                SiteSettingsId = settings.Id,
                Platform = effectiveContacts[index].Platform,
                Label = effectiveContacts[index].Label,
                Url = effectiveContacts[index].Url,
                Order = index,
            });
        }
    }

    private static void ApplyTranslation(
        SiteSettingsEntity settings,
        string locale,
        SiteSettingsTranslationEntity source
    )
    {
        var existing = settings.Translations.FirstOrDefault(translation => translation.Locale == locale);
        if (existing is null)
        {
            settings.Translations.Add(new SiteSettingsTranslationEntity
            {
                Locale = locale,
                CopyrightTemplate = source.CopyrightTemplate,
                MaintenanceEyebrow = source.MaintenanceEyebrow,
                MaintenanceTitle = source.MaintenanceTitle,
                MaintenanceDescription = source.MaintenanceDescription,
                Seo = source.Seo,
            });
            return;
        }

        existing.CopyrightTemplate = source.CopyrightTemplate;
        existing.MaintenanceEyebrow = source.MaintenanceEyebrow;
        existing.MaintenanceTitle = source.MaintenanceTitle;
        existing.MaintenanceDescription = source.MaintenanceDescription;
        existing.Seo = source.Seo;
    }
}
