@using Microsoft.AspNetCore.Components.Forms
@inherits InputBase<string>

@if (!RendererInfo.IsInteractive)
{
    <select class="@ControlClass"
            id="@ResolvedId"
            name="@Name"
            disabled="@(Disabled || ReadOnly || Loading)"
            required="@ResolvedRequired"
            aria-readonly="@ReadOnly"
            aria-invalid="@ResolvedInvalid"
            aria-busy="@Loading"
            aria-describedby="@ResolvedDescribedBy"
            @bind="CurrentValue"
            @attributes="AdditionalAttributes">
        @if (Clearable && !Options.Any(option => string.IsNullOrEmpty(option.Value)))
        {
            <option value="">@Placeholder</option>
        }
        @foreach (var option in Options)
        {
            <option value="@option.Value">@option.Label</option>
        }
    </select>
}
else
{
    <div class="site-select-interactive @(ShowClearButton ? "site-select-interactive-clearable" : null)">
        <BlazorBlueprint.Primitives.Select.BbSelect TValue="string"
            @bind-Value="CurrentValue"
            Disabled="@(Disabled || ReadOnly || Loading)"
            Required="@ResolvedRequired"
            DisplayTextSelector="@ResolveDisplayText">
            <BlazorBlueprint.Primitives.Select.BbSelectTrigger TValue="string"
                AdditionalAttributes="@TriggerAttributes">
                <BlazorBlueprint.Primitives.Select.BbSelectValue TValue="string"
                    Placeholder="@Placeholder"
                    Context="selectedLabel">
                    <span class="site-select-value">
                        @if (SelectedIcon is { } selectedIcon)
                        {
                            <SiteIcon Name="@selectedIcon"
                                Size="14"
                                Class="icon site-select-option-icon" />
                        }
                        @selectedLabel
                    </span>
                </BlazorBlueprint.Primitives.Select.BbSelectValue>
                <SiteIcon Name="chevron-down" Size="14" Class="site-select-chevron" />
            </BlazorBlueprint.Primitives.Select.BbSelectTrigger>
            <BlazorBlueprint.Primitives.Select.BbSelectContent TValue="string"
                MatchTriggerWidth="true"
                AdditionalAttributes="@ContentAttributes">
                @if (ShowSearch)
                {
                    <div class="site-select-search"
                        @onkeydown:stopPropagation
                        @onclick:stopPropagation>
                        <SiteTextInput Value="@_search"
                            ValueChanged="HandleSearchChanged"
                            Placeholder="@SearchPlaceholder"
                            aria-label="@SearchPlaceholder"
                            AutoComplete="false" />
                    </div>
                }
                @if (Clearable && !HasNeutralOption)
                {
                    <BlazorBlueprint.Primitives.Select.BbSelectItem TValue="string"
                        Value="@string.Empty"
                        Text="@ClearLabel">@ClearLabel</BlazorBlueprint.Primitives.Select.BbSelectItem>
                }
                @foreach (var option in VisibleOptions)
                {
                    <BlazorBlueprint.Primitives.Select.BbSelectItem TValue="string"
                        @key="option.Value"
                        Value="@option.Value"
                        Text="@option.Label">
                        @if (!string.IsNullOrWhiteSpace(option.Icon))
                        {
                            <SiteIcon Name="@option.Icon"
                                Size="14"
                                Class="icon site-select-option-icon" />
                        }
                        @option.Label
                    </BlazorBlueprint.Primitives.Select.BbSelectItem>
                }
                @if (ShowSearch && FilteredOptions.Count == 0)
                {
                    <SiteText Variant="SiteTextVariant.Small"
                        Class="site-select-empty">@EmptyText</SiteText>
                }
                @if (HiddenCount > 0)
                {
                    <div class="site-select-more" @onclick:stopPropagation>
                        <SiteButton Variant="SiteButtonVariant.Ghost"
                            Size="SiteButtonSize.Sm"
                            OnClick="ShowMore">@MoreLabel(HiddenCount)</SiteButton>
                    </div>
                }
            </BlazorBlueprint.Primitives.Select.BbSelectContent>
        </BlazorBlueprint.Primitives.Select.BbSelect>
        @if (ShowClearButton)
        {
            <button type="button"
                class="site-select-clear-btn"
                aria-label="@ClearAriaLabel"
                @onclick="HandleClear">
                <SiteIcon Name="x" Size="14" />
            </button>
        }
    </div>
}

@if (EditContext is not null && ValueExpression is not null)
{
    <SiteValidationMessage Id="@ValidationMessageId" For="@ValueExpression" />
}
