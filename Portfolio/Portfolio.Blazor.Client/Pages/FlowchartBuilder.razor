@inherits LocalizedComponentBase
@page "/tools/flowchart-builder"
@page "/pt-BR/tools/flowchart-builder"
@using Microsoft.JSInterop
@inject IJSRuntime JS

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteCard Class="site-block" Label="@Title">
        <div data-tool="flowchart-builder" data-chart-label="@ChartLabel">
        <SiteNotice>@Note</SiteNotice>
        <SiteToolForm Action="@Action" SubmitLabel="@GenerateLabel" AriaLabel="@InputLabel">
            <SiteFormField For="flowchart-input"
                Label="@InputLabel"><SiteTextAreaInput Id="flowchart-input"
                    Name="source"
                    Rows="6"
                    Value="@Source"
                    ValueChanged="@(v => Source = v)"
                    data-flowchart-input /></SiteFormField>
            @if (RendererInfo.IsInteractive)
            {
                <SiteButton data-flowchart-download
                    Variant="SiteButtonVariant.Default"
                    Class="tool-button"><SiteIcon Name="download"
                        Size="14" />@DownloadLabel</SiteButton>
            }
        </SiteToolForm>
        <SiteErrorMessage data-flowchart-error>
        </SiteErrorMessage>
        <div class="tool-visualization tool-chart-wrap" data-flowchart-chart>
        </div>
    </div>
    </SiteCard>
</ToolPage>
