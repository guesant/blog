@inherits LocalizedComponentBase
@using Blog.Blazor.Core
@using Blog.Blazor.Core.Localization
@inject ICultureCatalog Cultures
@inject ILocalizedUrlBuilder Urls
@inject IStringLocalizer<NavigationResource> NavL

<aside class="site-nav @(Right ? "site-sidebar-right" : "site-sidebar-left")"
    id="@(Right ? "site-nav-right" : "site-nav")"
    data-layout-region="@(Right ? "right-sidebar" : "sidebar")">
    @if (Right)
    {
        <SiteSidebarSecondary Snapshot="@Snapshot" />
    }
    else
    {
        <SiteInline Gap="SiteSpace.Sm" Class="site-nav-brand-row">
            <SiteBackLink Href="@BackHref" Label="@BackLabel" />
            <SiteLink Class="site-nav-brand text-decoration-none"
                Href="@LocalizedPath("home")">guesant.net</SiteLink>
        </SiteInline>
        <SiteNavDivider />
        <nav class="site-nav-links" aria-label="@NavigationLabel">
            <ul>
                <li>
                    <SiteNavLink Href="@LocalizedPath("home")"
                        AriaCurrent="@(IsHome ? "page" : null)">
                        <SidebarNavIcon Route="home" Active="@IsHome" />
                        <SiteNavItemLabel>@HomeLabel</SiteNavItemLabel>
                    </SiteNavLink>
                </li>
            </ul>
            @foreach (var group in SidebarGroups)
            {
                <SiteNavDivider />
                <SiteNavGroup Label="@group.Label">
                    @foreach (var item in group.Items)
                    {
                        <li>
                            <SiteNavLink Class="@(IsActiveParent(item) ? "is-active-parent" : null)"
                                Href="@RouteUrl(item.Route)"
                                AriaCurrent="@(IsCurrent(item.Route) ? "page" : null)">
                                <SidebarNavIcon Route="@item.Route"
                                    Active="@IsCurrent(item.Route)" />
                                <SiteNavItemLabel>@Lower(item.Label)</SiteNavItemLabel>
                            </SiteNavLink>
                        </li>
                    }
                </SiteNavGroup>
            }
        </nav>
        @if (ShowAboutBlock)
        {
            <SiteNavDivider />
            <ul>
                <li>
                    <SiteNavLink Class="@(IsAboutChild ? "is-active-parent" : null)"
                        Href="@LocalizedPath("about")"
                        AriaCurrent="@(IsAbout ? "page" : null)">
                        <SidebarNavIcon Route="about" Active="@IsAbout" />
                        <SiteNavItemLabel>@NavLabel("about")</SiteNavItemLabel>
                    </SiteNavLink>
                    @if (VisibleAboutChildren.Count > 0)
                    {
                        <ul class="site-nav-sub">
                            @foreach (var route in VisibleAboutChildren)
                            {
                                <li>
                                    <SiteNavLink Href="@LocalizedPath(route)"
                                        AriaCurrent="@(IsRoute(route) ? "page" : null)">
                                        <SidebarNavIcon Route="@route" Active="@IsRoute(route)" />
                                        <SiteNavItemLabel>@NavLabel(route)</SiteNavItemLabel>
                                    </SiteNavLink>
                                </li>
                            }
                        </ul>
                    }
                </li>
            </ul>
        }
        <div class="site-nav-secondary-mobile">
            <SiteNavDivider />
            <SiteSidebarSecondary Snapshot="@Snapshot" IdPrefix="mobile-sidebar" />
        </div>
        <SiteNavDivider />
        <SiteStack Gap="SiteSpace.Sm" Class="site-nav-settings">
            <SiteToggleGroup AriaLabel="@LanguageLabel" Class="lang-switch">
                <SiteToggleLink Href="@LanguageUrl("en")"
                    Active="@IsCulture("en")"
                    Fill="true"
                    Size="SiteButtonSize.Sm">en</SiteToggleLink>
                <SiteToggleLink Href="@LanguageUrl("pt-BR")"
                    Active="@IsCulture("pt-BR")"
                    Fill="true"
                    Size="SiteButtonSize.Sm">pt</SiteToggleLink>
            </SiteToggleGroup>
            <SiteThemeSwitch Label="@(L["theme"])"
                SystemLabel="@(L["theme_system"])"
                LightLabel="@(L["theme_light"])"
                DarkLabel="@(L["theme_dark"])" />
        </SiteStack>
    }
</aside>
