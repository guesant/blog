@typeparam TItem

@{ ColumnList.Clear(); }
<CascadingValue Value="this" IsFixed="true">
    @Columns
</CascadingValue>
<SiteTable Caption="@Caption" Class="@Class">
    <thead>
        <tr>
            @foreach (var column in ColumnList)
            {
                <th scope="col">@column.Header</th>
            }
            @if (Actions is not null)
            {
                <th scope="col" data-slot="actions-cell">
                    <span class="visually-hidden">@ActionsHeader</span>
                </th>
            }
        </tr>
    </thead>
    <tbody>
        @if (Items.Count == 0)
        {
            <tr>
                <td colspan="@(ColumnList.Count + (Actions is null ? 0 : 1))">@EmptyText</td>
            </tr>
        }
        else
        {
            @foreach (var item in Items)
            {
                <tr @key="RowKey(item)">
                    @foreach (var column in ColumnList)
                    {
                        @if (column.IsRowHeader)
                        {
                            <th scope="row">@column.Cell(item)</th>
                        }
                        else
                        {
                            <td>@column.Cell(item)</td>
                        }
                    }
                    @if (Actions is not null)
                    {
                        <td data-slot="actions-cell">@Actions(item)</td>
                    }
                </tr>
            }
        }
    </tbody>
</SiteTable>
