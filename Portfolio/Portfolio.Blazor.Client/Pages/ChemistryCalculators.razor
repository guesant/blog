@inherits LocalizedComponentBase
@page "/tools/dilution-calculator"
@page "/pt-BR/tools/dilution-calculator"
@page "/tools/ph-calculator"
@page "/pt-BR/tools/ph-calculator"
@using System.Globalization
@using Portfolio.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    @if (IsDilution)
    {
        <SiteToolForm Action="@Action"
            SubmitLabel="@SubmitLabel"
            Submit="SiteToolFormSubmit.StaticOnly"
            OnSubmit="HandleSubmit"
            AriaLabel="C₁ (mol/L)">
            <SiteFormField Label="C₁ (mol/L)"
                For="dilution-c1"><SiteInput Id="dilution-c1"
                    Name="c1"
                    Type="number"
                    min="0"
                    step="any"
                    Value="@C1Text"
                    ValueChanged="@(v => C1Text = v)" /></SiteFormField>
            <SiteFormField Label="V₁ (L)"
                For="dilution-v1"><SiteInput Id="dilution-v1"
                    Name="v1"
                    Type="number"
                    min="0"
                    step="any"
                    Value="@V1Text"
                    ValueChanged="@(v => V1Text = v)" /></SiteFormField>
            <SiteFormField Label="C₂ (mol/L)"
                For="dilution-c2"><SiteInput Id="dilution-c2"
                    Name="c2"
                    Type="number"
                    min="0"
                    step="any"
                    Value="@C2Text"
                    ValueChanged="@(v => C2Text = v)" /></SiteFormField>
            <SiteFormField Label="V₂ (L)"
                For="dilution-v2"><SiteInput Id="dilution-v2"
                    Name="v2"
                    Type="number"
                    min="0"
                    step="any"
                    Value="@V2Text"
                    ValueChanged="@(v => V2Text = v)" /></SiteFormField>
        </SiteToolForm>
        @if (!Dilution.IsValid) { <SiteErrorMessage>@ErrorLabel</SiteErrorMessage> }
        else
        {
            <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
                <SiteStats>
                    <SiteStatItem Label="C₁">@Format(Dilution.C1) mol/L</SiteStatItem>
                        <SiteStatItem Label="V₁">@Format(Dilution.V1) L</SiteStatItem>
                            <SiteStatItem Label="C₂">@Format(Dilution.C2) mol/L</SiteStatItem>
                                <SiteStatItem Label="V₂">@Format(Dilution.V2) L</SiteStatItem>
                            </SiteStats>
            </SiteLiveRegion>
        }
    }
    else
    {
        <SiteToolForm Action="@Action"
            SubmitLabel="@SubmitLabel"
            Submit="SiteToolFormSubmit.StaticOnly"
            OnSubmit="HandleSubmit"
            AriaLabel="@($"{ConcentrationLabel} (mol/L)")">
            <SiteFormField Label="@($"{ConcentrationLabel} (mol/L)")"
                For="ph-concentration"><SiteInput Id="ph-concentration"
                    Name="concentration"
                    Type="number"
                    min="0"
                    step="any"
                    Value="@ConcentrationText"
                    ValueChanged="@(v => ConcentrationText = v)" /></SiteFormField>
        </SiteToolForm>
        @if (!Ph.IsValid) { <SiteErrorMessage>@ErrorLabel</SiteErrorMessage> }
        else { <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
            <SiteStats>
                <SiteStatItem Label="pH">@Format(Ph.Ph)</SiteStatItem>
                    <SiteStatItem Label="pOH">@Format(Ph.Poh)</SiteStatItem>
                </SiteStats>
            </SiteLiveRegion> }
    }
</ToolPage>
