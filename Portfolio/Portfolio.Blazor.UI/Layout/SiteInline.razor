<div class="@RootClass"
    data-slot="inline"
    data-gap="@GapToken"
    data-align="@AlignToken"
    data-justify="@JustifyToken"
    data-wrap="@Wrap.ToString().ToLowerInvariant()"
    @attributes="ForwardedAttributes">@ChildContent</div>

@code {
    /// <summary>Gap between inline children.</summary>
    [Parameter]
    public SiteSpace Gap { get; set; } = SiteSpace.Sm;
    /// <summary>Cross-axis alignment of the inline children.</summary>
    [Parameter]
    public SiteAlign Align { get; set; } = SiteAlign.Center;
    /// <summary>Main-axis justification of the inline children.</summary>
    [Parameter]
    public SiteJustify Justify { get; set; } = SiteJustify.Start;
    /// <summary>Whether children wrap onto multiple lines.</summary>
    [Parameter]
    public bool Wrap { get; set; } = true;
    /// <summary>Extra class applied to the root element.</summary>
    [Parameter]
    public string? Class { get; set; }
    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string RootClass => SiteCss.Join("site-inline", Class);

    private string GapToken => SiteTokens.Gap(Gap);

    private string AlignToken => SiteTokens.Align(Align);

    private string JustifyToken => Justify switch
    {
        SiteJustify.Center => "center",
        SiteJustify.End => "end",
        SiteJustify.Between => "between",
        _ => "start",
    };

    private IReadOnlyDictionary<string, object> ForwardedAttributes => AdditionalAttributes ?? new Dictionary<string, object>();
}
