@inherits SiteInputBase

<label class="@RootClass" data-slot="switch">
    <BlazorBlueprint.Primitives.Switch.BbSwitch Checked="@Value"
        CheckedChanged="HandleChanged"
        Disabled="@Disabled"
        AdditionalAttributes="@SwitchAttributes">
        <BlazorBlueprint.Primitives.Switch.BbSwitchThumb AdditionalAttributes="@ThumbAttributes" />
    </BlazorBlueprint.Primitives.Switch.BbSwitch>
    <span class="site-switch-label">@Label</span>
</label>
