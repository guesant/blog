@inherits ContentPageBase
@page "/topics/{Slug}"
@page "/pt-BR/topics/{Slug}"
@using Microsoft.AspNetCore.Components
@using Portfolio.Blazor.Core

<PageTitle>@Title</PageTitle>
<SeoHead Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath" />

<SitePage Template="topic-detail">
    <SiteBreadcrumb HomeUrl="@LocalizedPath("home")"
        HomeLabel="@(L["legacy_ddc150008e2f"])"
        Links="@BreadcrumbLinks"
        CurrentLabel="@Title" />

    @if (Snapshot is null)
    {
        <SiteHero Title="@LoadingLabel" />
    }
    else if (Topic is null)
    {
        <SiteHero Title="@NotFoundLabel"
            Lead="@NotFoundDescription"><ChildContent>
                <SiteLink Variant="SiteButtonVariant.Outline" Href="@IndexUrl">
                    <SiteIcon Name="arrow-left" Size="14" />@BackLabel</SiteLink>
                </ChildContent>
            </SiteHero>
    }
    else
    {
        <SiteHero Title="@Title" Lead="@Description" BackHref="@IndexUrl" BackLabel="@BackLabel" />
        @if (Writings.Count == 0 && Findings.Count == 0)
        {
            <SiteEmptyState Message="@EmptyLabel" />
        }
        else
        {
            @if (Writings.Count > 0)
            {
                <SiteSection Region="writing"
                    HeadingId="topic-writing-heading"
                    Title="@(L["legacy_ebede9852c81"])">
                    <SiteGrid>
                        @foreach (var item in Writings)
                        {
                            <SiteGridColumn>
                                <SiteClickableCard Label="@JoinMeta(WritingKind(item.Type), FormatDate(item.Date), item.ReadingTime)"
                                    Class="h-100"
                                    Href="@LocalizedUrl(item.Url)"
                                    Title="@item.Title"
                                    TitleClass="h5"
                                    HeadingLevel="3">
                                    @if (!string.IsNullOrWhiteSpace(item.Excerpt)) { <SiteText Variant="SiteTextVariant.Excerpt">@item.Excerpt</SiteText> }
                                </SiteClickableCard>
                            </SiteGridColumn>
                        }
                    </SiteGrid>
                </SiteSection>
            }
            @if (Findings.Count > 0)
            {
                <SiteSection Region="findings"
                    HeadingId="topic-findings-heading"
                    Title="@(L["legacy_a2d8de463c5a"])">
                    <SiteGrid>
                        @foreach (var item in Findings)
                        {
                            <SiteGridColumn>
                                <SiteClickableCard Label="@JoinMeta(FindingKind(item.Type), FormatDate(item.PublishedDate), RatingName(item.Rating))"
                                    Class="h-100"
                                    Href="@LocalizedUrl(item.Url)"
                                    Title="@(item.Title ?? item.Slug)"
                                    TitleClass="h5"
                                    HeadingLevel="3">
                                    @if (!string.IsNullOrWhiteSpace(item.Description)) { <SiteText Variant="SiteTextVariant.Excerpt">@item.Description</SiteText> }
                                    @if (item.Topics is { Count: > 0 }) { <SiteChipGroup>@foreach (var topic in item.Topics.Take(3)) { <SiteChip Label="@(topic.Name ?? topic.Slug)" Href="@LocalizedUrl(topic.Url ?? $"/topics/{topic.Slug}")" /> }</SiteChipGroup> }
                                </SiteClickableCard>
                            </SiteGridColumn>
                        }
                    </SiteGrid>
                </SiteSection>
            }
        }
        <ContentRelations CurrentUrl="@CanonicalPath" />
    }
</SitePage>
