@inherits LocalizedComponentBase
@page "/tools/random-string-generator"
@page "/pt-BR/tools/random-string-generator"
@using System.Globalization
@using Blog.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action"
        SubmitLabel="@GenerateLabel"
        Submit="SiteToolFormSubmit.Always"
        OnSubmit="Generate"
        AriaLabel="@LengthLabel">
        <SiteFormField Label="@LengthLabel" For="random-string-length">
            <SiteRangeInput Id="random-string-length"
                Name="length"
                min="1"
                max="64"
                Value="@Length"
                ValueChanged="@(v => Length = v)" />
            @if (RendererInfo.IsInteractive) { <SiteText Variant="SiteTextVariant.Meta">@Length</SiteText> }
        </SiteFormField>
        <SiteFormField Label="@CountLabel"
            For="random-string-count"><SiteInput Id="random-string-count"
                Name="count"
                Type="number"
                min="1"
                max="50"
                Value="@CountText"
                ValueChanged="@(v => CountText = v)" /></SiteFormField>
        <SiteFormActions>
            <SiteCheckbox Label="@LowercaseLabel"
                Name="lowercase"
                Value="@Lowercase"
                ValueChanged="@(v => Lowercase = v)"
                HtmlValue="true" />
            <SiteCheckbox Label="@UppercaseLabel"
                Name="uppercase"
                Value="@Uppercase"
                ValueChanged="@(v => Uppercase = v)"
                HtmlValue="true" />
            <SiteCheckbox Label="@NumbersLabel"
                Name="numbers"
                Value="@Numbers"
                ValueChanged="@(v => Numbers = v)"
                HtmlValue="true" />
            <SiteCheckbox Label="@SymbolsLabel"
                Name="symbols"
                Value="@Symbols"
                ValueChanged="@(v => Symbols = v)"
                HtmlValue="true" />
        </SiteFormActions>
    </SiteToolForm>
    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (Result.Error is not null) { <SiteErrorMessage>@ErrorLabel</SiteErrorMessage> }
        <SiteCard Class="site-block" Label="@ResultLabel">
            <SiteList>@foreach (var value in Result.Values) { <SiteListItem Class="list-group-item site-list-row tool-list-item">
                <SiteText Variant="SiteTextVariant.Meta" Class="tool-list-value">@value</SiteText>
            </SiteListItem> }</SiteList>
        </SiteCard>
    </SiteLiveRegion>
</ToolPage>
