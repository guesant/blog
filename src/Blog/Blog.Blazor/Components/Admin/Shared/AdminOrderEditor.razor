@typeparam TItem

<SitePageHeader Title="@Title" BackHref="@ListRoute" BackLabel="Back to list">
    <Actions>
        <SiteButton Variant="SiteButtonVariant.Default"
            Loading="@IsSaving"
            OnClick="@(() => OnSave.InvokeAsync())">
            <SiteIcon Name="check" Size="14" />Save order</SiteButton>
    </Actions>
</SitePageHeader>

@if (Error is not null)
{
    <SiteNotice Tone="SiteTone.Danger">@Error</SiteNotice>
}

@if (IsLoading)
{
    <SiteLoading Label="Loading…" />
}
else
{
    <SiteSortableList TItem="TItem"
        Items="@Items"
        AriaLabel="@Title"
        OnReordered="@(change => OnReordered.InvokeAsync(change))">
        <ItemTemplate Context="item">
            <SiteText Variant="SiteTextVariant.Small">@DisplayTitle(item)</SiteText>
        </ItemTemplate>
    </SiteSortableList>
}
