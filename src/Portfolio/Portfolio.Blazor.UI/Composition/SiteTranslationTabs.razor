<div class="site-translation-tabs" data-slot="translation-tabs">
    <BlazorBlueprint.Primitives.Tabs.BbTabs Value="@ActiveLocale"
        ValueChanged="ActiveLocaleChanged">
        <BlazorBlueprint.Primitives.Tabs.BbTabsList AdditionalAttributes="@TabListAttributes">
            @foreach (var locale in Locales)
            {
                <BlazorBlueprint.Primitives.Tabs.BbTabsTrigger Value="@locale.Code"
                    AdditionalAttributes="@TabTriggerAttributes">
                    @locale.Label
                </BlazorBlueprint.Primitives.Tabs.BbTabsTrigger>
            }
        </BlazorBlueprint.Primitives.Tabs.BbTabsList>
        @foreach (var locale in Locales)
        {
            <BlazorBlueprint.Primitives.Tabs.BbTabsContent Value="@locale.Code"
                ForceMount="true"
                AdditionalAttributes="@PanelAttributes">
                @Panel(locale.Code)
            </BlazorBlueprint.Primitives.Tabs.BbTabsContent>
        }
    </BlazorBlueprint.Primitives.Tabs.BbTabs>
</div>
