@attribute [Stories("Feedback/SiteToastHost")]
@inject SiteToastService Toasts

<Stories TComponent="SiteToastHost">

    <Story Name="Default">
        <Template>
            <SiteInline>
                <SiteButton OnClick="@(() => Toasts.Success("saved."))">success</SiteButton>
                <SiteButton OnClick="@(() => Toasts.Error("could not save."))">error</SiteButton>
                <SiteButton OnClick="@(() => Toasts.Info("nothing changed."))">info</SiteButton>
            </SiteInline>
            <SiteToastHost />
        </Template>
    </Story>

</Stories>
