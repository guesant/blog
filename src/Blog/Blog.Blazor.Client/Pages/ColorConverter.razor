@inherits LocalizedComponentBase
@page "/tools/color-converter"
@page "/pt-BR/tools/color-converter"
@using Blog.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action" SubmitLabel="@SubmitLabel" AriaLabel="@InputLabel">
        <SiteFormField For="color-input"
            Label="@InputLabel"><SiteInput Id="color-input"
                Name="input"
                Type="text"
                placeholder="#4f46e5"
                autocomplete="off"
                spellcheck="false"
                Value="@Input"
                ValueChanged="@(v => Input = v)" /></SiteFormField>
    </SiteToolForm>

    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (Result.HasInput && !Result.IsValid)
        {
            <SiteErrorMessage>@InvalidLabel</SiteErrorMessage>
        }
        <SitePreviewBox Class="tool-color-swatch"
            Style="@($"background-color: {Result.CssColor}")"
            AriaLabel="@SwatchLabel" />
        <SiteFormActions>
            <SiteFormField For="color-hex" Label="@HexLabel">
                <SiteInput Id="color-hex" readonly Value="@Result.Hex" />
            </SiteFormField>
            <SiteFormField For="color-rgb" Label="@RgbLabel">
                <SiteInput Id="color-rgb" readonly Value="@Result.Rgb" />
            </SiteFormField>
            <SiteFormField For="color-hsl" Label="@HslLabel">
                <SiteInput Id="color-hsl" readonly Value="@Result.Hsl" />
            </SiteFormField>
        </SiteFormActions>
    </SiteLiveRegion>
</ToolPage>
