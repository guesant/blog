@inherits LocalizedComponentBase
@page "/tools/complex-number-calculator"
@page "/pt-BR/tools/complex-number-calculator"
@using System.Globalization
@using Portfolio.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteNotice>@Note</SiteNotice>
    <SiteToolForm Action="@Action"
        SubmitLabel="@SubmitLabel"
        Submit="SiteToolFormSubmit.StaticOnly"
        OnSubmit="Calculate"
        AriaLabel="z₁">
        <SiteFormField Label="z₁"
            For="complex-first"><SiteInput Id="complex-first"
                Name="first"
                Type="text"
                Value="@FirstText"
                ValueChanged="@(value => FirstText = value)" /></SiteFormField>
        <SiteFormField Label="@OperationLabel"
            For="complex-operation"><SiteSelect Id="complex-operation"
                Name="operation"
                @bind-Value="OperationText"
                Options="@OperationOptions"
                Placeholder="@OperationLabel"
                EmptyText="@OperationLabel" /></SiteFormField>
        <SiteFormField Label="z₂"
            For="complex-second"><SiteInput Id="complex-second"
                Name="second"
                Type="text"
                Value="@SecondText"
                ValueChanged="@(value => SecondText = value)" /></SiteFormField>
    </SiteToolForm>
    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (!Result.IsValid) { <SiteErrorMessage>@ErrorLabel</SiteErrorMessage> } else { <SiteCard Class="site-block" Label="@Title">
            <SiteText Variant="SiteTextVariant.Body"
                Class="tool-result-value">@Format(Result.Value) · |z| = @Format(Result.Magnitude)</SiteText>
        </SiteCard> }
    </SiteLiveRegion>
</ToolPage>
