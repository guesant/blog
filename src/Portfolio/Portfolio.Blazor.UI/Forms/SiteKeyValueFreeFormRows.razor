<SiteStack Gap="SiteSpace.Sm" Class="@Class">
    @if (ShowSectionLabel)
    {
        <SiteText Variant="SiteTextVariant.SectionLabel">@SectionLabel</SiteText>
    }
    <div class="site-key-value-free-grid">
    @foreach (var rowIndex in Indices)
    {
        <SiteInline Gap="SiteSpace.Sm" Class="@RowClass">
            <SiteTextInput Id="@($"{RootId}-free-{rowIndex}-key")"
                Placeholder="@KeyPlaceholder"
                Value="@Rows[rowIndex].Key"
                ValueChanged="@(value => KeyChanged.InvokeAsync((rowIndex, value)))" />
            <SiteTextInput Id="@($"{RootId}-free-{rowIndex}-value")"
                Placeholder="@ValuePlaceholder"
                Value="@Rows[rowIndex].Value"
                ValueChanged="@(value => ValueEdited.InvokeAsync((rowIndex, value)))" />
            <SiteButton Variant="SiteButtonVariant.Outline"
                @onclick="@(() => Removed.InvokeAsync(rowIndex))"><SiteIcon Name="trash-2"
                    Size="14" />@RemoveLabel</SiteButton>
        </SiteInline>
    }
    </div>
    <SiteButton Variant="SiteButtonVariant.Outline" @onclick="@(() => Added.InvokeAsync())">
        <SiteIcon Name="plus" Size="14" />@AddLabel</SiteButton>
</SiteStack>
