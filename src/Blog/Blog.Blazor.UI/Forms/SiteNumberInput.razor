@typeparam TValue
@inherits SiteInputBase

<input type="number"
       id="@ResolvedId"
       name="@Name"
       value="@FormatValue(Value)"
       step="@Step"
       min="@(Min is null ? null : FormatValue(Min))"
       max="@(Max is null ? null : FormatValue(Max))"
       class="@InputClass"
       aria-describedby="@FieldContext?.DescribedBy"
       aria-required="@(FieldContext?.Required == true ? "true" : null)"
       aria-invalid="@(FieldContext?.Invalid == true ? "true" : null)"
       @attributes="ForwardedAttributes"
       @oninput="HandleInput" />
