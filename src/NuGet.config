<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="Microsoft.*" />
      <package pattern="System.*" />
      <package pattern="pax.BlazorChartJs" />
      <package pattern="BlazorBlueprint.*" />
      <package pattern="QRCoder" />
      <package pattern="Konscious.Security.Cryptography.*" />
      <!-- Transitive deps of BlazorBlueprint.Primitives. -->
      <package pattern="HtmlSanitizer" />
      <package pattern="Markdig" />
      <package pattern="TailwindMerge.NET" />
      <package pattern="AngleSharp" />
      <package pattern="AngleSharp.Css" />
      <package pattern="Planetarium.LruCacheNet" />
      <!-- BlazingStory and its Toolbelt transitives back the dev-only story catalog. -->
      <package pattern="BlazingStory" />
      <package pattern="BlazingStory.*" />
      <package pattern="Toolbelt.*" />
      <!-- Transitive deps of Microsoft.EntityFrameworkCore.Design, used only by
           Portfolio.Blazor.Database to author migrations. -->
      <package pattern="Humanizer.Core" />
      <package pattern="Mono.TextTemplating" />
      <package pattern="Newtonsoft.Json" />
      <package pattern="dotnet-ef" />
      <!-- PostgreSQL provider and its transitives. -->
      <package pattern="Npgsql" />
      <package pattern="Npgsql.*" />
      <!-- Formatter tool restored by `just format`; it never ships in the app. -->
      <package pattern="csharpier" />
    </packageSource>
  </packageSourceMapping>
</configuration>
