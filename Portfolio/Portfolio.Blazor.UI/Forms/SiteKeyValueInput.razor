@inherits SiteKeyValueRowsInputBase

<div class="site-key-value-input" data-slot="key-value-input" id="@Id">
    @for (var index = 0; index < Rows.Count; index++)
    {
        var rowIndex = index;
        <SiteInline Gap="SiteSpace.Sm" Class="site-key-value-row">
            <SiteTextInput Placeholder="@KeyPlaceholder"
                Value="@Rows[rowIndex].Key"
                ValueChanged="@(value => HandleKeyChanged(rowIndex, value))" />
            <SiteTextInput Placeholder="@ValuePlaceholder"
                Value="@Rows[rowIndex].Value"
                ValueChanged="@(value => HandleValueChanged(rowIndex, value))" />
            <SiteButton Variant="SiteButtonVariant.Outline"
                @onclick="@(() => RemoveRow(rowIndex))"><SiteIcon Name="trash-2"
                    Size="14" />@RemoveLabel</SiteButton>
        </SiteInline>
    }
    <SiteButton Variant="SiteButtonVariant.Outline" @onclick="AddRow">
        <SiteIcon Name="plus" Size="14" />@AddLabel</SiteButton>
</div>

@code {
    [Parameter]
    public string? Id { get; set; }

    private void HandleKeyChanged(int index, string value)
    {
        Rows[index] = (value, Rows[index].Value);
        NotifyChanged();
    }

    private void HandleValueChanged(int index, string value)
    {
        Rows[index] = (Rows[index].Key, value);
        NotifyChanged();
    }
}
