@if (IsLink)
{
    <li>
        <SiteLink Variant="SiteButtonVariant.Outline"
            Class="@LinkClass"
            Href="@(Href ?? string.Empty)"
            aria-label="@AriaLabel"
            @attributes="AdditionalAttributes">
            @ChildContent
        </SiteLink>
    </li>
}
else
{
    <li class="@StaticClass" @attributes="AdditionalAttributes">
        @ChildContent
    </li>
}
