@if (IsInlineTag)
{
    <span class="@RootClass"
        data-slot="text"
        data-variant="@VariantToken"
        @attributes="ForwardedAttributes">@ChildContent</span>
}
else
{
    <p class="@RootClass"
        data-slot="text"
        data-variant="@VariantToken"
        @attributes="ForwardedAttributes">@ChildContent</p>
}
