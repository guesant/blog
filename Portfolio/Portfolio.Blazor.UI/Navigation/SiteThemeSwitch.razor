<SiteToggleGroup AriaLabel="@Label"
    Class="site-theme-switch"
    data-theme-switch="true"
    @attributes="AdditionalAttributes">
    @foreach (var option in Options)
    {
        <SiteButton Variant="SiteButtonVariant.Outline"
            Size="SiteButtonSize.Sm"
            Class="site-toggle-link"
            aria-pressed="false"
            aria-label="@option.Label"
            title="@option.Label"
            data-theme-value="@option.Value"><SiteIcon Name="@option.Icon" Size="14" />
            </SiteButton>
    }
</SiteToggleGroup>
