@inherits LocalizedComponentBase
@implements IDisposable
@page "/tools/normal-distribution"
@page "/pt-BR/tools/normal-distribution"
@using System.Globalization
@using Blog.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action"
        SubmitLabel="@SubmitLabel"
        Submit="SiteToolFormSubmit.StaticOnly"
        OnSubmit="Calculate">
        <SiteFormField Label="@($"μ ({MeanLabel})")"
            For="normal-mean"><SiteInput Id="normal-mean"
                Name="mean"
                Type="number"
                step="any"
                Value="@MeanText"
                ValueChanged="@(v => MeanText = v)" /></SiteFormField>
        <SiteFormField Label="@($"σ ({DeviationLabel})")"
            For="normal-deviation"><SiteInput Id="normal-deviation"
                Name="deviation"
                Type="number"
                min="0"
                step="any"
                Value="@DeviationText"
                ValueChanged="@(v => DeviationText = v)" /></SiteFormField>
        <SiteFormField Label="@($"x ({PointLabel})")"
            For="normal-point"><SiteInput Id="normal-point"
                Name="point"
                Type="number"
                step="any"
                Value="@PointText"
                ValueChanged="@(v => PointText = v)" /></SiteFormField>
    </SiteToolForm>

    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (!Result.IsValid)
        {
            <SiteErrorMessage>@ErrorLabel</SiteErrorMessage>
        }
        else
        {
            <SiteStats>
                <SiteStatItem Label="z">@Format(Result.Z)</SiteStatItem>
                <SiteStatItem Label="@ProbabilityLabel">@Percent(Result.CumulativeProbability)</SiteStatItem>
                <SiteStatItem Label="@DensityLabel">@Format(Result.Density)</SiteStatItem>
            </SiteStats>
            <SiteCard Class="site-block" Label="@ChartLabel">
                @if (RendererInfo.IsInteractive)
                {
                    <SiteChart ChartJsConfig="@ChartConfig" AriaLabel="@ChartLabel" />
                }
                else
                {
                    <SiteText Variant="SiteTextVariant.Body"
                        id="normal-chart-description">@Description</SiteText>
                    <SiteList Variant="SiteListVariant.Boxed"
                        AriaLabel="@ChartLabel">@foreach (var point in Result.Points) { <SiteListItem Class="site-text-list-item">@Format(point.X): @Format(point.Density)</SiteListItem> }</SiteList>
                }
            </SiteCard>
        }
    </SiteLiveRegion>
</ToolPage>
