@inherits LocalizedComponentBase
@page "/tools/age-calculator"
@page "/pt-BR/tools/age-calculator"
@page "/tools/bmi-calculator"
@page "/pt-BR/tools/bmi-calculator"
@page "/tools/date-difference-calculator"
@page "/pt-BR/tools/date-difference-calculator"
@using System.Globalization
@using Blog.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    @if (Slug == "age-calculator")
    {
        <SiteToolForm Action="@Action"
            SubmitLabel="@SubmitLabel"
            Submit="SiteToolFormSubmit.StaticOnly"
            OnSubmit="Calculate"
            AriaLabel="@BirthLabel">
            <SiteFormField For="age-birth"
                Label="@BirthLabel"><SiteInput Id="age-birth"
                    Name="birth"
                    Type="date"
                    Value="@BirthText"
                    ValueChanged="@(v => { BirthText = v; Calculate(); })" /></SiteFormField>
        </SiteToolForm>
        @if (Age.IsValid) { <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
            <SiteStats>
                <SiteStatItem Label="@ResultLabel">@Age.Years @YearsLabel, @Age.Months @MonthsLabel, @Age.Days @DaysLabel</SiteStatItem>
            </SiteStats>
        </SiteLiveRegion> }
    }
    else if (Slug == "bmi-calculator")
    {
        <SiteToolForm Action="@Action"
            SubmitLabel="@SubmitLabel"
            Submit="SiteToolFormSubmit.StaticOnly"
            OnSubmit="Calculate"
            AriaLabel="@WeightLabel">
            <SiteFormField For="bmi-weight"
                Label="@WeightLabel"><SiteInput Id="bmi-weight"
                    Name="weight"
                    Type="number"
                    step="any"
                    Value="@WeightText"
                    ValueChanged="@(v => { WeightText = v; Calculate(); })" /></SiteFormField>
            <SiteFormField For="bmi-height"
                Label="@HeightLabel"><SiteInput Id="bmi-height"
                    Name="height"
                    Type="number"
                    step="any"
                    Value="@HeightText"
                    ValueChanged="@(v => { HeightText = v; Calculate(); })" /></SiteFormField>
        </SiteToolForm>
        @if (Bmi.IsValid) { <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
            <SiteStats>
                <SiteStatItem Label="@ResultLabel">@Bmi.Value.ToString("G6", CultureInfo.InvariantCulture) · @Bmi.Category</SiteStatItem>
            </SiteStats>
        </SiteLiveRegion> }
    }
    else
    {
        <SiteToolForm Action="@Action"
            SubmitLabel="@SubmitLabel"
            Submit="SiteToolFormSubmit.StaticOnly"
            OnSubmit="Calculate"
            AriaLabel="@StartLabel">
            <SiteFormField For="date-start"
                Label="@StartLabel"><SiteInput Id="date-start"
                    Name="start"
                    Type="date"
                    Value="@StartText"
                    ValueChanged="@(v => { StartText = v; Calculate(); })" /></SiteFormField>
            <SiteFormField For="date-end"
                Label="@EndLabel"><SiteInput Id="date-end"
                    Name="end"
                    Type="date"
                    Value="@EndText"
                    ValueChanged="@(v => { EndText = v; Calculate(); })" /></SiteFormField>
        </SiteToolForm>
        @if (DateDifference.HasInput && !DateDifference.IsValid) { <SiteErrorMessage>@InvalidDateLabel</SiteErrorMessage> }
        <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
            @if (DateDifference.Reversed) { <SiteNotice>@DateOrderNote</SiteNotice> }
            <SiteStats Grid="true">
                <SiteStatItem Label="@TotalDaysLabel">@(DateDifference.IsValid ? DateDifference.TotalDays : '—')</SiteStatItem>
                    <SiteStatItem Label="@YearsLabel">@(DateDifference.IsValid ? DateDifference.Years : '—')</SiteStatItem>
                        <SiteStatItem Label="@MonthsLabel">@(DateDifference.IsValid ? DateDifference.Months : '—')</SiteStatItem>
                            <SiteStatItem Label="@DaysLabel">@(DateDifference.IsValid ? DateDifference.Days : '—')</SiteStatItem>
                        </SiteStats>
        </SiteLiveRegion>
    }
</ToolPage>
