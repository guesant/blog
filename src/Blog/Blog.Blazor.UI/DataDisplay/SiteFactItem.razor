<div class="@RootClass" data-slot="fact-item">
    <dt class="site-fact-item-label">
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <SiteIcon Name="@Icon" Size="12" Class="icon site-fact-item-icon" />
        }
        @Label
    </dt>
    <dd class="site-fact-item-value">@ChildContent</dd>
</div>
