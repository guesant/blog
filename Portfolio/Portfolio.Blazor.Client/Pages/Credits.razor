@inherits ListPageBase
@page "/credits"
@page "/pt-BR/credits"
@using Portfolio.Blazor.Core

<PageTitle>@Title</PageTitle>
<SeoHead Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath" />

<SitePage Template="credits">
    <SiteBreadcrumb HomeUrl="@(L["legacy_0607643fd42c"])"
        HomeLabel="@(L["legacy_ddc150008e2f"])"
        CurrentLabel="@Title" />
    <SiteHero Title="@Title"
        Lead="@Description"
        BackHref="@(L["legacy_0607643fd42c"])"
        BackLabel="@(L["legacy_ddc150008e2f"])" />
    @if (Snapshot is null || Snapshot.Credits.Count == 0)
    {
        <SiteListingShell HasResults="false"
            CurrentPage="@CurrentPage"
            TotalPages="@PageCount"
            PaginationLabel="@(L["legacy_ce41390e654d"] )"
            PreviousLabel="@(L["legacy_c3b535ded088"] )"
            NextLabel="@(L["legacy_a6c78a6436e2"] )"
            Href="@PageUrl">
            <EmptyContent>
                <SiteEmptyState Message="@(L["legacy_3baca6489d5c"])" />
            </EmptyContent>
        </SiteListingShell>
    }
    else
    {
        <SiteListingShell HasResults="@(PagedCredits.Count > 0)"
            Summary="@ListingSummary(PagedCredits.Count, SortedCredits.Count, CurrentPage, PageCount)"
            CurrentPage="@CurrentPage"
            TotalPages="@PageCount"
            PaginationLabel="@(L["legacy_ce41390e654d"])"
            PreviousLabel="@(L["legacy_c3b535ded088"])"
            NextLabel="@(L["legacy_a6c78a6436e2"])"
            Href="@PageUrl">
        <FilterContent>
            <SiteListingFilterBar Action="@Action"
                    ApplyLabel="@(L["legacy_c975d2551cc4"])"
                    ClearLabel="@(L["legacy_5262517729fc"])"
                    ClearHref="@Action"
                    OnApply="@(() => HandleApply(Action, SortValue, Search, DenseView))">
                    <PrimaryFields>
                        <SiteFilterSelect Icon="arrow-up-down"
                            Label="@(L["legacy_4c302e056a19"])"
                            Id="credits-sort"
                            Name="sort"
                            @bind-Value="SortValue"
                            Options="@SortOptions"
                            Placeholder="@(L["legacy_d878d9136e0e"])"
                            EmptyText="@(L["legacy_0bb89437e6cb"])" />
                    </PrimaryFields>
                    <SearchField>
                        <SiteSearchField Label="@(L["legacy_6bb12bff6f09"])"
                            Id="credits-search"
                            Name="q"
                            Value="@Search"
                            ValueChanged="@((string value) => Search = value)"
                            Placeholder="@(L["search_by_name"])" />
                    </SearchField>
                </SiteListingFilterBar>
        </FilterContent>
        <ResultContent>
        <SiteStack Gap="SiteSpace.Lg" id="view-spacious-credits" data-layout-region="items">
            @foreach (var group in CreditSections)
            {
                @if (group.Items.Count > 0)
                {
                    <SiteSection Region="@($"credits-{group.Key}")"
                        HeadingId="@($"credits-{group.Key}-heading")"
                        Title="@group.Label">
                        <SiteGrid>
                            @foreach (var credit in group.Items)
                            {
                                <SiteGridColumn>
                                    <SiteFeedCard KindLabel="@group.Label"
                                        Title="@credit.Name"
                                        Href="@(group.LinkItems ? SafeUrl(credit.Url) : null)"
                                        External="true"
                                        Preview="@credit.Description"
                                        ViewLabel="@(L["open"])" />
                                </SiteGridColumn>
                            }
                        </SiteGrid>
                    </SiteSection>
                }
            }
        </SiteStack>
        </ResultContent>
        </SiteListingShell>
    }
</SitePage>
