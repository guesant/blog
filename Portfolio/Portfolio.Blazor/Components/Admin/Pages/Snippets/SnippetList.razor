@page "/admin/snippets"
@page "/admin/snippets/order"
@inherits AdminListPageBase<Snippet>
@layout AdminLayout

<PageTitle>Snippets</PageTitle>

@if (IsOrderMode)
{
    <AdminOrderEditor TItem="Snippet"
        Title="Snippets order"
        ListRoute="/admin/snippets"
        Items="@Items"
        DisplayTitle="@DisplayTitle"
        IsLoading="@IsLoading"
        IsSaving="@IsSaving"
        Error="@Error"
        OnReordered="HandleReorder"
        OnSave="@(() => HandleSaveOrderAsync("/admin/snippets"))" />
}
else
{
    <SitePageHeader Title="Snippets">
        <Actions>
            <SiteInline Gap="SiteSpace.Sm">
                <SiteLink Variant="SiteButtonVariant.Outline" Href="/admin/snippets/order">
                    <SiteIcon Name="arrow-up-down" Size="14" />Edit order</SiteLink>
                <SiteLink Variant="SiteButtonVariant.Default" Href="/admin/snippets/create">
                    <SiteIcon Name="plus" Size="14" />New snippet</SiteLink>
            </SiteInline>
        </Actions>
    </SitePageHeader>

    @if (Error is not null)
    {
        <SiteNotice Tone="SiteTone.Danger">@Error</SiteNotice>
    }

    @if (IsLoading)
    {
        <SiteLoading Label="Loading…" />
    }
    else
    {
        <SiteDataTable TItem="Snippet"
            Items="@PageItems"
            EmptyText="No snippets yet."
            RowKey="@(snippet => snippet.Id)">
            <Columns>
                <SiteColumn TItem="Snippet" Header="Title" IsRowHeader="true">
                    <Cell Context="snippet">@DisplayTitle(snippet)</Cell>
                </SiteColumn>
                <SiteColumn TItem="Snippet" Header="Slug">
                    <Cell Context="snippet">@snippet.Slug</Cell>
                </SiteColumn>
                <SiteColumn TItem="Snippet" Header="Files">
                    <Cell Context="snippet">@snippet.Files.Count</Cell>
                </SiteColumn>
                <SiteColumn TItem="Snippet"
                    Header="Status"><Cell Context="snippet">@if (snippet.Hidden) { <SiteBadge Label="Hidden" /> }</Cell>
                    </SiteColumn>
                <SiteColumn TItem="Snippet"
                    Header="Published"><Cell Context="snippet">@(snippet.PublishedAt?.ToString("yyyy-MM-dd") ?? "·")</Cell>
                    </SiteColumn>
            </Columns>
            <Actions Context="snippet">
                <SiteInline Gap="SiteSpace.Sm">
                    <SiteLink Variant="SiteButtonVariant.Outline"
                        Href="@($"/admin/snippets/{snippet.Id}")">
                        <SiteIcon Name="pencil" Size="14" />Edit</SiteLink>
                    <SiteButton Variant="SiteButtonVariant.Destructive"
                        @onclick="@(() => HandleDeleteAsync(snippet))"><SiteIcon Name="trash-2"
                            Size="14" />Delete</SiteButton>
                </SiteInline>
            </Actions>
        </SiteDataTable>
        <SitePagination CurrentPage="@CurrentPage" TotalPages="@TotalPages" Href="@PageUrl" />
    }
}

@code {
    protected override string EntityLabel => "snippet";

    protected override void SetOrder(Snippet entity, int order) => entity.Order = order;

    protected override async Task<List<Snippet>> LoadEntitiesAsync(PortfolioAdminDbContext dbContext) =>
        await dbContext.Snippets
            .Include(snippet => snippet.Translations)
            .Include(snippet => snippet.Files)
            .AsNoTracking()
            .OrderBy(snippet => snippet.Order)
            .ThenBy(snippet => snippet.Slug)
            .ToListAsync();

    protected override Task<Snippet?> FindTrackedAsync(PortfolioAdminDbContext dbContext, int id) =>
        dbContext.Snippets.FirstOrDefaultAsync(candidate => candidate.Id == id);

    protected override string DisplayTitle(Snippet snippet) =>
        TranslationLookup.Resolve(snippet.Translations, translation => translation.Locale, translation => translation.Title, "en")
        ?? snippet.Slug;

    protected override int GetId(Snippet snippet) => snippet.Id;

    protected override string DeleteConfirmDescription(Snippet entity) =>
        "This permanently removes the snippet, its translations and its files. This cannot be undone.";
}
