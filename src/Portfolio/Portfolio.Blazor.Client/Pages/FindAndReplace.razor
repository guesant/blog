@inherits LocalizedComponentBase
@implements IDisposable
@page "/tools/find-and-replace"
@page "/pt-BR/tools/find-and-replace"
@using Portfolio.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action"
        SubmitLabel="@ReplaceButtonLabel"
        Submit="SiteToolFormSubmit.StaticOnly"
        OnSubmit="Replace"
        AriaLabel="@InputLabel">
        <SiteFormField For="find-replace-input"
            Label="@InputLabel"><SiteTextAreaInput Id="find-replace-input"
                Name="input"
                Rows="10"
                Value="@Input"
                ValueChanged="@(v => { Input = v; DebounceReplace(); })" /></SiteFormField>
        <SiteFormActions>
            <SiteFormField For="find-replace-find"
                Label="@FindLabel"><SiteInput Id="find-replace-find"
                    Name="find"
                    Type="text"
                    Value="@Find"
                    ValueChanged="@(v => { Find = v; DebounceReplace(); })" /></SiteFormField>
            <SiteFormField For="find-replace-replacement"
                Label="@ReplaceLabel"><SiteInput Id="find-replace-replacement"
                    Name="replacement"
                    Type="text"
                    Value="@Replacement"
                    ValueChanged="@(v => { Replacement = v; DebounceReplace(); })" /></SiteFormField>
        </SiteFormActions>
        <SiteFormActions>
            <SiteCheckbox Label="@CaseSensitiveLabel"
                Name="caseSensitive"
                HtmlValue="true"
                Value="@CaseSensitive"
                ValueChanged="@(v => { CaseSensitive = v; Replace(); })" />
            <SiteCheckbox Label="@UseRegexLabel"
                Name="useRegex"
                HtmlValue="true"
                Value="@UseRegex"
                ValueChanged="@(v => { UseRegex = v; Replace(); })" />
        </SiteFormActions>
    </SiteToolForm>
    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (!Result.IsValid) { <SiteErrorMessage>@InvalidRegexLabel: @Result.Error</SiteErrorMessage> }
        <SiteOutputField Id="find-replace-output"
            Label="@OutputLabel"
            Value="@Result.Output"
            Multiline="true"
            CopyLabel="@CopyLabel" />
    </SiteLiveRegion>
</ToolPage>
