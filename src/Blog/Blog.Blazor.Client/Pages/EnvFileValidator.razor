@inherits LocalizedComponentBase
@page "/tools/env-file-validator"
@page "/pt-BR/tools/env-file-validator"
@using Blog.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action" SubmitLabel="@ValidateLabel" AriaLabel="@InputLabel">
        <SiteFormField For="env-input"
            Label="@InputLabel"><SiteTextAreaInput Id="env-input"
                Name="content"
                Rows="10"
                Value="@Content"
                ValueChanged="@(v => Content = v)" /></SiteFormField>
    </SiteToolForm>
    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        <SiteHeading Level="2">@IssuesLabel</SiteHeading>
        @if (Result.Issues.Count == 0) { <SiteNotice>@NoIssuesLabel</SiteNotice> }
        else { <SiteList>@foreach (var issue in Result.Issues) { <SiteListItem Class="list-group-item site-list-row d-flex flex-wrap justify-content-between align-items-start tool-list-item">
            <SiteText Variant="SiteTextVariant.Meta"
                Class="tool-list-value">@LineLabel @issue.Line</SiteText>
                <SiteInlineError>@IssueMessage(issue)</SiteInlineError>
            </SiteListItem> }</SiteList> }
        <SiteHeading Level="2">@EntriesLabel</SiteHeading>
        <SiteList>@foreach (var entry in Result.Entries) { <SiteListItem Class="list-group-item site-list-row d-flex flex-wrap justify-content-between align-items-start tool-list-item">
            <SiteText Variant="SiteTextVariant.Meta" Class="tool-list-value">@entry.Key</SiteText>
                <SiteText Variant="SiteTextVariant.Meta">@entry.Value</SiteText>
            </SiteListItem> }</SiteList>
    </SiteLiveRegion>
</ToolPage>
