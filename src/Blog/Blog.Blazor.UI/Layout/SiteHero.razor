@using Microsoft.Extensions.Localization
@using Blog.Blazor.Core.Localization
@inject IStringLocalizer<SharedResource> L

<div class="site-hero hero">
    <div class="hero-title-row d-flex align-items-center gap-2">
        @if (!string.IsNullOrWhiteSpace(BackHref))
        {
            <SiteTooltip Text="@BackAriaLabel">
                <SiteLink Variant="SiteButtonVariant.Outline"
                    Size="SiteButtonSize.IconSm"
                    Href="@BackHref"
                    data-site-back
                    aria-label="@BackAriaLabel"><SiteIcon Name="arrow-left" Size="14" />
                    </SiteLink>
            </SiteTooltip>
        }
        @if (TitleContent is null)
        {
            <h1 class="site-page-title">@Title</h1>
        }
        else
        {
            @TitleContent
        }
        @if (Actions is not null)
        {
            <div class="hero-actions">@Actions</div>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(Lead))
    {
        <SiteText Variant="SiteTextVariant.Lead" Class="hero-lead">@Lead</SiteText>
    }
    @if (!string.IsNullOrWhiteSpace(Meta))
    {
        <SiteText Variant="SiteTextVariant.Meta" Class="hero-meta">@Meta</SiteText>
    }
    @ChildContent
</div>
