<div class="@RootClass" data-slot="save-bar" aria-busy="@(Saving ? "true" : "false")">
    <SiteInline Gap="SiteSpace.Sm">
        <SiteButton Variant="SiteButtonVariant.Default"
            Loading="@Saving"
            Type="SiteButtonType.Submit">@if (!Saving) { <SiteIcon Name="save"
                Size="14" /> }@(Saving ? SavingLabel : SubmitLabel)</SiteButton>
        <SiteLink Variant="SiteButtonVariant.Outline"
            Href="@CancelHref"
            aria-disabled="@(Saving ? "true" : null)"
            tabindex="@(Saving ? "-1" : null)"><SiteIcon Name="x"
                Size="14" />@CancelLabel</SiteLink>
    </SiteInline>
</div>
