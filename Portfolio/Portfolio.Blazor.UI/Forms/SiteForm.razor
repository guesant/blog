@if (EditContext is not null)
{
    <EditForm EditContext="@EditContext"
        OnValidSubmit="OnValidSubmit"
        OnInvalidSubmit="OnInvalidSubmit"
        class="@Class"
        @attributes="ForwardedAttributes">
        <DataAnnotationsValidator />
        @ChildContent
    </EditForm>
}
else if (Model is not null)
{
    <EditForm Model="@Model"
        OnValidSubmit="OnValidSubmit"
        OnInvalidSubmit="OnInvalidSubmit"
        class="@Class"
        @attributes="ForwardedAttributes">
        <DataAnnotationsValidator />
        @ChildContent
    </EditForm>
}
else if (ResolvedInteractive)
{
    <form class="@Class"
        data-layout-region="@Region"
        @onsubmit="HandleSubmit"
        @onsubmit:preventDefault="true"
        @attributes="ForwardedAttributes">
        @ChildContent
    </form>
}
else
{
    <form class="@Class"
        data-layout-region="@Region"
        action="@Action"
        method="@Method"
        data-enhance-nav="@(Enhance ? null : "false")"
        @attributes="ForwardedAttributes">
        @ChildContent
    </form>
}
