@page "/admin/case-studies/create"
@page "/admin/case-studies/{Id:int}"
@using System.Globalization
@using Portfolio.Blazor.Components.Admin.Shared
@inherits AdminEditPageBase<CaseStudy>
@layout AdminLayout

<PageTitle>@(IsEditing ? "Edit case study" : "New case study")</PageTitle>

<SiteFormShell Title="@(IsEditing ? "Edit case study" : "New case study")"
    Error="@SaveError"
    Loading="@IsLoading">
    <SiteForm EditContext="@_caseStudyEditContext" OnValidSubmit="HandleSaveAsync">
        <SiteStack Gap="SiteSpace.Lg">
            <SiteFormField Label="Slug"
                For="slug"
                Required="true"
                HelpText="Used in the public case study URL.">
                <SiteTextInput Id="slug" @bind-Value="_caseStudy.Slug" />
                <SiteValidationMessage For="@(() => _caseStudy.Slug)" />
            </SiteFormField>


            <SiteFormField Label="Href"
                For="href"
                HelpText="External link override, if this case study points elsewhere.">
                <SiteTextInput Id="href"
                    Value="@(_caseStudy.Href ?? string.Empty)"
                    ValueChanged="@(value => _caseStudy.Href = string.IsNullOrWhiteSpace(value) ? null : value)" />
            </SiteFormField>

            <SiteFormField Label="Published at"
                For="published-at"
                HelpText="Leave empty if not yet published.">
                <SiteDateInput Id="published-at" @bind-Value="_caseStudy.PublishedAt" />
            </SiteFormField>

            <SiteInline Gap="SiteSpace.Lg">
                <SiteCheckbox Label="Hidden" @bind-Value="_caseStudy.Hidden" />
                <SiteCheckbox Label="NDA" @bind-Value="_caseStudy.Nda" />
                <SiteCheckbox Label="External" @bind-Value="_caseStudy.External" />
                <SiteCheckbox Label="Show history" @bind-Value="_caseStudy.ShowHistory" />
            </SiteInline>

            <SiteFormSection Title="Translations">
                <SiteTranslationTabs Locales="@_locales"
                    ActiveLocale="@_activeLocale"
                    ActiveLocaleChanged="@((string locale) => _activeLocale = locale)"
                    IdPrefix="case-study-translation">
                    <Panel Context="locale">
                        @if (locale == "en")
                        {
                            <CascadingValue Value="_enEditContext"
                                TValue="EditContext"
                                IsFixed="true">
                                <DataAnnotationsValidator />
                                <SiteFormField Label="Title"
                                    For="title-en"
                                    HelpText="Leave blank to skip saving the English translation.">
                                    <SiteTextInput Id="title-en"
                                        @bind-Value="_translationEn.Title" />
                                </SiteFormField>

                                <SiteFormField Label="Status" For="status-en">
                                    <SiteTextInput Id="status-en"
                                        Value="@(_translationEn.Status ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Status = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Meta" For="meta-en">
                                    <SiteTextInput Id="meta-en"
                                        Value="@(_translationEn.Meta ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Meta = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Summary" For="summary-en">
                                    <SiteTextAreaInput Id="summary-en"
                                        Rows="3"
                                        Value="@(_translationEn.Summary ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Summary = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Context" For="context-en">
                                    <SiteTextAreaInput Id="context-en"
                                        Rows="3"
                                        Value="@(_translationEn.Context ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Context = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Role" For="role-en">
                                    <SiteTextInput Id="role-en"
                                        Value="@(_translationEn.Role ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Role = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Result" For="result-en">
                                    <SiteTextAreaInput Id="result-en"
                                        Rows="3"
                                        Value="@(_translationEn.Result ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Result = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Metrics"
                                    For="metrics-en"
                                    HelpText="One entry per metric, with a label and a value, e.g. label &quot;users&quot; / value &quot;10k&quot;. Leave empty if not applicable.">
                                    <SiteJsonArrayInput Id="metrics-en"
                                        Fields="@MetricFields"
                                        Value="@(_translationEn.Metrics ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Metrics = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationEn.Metrics)" />
                                </SiteFormField>

                                <SiteFormField Label="SEO"
                                    For="seo-en"
                                    HelpText="Standard meta fields for this page; add any extra tag under other fields. Leave empty if not applicable.">
                                    <SitePageFieldsInput Id="seo-en"
                                        Slug="PageFieldSlug.Seo"
                                        Locale="en"
                                        Value="@(_translationEn.Seo ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Seo = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationEn.Seo)" />
                                </SiteFormField>

                                <SiteFormField Label="Body (Markdown)" For="body-en">
                                    <SiteMarkdownSplitEditor Id="body-en"
                                        Rows="12"
                                        Value="@(_translationEn.Body ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Body = NullIfBlank(value))"
                                        Render="MarkdownRenderer.ToHtml" />
                                </SiteFormField>
                            </CascadingValue>
                        }
                        else
                        {
                            <CascadingValue Value="_ptEditContext"
                                TValue="EditContext"
                                IsFixed="true">
                                <DataAnnotationsValidator />
                                <SiteFormField Label="Título"
                                    For="title-pt"
                                    HelpText="Deixe em branco para não salvar a tradução em português.">
                                    <SiteTextInput Id="title-pt"
                                        @bind-Value="_translationPtBr.Title" />
                                </SiteFormField>

                                <SiteFormField Label="Status" For="status-pt">
                                    <SiteTextInput Id="status-pt"
                                        Value="@(_translationPtBr.Status ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Status = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Meta" For="meta-pt">
                                    <SiteTextInput Id="meta-pt"
                                        Value="@(_translationPtBr.Meta ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Meta = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Resumo" For="summary-pt">
                                    <SiteTextAreaInput Id="summary-pt"
                                        Rows="3"
                                        Value="@(_translationPtBr.Summary ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Summary = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Contexto" For="context-pt">
                                    <SiteTextAreaInput Id="context-pt"
                                        Rows="3"
                                        Value="@(_translationPtBr.Context ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Context = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Papel" For="role-pt">
                                    <SiteTextInput Id="role-pt"
                                        Value="@(_translationPtBr.Role ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Role = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Resultado" For="result-pt">
                                    <SiteTextAreaInput Id="result-pt"
                                        Rows="3"
                                        Value="@(_translationPtBr.Result ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Result = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Métricas"
                                    For="metrics-pt"
                                    HelpText="Um item por métrica, com um rótulo e um valor, ex.: rótulo &quot;usuários&quot; / valor &quot;10k&quot;. Deixe vazio se não for aplicável.">
                                    <SiteJsonArrayInput Id="metrics-pt"
                                        Fields="@MetricFields"
                                        Value="@(_translationPtBr.Metrics ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Metrics = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationPtBr.Metrics)" />
                                </SiteFormField>

                                <SiteFormField Label="SEO"
                                    For="seo-pt"
                                    HelpText="Campos meta padrão desta página; tags extras entram em outros campos. Deixe vazio se não for aplicável.">
                                    <SitePageFieldsInput Id="seo-pt"
                                        Slug="PageFieldSlug.Seo"
                                        Locale="pt-BR"
                                        Value="@(_translationPtBr.Seo ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Seo = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationPtBr.Seo)" />
                                </SiteFormField>

                                <SiteFormField Label="Corpo (Markdown)" For="body-pt">
                                    <SiteMarkdownSplitEditor Id="body-pt"
                                        Rows="12"
                                        Value="@(_translationPtBr.Body ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Body = NullIfBlank(value))"
                                        Render="MarkdownRenderer.ToHtml" />
                                </SiteFormField>
                            </CascadingValue>
                        }
                    </Panel>
                </SiteTranslationTabs>
            </SiteFormSection>

            <SiteFormSection Title="Technologies">
                <SiteEntityChecklist TItem="Technology"
                    Items="_allTechnologies"
                    Key="@(technology => technology.Id)"
                    Label="@TechnologyDisplayName"
                    Selected="_selectedTechnologyIds"
                    SelectedChanged="HandleSelectedTechnologiesChanged"
                    SearchPlaceholder="Search technologies…"
                    EmptyText="@(search => $"No technologies match \"{search}\".")" />
            </SiteFormSection>
        </SiteStack>

        <SiteSaveBar Saving="@IsSaving" CancelHref="/admin/case-studies" />
    </SiteForm>
</SiteFormShell>
