@page "/admin"
@inherits AdminComponentBase
@layout AdminLayout

<PageTitle>Admin Dashboard</PageTitle>

<SiteStack Gap="SiteSpace.Xl">
    <SitePageHeader Title="Admin Dashboard" />

    <SiteFormSection Title="Content">
        <SiteCardGrid Dense="true" aria-label="Content">
            <SiteTileLink Href="/admin/projects" Icon="folder" Label="projects" />
            <SiteTileLink Href="/admin/case-studies" Icon="briefcase" Label="case studies" />
            <SiteTileLink Href="/admin/experiments" Icon="flask-conical" Label="experiments" />
            <SiteTileLink Href="/admin/writings" Icon="pen-line" Label="writings" />
            <SiteTileLink Href="/admin/snippets" Icon="code" Label="snippets" />
            <SiteTileLink Href="/admin/findings" Icon="lightbulb" Label="findings" />
            <SiteTileLink Href="/admin/collections" Icon="archive" Label="collections" />
        </SiteCardGrid>
    </SiteFormSection>

    <SiteFormSection Title="Taxonomy">
        <SiteCardGrid Dense="true" aria-label="Taxonomy">
            <SiteTileLink Href="/admin/credits" Icon="award" Label="credits" />
            <SiteTileLink Href="/admin/topics" Icon="list" Label="topics" />
            <SiteTileLink Href="/admin/technologies" Icon="cpu" Label="technologies" />
            <SiteTileLink Href="/admin/languages" Icon="languages" Label="languages" />
        </SiteCardGrid>
    </SiteFormSection>

    <SiteFormSection Title="Site">
        <SiteCardGrid Dense="true" aria-label="Site">
            <SiteTileLink Href="/admin/profile" Icon="user" Label="profile" />
            <SiteTileLink Href="/admin/site-settings" Icon="settings" Label="site settings" />
            <SiteTileLink Href="/admin/resume" Icon="file-text" Label="resume" />
            <SiteTileLink Href="/admin/pages" Icon="file" Label="pages" />
            <SiteTileLink Href="/admin/nav-items" Icon="navigation" Label="nav items" />
        </SiteCardGrid>
    </SiteFormSection>
</SiteStack>
