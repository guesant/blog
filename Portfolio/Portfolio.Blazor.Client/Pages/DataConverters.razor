@inherits LocalizedComponentBase
@page "/tools/json-formatter"
@page "/pt-BR/tools/json-formatter"
@page "/tools/json-to-csv"
@page "/pt-BR/tools/json-to-csv"
@using Portfolio.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action"
        SubmitLabel="@SubmitLabel"
        Submit="SiteToolFormSubmit.StaticOnly"
        OnSubmit="HandleSubmit"
        AriaLabel="@InputLabel">
        <SiteFormField Label="@InputLabel" For="data-converter-input">
            <SiteTextAreaInput Id="data-converter-input"
                Name="json"
                Rows="14"
                Value="@Input"
                ValueChanged="@(v => Input = v)" />
        </SiteFormField>
    </SiteToolForm>
    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (!Result.IsValid) { <SiteErrorMessage>@ErrorLabel</SiteErrorMessage> }
        else { <SiteCard Class="site-block"
            Label="@OutputLabel"><SiteTextAreaInput readonly
                Rows="14">@Result.Output</SiteTextAreaInput>
            </SiteCard> }
    </SiteLiveRegion>
</ToolPage>

@code {
    private string CanonicalPath => RequestPath;
    private string _input = "[{\"name\":\"alpha\",\"value\":10},{\"name\":\"beta\",\"value\":20}]";
    private DataConverterResult _result = DataConverter.JsonToCsv("[{\"name\":\"alpha\",\"value\":10},{\"name\":\"beta\",\"value\":20}]");
    private bool _queryInitialized;
    [SupplyParameterFromQuery(Name = "json")]
    private string? QueryJson { get; set; }
    private bool IsJsonToCsv => Navigation.Uri.Contains(
        "/json-to-csv",
        StringComparison.OrdinalIgnoreCase
    );
    private string Action => LocalizedUrls.Current($"/tools/{(IsJsonToCsv ? "json-to-csv" : "json-formatter")}");
    private string Title => IsJsonToCsv ? (L["legacy_66bab7de1aae"]) : (L["legacy_98ab1008ef0c"]);
    private string Description => IsJsonToCsv ? (L["legacy_53703fa9168c"]) : (L["legacy_042b69578eac"]);
    private string InputLabel => L["legacy_9273dd785105"];
    private string OutputLabel => L["legacy_f2a7eb87e63d"];
    private string SubmitLabel => IsJsonToCsv ? (L["legacy_ae125407093e"]) : (L["legacy_1593ad5197b9"]);
    private string ErrorLabel => IsJsonToCsv ? (L["legacy_542fcc3fa57f"]) : (L["legacy_60b04b590d85"]);
    private string Input { get => _input; set { _input = value; Recalculate(); } }
    private DataConverterResult Result => _result;
    protected override void OnParametersSet() { if (!_queryInitialized) { _input = QueryJson ?? _input; Recalculate(); _queryInitialized = true; } }
    private void HandleSubmit() => Recalculate();
    private void Recalculate() => _result = IsJsonToCsv ? DataConverter.JsonToCsv(_input) : DataConverter.FormatJson(_input);
}
