@using System.Text.RegularExpressions
@using Portfolio.Blazor.Core
@inject IStringLocalizer<SharedResource> L

<SiteStack Gap="SiteSpace.None" Class="content-actions" data-layout-region="content-actions" data-content-actions
     data-content-actions-title="@Title" data-content-actions-url="@Url"
     data-content-actions-filename="@Filename">
    <template data-content-actions-markdown>@Body</template>
    <template data-content-actions-text>@PlainText</template>
    <SiteInline Gap="SiteSpace.None" Wrap="false" Class="site-content-actions">
        <SiteButton Variant="SiteButtonVariant.Outline"
            Size="SiteButtonSize.Sm"
            Class="content-actions-primary"
            data-content-actions-action="copy-markdown"><SiteIcon Name="copy"
                Size="14" /><span data-content-actions-copy-markdown-label
                data-label="@CopyPageLabel"
                data-copied-label="@CopiedLabel">@CopyPageLabel</span>
                </SiteButton>
        <SiteDropdown ExclusiveGroup="content-actions"
            AlignEnd="true"
            IconTriggerLabel="@MoreActionsLabel">
            <ToggleContent>
                <SiteIcon Name="chevron-down" Size="14" />
            </ToggleContent>
            <MenuContent>
                <SiteButton Variant="SiteButtonVariant.Ghost"
                    Class="dropdown-item"
                    role="menuitem"
                    data-content-actions-action="copy-url"><SiteIcon Name="link"
                        Size="14" /><span data-content-actions-copy-url-label
                        data-label="@CopyUrlLabel"
                        data-copied-label="@CopiedLabel">@CopyUrlLabel</span>
                        </SiteButton>
                <SiteButton Variant="SiteButtonVariant.Ghost"
                    Class="dropdown-item"
                    role="menuitem"
                    data-content-actions-action="copy-text"><SiteIcon Name="copy"
                        Size="14" /><span data-content-actions-copy-text-label
                        data-label="@CopyTextLabel"
                        data-copied-label="@CopiedLabel">@CopyTextLabel</span>
                        </SiteButton>
                <SiteButton Variant="SiteButtonVariant.Ghost"
                    Class="dropdown-item"
                    role="menuitem"
                    data-content-actions-action="copy-markdown"><SiteIcon Name="copy"
                        Size="14" /><span data-content-actions-copy-markdown-label
                        data-label="@CopyMarkdownLabel"
                        data-copied-label="@CopiedLabel">@CopyMarkdownLabel</span>
                        </SiteButton>
                <SiteButton Variant="SiteButtonVariant.Ghost"
                    Class="dropdown-item"
                    role="menuitem"
                    data-content-actions-action="download-txt"><SiteIcon Name="download"
                        Size="14" />@DownloadTextLabel</SiteButton>
                <SiteButton Variant="SiteButtonVariant.Ghost"
                    Class="dropdown-item"
                    role="menuitem"
                    data-content-actions-action="download-md"><SiteIcon Name="download"
                        Size="14" />@DownloadMarkdownLabel</SiteButton>
                @if (!string.IsNullOrWhiteSpace(ExternalUrl))
                {
                    <SiteLink Variant="SiteButtonVariant.Ghost"
                        Class="dropdown-item"
                        role="menuitem"
                        Href="@ExternalUrl"
                        target="_blank"
                        rel="noopener noreferrer"><SiteIcon Name="arrow-up-right"
                            Size="14" />@ExternalLabel</SiteLink>
                }
                @if (!string.IsNullOrWhiteSpace(DownloadUrl))
                {
                    <SiteLink Variant="SiteButtonVariant.Ghost"
                        Class="dropdown-item"
                        role="menuitem"
                        Href="@DownloadUrl"><SiteIcon Name="download"
                            Size="14" />@DownloadFilesLabel</SiteLink>
                }
            </MenuContent>
        </SiteDropdown>
    </SiteInline>
</SiteStack>
