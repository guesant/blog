@page "/admin/nav-items/create"
@page "/admin/nav-items/{Id:int}"
@using System.Globalization
@inherits AdminEditPageBase<NavItem>
@layout AdminLayout

<PageTitle>@(IsEditing ? "Edit nav item" : "New nav item")</PageTitle>

<SiteFormShell Title="@(IsEditing ? "Edit nav item" : "New nav item")"
    Error="@SaveError"
    Loading="@IsLoading">
    <SiteForm EditContext="@_navItemEditContext" OnValidSubmit="HandleSaveAsync">
        <SiteStack Gap="SiteSpace.Lg">
            <SiteFormField Label="Route name"
                For="route-name"
                Required="true"
                HelpText="Identifies which page this nav item points to, e.g. &quot;home&quot;, &quot;topics&quot;, &quot;cases.show&quot;. Matched against a fixed set of named routes on the public site; unrecognized names fall back to a path built from the dots (e.g. &quot;projects.experiments.show&quot; becomes /projects/experiments/{slug}).">
                <SiteTextInput Id="route-name" @bind-Value="_navItem.RouteName" />
                <SiteValidationMessage For="@(() => _navItem.RouteName)" />
            </SiteFormField>

            <SiteFormField Label="Placement"
                For="placement"
                HelpText="Where this item appears on the public site. Leave unset for items only reachable as a child of another nav item.">
                <SiteSelect Id="placement"
                    @bind-Value="PlacementValue"
                    Options="PlacementOptions"
                    Clearable="true"
                    Placeholder="None" />
            </SiteFormField>

            <SiteFormField Label="Sidebar group"
                For="sidebar-group"
                HelpText="Groups top-level sidebar items together; items sharing the same number are rendered as one group, ordered by this number then by Order. Only relevant for top-level items with placement &quot;sidebar&quot;.">
                <SiteNumberInput TValue="int?"
                    Id="sidebar-group"
                    @bind-Value="_navItem.SidebarGroup" />
            </SiteFormField>


            <SiteFormField Label="Parent"
                For="parent"
                HelpText="Nests this item as a child link under another nav item.">
                <SiteSelect Id="parent"
                    @bind-Value="ParentIdValue"
                    Options="ParentOptions"
                    Clearable="true"
                    Placeholder="None" />
            </SiteFormField>

            <SiteFormSection Title="Translations">
                <SiteTranslationTabs Locales="@_locales"
                    ActiveLocale="@_activeLocale"
                    ActiveLocaleChanged="@((string locale) => _activeLocale = locale)"
                    IdPrefix="nav-item-translation">
                    <Panel Context="locale">
                        @if (locale == "en")
                        {
                            <CascadingValue Value="_enEditContext"
                                TValue="EditContext"
                                IsFixed="true">
                                <DataAnnotationsValidator />
                                <SiteFormField Label="Label"
                                    For="label-en"
                                    HelpText="Leave blank to skip saving the English translation.">
                                    <SiteTextInput Id="label-en"
                                        @bind-Value="_translationEn.Label" />
                                </SiteFormField>
                            </CascadingValue>
                        }
                        else
                        {
                            <CascadingValue Value="_ptEditContext"
                                TValue="EditContext"
                                IsFixed="true">
                                <DataAnnotationsValidator />
                                <SiteFormField Label="Rótulo"
                                    For="label-pt"
                                    HelpText="Deixe em branco para não salvar a tradução em português.">
                                    <SiteTextInput Id="label-pt"
                                        @bind-Value="_translationPtBr.Label" />
                                </SiteFormField>
                            </CascadingValue>
                        }
                    </Panel>
                </SiteTranslationTabs>
            </SiteFormSection>
        </SiteStack>

        <SiteSaveBar Saving="@IsSaving" CancelHref="/admin/nav-items" />
    </SiteForm>
</SiteFormShell>
