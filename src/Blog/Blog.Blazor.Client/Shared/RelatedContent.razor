@using Blog.Blazor.Core
@inject IStringLocalizer<SharedResource> L

@if (Items is { Count: > 0 })
{
    <SiteSection Region="related-content"
        HeadingId="related-content-heading"
        Title="@L["related_content"]">
        <SiteCardGrid aria-labelledby="related-content-heading" data-layout-region="items">
            @foreach (var item in Items)
            {
                <SiteGridColumn>
                    <SiteFeedCard KindLabel="@(L["kind_related"])"
                        Date="@item.Date"
                        Title="@item.Title"
                        Href="@item.Url"
                        ViewLabel="@(L["read_more"])" />
                </SiteGridColumn>
            }
        </SiteCardGrid>
    </SiteSection>
}
