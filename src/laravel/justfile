set shell := ["bash", "-uc"]
set positional-arguments

default:
    @just --list

build:
    docker compose build

up: build
    docker compose up -d

down:
    docker compose down

restart: down up

logs *args:
    docker compose logs -f "$@"

shell:
    docker compose exec app bash

install:
    docker compose run --rm app composer install

artisan *args:
    docker compose exec app php artisan "$@"

composer *args:
    docker compose exec app composer "$@"

test *args:
    docker compose exec app php -d memory_limit=512M vendor/bin/phpunit --configuration phpunit.xml "$@"

supply-chain:
    docker compose exec app sh scripts/verify-supply-chain.sh
    docker compose exec app composer audit --locked --no-interaction

migrate *args:
    docker compose exec app php artisan migrate "$@"

fresh:
    @echo "Destructive database reset is disabled. Use a disposable test database instead." >&2
    @exit 1

tinker:
    docker compose exec app php artisan tinker

resume-pdf *args:
    docker compose exec app php artisan portfolio:generate-resume-pdf "$@"
