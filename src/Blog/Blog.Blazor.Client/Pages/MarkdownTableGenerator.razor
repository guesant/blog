@inherits LocalizedComponentBase
@page "/tools/markdown-table-generator"
@page "/pt-BR/tools/markdown-table-generator"
@using Blog.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action"
        SubmitLabel="@GenerateLabel"
        Submit="SiteToolFormSubmit.StaticOnly"
        OnSubmit="Generate"
        AriaLabel="@InputLabel">
        <SiteFormField Label="@InputLabel" For="markdown-table-input">
            <SiteTextAreaInput Id="markdown-table-input"
                Name="input"
                Rows="10"
                spellcheck="false"
                Value="@Input"
                ValueChanged="@(v => { Input = v; Generate(); })" />
        </SiteFormField>
    </SiteToolForm>
    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        <SiteOutputField Id="markdown-table-output"
            Label="@OutputLabel"
            Value="@Output"
            Multiline="true"
            CopyLabel="@CopyLabel" />
    </SiteLiveRegion>
</ToolPage>
