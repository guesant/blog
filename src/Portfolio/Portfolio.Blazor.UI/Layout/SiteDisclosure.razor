<div class="@RootClass" data-slot="disclosure" @attributes="ForwardedAttributes">
    <BlazorBlueprint.Primitives.Collapsible.BbCollapsible Open="_open"
        OpenChanged="HandleOpenChangedAsync">
        <BlazorBlueprint.Primitives.Collapsible.BbCollapsibleTrigger AdditionalAttributes="@TriggerAttributes">
            <span class="site-disclosure-summary-label">@Summary</span>
            <SiteIcon Name="chevron-down" Size="16" Class="site-disclosure-chevron" />
        </BlazorBlueprint.Primitives.Collapsible.BbCollapsibleTrigger>
        <BlazorBlueprint.Primitives.Collapsible.BbCollapsibleContent ForceMount="true"
            AdditionalAttributes="@ContentAttributes">
            @ChildContent
        </BlazorBlueprint.Primitives.Collapsible.BbCollapsibleContent>
    </BlazorBlueprint.Primitives.Collapsible.BbCollapsible>
</div>
