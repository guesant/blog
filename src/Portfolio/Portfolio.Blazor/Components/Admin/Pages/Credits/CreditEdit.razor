@page "/admin/credits/create"
@page "/admin/credits/{Id:int}"
@inherits AdminEditPageBase<CreditEntry>
@layout AdminLayout

<PageTitle>@(IsEditing ? "Edit credit" : "New credit")</PageTitle>

<SiteFormShell Title="@(IsEditing ? "Edit credit" : "New credit")"
    Error="@SaveError"
    Loading="@IsLoading">
    <SiteForm EditContext="@_creditEditContext" OnValidSubmit="HandleSaveAsync">
        <SiteStack Gap="SiteSpace.Lg">
            <SiteFormField Label="Category"
                For="category"
                Required="true"
                HelpText="Credits are grouped by this on the public credits page.">
                <SiteTextInput Id="category" @bind-Value="_credit.Category" />
                <SiteValidationMessage For="@(() => _credit.Category)" />
            </SiteFormField>


            <SiteFormField Label="URL" For="url">
                <SiteTextInput Id="url"
                    Value="@(_credit.Url ?? string.Empty)"
                    ValueChanged="@(value => _credit.Url = NullIfBlank(value))" />
            </SiteFormField>

            <SiteInline Gap="SiteSpace.Lg">
                <SiteCheckbox Label="Active" @bind-Value="_credit.Active" />
            </SiteInline>

            <SiteFormSection Title="Translations">
                <SiteTranslationTabs Locales="@_locales"
                    ActiveLocale="@_activeLocale"
                    ActiveLocaleChanged="@((string locale) => _activeLocale = locale)"
                    IdPrefix="credit-translation">
                    <Panel Context="locale">
                        @if (locale == "en")
                        {
                            <CascadingValue Value="_enEditContext"
                                TValue="EditContext"
                                IsFixed="true">
                                <DataAnnotationsValidator />
                                <SiteFormField Label="Name"
                                    For="name-en"
                                    HelpText="Leave blank to skip saving the English translation.">
                                    <SiteTextInput Id="name-en" @bind-Value="_translationEn.Name" />
                                </SiteFormField>

                                <SiteFormField Label="Description" For="description-en">
                                    <SiteTextAreaInput Id="description-en"
                                        Rows="4"
                                        Value="@(_translationEn.Description ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Description = NullIfBlank(value))" />
                                </SiteFormField>
                            </CascadingValue>
                        }
                        else
                        {
                            <CascadingValue Value="_ptEditContext"
                                TValue="EditContext"
                                IsFixed="true">
                                <DataAnnotationsValidator />
                                <SiteFormField Label="Nome"
                                    For="name-pt"
                                    HelpText="Deixe em branco para não salvar a tradução em português.">
                                    <SiteTextInput Id="name-pt"
                                        @bind-Value="_translationPtBr.Name" />
                                </SiteFormField>

                                <SiteFormField Label="Descrição" For="description-pt">
                                    <SiteTextAreaInput Id="description-pt"
                                        Rows="4"
                                        Value="@(_translationPtBr.Description ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Description = NullIfBlank(value))" />
                                </SiteFormField>
                            </CascadingValue>
                        }
                    </Panel>
                </SiteTranslationTabs>
            </SiteFormSection>
        </SiteStack>

        <SiteSaveBar Saving="@IsSaving" CancelHref="/admin/credits" />
    </SiteForm>
</SiteFormShell>
