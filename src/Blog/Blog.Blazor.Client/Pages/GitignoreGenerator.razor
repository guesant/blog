@inherits LocalizedComponentBase
@page "/tools/gitignore-generator"
@page "/pt-BR/tools/gitignore-generator"
@using Blog.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action" SubmitLabel="@GenerateLabel" AriaLabel="@FilterLabel">
        <SiteFormField Label="@FilterLabel"
            For="gitignore-filter"><SiteInput Id="gitignore-filter"
                Name="filter"
                Type="text"
                autocomplete="off"
                Value="@Filter"
                ValueChanged="@(v => Filter = v)" /></SiteFormField>
        <SiteFormActions>
            @foreach (var option in RendererInfo.IsInteractive ? Options.Where(option => string.IsNullOrWhiteSpace(Filter) || option.Name.Contains(Filter, StringComparison.OrdinalIgnoreCase)) : Options)
            {
                <SiteCheckbox Label="@option.Name"
                    Class="filter-label filter-checkbox"
                    Name="templates"
                    Value="@option.Selected"
                    ValueChanged="@(v => option.Selected = v)"
                    HtmlValue="@option.Name" />
            }
        </SiteFormActions>
    </SiteToolForm>
    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        <SiteCard Class="site-block" Label="@OutputLabel">
            <SiteOutputField Id="gitignore-output"
                Label="@OutputLabel"
                Value="@Output"
                Multiline="true"
                Copyable="true"
                CopyLabel="@CopyLabel" />
            @if (Output.Length > 0)
            {
                <SiteFormActions>
                    <SiteLink Variant="SiteButtonVariant.Default"
                        download=".gitignore"
                        Href="@DownloadHref"
                        Class="tool-action-btn"><SiteIcon Name="download"
                            Size="14" />@DownloadLabel</SiteLink>
                </SiteFormActions>
            }
        </SiteCard>
    </SiteLiveRegion>
</ToolPage>
