@inherits ListPageBase
@using Microsoft.AspNetCore.Components
@using Blog.Blazor.Core

<PageTitle>@Headline</PageTitle>
<SeoHead Title="@Headline" Description="@Subline" CanonicalPath="@CanonicalPath" />

<SitePage Template="@(FixedKind is null ? "home" : "feed")">
    @if (FixedKind is null)
    {
        <SiteBreadcrumb CurrentLabel="@Text("home_label", L["home"])"
            ShowHomeLink="false" />
    }
    else
    {
        <SiteBreadcrumb HomeUrl="@LocalizedUrls.Current("/")"
            HomeLabel="@(L["home"])"
            CurrentLabel="@CrumbLabel(FixedRoute, KindLabel(FixedKind!))" />
    }

    <SiteHero Title="@Headline" Lead="@Subline" />

    @if (Snapshot is null || AllFeedItems.Count == 0)
    {
        <SiteListingShell HasResults="false"
            CurrentPage="@CurrentPage"
            TotalPages="@PageCount"
            PaginationLabel="@Text("pagination", L["pagination"] )"
            PreviousLabel="@Text("previous", L["previous"] )"
            NextLabel="@Text("next", L["next"] )"
            Href="@(page => QueryUrl(ViewMode, page))">
            <EmptyContent>
                <SiteEmptyState Message="@(Snapshot is null ? L["public_content_is_temporarily_unavailable"] : Text("nothing_here_yet", L["there_is_no_public_content_here_yet"]))" />
            </EmptyContent>
        </SiteListingShell>
    }
    else
    {
        <SiteListingShell HasResults="@(PagedFeedItems.Count > 0)"
            Summary="@ListingSummary(PagedFeedItems.Count, SortedFeedItems.Count, CurrentPage, PageCount)"
            CurrentPage="@CurrentPage"
            TotalPages="@PageCount"
            PaginationLabel="@Text("pagination", L["pagination"])"
            PreviousLabel="@Text("previous", L["previous"])"
            NextLabel="@Text("next", L["next"])"
            Href="@(page => QueryUrl(ViewMode, page))">
        <FilterContent>
            <SiteListingFilterBar Action="@Action"
                ApplyLabel="@Text("apply", L["apply"])"
                ClearLabel="@Text("clear", L["clear"])"
                ClearHref="@Action"
                OnApply="@HandleApply">
                <PrimaryFields>
                    @if (FixedKind is null)
                    {
                        <SiteFilterSelect Icon="tag"
                            Label="@Text("filter_category_label", L["category"])"
                            Id="feed-kind-filter"
                            Name="kind"
                            @bind-Value="KindValue"
                            Options="@KindSelectOptions"
                            Placeholder="@Text("filter_all", L["all"])"
                            EmptyText="@(L["no_category_found"])" />
                    }
                    <SiteFilterSelect Icon="hash"
                        Label="@Text("filter_topic_short_label", L["topic"])"
                        Id="feed-topic-filter"
                        Name="topic"
                        @bind-Value="TopicValue"
                        Options="@TopicSelectOptions"
                        Placeholder="@Text("filter_all_topics", L["all_topics"])"
                        EmptyText="@(L["no_topic_found"])" />
                    @if (ShowTypeFilter)
                    {
                        <SiteFilterSelect Icon="tag"
                            Label="@(L["filter_type_label"])"
                            Id="feed-type-filter"
                            Name="type"
                            @bind-Value="TypeValue"
                            Options="@TypeSelectOptions"
                            Placeholder="@Text("filter_all", L["all"])"
                            EmptyText="@(L["no_category_found"])" />
                    }
                    <SiteFilterSelect Icon="arrow-up-down"
                        Label="@Text("filter_sort_label", L["sort_by"])"
                        Id="feed-sort-filter"
                        Name="sort"
                        @bind-Value="SortValue"
                        Options="@SortSelectOptions"
                        Placeholder="@(L["newest"])"
                        EmptyText="@(L["no_option_found"])" />
                </PrimaryFields>
                <SearchField>
                    <SiteSearchField Label="@Text("search_short_label", L["search"])"
                        Id="feed-search"
                        Name="q"
                        Value="@PendingSearch"
                        ValueChanged="@((string v) => PendingSearch = v)"
                        Placeholder="@Text("search_placeholder", L["title_author_or_description"])" />
                </SearchField>
            </SiteListingFilterBar>
        </FilterContent>

        <EmptyContent>
            <SiteEmptyState Message="@Text("filter_no_results", L["no_item_matches_these_filters"])" />
        </EmptyContent>
        <ResultContent>
            @if (FilteredFeedItems.Count > 0)
            {
                <SiteCardGrid id="view-spacious"
                    aria-label="@Text("feed_label", L["archive"])"
                    data-layout-region="items">
                    @foreach (var item in PagedFeedItems)
                    {
                        <SiteGridColumn>
                            <SiteFeedCard KindLabel="@KindLabel(item.Kind)"
                                Date="@(FormatHumanDate(item.Date) is { } date && date != "·" ? date : null)"
                                ReadingTime="@item.ReadingTime"
                                Title="@item.Title"
                                Href="@LocalizedUrl(item.Url)"
                                Preview="@item.Preview.Text"
                                Truncated="@item.Preview.Truncated"
                                ViewLabel="@(L["read_more"])"
                                ExternalUrl="@item.ExternalUrl"
                                ExternalLabel="@(string.IsNullOrWhiteSpace(item.ExternalLabel) ? null : $"via {item.ExternalLabel}")">
                                <MetaItems>
                                    @if (item.Kind == "achado" && !string.IsNullOrWhiteSpace(item.FindingType))
                                    {
                                        <SiteCardMetaItem Icon="@FindingTypeCatalog.Icon(item.FindingType)">@FindingTypeCatalog.Label(item.FindingType, L)</SiteCardMetaItem>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.PopularityLabel)) { <SiteCardMetaItem Icon="star">@item.PopularityLabel</SiteCardMetaItem> }
                                </MetaItems>
                                <Tags>
                                    @if (item.Featured || item.Topics.Count > 0)
                                    {
                                        <SiteChipGroup>
                                            @if (item.Featured) { <SiteBadge Label="@(L["featured"])"
                                                Tone="SiteTone.Info" /> }
                                            @foreach (var topic in item.Topics)
                                            {
                                                <SiteChip Label="@topic.Name"
                                                    Href="@(string.IsNullOrWhiteSpace(topic.Url) ? null : LocalizedUrl(topic.Url))" />
                                            }
                                        </SiteChipGroup>
                                    }
                                </Tags>
                            </SiteFeedCard>
                        </SiteGridColumn>
                    }
                </SiteCardGrid>
            }
        </ResultContent>
        </SiteListingShell>
    }
    <ExploreSection HeadingId="home-explore-heading" />
</SitePage>
