<div class="site-hero hero">
    <div class="hero-title-row">
        @if (TitleContent is null)
        {
            <h1 class="site-page-title">@Title</h1>
        }
        else
        {
            @TitleContent
        }
    </div>
    @if (Actions is not null)
    {
        <div class="hero-actions">@Actions</div>
    }
    @if (!string.IsNullOrWhiteSpace(Lead))
    {
        <SiteText Variant="SiteTextVariant.Lead" Class="hero-lead">@Lead</SiteText>
    }
    @if (!string.IsNullOrWhiteSpace(Meta))
    {
        <SiteText Variant="SiteTextVariant.Meta" Class="hero-meta">@Meta</SiteText>
    }
    @ChildContent
</div>
