@inherits LocalizedComponentBase
@page "/tools/random-date-generator"
@page "/pt-BR/tools/random-date-generator"
@using System.Globalization
@using Blog.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action"
        SubmitLabel="@GenerateLabel"
        Submit="SiteToolFormSubmit.Always"
        OnSubmit="Generate"
        AriaLabel="@FromLabel">
        <SiteFormField For="random-date-from"
            Label="@FromLabel"><SiteDateInput Id="random-date-from"
                Name="from"
                Value="@FromDateOnly"
                ValueChanged="@(v => FromDateOnly = v)" /></SiteFormField>
        <SiteFormField For="random-date-to"
            Label="@ToLabel"><SiteDateInput Id="random-date-to"
                Name="to"
                Value="@ToDateOnly"
                ValueChanged="@(v => ToDateOnly = v)" /></SiteFormField>
        <SiteFormField For="random-date-count"
            Label="@CountLabel"><SiteInput Id="random-date-count"
                Name="count"
                Type="number"
                min="1"
                max="50"
                Value="@CountText"
                ValueChanged="@(v => CountText = v)" /></SiteFormField>
        <SiteCheckbox Label="@IncludeTimeLabel"
            Name="time"
            Value="@IncludeTime"
            ValueChanged="@(v => IncludeTime = v)"
            HtmlValue="true" />
    </SiteToolForm>
    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (Result.Error is not null) { <SiteErrorMessage>@ErrorLabel</SiteErrorMessage> }
        <SiteCard Class="site-block" Label="@ResultLabel">
            <SiteList>@foreach (var value in Result.Values) { <SiteListItem Class="list-group-item site-list-row tool-list-item">
                <SiteText Variant="SiteTextVariant.Meta" Class="tool-list-value">@value</SiteText>
            </SiteListItem> }</SiteList>
        </SiteCard>
    </SiteLiveRegion>
</ToolPage>
