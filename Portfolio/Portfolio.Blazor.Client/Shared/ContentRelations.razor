@using Portfolio.Blazor.Core
@using Portfolio.Blazor.Core.Localization
@inject IStringLocalizer<SharedResource> L
@inject ICultureCatalog Cultures
@inject IPublicKnowledgeGraphProvider GraphProvider

@if (Relations.Count > 0)
{
    <SiteSection Region="connections"
        HeadingId="content-relations-heading"
        Title="@(Heading ?? L["connections"])">
        @foreach (var group in Relations.GroupBy(relation => relation.RelationLabel, StringComparer.OrdinalIgnoreCase))
        {
            <SiteStack Gap="SiteSpace.Sm" Class="site-relation-group">
                <SiteText Variant="SiteTextVariant.SectionLabel">@group.Key</SiteText>
                <SiteChipGroup>
                    @foreach (var relation in group)
                    {
                        <SiteChip Label="@relation.Label"
                            Href="@relation.Url"
                            Title="@relation.Note" />
                    }
                </SiteChipGroup>
            </SiteStack>
        }
    </SiteSection>
}
