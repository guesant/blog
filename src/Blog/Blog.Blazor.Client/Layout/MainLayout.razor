@inherits LayoutComponentBase
@using Blog.Blazor.Core
@using Blog.Blazor.Core.Localization
@inject IStringLocalizer<SharedResource> L
@inject ICultureCatalog Cultures
@inject ILocalizedUrlBuilder Urls
@inject IPublicSiteContentProvider ContentProvider

@if (Snapshot?.Chrome.Site.MaintenanceEnabled == true)
{
    <MaintenanceView Snapshot="@Snapshot" />
}
else
{
    <BbPortalHost />
    <SiteToastHost />
    <SiteConfirmDialog />
    <SiteAppShell SidebarRight="@RightSidebarFragment">
        <Brand>
            <SiteLink Class="site-nav-brand text-decoration-none"
                Href="@LocalizedPath("home")">guesant.net</SiteLink>
        </Brand>
        <Toggle>
            <SiteButton Variant="SiteButtonVariant.Outline"
                Size="SiteButtonSize.Sm"
                Class="site-nav-toggle"
                data-nav-toggle
                aria-expanded="false"
                aria-controls="site-nav"><SiteIcon Name="menu"
                    Size="14" /><SiteText Variant="SiteTextVariant.Meta">@L["menu"]</SiteText>
                    </SiteButton>
        </Toggle>
        <SidebarLeft>
            <SiteSidebar Snapshot="@Snapshot" />
        </SidebarLeft>
        <Footer>
            <SiteFooter Snapshot="@Snapshot" />
        </Footer>
        <ChildContent>
            <CascadingValue Value="Snapshot">
                @Body
            </CascadingValue>
        </ChildContent>
    </SiteAppShell>
}

@code {
    private RenderFragment? RightSidebarFragment =>
        ShowRightSidebar ? @<SiteSidebar Snapshot="@Snapshot" Right="true" /> : null;
}
