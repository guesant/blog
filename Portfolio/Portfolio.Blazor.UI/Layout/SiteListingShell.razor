<div class="site-listing-shell @Class">
@if (FilterContent is not null)
{
    <section class="site-listing-filters" data-layout-region="filters">
        @FilterContent
    </section>
}

<div class="site-listing-toolbar" data-layout-region="toolbar">
    @ToolbarContent
</div>

<section class="site-listing-results" data-layout-region="results">
@if (HasResults)
{
    @ResultContent
}
else
{
    @EmptyContent
}
</section>

@if (ShowPagination)
{
    <div class="site-listing-pagination" data-layout-region="pagination">
        <SitePagination CurrentPage="@CurrentPage"
            TotalPages="@TotalPages"
            AriaLabel="@PaginationLabel"
            PreviousLabel="@PreviousLabel"
            NextLabel="@NextLabel"
            Href="@Href" />
        @if (!string.IsNullOrWhiteSpace(Summary))
        {
            <SiteText Variant="SiteTextVariant.Meta"
                Class="site-listing-summary">@Summary</SiteText>
        }
    </div>
}
</div>
