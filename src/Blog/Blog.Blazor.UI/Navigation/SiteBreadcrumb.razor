@using Microsoft.Extensions.Localization
@using Blog.Blazor.Core
@using Blog.Blazor.Core.Localization
@inject IStringLocalizer<SharedResource> L

<div class="breadcrumb-bar">
    <nav aria-label="@L["breadcrumb"]">
        <ol class="breadcrumb">
        @if (ShowHomeLink)
        {
            <li class="breadcrumb-item">
                <SiteLink Class="breadcrumb-link" Href="@ResolvedHomeUrl">
                    <SiteIcon Name="home" Size="12" Class="icon breadcrumb-home-icon" />
                    <span class="breadcrumb-label">@HomeLabel</span>
                </SiteLink>
            </li>
        }
        @foreach (var item in Links)
        {
            <li class="breadcrumb-item">
                <SiteLink Class="breadcrumb-link" Href="@item.Url">
                    <span class="breadcrumb-label">@item.Label</span>
                </SiteLink>
            </li>
        }
        <li class="breadcrumb-item active"
            aria-current="page"><span class="breadcrumb-current">@if (!ShowHomeLink) { <SiteIcon Name="home" Size="12" Class="icon breadcrumb-home-icon" /> }<span class="breadcrumb-label">@CurrentLabel</span>
            </span>
            </li>
        </ol>
    </nav>
</div>
