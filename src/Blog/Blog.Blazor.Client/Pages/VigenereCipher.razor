@inherits LocalizedComponentBase
@page "/tools/vigenere-cipher"
@page "/pt-BR/tools/vigenere-cipher"
@using Blog.Blazor.Core
@using Microsoft.JSInterop
@inject IJSRuntime JS
<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteFormCard Class="site-block">
        <SiteFormField Label="@InputLabel"
            For="vigenere-input"><SiteTextAreaInput id="vigenere-input"
                Class="tool-textarea"
                rows="8"
                @bind-Value="Input" /></SiteFormField>
            <SiteFormActions>
                <SiteFormField Label="@KeyLabel"
                    For="vigenere-key"><SiteInput id="vigenere-key"
                        type="text"
                        @bind-Value="Key" /></SiteFormField>
                            <SiteButton Variant="SiteButtonVariant.Default"
                            Class="tool-action-btn"
                            @onclick="()=>Run(false)"><SiteIcon Name="arrow-right-left"
                                Size="14" />@EncodeLabel</SiteButton>
                                    <SiteButton Variant="SiteButtonVariant.Default"
                                Class="tool-action-btn"
                                @onclick="()=>Run(true)"><SiteIcon Name="arrow-right-left"
                                    Size="14" />@DecodeLabel</SiteButton>
                                    </SiteFormActions>
            </SiteFormCard>
                <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">@if(ShowError){<SiteErrorMessage>@ErrorLabel</SiteErrorMessage>}<SiteCard Class="site-block" Label="@OutputLabel">
                    <SiteOutputField Id="vigenere-output"
                        Label="@OutputLabel"
                        Value="@Output"
                        Multiline="true"
                        Copyable="true"
                        CopyLabel="@CopyLabel" />
                </SiteCard>
            </SiteLiveRegion>
        </ToolPage>
