@inherits SiteKnownFieldsRowsInputBase
@using Portfolio.Blazor.Core

<div class="site-content-fact-input" data-slot="content-fact-input" id="@RootId">
    @if (KnownFields.Count > 0)
    {
        <SiteStack Gap="SiteSpace.Sm" Class="site-content-fact-known">
            <SiteText Variant="SiteTextVariant.SectionLabel">@KnownSectionLabel</SiteText>
            @foreach (var fact in KnownFields)
            {
                var key = fact.Key;
                <SiteFormField Label="@fact.Label" For="@RowId(key)">
                    <div class="site-content-fact-field-wrap">
                        <SiteIcon Name="@fact.Icon"
                            Size="14"
                            Class="icon site-content-fact-field-icon" />
                        <SiteInput Id="@RowId(key)"
                            Class="site-content-fact-field-input"
                            Type="@InputType(fact.ValueKind)"
                            Value="@KnownValue(key)"
                            ValueChanged="@(value => SetKnownValue(key, value))" />
                    </div>
                </SiteFormField>
            }
        </SiteStack>
    }

    <SiteKeyValueFreeFormRows RootId="@RootId"
        Rows="@Rows"
        Indices="@FreeFormIndices"
        ShowSectionLabel="@(KnownFields.Count > 0)"
        SectionLabel="@FreeFormSectionLabel"
        Class="site-content-fact-free"
        RowClass="site-content-fact-free-row"
        KeyPlaceholder="@KeyPlaceholder"
        ValuePlaceholder="@ValuePlaceholder"
        AddLabel="@AddLabel"
        RemoveLabel="@RemoveLabel"
        KeyChanged="@(args => HandleFreeKeyChanged(args.Index, args.Value))"
        ValueEdited="@(args => HandleFreeValueChanged(args.Index, args.Value))"
        Removed="@(index => RemoveRow(index))"
        Added="AddRow" />
</div>

@code {
    [Parameter]
    public string? Id { get; set; }
    [Parameter]
    public ContentFactContentType ContentType { get; set; }
    [Parameter]
    public string KnownSectionLabel { get; set; } = "Known fields";
    [Parameter]
    public string FreeFormSectionLabel { get; set; } = "Other fields";

    private string RootId => Id ?? "content-fact-input";

    private IReadOnlyList<ContentFactDefinition> KnownFields => ContentType == ContentFactContentType.None
        ? []
        : ContentFactCatalog.All.Where(fact => fact.ContentTypes.HasFlag(ContentType)).ToList();

    protected override bool IsKnownKey(string key) =>
        KnownFields.Any(fact => string.Equals(fact.Key, key, StringComparison.OrdinalIgnoreCase));

    protected override IEnumerable<string> AllKnownKeys => ContentFactCatalog.All.Select(fact => fact.Key);

    private static string InputType(ContentFactValueKind kind) => kind switch
    {
        ContentFactValueKind.Number => "number",
        ContentFactValueKind.Url => "url",
        ContentFactValueKind.Date => "date",
        _ => "text",
    };

    private string RowId(string key) => $"{RootId}-{key}";
}
