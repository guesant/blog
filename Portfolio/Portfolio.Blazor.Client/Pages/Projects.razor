@inherits ListPageBase
@page "/projects"
@page "/pt-BR/projects"
@using Microsoft.AspNetCore.Components
@using Portfolio.Blazor.Core

<PageTitle>@PageField("projects", "title", Title)</PageTitle>
<SeoHead Title="@SeoTitle" Description="@SeoDescription" CanonicalPath="@CanonicalPath" />

<SitePage Template="projects-index">
    <SiteBreadcrumb HomeUrl="@LocalizedPath("home")"
        HomeLabel="@(L["legacy_ddc150008e2f"])"
        Links="@BreadcrumbLinks"
        CurrentLabel="@PageField("projects", "title", Title)" />

        <SiteHero Title="@SeoTitle"
            Lead="@SeoDescription"
            BackHref="@LocalizedPath("portfolio")"
            BackLabel="@(L["legacy_5c816876b410"])" />

    @if (Snapshot is null || SortedProjects.Count == 0)
    {
        <SiteListingShell HasResults="false"
            CurrentPage="@CurrentPage"
            TotalPages="@PageCount"
            PaginationLabel="@(L["legacy_ce41390e654d"] )"
            PreviousLabel="@(L["legacy_c3b535ded088"] )"
            NextLabel="@(L["legacy_a6c78a6436e2"] )"
            Href="@(page => QueryUrl(ViewMode, page))">
            <EmptyContent>
                <SiteEmptyState Message="@(Snapshot is null ? UnavailableLabel : EmptyLabel)" />
            </EmptyContent>
        </SiteListingShell>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(PageField("projects", "selectedLabel", string.Empty))) { <SiteText Variant="SiteTextVariant.SectionLabel">
            <SiteIcon Name="star"
                Size="12" />@PageField("projects", "selectedLabel", string.Empty)</SiteText> }
        <SiteHeading Level="2"
            Class="visually-hidden"
            Id="projects-title">@PageField("projects", "title", Title)</SiteHeading>
        <ProjectListing TItem="PublicProject"
            Summary="@ListingSummary(PagedProjects.Count, SortedProjects.Count, CurrentPage, PageCount)"
            Items="@PagedProjects" CurrentPage="@CurrentPage" TotalPages="@PageCount" PaginationLabel="@(L["legacy_ce41390e654d"])" PreviousLabel="@(L["legacy_c3b535ded088"])" NextLabel="@(L["legacy_a6c78a6436e2"])" Href="@(page => QueryUrl(ViewMode, page))"
            Action="@Action" SortId="projects-sort" SortName="sort" SortLabel="@(L["legacy_6541e97b7c64"])" SortValue="@SortValue" SortValueChanged="@((string v) => SortValue = v)" SortOptions="@SortOptions" SortPlaceholder="@(L["legacy_77c78d92c603"])" SortEmptyText="@(L["legacy_0bb89437e6cb"])" ApplyLabel="@(L["legacy_c975d2551cc4"])" OnApply="@(() => HandleApply(Action, SortValue, Search, DenseView))"
            SearchLabel="@(L["legacy_6bb12bff6f09"])" SearchValue="@Search" SearchValueChanged="@((string v) => Search = v)" SearchPlaceholder="@(L["search_by_name"])" ClearLabel="@(L["legacy_5262517729fc"])" ClearHref="@Action"
            GridId="view-spacious-projects" GridAriaLabelledBy="projects-title" KindLabel="@(L["kind_project"])" ViewLabel="@(L["read_more"])"
            ItemHref="@(project => LocalizedUrl(project.Url))" ItemTitle="@(project => project.Name)" ItemStatusLabel="@(project => project.Status)" ItemDate="@(project => FormatDate(project.PublishedAt) is { } date && date != "·" ? date : null)"
            ItemPurpose="@(project => project.Purpose)" ItemProblem="@(project => project.Problem)" ItemTechnologies="@(project => project.Technologies)" TechnologyUrl="@LocalizedTechnologyUrl" />
    }

    <SiteSection Region="experiments"
        HeadingId="experiments-title"
        Label="@PageField("projects", "archiveLabel", string.Empty)"
        Title="@PageField("projects", "experimentsTitle", string.Empty)">
        @if (Snapshot?.Experiments is not { Count: > 0 })
        {
            <SiteListingShell HasResults="false"
                CurrentPage="@ExperimentCurrentPage"
                TotalPages="@ExperimentPageCount"
                PaginationLabel="@(L["legacy_ce41390e654d"] )"
                PreviousLabel="@(L["legacy_c3b535ded088"] )"
                NextLabel="@(L["legacy_a6c78a6436e2"] )"
                Href="@(page => ExperimentQueryUrl(ExperimentViewMode, page))">
                <EmptyContent>
                    <SiteEmptyState Message="@(L["legacy_11b1335776c9"])" />
                </EmptyContent>
            </SiteListingShell>
        }
        else
        {
            <ProjectListing TItem="PublicExperiment"
                Summary="@ListingSummary(PagedExperiments.Count, SortedExperiments.Count, ExperimentCurrentPage, ExperimentPageCount)"
                Items="@PagedExperiments" CurrentPage="@ExperimentCurrentPage" TotalPages="@ExperimentPageCount" PaginationLabel="@(L["legacy_ce41390e654d"])" PreviousLabel="@(L["legacy_c3b535ded088"])" NextLabel="@(L["legacy_a6c78a6436e2"])" Href="@(page => ExperimentQueryUrl(ExperimentViewMode, page))"
                Action="@Action" SortId="experiments-sort" SortName="sort_experiments" SortLabel="@(L["legacy_6541e97b7c64"])" SortValue="@ExperimentSortValue" SortValueChanged="@((string v) => ExperimentSortValue = v)" SortOptions="@SortOptions" SortPlaceholder="@(L["legacy_77c78d92c603"])" SortEmptyText="@(L["legacy_0bb89437e6cb"])" ApplyLabel="@(L["legacy_c975d2551cc4"])" OnApply="@HandleExperimentApply"
                SearchLabel="@(L["legacy_6bb12bff6f09"])" SearchName="q_experiments" SearchValue="@ExperimentSearch" SearchValueChanged="@((string v) => ExperimentSearch = v)" SearchPlaceholder="@(L["search_by_name"])" ClearLabel="@(L["legacy_5262517729fc"])" ClearHref="@Action"
                GridId="view-spacious-experiments" GridAriaLabelledBy="experiments-title" KindLabel="@(L["kind_experiment"])" ViewLabel="@(L["read_more"])"
                ItemHref="@(experiment => LocalizedUrl(experiment.Url))" ItemTitle="@(experiment => experiment.Name)" ItemStatusLabel="@(experiment => L["legacy_83f80c05505d"])" ItemDate="@(experiment => FormatDate(experiment.PublishedAt) is { } date && date != "·" ? date : null)"
                ItemPurpose="@(experiment => experiment.Purpose)" ItemTechnologies="@(experiment => experiment.Technologies)" TechnologyUrl="@LocalizedTechnologyUrl" />
        }
    </SiteSection>
</SitePage>

@code {

    [SupplyParameterFromQuery(Name = "sort")]
    private string? QuerySort { get; set; }

    [SupplyParameterFromQuery(Name = "sort_experiments")]
    private string? QueryExperimentSort { get; set; }

    [SupplyParameterFromQuery(Name = "view")]
    private string? QueryView { get; set; }

    [SupplyParameterFromQuery(Name = "view_experiments")]
    private string? QueryExperimentView { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    private int? QueryPage { get; set; }

    [SupplyParameterFromQuery(Name = "experiment_page")]
    private int? QueryExperimentPage { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    private string? QuerySearch { get; set; }

    [SupplyParameterFromQuery(Name = "q_experiments")]
    private string? QueryExperimentSearch { get; set; }
    private string _search = string.Empty;
    private string Search { get => _search; set => _search = value; }
    private string _experimentSearch = string.Empty;
    private string ExperimentSearch { get => _experimentSearch; set => _experimentSearch = value; }
    private string Action => LocalizedUrls.Current("/projects");
    private string CanonicalPath => Action;
    private string Title => L["legacy_9f8a5148998e"];
    private string FallbackDescription => L["legacy_4446bebd53aa"];
    private string EmptyLabel => L["legacy_14c99ed6387a"];
    private string UnavailableLabel => L["legacy_59fa21acd9e0"];
    private string SeoTitle => PageField("projects", "title", Title);
    private string SeoDescription => PageField("projects", "description", FallbackDescription);
    private string Sort => QuerySort is "asc" or "alpha" ? QuerySort : "desc";
    private string _sortValue = "desc";
    private string SortValue { get => _sortValue; set => _sortValue = value is "asc" or "alpha" or "desc" ? value : "desc"; }
    private string ExperimentSort => QueryExperimentSort is "asc" or "alpha" ? QueryExperimentSort : "desc";
    private string _experimentSortValue = "desc";
    private string ExperimentSortValue { get => _experimentSortValue; set => _experimentSortValue = value is "asc" or "alpha" or "desc" ? value : "desc"; }
    private IReadOnlyList<SiteSelectOption> SortOptions => [new(
        "desc",
        L["legacy_77c78d92c603"]
    ), new("asc", L["legacy_07b165cdd970"]), new("alpha", L["legacy_cc8d79d78bef"])];
    private bool DenseView => string.Equals(QueryView, "dense", StringComparison.OrdinalIgnoreCase);
    private bool ExperimentDenseView => string.Equals(
        QueryExperimentView,
        "dense",
        StringComparison.OrdinalIgnoreCase
    );
    private const int PageSize = 20;
    private const int ExperimentPageSize = 12;

    private IReadOnlyList<PublicProject> SortedProjects => (Snapshot?.Projects ?? [])
        .Where(item => MatchesSearch(QuerySearch, item.Name, item.Purpose, item.Problem))
        .OrderByDescending(item => Sort.Equals("desc", StringComparison.OrdinalIgnoreCase) ? item.PublishedAt ?? string.Empty : string.Empty)
        .ThenBy(item => Sort.Equals("alpha", StringComparison.OrdinalIgnoreCase) ? item.Name : string.Empty, StringComparer.OrdinalIgnoreCase)
        .ThenBy(item => Sort.Equals("asc", StringComparison.OrdinalIgnoreCase) ? item.PublishedAt ?? string.Empty : string.Empty)
        .ToArray();

    private int PageCount => PageCountFor(SortedProjects.Count, PageSize);
    private int CurrentPage => CurrentPageFor(QueryPage, PageCount);
    private IReadOnlyList<PublicProject> PagedProjects => ItemsForPage(
        SortedProjects,
        CurrentPage,
        PageSize
    );
    private IReadOnlyList<PublicExperiment> SortedExperiments => (Snapshot?.Experiments ?? [])
        .Where(item => MatchesSearch(QueryExperimentSearch, item.Name, item.Purpose))
        .OrderByDescending(item => ExperimentSort.Equals("desc", StringComparison.OrdinalIgnoreCase) ? item.PublishedAt ?? string.Empty : string.Empty)
        .ThenBy(item => ExperimentSort.Equals("alpha", StringComparison.OrdinalIgnoreCase) ? item.Name : string.Empty, StringComparer.OrdinalIgnoreCase)
        .ThenBy(item => ExperimentSort.Equals("asc", StringComparison.OrdinalIgnoreCase) ? item.PublishedAt ?? string.Empty : string.Empty)
        .ToArray();
    private int ExperimentPageCount => PageCountFor(SortedExperiments.Count, ExperimentPageSize);
    private int ExperimentCurrentPage => CurrentPageFor(QueryExperimentPage, ExperimentPageCount);
    private IReadOnlyList<PublicExperiment> PagedExperiments => ItemsForPage(
        SortedExperiments,
        ExperimentCurrentPage,
        ExperimentPageSize
    );
    private static string FormatDate(string? value) => DateTime.TryParse(value, out var date) ? date.ToString("yyyy-MM-dd") : "·";
    private string LocalizedTechnologyUrl(PublicTechnology technology) => LocalizedUrls.Current($"/technologies/{technology.Slug}");
    private IReadOnlyList<BreadcrumbLink> BreadcrumbLinks => [new(
        L["legacy_5c816876b410"],
        LocalizedPath("portfolio")
    )];

    protected override void OnParametersSet()
    {
        SortValue = Sort;
        ExperimentSortValue = ExperimentSort;
        _search = QuerySearch ?? string.Empty;
        _experimentSearch = QueryExperimentSearch ?? string.Empty;
    }

    private void HandleExperimentApply() =>
        Navigation.NavigateTo(ExperimentUrl(ExperimentSortValue, ExperimentSearch, ExperimentViewMode, 1));

    private string ExperimentUrl(string sort, string? search, string view, int page)
    {
        var url = ListingUrl(Action, Sort, QuerySearch, DenseView, 1)
            + $"&sort_experiments={Uri.EscapeDataString(sort)}"
            + $"&view_experiments={(view.Equals("dense", StringComparison.OrdinalIgnoreCase) ? "dense" : "spacious")}";
        if (!string.IsNullOrWhiteSpace(search)) url += $"&q_experiments={Uri.EscapeDataString(search.Trim())}";
        if (page > 1) url += $"&experiment_page={page}";
        return url;
    }

    private string PageField(string page, string field, string fallback)
    {
        if (Snapshot?.Pages.TryGetValue(page, out var fields) != true || fields.ValueKind != System.Text.Json.JsonValueKind.Object || !fields.TryGetProperty(field, out var value)) return fallback;
        return value.GetString() ?? fallback;
    }

    private string ResultsSummary(int count, string label) => $"{count} {label}";
    private string ViewMode => DenseView ? "dense" : "spacious";
    private string QueryUrl(string view, int page = 1) =>
        ListingUrl(
            Action,
            Sort,
            QuerySearch,
            view.Equals("dense", StringComparison.OrdinalIgnoreCase),
            page
        );
    private string ExperimentViewMode => ExperimentDenseView ? "dense" : "spacious";
    private string ExperimentQueryUrl(string view, int page = 1) =>
        ExperimentUrl(ExperimentSort, QueryExperimentSearch, view, page);
    private string LocalizedPath(string path) => LocalizedUrls.Current($"/{path}");
    private string LocalizedUrl(string url)
    {
        if (!Uri.TryCreate(url, UriKind.Absolute, out var absolute)) return url;
        var path = absolute.AbsolutePath;
        return LocalizedUrls.Current(path);
    }
}
