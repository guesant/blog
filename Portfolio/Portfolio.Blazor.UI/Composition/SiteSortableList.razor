@typeparam TItem

<BlazorBlueprint.Components.BbSortable TItem="TItem"
    Items="@Items"
    Handle=".site-sortable-handle"
    ForceFallback="true"
    AriaLabel="@AriaLabel"
    Class="site-sortable-list"
    OnUpdate="HandleUpdate">
    <ItemTemplate Context="item">
        <div class="site-sortable-item" data-slot="sortable-item">
            <SiteButton Variant="SiteButtonVariant.Ghost"
                Size="SiteButtonSize.IconSm"
                Class="site-sortable-handle"
                aria-label="@HandleLabel"><SiteIcon Name="grip-vertical" Size="14" />
                </SiteButton>
            <div class="site-sortable-content">@ItemTemplate(item)</div>
        </div>
    </ItemTemplate>
</BlazorBlueprint.Components.BbSortable>
