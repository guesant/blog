@attribute [Stories("Templates/SiteAppShell")]

<Stories TComponent="SiteAppShell">

    <Story Name="With right sidebar">
        <Template>
            <SiteAppShell>
                <SidebarLeft>
                    <SiteText>left sidebar</SiteText>
                </SidebarLeft>
                <SidebarRight>
                    <SiteText>right sidebar</SiteText>
                </SidebarRight>
                <ChildContent>sample</ChildContent>
            </SiteAppShell>
        </Template>
    </Story>

    <Story Name="Without right sidebar">
        <Template>
            <SiteAppShell>
                <SidebarLeft>
                    <SiteText>left sidebar</SiteText>
                </SidebarLeft>
                <ChildContent>sample</ChildContent>
            </SiteAppShell>
        </Template>
    </Story>

</Stories>
