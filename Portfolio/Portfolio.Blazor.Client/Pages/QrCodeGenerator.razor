@inherits LocalizedComponentBase
@page "/tools/qr-code-generator"
@page "/pt-BR/tools/qr-code-generator"
@using Microsoft.JSInterop
@using Portfolio.Blazor.Core
@inject IJSRuntime JS

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action" SubmitLabel="@GenerateLabel" AriaLabel="@InputLabel">
        <SiteFormField Label="@InputLabel"
            For="qr-input"><SiteTextAreaInput Id="qr-input"
                Name="input"
                Class="tool-textarea"
                Rows="3"
                spellcheck="false"
                Value="@Input"
                ValueChanged="@(v => Input = v)" /></SiteFormField>
    </SiteToolForm>
    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (!string.IsNullOrEmpty(Input) && !Result.IsValid) { <SiteErrorMessage>@InvalidLabel</SiteErrorMessage> }
        @if (Result.IsValid) { <SiteCard Class="site-block" Label="@DownloadLabel">
            <SiteStack Class="tool-qr-preview"
                aria-label="QR code">@((MarkupString)Result.Svg)</SiteStack>@if (RendererInfo.IsInteractive) { <SiteButton Variant="SiteButtonVariant.Default"
                    Class="tool-action-btn"
                    @onclick="DownloadAsync"><SiteIcon Name="download"
                        Size="14" />@DownloadLabel</SiteButton> } else { <SiteLink Variant="SiteButtonVariant.Default"
                        Class="tool-action-btn"
                        download="qr-code.svg"
                        Href="@DownloadHref"><SiteIcon Name="download"
                            Size="14" />@DownloadLabel</SiteLink> }</SiteCard> }
    </SiteLiveRegion>
</ToolPage>
@code {
    private string CanonicalPath => RequestPath; private string _input = string.Empty; private bool _queryInitialized; [SupplyParameterFromQuery(Name="input")] private string? QueryInput { get; set; } private string Action => L["legacy_d6f37f5d3529"];  private string Title => L["legacy_d51182132f2c"]; private string Description => L["legacy_324ae4e57ca3"]; private string InputLabel => L["legacy_b5fe689222ce"]; private string GenerateLabel => L["legacy_cc7df97fb1b2"]; private string DownloadLabel => L["legacy_c36a12636bbd"]; private string InvalidLabel => L["legacy_93577aecb1ab"]; private string Input { get => _input; set => _input = value; } private QrCodeResult Result => QrCodeGeneratorEngine.Generate(Input); private string DownloadHref => $"data:image/svg+xml;charset=utf-8,{Uri.EscapeDataString(Result.Svg)}"; protected override void OnParametersSet() { if (_queryInitialized) return; _input = QueryInput ?? string.Empty; _queryInitialized = true; } private async Task DownloadAsync() { if (Result.IsValid) await JS.InvokeVoidAsync("qrCodeGenerator.download", Result.Svg); } }
