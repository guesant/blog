@inherits LocalizedComponentBase
@page "/tools/regex-tester"
@page "/pt-BR/tools/regex-tester"
@using Microsoft.JSInterop
@using Portfolio.Blazor.Core
@inject IJSRuntime JS

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action" SubmitLabel="@TestLabel" AriaLabel="@PatternLabel">
        <SiteFormActions>
            <SiteFormField For="regex-pattern"
                Label="@PatternLabel"><SiteInput Id="regex-pattern"
                    Name="pattern"
                    autocomplete="off"
                    spellcheck="false"
                    Value="@Pattern"
                    ValueChanged="@(v => Pattern = v)" /></SiteFormField>
            @if (RendererInfo.IsInteractive)
            {
                <SiteCheckbox Label="@GlobalLabel"
                    Value="@Global"
                    ValueChanged="@(v => Global = v)" />
                <SiteCheckbox Label="@IgnoreCaseLabel"
                    Value="@IgnoreCase"
                    ValueChanged="@(v => IgnoreCase = v)" />
                <SiteCheckbox Label="@MultilineLabel"
                    Value="@Multiline"
                    ValueChanged="@(v => Multiline = v)" />
                <SiteCheckbox Label="@SinglelineLabel"
                    Value="@Singleline"
                    ValueChanged="@(v => Singleline = v)" />
            }
        </SiteFormActions>
        <SiteFormField For="regex-input"
            Label="@TestStringLabel"><SiteTextAreaInput Id="regex-input"
                Name="input"
                Rows="8"
                spellcheck="false"
                Value="@Input"
                ValueChanged="@(v => Input = v)" /></SiteFormField>
    </SiteToolForm>
    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (!Result.IsValid) { <SiteErrorMessage>@InvalidLabel</SiteErrorMessage> }
        <SiteCard Class="site-block"
            Label="@HighlightLabel"><SiteHtmlPreview Class="tool-highlight-preview">@((MarkupString)Result.HighlightHtml)</SiteHtmlPreview>
            </SiteCard>
        <SiteCard Class="site-block" Label="@MatchesLabel">
            <SiteList>@foreach (var match in Result.Matches) { <SiteListItem Class="list-group-item site-list-row tool-list-item">
                <SiteText Variant="SiteTextVariant.Meta"
                    Class="tool-list-value">@match.Value</SiteText>
                    <SiteText Variant="SiteTextVariant.Meta">@(match.Groups.Count > 0 ? string.Join(", ", match.Groups.Select((group, index) => $"#{index + 1}: {group ?? string.Empty}")) : $"#{match.Number}")</SiteText>
                </SiteListItem> }</SiteList>
        </SiteCard>
    </SiteLiveRegion>
</ToolPage>
