<div class="site-select-with-custom" data-slot="select-with-custom">
    <SiteSelect Id="@Id"
        Value="@SelectValue"
        ValueChanged="@HandleSelectChanged"
        ValueExpression="@(() => _selectValue)"
        Options="@AllOptions"
        Placeholder="@Placeholder"
        Clearable="@Clearable"
        ClearLabel="@Placeholder"
        ClearAriaLabel="@Placeholder" />
    @if (IsCustom)
    {
        <SiteTextInput Id="@($"{Id}-custom")"
            Value="@Value"
            ValueChanged="@HandleCustomChanged"
            Placeholder="@CustomPlaceholder"
            aria-label="@CustomLabel" />
    }
</div>

@code {
    /// <summary>Sentinel option value that switches the field into free-text mode.</summary>
    public const string CustomValue = "__custom__";

    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;
    /// <summary>Current value; either one of <see cref="Choices"/> or any free text.</summary>
    [Parameter]
    public string Value { get; set; } = string.Empty;
    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }
    /// <summary>Well-known values offered in the select; anything else is reached through the
    /// custom option, which reveals a free-text input.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<string> Choices { get; set; } = [];
    [Parameter]
    public string Placeholder { get; set; } = "select";
    /// <summary>Label of the option that unlocks free text.</summary>
    [Parameter]
    public string CustomLabel { get; set; } = "other (custom)";
    [Parameter]
    public string CustomPlaceholder { get; set; } = "type a custom value";
    [Parameter]
    public bool Clearable { get; set; } = true;

    private bool _custom;
    private string _selectValue = string.Empty;

    private bool MatchesChoice(string value) =>
        Choices.Any(choice => string.Equals(choice, value, StringComparison.OrdinalIgnoreCase));

    private bool IsCustom => _custom || (!string.IsNullOrEmpty(Value) && !MatchesChoice(Value));

    private string SelectValue => IsCustom
        ? CustomValue
        : Choices.FirstOrDefault(choice => string.Equals(choice, Value, StringComparison.OrdinalIgnoreCase)) ?? string.Empty;

    private IReadOnlyList<SiteSelectOption> AllOptions =>
        Choices.Select(choice => new SiteSelectOption(choice, choice))
            .Append(new SiteSelectOption(CustomValue, CustomLabel, "pencil"))
            .ToList();

    protected override void OnParametersSet() => _selectValue = SelectValue;

    private async Task HandleSelectChanged(string selected)
    {
        if (selected == CustomValue)
        {
            _custom = true;
            if (MatchesChoice(Value))
            {
                await ValueChanged.InvokeAsync(string.Empty);
            }
            return;
        }

        _custom = false;
        await ValueChanged.InvokeAsync(selected);
    }

    private Task HandleCustomChanged(string value) => ValueChanged.InvokeAsync(value);
}
