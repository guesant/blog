@inherits LocalizedComponentBase
@page "/tools/cipher-tool"
@page "/pt-BR/tools/cipher-tool"
@using Portfolio.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    @if (RendererInfo.IsInteractive)
    {
        <SiteFormCard Class="site-block">
            <SiteFormField For="cipher-input"
                Label="@InputLabel"><SiteTextAreaInput Id="cipher-input"
                    Rows="8"
                    Value="@Input"
                    ValueChanged="@(v => Input = v)" /></SiteFormField>
            <SiteFormActions>
                <SiteFormField For="cipher-shift"
                    Label="@ShiftLabel"><SiteInput Id="cipher-shift"
                        Type="number"
                        min="-25"
                        max="25"
                        Value="@ShiftText"
                        ValueChanged="@(v => ShiftText = v)" /></SiteFormField>
                <SiteButton Variant="SiteButtonVariant.Default"
                    OnClick="Rot13"><SiteIcon Name="arrow-right-left"
                        Size="14" />@Rot13Label</SiteButton>
                <SiteButton Variant="SiteButtonVariant.Default"
                    OnClick="Encode"><SiteIcon Name="arrow-right-left"
                        Size="14" />@EncodeLabel</SiteButton>
                <SiteButton Variant="SiteButtonVariant.Default"
                    OnClick="Decode"><SiteIcon Name="arrow-right-left"
                        Size="14" />@DecodeLabel</SiteButton>
            </SiteFormActions>
        </SiteFormCard>
    }
    else
    {
        <SiteFilterCard Action="@Action"
            DataLayoutRegion="tool-form"
            FormClass="d-grid gap-3"
            Class="site-block">
            <SiteFormField For="cipher-input"
                Label="@InputLabel"><SiteTextAreaInput Id="cipher-input"
                    Name="input"
                    Rows="8">@Input</SiteTextAreaInput>
                </SiteFormField>
            <SiteFormActions>
                <SiteFormField For="cipher-shift"
                    Label="@ShiftLabel"><SiteInput Id="cipher-shift"
                        Name="shift"
                        Type="number"
                        min="-25"
                        max="25"
                        Value="@ShiftText"
                        ValueChanged="@(v => ShiftText = v)" /></SiteFormField>
                <SiteButton Variant="SiteButtonVariant.Default"
                    name="operation"
                    value="rot13"
                    Type="SiteButtonType.Submit"><SiteIcon Name="arrow-right-left"
                        Size="14" />@Rot13Label</SiteButton>
                <SiteButton Variant="SiteButtonVariant.Default"
                    name="operation"
                    value="encode"
                    Type="SiteButtonType.Submit"><SiteIcon Name="arrow-right-left"
                        Size="14" />@EncodeLabel</SiteButton>
                <SiteButton Variant="SiteButtonVariant.Default"
                    name="operation"
                    value="decode"
                    Type="SiteButtonType.Submit"><SiteIcon Name="arrow-right-left"
                        Size="14" />@DecodeLabel</SiteButton>
            </SiteFormActions>
        </SiteFilterCard>
    }

    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        <SiteCard Class="site-block" Label="@OutputLabel">
            <SiteOutputField Id="cipher-output"
                Label="@OutputLabel"
                Value="@Result"
                Multiline="true"
                Copyable="@(!string.IsNullOrEmpty(Result))"
                CopyLabel="@CopyLabel" />
        </SiteCard>
    </SiteLiveRegion>
</ToolPage>

@code {
    private string CanonicalPath => RequestPath;
    private string _input = string.Empty;
    private string _shiftText = "13";
    private string _operation = "encode";
    private string _result = string.Empty;
    private bool _queryInitialized;
    [SupplyParameterFromQuery(Name = "input")]
    private string? QueryInput { get; set; }
    [SupplyParameterFromQuery(Name = "shift")]
    private int? QueryShift { get; set; }
    [SupplyParameterFromQuery(Name = "operation")]
    private string? QueryOperation { get; set; }
    private string Action => L["legacy_99f33be40dd2"];
    private string Title => L["legacy_e59a04d80fff"];
    private string Description => L["legacy_9bc5b47b831b"];
    private string InputLabel => L["legacy_2c18cd904ab1"];
    private string OutputLabel => L["legacy_5271811ebe62"];
    private string ShiftLabel => L["legacy_afa1ac95c295"];
    private string Rot13Label => "ROT13";
    private string EncodeLabel => L["legacy_360020cc7b01"];
    private string DecodeLabel => L["legacy_4c0e9b70ce8c"];
    private string CopyLabel => L["legacy_b4bdba0acbfb"];
    private string Input { get => _input; set { _input = value; Recalculate(); } }
    private string ShiftText { get => _shiftText; set { _shiftText = value; Recalculate(); } }
    private string Result => _result;
    protected override void OnParametersSet()
    {
        if (_queryInitialized) return;
        _input = QueryInput ?? _input;
        if (QueryShift.HasValue) _shiftText = QueryShift.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        _operation = QueryOperation is "decode" or "rot13" ? QueryOperation : "encode";
        if (_operation == "rot13") _shiftText = "13";
        Recalculate();
        _queryInitialized = true;
    }
    private int Shift => int.TryParse(ShiftText, out var shift) ? shift : 0;
    private void Encode() { _operation = "encode"; Recalculate(); }
    private void Decode() { _operation = "decode"; Recalculate(); }
    private void Rot13() { _shiftText = "13"; _operation = "rot13"; Recalculate(); }
    private void Recalculate() => _result = CaesarCipher.Transform(_input, Shift, _operation == "decode");
}
