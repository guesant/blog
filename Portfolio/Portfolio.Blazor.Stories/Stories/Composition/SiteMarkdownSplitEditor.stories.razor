@attribute [Stories("Composition/SiteMarkdownSplitEditor")]

<Stories TComponent="SiteMarkdownSplitEditor">

    <Story Name="Default">
        <Template>
            <SiteMarkdownSplitEditor Id="markdown-sample"
                                     Value="@_value"
                                     ValueChanged="@(value => _value = value)"
                                     Rows="8"
                                     Render="@(markdown => $"<p>{markdown}</p>")" />
        </Template>
    </Story>

</Stories>

@code {
    private string _value = "# heading\n\nsome text.";
}
