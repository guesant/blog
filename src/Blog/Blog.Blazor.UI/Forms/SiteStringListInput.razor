@using System.Text.Json
@using Blog.Blazor.UI.Composition

<div class="site-string-list-input" data-slot="string-list-input" id="@Id">
    <SiteRepeatableItems TItem="string"
                          Items="@_items"
                          ItemTitle="@((item, index) => string.IsNullOrWhiteSpace(item) ? $"item {index + 1}" : item)"
                          AddLabel="@AddLabel"
                          RemoveLabel="@RemoveLabel"
                          OnAdd="AddItem"
                          OnRemove="RemoveItem">
        <ItemTemplate Context="itemContext">
            <SiteTextInput Id="@($"{Id}-{itemContext.Index}")"
                Value="@itemContext.Item"
                ValueChanged="@(value => HandleChanged(itemContext.Index, value))" />
        </ItemTemplate>
    </SiteRepeatableItems>
</div>
