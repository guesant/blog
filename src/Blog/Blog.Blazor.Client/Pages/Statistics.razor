@inherits LocalizedComponentBase
@implements IDisposable
@page "/tools/statistics"
@page "/tools/statistics-analyzer"
@page "/pt-BR/tools/statistics"
@page "/pt-BR/tools/statistics-analyzer"
@using System.Globalization
@using Blog.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action"
        SubmitLabel="@SubmitLabel"
        Submit="SiteToolFormSubmit.StaticOnly"
        OnSubmit="HandleSubmit">
        <SiteFormField For="statistics-input"
            Label="@InputLabel"><SiteTextAreaInput Id="statistics-input"
                Name="values"
                Rows="10"
                Value="@Values"
                ValueChanged="@(v => Values = v)" /></SiteFormField>
    </SiteToolForm>

    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (!Summary.IsValid)
        {
            <SiteErrorMessage>@ErrorMessage</SiteErrorMessage>
        }
        else
        {
            <SiteStats>
                <SiteStatItem Label="@CountLabel">@Summary.Count</SiteStatItem>
                <SiteStatItem Label="@MinimumLabel">@Format(Summary.Minimum)</SiteStatItem>
                <SiteStatItem Label="@MaximumLabel">@Format(Summary.Maximum)</SiteStatItem>
                <SiteStatItem Label="@MeanLabel">@Format(Summary.Mean)</SiteStatItem>
                <SiteStatItem Label="@MedianLabel">@Format(Summary.Median)</SiteStatItem>
                <SiteStatItem Label="@ModeLabel">@(Summary.Mode.HasValue ? Format(Summary.Mode.Value) : NoModeLabel)</SiteStatItem>
                <SiteStatItem Label="@FirstQuartileLabel">@Format(Summary.FirstQuartile)</SiteStatItem>
                <SiteStatItem Label="@ThirdQuartileLabel">@Format(Summary.ThirdQuartile)</SiteStatItem>
                <SiteStatItem Label="@IqrLabel">@Format(Summary.InterquartileRange)</SiteStatItem>
                <SiteStatItem Label="@PopulationStdDevLabel">@Format(Summary.PopulationStandardDeviation)</SiteStatItem>
                <SiteStatItem Label="@SampleStdDevLabel">@Format(Summary.SampleStandardDeviation)</SiteStatItem>
            </SiteStats>

            <SiteCard Class="site-block" Label="@HistogramLabel">
                @if (RendererInfo.IsInteractive)
                {
                    <SiteChart ChartJsConfig="@HistogramConfig" AriaLabel="@HistogramLabel" />
                }
                else
                {
                    <SiteList Variant="SiteListVariant.Boxed"
                        AriaLabel="@HistogramLabel">@foreach (var bin in Summary.Histogram) { <SiteListItem Class="site-text-list-item">@Format(bin.Start)–@Format(bin.End): @bin.Count @BinItemsLabel</SiteListItem> }</SiteList>
                }
            </SiteCard>
        }
    </SiteLiveRegion>
</ToolPage>
