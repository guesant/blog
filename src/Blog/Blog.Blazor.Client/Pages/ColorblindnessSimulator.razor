@inherits LocalizedComponentBase
@page "/tools/colorblindness-simulator"
@page "/pt-BR/tools/colorblindness-simulator"
@using Microsoft.JSInterop
@inject IJSRuntime JS

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteCard Class="site-block" Label="@FileLabel">
        <SiteFormField Label="@FileLabel" For="colorblindness-input">
            <SiteFileInput type="file"
                accept="image/*"
                data-colorblindness-simulator-input
                id="colorblindness-input" />
        </SiteFormField>
        <SiteGrid Class="tool-simulation-grid" data-colorblindness-simulator-grid hidden>
            <SiteStack Class="tool-simulation-item">
                <canvas data-colorblindness-simulator-canvas="original">
            </canvas>
                <figcaption>@OriginalLabel</figcaption>
            </SiteStack>
            <SiteStack Class="tool-simulation-item">
                <canvas data-colorblindness-simulator-canvas="protanopia">
            </canvas>
                <figcaption>protanopia</figcaption>
            </SiteStack>
            <SiteStack Class="tool-simulation-item">
                <canvas data-colorblindness-simulator-canvas="deuteranopia">
            </canvas>
                <figcaption>deuteranopia</figcaption>
            </SiteStack>
            <SiteStack Class="tool-simulation-item">
                <canvas data-colorblindness-simulator-canvas="tritanopia">
            </canvas>
                <figcaption>tritanopia</figcaption>
            </SiteStack>
        </SiteGrid>
    </SiteCard>
</ToolPage>
