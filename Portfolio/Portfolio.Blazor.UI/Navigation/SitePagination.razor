<nav class="site-pagination d-flex justify-content-center"
    aria-label="@AriaLabel"
    data-layout-region="pagination">
    <ul class="pagination pagination-sm">
        <li class="page-item pagination-edge pagination-previous @(CurrentPage <= 1 ? "disabled" : null)">
            @if (CurrentPage > 1)
            {
                <SiteLink Class="page-link"
                    Href="@Href(CurrentPage - 1)"
                    aria-label="@PreviousLabel"
                    title="@PreviousLabel"><SiteIcon Name="arrow-left" Size="14" />
                    </SiteLink>
            }
            else
            {
                <span class="page-link" aria-hidden="true" title="@PreviousLabel">
                    <SiteIcon Name="arrow-left" Size="14" />
                </span>
            }
        </li>
        @foreach (var itemPage in VisiblePages)
        {
            <li class="page-item @(itemPage == CurrentPage ? "active" : null)"
                aria-current="@(itemPage == CurrentPage ? "page" : null)">
                @if (itemPage == CurrentPage)
                {
                    <span class="page-link">@itemPage</span>
                }
                else
                {
                    <SiteLink Class="page-link"
                        Href="@Href(itemPage)"
                        aria-label="@itemPage">@itemPage</SiteLink>
                }
            </li>
        }
        <li class="page-item pagination-edge pagination-next @(CurrentPage >= TotalPages ? "disabled" : null)">
            @if (CurrentPage < TotalPages)
            {
                <SiteLink Class="page-link"
                    Href="@Href(CurrentPage + 1)"
                    aria-label="@NextLabel"
                    title="@NextLabel"><SiteIcon Name="arrow-right" Size="14" />
                    </SiteLink>
            }
            else
            {
                <span class="page-link" aria-hidden="true" title="@NextLabel">
                    <SiteIcon Name="arrow-right" Size="14" />
                </span>
            }
        </li>
    </ul>
</nav>
