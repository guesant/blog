@page "/admin/resume"
@using System.Globalization
@using Portfolio.Blazor.Components.Admin.Shared
@using ResumeEntity = Portfolio.Blazor.Data.Entities.Resume
@using ResumeTranslationEntity = Portfolio.Blazor.Data.Entities.ResumeTranslation
@inherits AdminEditPageBase<ResumeEntity>
@layout AdminLayout

<PageTitle>Resume</PageTitle>

<SiteFormShell Title="Resume" Error="@SaveError" Loading="@IsLoading">
    <SiteForm EditContext="@_resumeEditContext" OnValidSubmit="HandleSaveAsync">
        <SiteStack Gap="SiteSpace.Lg">
            <SiteFormSection Title="Translations">
                <SiteTranslationTabs Locales="@_locales"
                    ActiveLocale="@_activeLocale"
                    ActiveLocaleChanged="@((string locale) => _activeLocale = locale)"
                    IdPrefix="resume-translation">
                    <Panel Context="locale">
                        @if (locale == "en")
                        {
                            <CascadingValue Value="_enEditContext"
                                TValue="EditContext"
                                IsFixed="true">
                                <DataAnnotationsValidator />

                                <SiteFormField Label="Summary" For="summary-en">
                                    <SiteTextAreaInput Id="summary-en"
                                        Rows="4"
                                        Value="@(_translationEn.Summary ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Summary = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Leadership"
                                    For="leadership-en"
                                    HelpText="Leadership roles or responsibilities, one item per entry. Leave empty if not applicable.">
                                    <SiteJsonArrayInput Id="leadership-en"
                                        Fields="@LeadershipFields"
                                        Value="@(_translationEn.Leadership ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Leadership = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationEn.Leadership)" />
                                </SiteFormField>

                                <SiteFormField Label="Education"
                                    For="education-en"
                                    HelpText="One entry per school or program. Leave empty if not applicable.">
                                    <SiteJsonArrayInput Id="education-en"
                                        Fields="@EducationFields"
                                        Value="@(_translationEn.Education ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Education = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationEn.Education)" />
                                </SiteFormField>

                                <SiteFormField Label="Certificates"
                                    For="certificates-en"
                                    HelpText="One entry per certificate. Leave empty if not applicable.">
                                    <SiteJsonArrayInput Id="certificates-en"
                                        Fields="@DescribedFields"
                                        Value="@(_translationEn.Certificates ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Certificates = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationEn.Certificates)" />
                                </SiteFormField>

                                <SiteFormField Label="Certifications"
                                    For="certifications-en"
                                    HelpText="One entry per certification. Leave empty if not applicable.">
                                    <SiteJsonArrayInput Id="certifications-en"
                                        Fields="@DescribedFields"
                                        Value="@(_translationEn.Certifications ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Certifications = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationEn.Certifications)" />
                                </SiteFormField>

                                <SiteFormField Label="Publications"
                                    For="publications-en"
                                    HelpText="One entry per publication. Leave empty if not applicable.">
                                    <SiteJsonArrayInput Id="publications-en"
                                        Fields="@DescribedFields"
                                        Value="@(_translationEn.Publications ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Publications = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationEn.Publications)" />
                                </SiteFormField>

                                <SiteFormField Label="Recommendations"
                                    For="recommendations-en"
                                    HelpText="One entry per recommendation. Leave empty if not applicable.">
                                    <SiteJsonArrayInput Id="recommendations-en"
                                        Fields="@DescribedFields"
                                        Value="@(_translationEn.Recommendations ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Recommendations = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationEn.Recommendations)" />
                                </SiteFormField>

                                <SiteFormField Label="Technical productions"
                                    For="technical-productions-en"
                                    HelpText="One entry per project, tool or piece of writing to feature. Leave empty if not applicable.">
                                    <SiteJsonArrayInput Id="technical-productions-en"
                                        Fields="@TechnicalProductionFields"
                                        Value="@(_translationEn.TechnicalProductions ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.TechnicalProductions = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationEn.TechnicalProductions)" />
                                </SiteFormField>

                                <SiteFormField Label="Events"
                                    For="events-en"
                                    HelpText="One entry per event attended or presented at. Leave empty if not applicable.">
                                    <SiteJsonArrayInput Id="events-en"
                                        Fields="@EventFields"
                                        Value="@(_translationEn.Events ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Events = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationEn.Events)" />
                                </SiteFormField>

                                <SiteFormField Label="Awards"
                                    For="awards-en"
                                    HelpText="One entry per award. Leave empty if not applicable.">
                                    <SiteJsonArrayInput Id="awards-en"
                                        Fields="@DescribedFields"
                                        Value="@(_translationEn.Awards ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Awards = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationEn.Awards)" />
                                </SiteFormField>
                            </CascadingValue>
                        }
                        else
                        {
                            <CascadingValue Value="_ptEditContext"
                                TValue="EditContext"
                                IsFixed="true">
                                <DataAnnotationsValidator />

                                <SiteFormField Label="Resumo" For="summary-pt">
                                    <SiteTextAreaInput Id="summary-pt"
                                        Rows="4"
                                        Value="@(_translationPtBr.Summary ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Summary = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Liderança"
                                    For="leadership-pt"
                                    HelpText="Um item por cargo ou responsabilidade de liderança. Deixe vazio se não for aplicável.">
                                    <SiteJsonArrayInput Id="leadership-pt"
                                        Fields="@LeadershipFields"
                                        Value="@(_translationPtBr.Leadership ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Leadership = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationPtBr.Leadership)" />
                                </SiteFormField>

                                <SiteFormField Label="Educação"
                                    For="education-pt"
                                    HelpText="Um item por instituição ou programa. Deixe vazio se não for aplicável.">
                                    <SiteJsonArrayInput Id="education-pt"
                                        Fields="@EducationFields"
                                        Value="@(_translationPtBr.Education ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Education = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationPtBr.Education)" />
                                </SiteFormField>

                                <SiteFormField Label="Certificados"
                                    For="certificates-pt"
                                    HelpText="Um item por certificado. Deixe vazio se não for aplicável.">
                                    <SiteJsonArrayInput Id="certificates-pt"
                                        Fields="@DescribedFields"
                                        Value="@(_translationPtBr.Certificates ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Certificates = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationPtBr.Certificates)" />
                                </SiteFormField>

                                <SiteFormField Label="Certificações"
                                    For="certifications-pt"
                                    HelpText="Um item por certificação. Deixe vazio se não for aplicável.">
                                    <SiteJsonArrayInput Id="certifications-pt"
                                        Fields="@DescribedFields"
                                        Value="@(_translationPtBr.Certifications ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Certifications = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationPtBr.Certifications)" />
                                </SiteFormField>

                                <SiteFormField Label="Publicações"
                                    For="publications-pt"
                                    HelpText="Um item por publicação. Deixe vazio se não for aplicável.">
                                    <SiteJsonArrayInput Id="publications-pt"
                                        Fields="@DescribedFields"
                                        Value="@(_translationPtBr.Publications ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Publications = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationPtBr.Publications)" />
                                </SiteFormField>

                                <SiteFormField Label="Recomendações"
                                    For="recommendations-pt"
                                    HelpText="Um item por recomendação. Deixe vazio se não for aplicável.">
                                    <SiteJsonArrayInput Id="recommendations-pt"
                                        Fields="@DescribedFields"
                                        Value="@(_translationPtBr.Recommendations ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Recommendations = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationPtBr.Recommendations)" />
                                </SiteFormField>

                                <SiteFormField Label="Produções técnicas"
                                    For="technical-productions-pt"
                                    HelpText="Um item por projeto, ferramenta ou texto a destacar. Deixe vazio se não for aplicável.">
                                    <SiteJsonArrayInput Id="technical-productions-pt"
                                        Fields="@TechnicalProductionFields"
                                        Value="@(_translationPtBr.TechnicalProductions ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.TechnicalProductions = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationPtBr.TechnicalProductions)" />
                                </SiteFormField>

                                <SiteFormField Label="Eventos"
                                    For="events-pt"
                                    HelpText="Um item por evento em que participou ou apresentou. Deixe vazio se não for aplicável.">
                                    <SiteJsonArrayInput Id="events-pt"
                                        Fields="@EventFields"
                                        Value="@(_translationPtBr.Events ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Events = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationPtBr.Events)" />
                                </SiteFormField>

                                <SiteFormField Label="Prêmios"
                                    For="awards-pt"
                                    HelpText="Um item por prêmio. Deixe vazio se não for aplicável.">
                                    <SiteJsonArrayInput Id="awards-pt"
                                        Fields="@DescribedFields"
                                        Value="@(_translationPtBr.Awards ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Awards = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationPtBr.Awards)" />
                                </SiteFormField>
                            </CascadingValue>
                        }
                    </Panel>
                </SiteTranslationTabs>
            </SiteFormSection>

            <SiteFormSection Title="Skills"
                Description="Each skill is a topic (kind &quot;skill&quot;) paired with its own set of technologies. Saving always rewrites the full skill list and its technology pivots.">
                <SiteRepeatableItems TItem="ResumeSkillFormModel"
                    Items="@_skills"
                    ItemTitle="@((skill, index) => $"Skill {index + 1}")"
                    AddLabel="Add skill"
                    RemoveLabel="Remove"
                    OnAdd="HandleAddSkill"
                    OnRemove="HandleRemoveSkill">
                    <ItemTemplate Context="skillContext">
                        <SiteFormField Label="Topic"
                            For="@($"skill-topic-{skillContext.Index}")"
                            Required="true">
                            <SiteSelect Id="@($"skill-topic-{skillContext.Index}")"
                                         @bind-Value="skillContext.Item.TopicIdText"
                                         Options="TopicOptions"
                                         Clearable="true"
                                         Placeholder="Select a topic" />
                        </SiteFormField>

                        <SiteFormField Label="Technologies"
                            For="@($"skill-technologies-{skillContext.Index}")">
                            <SiteEntityChecklist TItem="Technology"
                                Items="_allTechnologies"
                                Key="@(technology => technology.Id)"
                                Label="@TechnologyDisplayName"
                                Selected="skillContext.Item.SelectedTechnologyIds"
                                SelectedChanged="@(selected => HandleSkillTechnologiesChanged(skillContext.Item, selected))"
                                SearchPlaceholder="Search technologies…"
                                EmptyText="@(search => $"No technologies match \"{search}\".")" />
                        </SiteFormField>
                    </ItemTemplate>
                </SiteRepeatableItems>
            </SiteFormSection>

            <SiteFormSection Title="Languages">
                <SiteRepeatableItems TItem="ResumeLanguageFormModel"
                    Items="@_languages"
                    ItemTitle="@((language, index) => $"Language {index + 1}")"
                    AddLabel="Add language"
                    RemoveLabel="Remove"
                    OnAdd="HandleAddLanguage"
                    OnRemove="HandleRemoveLanguage">
                    <ItemTemplate Context="languageContext">
                        <SiteFormField Label="Language"
                            For="@($"language-{languageContext.Index}")"
                            Required="true">
                            <SiteSelect Id="@($"language-{languageContext.Index}")"
                                         @bind-Value="languageContext.Item.LanguageIdText"
                                         Options="LanguageOptions"
                                         Clearable="true"
                                         Placeholder="Select a language" />
                        </SiteFormField>

                        <SiteFormField Label="Proficiency"
                            For="@($"language-proficiency-{languageContext.Index}")"
                            HelpText="Leave blank if unspecified.">
                            <SiteSelectWithCustom Id="@($"language-proficiency-{languageContext.Index}")"
                                Value="@languageContext.Item.Proficiency"
                                ValueChanged="@(value => languageContext.Item.Proficiency = value)"
                                Choices="@Proficiencies"
                                Placeholder="Not set" />
                        </SiteFormField>
                    </ItemTemplate>
                </SiteRepeatableItems>
            </SiteFormSection>

            <SiteFormSection Title="Selected case studies">
                <SiteEntityChecklist TItem="CaseStudy"
                    Items="_allCaseStudies"
                    Key="@(caseStudy => caseStudy.Id)"
                    Label="@CaseStudyDisplayName"
                    Selected="_selectedCaseStudyIds"
                    SelectedChanged="HandleSelectedCaseStudiesChanged"
                    SearchPlaceholder="Search case studies…"
                    EmptyText="@(search => $"No case studies match \"{search}\".")" />
            </SiteFormSection>
        </SiteStack>

        <SiteSaveBar Saving="@IsSaving" CancelHref="/admin/resume" />
    </SiteForm>
</SiteFormShell>

@code {
    private static readonly string[] Proficiencies =
    [
        "native",
        "fluent",
        "advanced",
        "intermediate",
        "basic",
    ];

    private static readonly string[] LeadershipFields = ["role", "organization", "period", "highlights:list", "includeInResume:bool", "hidden:bool"];
    private static readonly string[] EducationFields = ["institution", "degree", "location", "period", "hidden:bool"];
    private static readonly string[] DescribedFields = ["name", "issuer", "description", "period", "includeInPdf:bool", "hidden:bool"];
    private static readonly string[] TechnicalProductionFields = ["name", "kind", "description", "url", "period", "includeInPdf:bool", "hidden:bool"];
    private static readonly string[] EventFields = ["name", "role", "location", "period", "includeInPdf:bool", "hidden:bool"];
    public sealed class ResumeSkillFormModel
    {
        public int TopicId
        {
            get; set;
        }
        public string TopicIdText
        {
            get => TopicId == 0 ? string.Empty : TopicId.ToString(CultureInfo.InvariantCulture);
            set => TopicId = string.IsNullOrWhiteSpace(value) ? 0 : int.Parse(value, CultureInfo.InvariantCulture);
        }
        public HashSet<int> SelectedTechnologyIds { get; set; } = [];
    }

    public sealed class ResumeLanguageFormModel
    {
        public int LanguageId
        {
            get; set;
        }
        public string LanguageIdText
        {
            get => LanguageId == 0 ? string.Empty : LanguageId.ToString(CultureInfo.InvariantCulture);
            set => LanguageId = string.IsNullOrWhiteSpace(value) ? 0 : int.Parse(value, CultureInfo.InvariantCulture);
        }
        public string Proficiency { get; set; } = string.Empty;
    }

    private static readonly IReadOnlyList<SiteLocaleTab> _locales = [new(
        "en",
        "English"
    ), new("pt-BR", "Português")];

    private ResumeEntity _resume = new();
    private ResumeTranslationEntity _translationEn = new() { Locale = "en" };
    private ResumeTranslationEntity _translationPtBr = new() { Locale = "pt-BR" };
    private List<ResumeSkillFormModel> _skills = [];
    private List<ResumeLanguageFormModel> _languages = [];
    private List<(int LanguageId, string Proficiency)> _initialLanguageRows = [];
    private List<Topic> _allTopics = [];
    private List<Technology> _allTechnologies = [];
    private List<Language> _allLanguages = [];
    private List<CaseStudy> _allCaseStudies = [];
    private HashSet<int> _selectedCaseStudyIds = [];
    private List<int> _initialOrderedCaseStudyIds = [];
    private string _activeLocale = "en";

    private EditContext _resumeEditContext = default!;
    private EditContext _enEditContext = default!;
    private EditContext _ptEditContext = default!;

    protected override string EntityLabel => "resume";
    protected override string ListRoute => "/admin/resume";

    private IReadOnlyList<SiteSelectOption> TopicOptions => _allTopics
        .OrderBy(topic => topic.Order)
        .ThenBy(topic => topic.Id)
        .Select(topic => new SiteSelectOption(topic.Id.ToString(CultureInfo.InvariantCulture), TopicDisplayName(topic)))
        .ToArray();

    private IReadOnlyList<SiteSelectOption> LanguageOptions => _allLanguages
        .OrderBy(language => language.Order)
        .ThenBy(language => language.Id)
        .Select(language => new SiteSelectOption(language.Id.ToString(CultureInfo.InvariantCulture), LanguageDisplayName(language)))
        .ToArray();

    private static string TopicDisplayName(Topic topic) =>
        TranslationLookup.Resolve(topic.Translations, translation => translation.Locale, translation => translation.Name, "en")
        ?? topic.Slug;

    private static string LanguageDisplayName(Language language) =>
        TranslationLookup.Resolve(language.Translations, translation => translation.Locale, translation => translation.Name, "en")
        ?? language.Slug;

    private static string TechnologyDisplayName(Technology technology) =>
        TranslationLookup.Resolve(technology.Translations, translation => translation.Locale, translation => translation.Name, "en")
        ?? technology.Slug;

    private static string CaseStudyDisplayName(CaseStudy caseStudy) =>
        TranslationLookup.Resolve(caseStudy.Translations, translation => translation.Locale, translation => translation.Title, "en")
        ?? caseStudy.Slug;

    protected override async Task LoadAsync(PortfolioAdminDbContext dbContext)
    {
        _allTopics = await dbContext.Topics
            .Include(topic => topic.Translations)
            .AsNoTracking()
            .Where(topic => topic.Kind == "skill")
            .OrderBy(topic => topic.Order)
            .ThenBy(topic => topic.Id)
            .ToListAsync();

        _allTechnologies = await dbContext.Technologies
            .Include(technology => technology.Translations)
            .AsNoTracking()
            .OrderBy(technology => technology.Order)
            .ThenBy(technology => technology.Id)
            .ToListAsync();

        _allLanguages = await dbContext.Languages
            .Include(language => language.Translations)
            .AsNoTracking()
            .OrderBy(language => language.Order)
            .ThenBy(language => language.Id)
            .ToListAsync();

        _allCaseStudies = await dbContext.CaseStudies
            .Include(caseStudy => caseStudy.Translations)
            .AsNoTracking()
            .OrderBy(caseStudy => caseStudy.Order)
            .ThenBy(caseStudy => caseStudy.Id)
            .ToListAsync();

        var resume = await dbContext.Resumes
            .Include(candidate => candidate.Translations)
            .Include(candidate => candidate.Skills).ThenInclude(skill => skill.SkillTechnologies)
            .Include(candidate => candidate.Languages)
            .Include(candidate => candidate.SelectedCases)
            .AsNoTracking()
            .OrderBy(candidate => candidate.Id)
            .FirstOrDefaultAsync();

        if (resume is null)
        {
            ToastService.Error("Resume not found.");
            Navigation.NavigateTo("/admin");
            return;
        }

        _resume = resume;
        _translationEn = resume.Translations.FirstOrDefault(translation => translation.Locale == "en")
            ?? new ResumeTranslationEntity { ResumeId = resume.Id, Locale = "en" };
        _translationPtBr = resume.Translations.FirstOrDefault(translation => translation.Locale == "pt-BR")
            ?? new ResumeTranslationEntity { ResumeId = resume.Id, Locale = "pt-BR" };

        _skills = resume.Skills
            .OrderBy(skill => skill.Order)
            .ThenBy(skill => skill.Id)
            .Select(skill => new ResumeSkillFormModel
            {
                TopicId = skill.TopicId,
                SelectedTechnologyIds = skill.SkillTechnologies.Select(skillTechnology => skillTechnology.TechnologyId).ToHashSet(),
            })
            .ToList();

        _languages = resume.Languages
            .OrderBy(language => language.Order)
            .ThenBy(language => language.Id)
            .Select(language => new ResumeLanguageFormModel
            {
                LanguageId = language.LanguageId,
                Proficiency = language.Proficiency ?? string.Empty,
            })
            .ToList();
        _initialLanguageRows = _languages.Select(language => (language.LanguageId, language.Proficiency)).ToList();

        _initialOrderedCaseStudyIds = resume.SelectedCases
            .OrderBy(selected => selected.Order)
            .Select(selected => selected.CaseStudyId)
            .ToList();
        _selectedCaseStudyIds = _initialOrderedCaseStudyIds.ToHashSet();

        _resumeEditContext = new EditContext(_resume);
        _enEditContext = new EditContext(_translationEn);
        _ptEditContext = new EditContext(_translationPtBr);
    }

    private void HandleAddSkill() => _skills.Add(new ResumeSkillFormModel());

    private void HandleRemoveSkill(int index) => _skills.RemoveAt(index);

    private Task HandleSkillTechnologiesChanged(
        ResumeSkillFormModel skillRow,
        HashSet<int> selected
    )
    {
        skillRow.SelectedTechnologyIds = selected;
        return Task.CompletedTask;
    }

    private void HandleAddLanguage() => _languages.Add(new ResumeLanguageFormModel());

    private void HandleRemoveLanguage(int index) => _languages.RemoveAt(index);

    private Task HandleSelectedCaseStudiesChanged(HashSet<int> selected)
    {
        _selectedCaseStudyIds = selected;
        return Task.CompletedTask;
    }

    protected override Task<bool> ValidateAsync()
    {
        if (!_enEditContext.Validate() || !_ptEditContext.Validate())
        {
            return Task.FromResult(false);
        }

        if (_skills.Any(skillRow => skillRow.TopicId == 0))
        {
            SaveError = "Every skill needs a topic.";
            return Task.FromResult(false);
        }

        if (_languages.Any(languageRow => languageRow.LanguageId == 0))
        {
            SaveError = "Every language needs a language selected.";
            return Task.FromResult(false);
        }

        return Task.FromResult(true);
    }

    protected override async Task ApplyChangesAsync(PortfolioAdminDbContext dbContext)
    {
        // IMPORTANT: newly checked case studies are appended after the ones
        // that were already selected, in their own site-wide order — the
        // checklist only exposes a HashSet, with no way to express a custom
        // resume-specific ranking. Falling back to sorting every selected id
        // by CaseStudy.Order on every save would silently reshuffle the whole
        // "selected work" sequence whenever any single case study is toggled,
        // discarding whatever curation order the resume previously had.
        var orderedSelectedCaseStudyIds = _initialOrderedCaseStudyIds
            .Where(caseStudyId => _selectedCaseStudyIds.Contains(caseStudyId))
            .Concat(_allCaseStudies
                .OrderBy(caseStudy => caseStudy.Order)
                .ThenBy(caseStudy => caseStudy.Id)
                .Select(caseStudy => caseStudy.Id)
                .Where(caseStudyId => _selectedCaseStudyIds.Contains(caseStudyId) && !_initialOrderedCaseStudyIds.Contains(caseStudyId)))
            .ToList();

        var currentLanguageRows = _languages.Select(language => (language.LanguageId, language.Proficiency)).ToList();

        var resume = await dbContext.Resumes
            .Include(candidate => candidate.Translations)
            .Include(candidate => candidate.Skills).ThenInclude(skill => skill.SkillTechnologies)
            .Include(candidate => candidate.Languages)
            .Include(candidate => candidate.SelectedCases)
            .FirstAsync(candidate => candidate.Id == _resume.Id);

        ApplyTranslation(resume, "en", _translationEn);
        ApplyTranslation(resume, "pt-BR", _translationPtBr);

        // IMPORTANT: skills are always fully rewritten on save, unlike
        // languages and selected cases below. Each skill also owns a
        // per-skill technology pivot, so a precise diff would need to
        // reconcile two nested collections at once; a full
        // RemoveRange+Add is simpler and this form already replaces
        // the whole skill list on every save regardless.
        dbContext.ResumeSkills.RemoveRange(resume.Skills);
        for (var index = 0; index < _skills.Count; index++)
        {
            var skillRow = _skills[index];
            var skill = new ResumeSkill
            {
                ResumeId = resume.Id,
                TopicId = skillRow.TopicId,
                Order = index,
            };
            foreach (var technologyId in skillRow.SelectedTechnologyIds)
            {
                skill.SkillTechnologies.Add(new ResumeSkillTechnology { TechnologyId = technologyId });
            }

            dbContext.ResumeSkills.Add(skill);
        }

        if (!currentLanguageRows.SequenceEqual(_initialLanguageRows))
        {
            dbContext.ResumeLanguages.RemoveRange(resume.Languages);
            for (var index = 0; index < currentLanguageRows.Count; index++)
            {
                dbContext.ResumeLanguages.Add(new ResumeLanguage
                {
                    ResumeId = resume.Id,
                    LanguageId = currentLanguageRows[index].LanguageId,
                    Proficiency = NullIfBlank(currentLanguageRows[index].Proficiency),
                    Order = index,
                });
            }
        }

        if (!orderedSelectedCaseStudyIds.SequenceEqual(_initialOrderedCaseStudyIds))
        {
            dbContext.ResumeSelectedCases.RemoveRange(resume.SelectedCases);
            for (var index = 0; index < orderedSelectedCaseStudyIds.Count; index++)
            {
                dbContext.ResumeSelectedCases.Add(new ResumeSelectedCase
                {
                    ResumeId = resume.Id,
                    CaseStudyId = orderedSelectedCaseStudyIds[index],
                    Order = index,
                });
            }
        }

        // IMPORTANT: languages and selected cases are only rewritten when
        // they differ from these baselines, so a second save in the same
        // page load must move the baselines forward to what was just
        // applied here — otherwise a later edit that happens to match the
        // original page-load snapshot (e.g. remove then re-add the same
        // language) would compare equal to the stale baseline and silently
        // skip writing, even though the two saves disagree with each other.
        _initialLanguageRows = currentLanguageRows;
        _initialOrderedCaseStudyIds = orderedSelectedCaseStudyIds;
    }

    private static void ApplyTranslation(
        ResumeEntity resume,
        string locale,
        ResumeTranslationEntity source
    )
    {
        var existing = resume.Translations.FirstOrDefault(translation => translation.Locale == locale);
        if (existing is null)
        {
            resume.Translations.Add(new ResumeTranslationEntity
            {
                Locale = locale,
                Summary = source.Summary,
                Leadership = source.Leadership,
                Education = source.Education,
                Certificates = source.Certificates,
                Certifications = source.Certifications,
                Publications = source.Publications,
                Recommendations = source.Recommendations,
                TechnicalProductions = source.TechnicalProductions,
                Events = source.Events,
                Awards = source.Awards,
            });
            return;
        }

        existing.Summary = source.Summary;
        existing.Leadership = source.Leadership;
        existing.Education = source.Education;
        existing.Certificates = source.Certificates;
        existing.Certifications = source.Certifications;
        existing.Publications = source.Publications;
        existing.Recommendations = source.Recommendations;
        existing.TechnicalProductions = source.TechnicalProductions;
        existing.Events = source.Events;
        existing.Awards = source.Awards;
    }
}
