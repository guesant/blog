@inherits LocalizedComponentBase
@page "/tools/viewport-info"
@page "/pt-BR/tools/viewport-info"
@using Microsoft.JSInterop
@inject IJSRuntime JS
<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteCard Class="site-block" Label="@Title">
        <SiteStats Grid="true">
            <SiteStatItem Label="@ViewportWidthLabel">@Info.ViewportWidth</SiteStatItem>
                <SiteStatItem Label="@ViewportHeightLabel">@Info.ViewportHeight</SiteStatItem>
                    <SiteStatItem Label="@ScreenWidthLabel">@Info.ScreenWidth</SiteStatItem>
                        <SiteStatItem Label="@ScreenHeightLabel">@Info.ScreenHeight</SiteStatItem>
                            <SiteStatItem Label="@PixelRatioLabel">@Info.PixelRatio</SiteStatItem>
                                <SiteStatItem Label="@ColorDepthLabel">@Info.ColorDepth</SiteStatItem>
                                    <SiteStatItem Label="@LanguageLabel">@Info.Language</SiteStatItem>
                                        <SiteStatItem Label="@LanguagesLabel">@Info.Languages</SiteStatItem>
                                    </SiteStats>
                                </SiteCard>
                            </ToolPage>
