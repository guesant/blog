@page "/admin/findings"
@page "/admin/findings/order"
@inherits AdminListPageBase<Resource>
@layout AdminLayout

<PageTitle>Findings</PageTitle>

@if (IsOrderMode)
{
    <AdminOrderEditor TItem="Resource"
        Title="Findings order"
        ListRoute="/admin/findings"
        Items="@Items"
        DisplayTitle="@DisplayTitle"
        IsLoading="@IsLoading"
        IsSaving="@IsSaving"
        Error="@Error"
        OnReordered="HandleReorder"
        OnSave="@(() => HandleSaveOrderAsync("/admin/findings"))" />
}
else
{
    <SitePageHeader Title="Findings">
        <Actions>
            <SiteInline Gap="SiteSpace.Sm">
                <SiteLink Variant="SiteButtonVariant.Outline" Href="/admin/findings/order">
                    <SiteIcon Name="arrow-up-down" Size="14" />Edit order</SiteLink>
                <SiteLink Variant="SiteButtonVariant.Default" Href="/admin/findings/create">
                    <SiteIcon Name="plus" Size="14" />New finding</SiteLink>
            </SiteInline>
        </Actions>
    </SitePageHeader>

    @if (Error is not null)
    {
        <SiteNotice Tone="SiteTone.Danger">@Error</SiteNotice>
    }

    @if (IsLoading)
    {
        <SiteLoading Label="Loading…" />
    }
    else
    {
        <SiteDataTable TItem="Resource"
            Items="@PageItems"
            EmptyText="No findings yet."
            RowKey="@(resource => resource.Id)">
            <Columns>
                <SiteColumn TItem="Resource"
                    Header="Title"
                    IsRowHeader="true"><Cell Context="resource">@DisplayTitle(resource)</Cell>
                    </SiteColumn>
                <SiteColumn TItem="Resource" Header="Slug">
                    <Cell Context="resource">@resource.Slug</Cell>
                </SiteColumn>
                <SiteColumn TItem="Resource" Header="Type">
                    <Cell Context="resource">@resource.Type</Cell>
                </SiteColumn>
                <SiteColumn TItem="Resource" Header="Rating">
                    <Cell Context="resource">@(resource.Rating ?? "·")</Cell>
                </SiteColumn>
                <SiteColumn TItem="Resource"
                    Header="Status"><Cell Context="resource">@if (resource.Hidden) { <SiteBadge Label="Hidden" /> }</Cell>
                    </SiteColumn>
                <SiteColumn TItem="Resource"
                    Header="Published"><Cell Context="resource">@(resource.PublishedDateIso?.ToString("yyyy-MM-dd") ?? "·")</Cell>
                    </SiteColumn>
            </Columns>
            <Actions Context="resource">
                <SiteInline Gap="SiteSpace.Sm">
                    <SiteLink Variant="SiteButtonVariant.Outline"
                        Href="@($"/admin/findings/{resource.Id}")">
                        <SiteIcon Name="pencil" Size="14" />Edit</SiteLink>
                    <SiteButton Variant="SiteButtonVariant.Destructive"
                        @onclick="@(() => HandleDeleteAsync(resource))"><SiteIcon Name="trash-2"
                            Size="14" />Delete</SiteButton>
                </SiteInline>
            </Actions>
        </SiteDataTable>
        <SitePagination CurrentPage="@CurrentPage" TotalPages="@TotalPages" Href="@PageUrl" />
    }
}
