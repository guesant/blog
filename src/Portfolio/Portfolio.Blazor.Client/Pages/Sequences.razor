@inherits LocalizedComponentBase
@implements IDisposable
@page "/tools/sequences"
@page "/pt-BR/tools/sequences"
@page "/tools/arithmetic-progression"
@page "/pt-BR/tools/arithmetic-progression"
@page "/tools/geometric-progression"
@page "/pt-BR/tools/geometric-progression"
@using System.Globalization
@using Portfolio.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action"
        SubmitLabel="@SubmitLabel"
        Submit="SiteToolFormSubmit.StaticOnly"
        OnSubmit="Calculate">
        <SiteFormField Label="@FirstLabel"
            For="sequence-first"><SiteInput Id="sequence-first"
                Name="first"
                Type="number"
                step="any"
                Value="@FirstText"
                ValueChanged="@(v => FirstText = v)" /></SiteFormField>
        @if (IsArithmetic || IsCombined) { <SiteFormField Label="@DifferenceLabel"
            For="sequence-difference"><SiteInput Id="sequence-difference"
                Name="difference"
                Type="number"
                step="any"
                Value="@DifferenceText"
                ValueChanged="@(v => DifferenceText = v)" /></SiteFormField> }
        @if (!IsArithmetic || IsCombined) { <SiteFormField Label="@RatioLabel"
            For="sequence-ratio"><SiteInput Id="sequence-ratio"
                Name="ratio"
                Type="number"
                step="any"
                Value="@RatioText"
                ValueChanged="@(v => RatioText = v)" /></SiteFormField> }
        <SiteFormField Label="@TermsLabel"
            For="sequence-terms"><SiteInput Id="sequence-terms"
                Name="terms"
                Type="number"
                min="1"
                max="100000"
                Value="@TermsText"
                ValueChanged="@(v => TermsText = v)" /></SiteFormField>
    </SiteToolForm>
    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (!Result.IsValid) { <SiteErrorMessage>@ErrorLabel</SiteErrorMessage> }
        else
        {
            <SiteStats>
                @if (IsArithmetic || IsCombined) { <SiteStatItem Label="aₙ">@Format(Result.ArithmeticTerm)</SiteStatItem>
                    <SiteStatItem Label="Σaₙ">@Format(Result.ArithmeticSum)</SiteStatItem> }
                @if (!IsArithmetic || IsCombined) { <SiteStatItem Label="gₙ">@Format(Result.GeometricTerm)</SiteStatItem>
                    <SiteStatItem Label="Σgₙ">@Format(Result.GeometricSum)</SiteStatItem> }
            </SiteStats>
            @if ((!IsArithmetic || IsCombined) && Result.InfiniteGeometricSum is not null) { <SiteCard Class="site-block"
                Label="@InfiniteLabel"><SiteText>@Format(Result.InfiniteGeometricSum.Value)</SiteText>
                </SiteCard> }
            @if (RendererInfo.IsInteractive)
            {
                <SiteCard Class="site-block"
                    Label="@ChartLabel"><SiteChart ChartJsConfig="@SequenceConfig"
                        AriaLabel="@ChartLabel" />
                    </SiteCard>
            }
        }
    </SiteLiveRegion>
</ToolPage>
