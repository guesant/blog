@page "/admin/experiments/create"
@page "/admin/experiments/{Id:int}"
@inherits AdminEditPageBase<Experiment>
@layout AdminLayout

<PageTitle>@(IsEditing ? "Edit experiment" : "New experiment")</PageTitle>

<SiteFormShell Title="@(IsEditing ? "Edit experiment" : "New experiment")"
    Error="@SaveError"
    Loading="@IsLoading">
    <SiteForm EditContext="@_experimentEditContext" OnValidSubmit="HandleSaveAsync">
        <SiteStack Gap="SiteSpace.Lg">
            <SiteFormField Label="Slug"
                For="slug"
                Required="true"
                HelpText="Used in the public experiment URL.">
                <SiteTextInput Id="slug" @bind-Value="_experiment.Slug" />
                <SiteValidationMessage For="@(() => _experiment.Slug)" />
            </SiteFormField>


            <SiteFormField Label="Href"
                For="href"
                HelpText="External link override, if this experiment points elsewhere.">
                <SiteTextInput Id="href"
                    Value="@(_experiment.Href ?? string.Empty)"
                    ValueChanged="@(value => _experiment.Href = string.IsNullOrWhiteSpace(value) ? null : value)" />
            </SiteFormField>

            <SiteFormField Label="Published at"
                For="published-at"
                HelpText="Leave empty if not yet published.">
                <SiteDateInput Id="published-at" @bind-Value="_experiment.PublishedAt" />
            </SiteFormField>

            <SiteInline Gap="SiteSpace.Lg">
                <SiteCheckbox Label="Hidden" @bind-Value="_experiment.Hidden" />
                <SiteCheckbox Label="External" @bind-Value="_experiment.External" />
                <SiteCheckbox Label="Show history" @bind-Value="_experiment.ShowHistory" />
            </SiteInline>

            <SiteFormSection Title="Translations">
                <SiteTranslationTabs Locales="@_locales"
                    ActiveLocale="@_activeLocale"
                    ActiveLocaleChanged="@((string locale) => _activeLocale = locale)"
                    IdPrefix="experiment-translation">
                    <Panel Context="locale">
                        @if (locale == "en")
                        {
                            <CascadingValue Value="_enEditContext"
                                TValue="EditContext"
                                IsFixed="true">
                                <DataAnnotationsValidator />

                                <SiteFormField Label="Name"
                                    For="name-en"
                                    HelpText="Leave blank to skip saving the English translation.">
                                    <SiteTextInput Id="name-en" @bind-Value="_translationEn.Name" />
                                </SiteFormField>

                                <SiteFormField Label="Purpose" For="purpose-en">
                                    <SiteTextInput Id="purpose-en"
                                        @bind-Value="_translationEn.Purpose" />
                                </SiteFormField>

                                <SiteFormField Label="SEO"
                                    For="seo-en"
                                    HelpText="Standard meta fields for this page; add any extra tag under other fields. Leave empty if not applicable.">
                                    <SitePageFieldsInput Id="seo-en"
                                        Slug="PageFieldSlug.Seo"
                                        Locale="en"
                                        Value="@(_translationEn.Seo ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Seo = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationEn.Seo)" />
                                </SiteFormField>

                                <SiteFormField Label="Body (Markdown)" For="body-en">
                                    <SiteMarkdownSplitEditor Id="body-en"
                                        Rows="12"
                                        Value="@(_translationEn.Body ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Body = NullIfBlank(value))"
                                        Render="MarkdownRenderer.ToHtml" />
                                </SiteFormField>
                            </CascadingValue>
                        }
                        else
                        {
                            <CascadingValue Value="_ptEditContext"
                                TValue="EditContext"
                                IsFixed="true">
                                <DataAnnotationsValidator />

                                <SiteFormField Label="Nome"
                                    For="name-pt"
                                    HelpText="Deixe em branco para não salvar a tradução em português.">
                                    <SiteTextInput Id="name-pt"
                                        @bind-Value="_translationPtBr.Name" />
                                </SiteFormField>

                                <SiteFormField Label="Propósito" For="purpose-pt">
                                    <SiteTextInput Id="purpose-pt"
                                        @bind-Value="_translationPtBr.Purpose" />
                                </SiteFormField>

                                <SiteFormField Label="SEO"
                                    For="seo-pt"
                                    HelpText="Campos meta padrão desta página; tags extras entram em outros campos. Deixe vazio se não for aplicável.">
                                    <SitePageFieldsInput Id="seo-pt"
                                        Slug="PageFieldSlug.Seo"
                                        Locale="pt-BR"
                                        Value="@(_translationPtBr.Seo ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Seo = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationPtBr.Seo)" />
                                </SiteFormField>

                                <SiteFormField Label="Corpo (Markdown)" For="body-pt">
                                    <SiteMarkdownSplitEditor Id="body-pt"
                                        Rows="12"
                                        Value="@(_translationPtBr.Body ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Body = NullIfBlank(value))"
                                        Render="MarkdownRenderer.ToHtml" />
                                </SiteFormField>
                            </CascadingValue>
                        }
                    </Panel>
                </SiteTranslationTabs>
            </SiteFormSection>

            <SiteFormSection Title="Technologies">
                <SiteEntityChecklist TItem="Technology"
                    Items="_allTechnologies"
                    Key="@(technology => technology.Id)"
                    Label="@TechnologyDisplayName"
                    Selected="_selectedTechnologyIds"
                    SelectedChanged="HandleSelectedTechnologiesChanged"
                    SearchPlaceholder="Search technologies…"
                    EmptyText="@(search => $"No technologies match \"{search}\".")" />
            </SiteFormSection>
        </SiteStack>

        <SiteSaveBar Saving="@IsSaving" CancelHref="/admin/experiments" />
    </SiteForm>
</SiteFormShell>
