@page "/admin/findings/create"
@page "/admin/findings/{Id:int}"
@using System.Globalization
@using Portfolio.Blazor.Components.Admin.Shared
@inherits AdminEditPageBase<Resource>
@layout AdminLayout

<PageTitle>@(IsEditing ? "Edit finding" : "New finding")</PageTitle>

<SiteFormShell Title="@(IsEditing ? "Edit finding" : "New finding")"
    Error="@SaveError"
    Loading="@IsLoading">
    <SiteForm EditContext="@_resourceEditContext" OnValidSubmit="HandleSaveAsync">
        <SiteStack Gap="SiteSpace.Lg">
            <SiteFormField Label="Slug"
                For="slug"
                Required="true"
                HelpText="Used in the public finding URL.">
                <SiteTextInput Id="slug" @bind-Value="_resource.Slug" />
                <SiteValidationMessage For="@(() => _resource.Slug)" />
            </SiteFormField>

            <SiteFormField Label="Type" For="type" Required="true">
                <SiteSelect Id="type" @bind-Value="_resource.Type" Options="TypeOptions" />
            </SiteFormField>


            <SiteFormField Label="Language"
                For="language"
                HelpText="Original language of the finding, if relevant.">
                <SiteSelect Id="language"
                    @bind-Value="ResourceLanguageIdValue"
                    Options="LanguageOptions"
                    Clearable="true"
                    Placeholder="No language" />
            </SiteFormField>

            <SiteFormField Label="Authors" For="authors">
                <SiteTextInput Id="authors"
                    Value="@(_resource.Authors ?? string.Empty)"
                    ValueChanged="@(value => _resource.Authors = NullIfBlank(value))" />
            </SiteFormField>

            <SiteFormField Label="Organizations" For="organizations">
                <SiteTextInput Id="organizations"
                    Value="@(_resource.Organizations ?? string.Empty)"
                    ValueChanged="@(value => _resource.Organizations = NullIfBlank(value))" />
            </SiteFormField>

            <SiteFormField Label="Published date"
                For="published-date-iso"
                HelpText="When the finding itself was published or released.">
                <SiteDateInput Id="published-date-iso" @bind-Value="_resource.PublishedDateIso" />
            </SiteFormField>

            <SiteFormField Label="Found date"
                For="found-date-iso"
                HelpText="When you found or started this finding.">
                <SiteDateInput Id="found-date-iso" @bind-Value="_resource.FoundDateIso" />
            </SiteFormField>

            <SiteFormField Label="Consumption state" For="consumption-state">
                <SiteSelect Id="consumption-state"
                    @bind-Value="ConsumptionStateValue"
                    Options="ConsumptionStateOptions"
                    Clearable="true"
                    Placeholder="Not set" />
            </SiteFormField>

            <SiteFormField Label="Rating" For="rating">
                <SiteSelect Id="rating"
                    @bind-Value="RatingValue"
                    Options="RatingOptions"
                    Clearable="true"
                    Placeholder="Not set" />
            </SiteFormField>

            <SiteFormField Label="Editorial state" For="editorial-state">
                <SiteSelectWithCustom Id="editorial-state"
                    Value="@(_resource.EditorialState ?? string.Empty)"
                    ValueChanged="@(value => _resource.EditorialState = NullIfBlank(value))"
                    Choices="@EditorialStates"
                    Placeholder="Not set" />
            </SiteFormField>

            <SiteFormField Label="Visibility"
                For="visibility"
                HelpText="Only findings with visibility exactly &quot;public&quot; show up on the public site, regardless of the Hidden flag below.">
                <SiteSelectWithCustom Id="visibility"
                    Value="@(_resource.Visibility ?? string.Empty)"
                    ValueChanged="@(value => _resource.Visibility = NullIfBlank(value))"
                    Choices="@Visibilities"
                    Placeholder="Not set" />
            </SiteFormField>

            <SiteFormField Label="Type details"
                For="type-details"
                HelpText="Known fields for the selected type are shown as labelled inputs. Anything else stays free-form. Leave empty if not applicable.">
                <SiteContentFactInput Id="type-details"
                    ContentType="@ContentFactCatalog.ContentTypeForResourceType(_resource.Type)"
                    Value="@_resource.TypeDetails"
                    ValueChanged="@(value => _resource.TypeDetails = value)" />
                <SiteValidationMessage For="@(() => _resource.TypeDetails)" />
            </SiteFormField>

            <SiteCheckbox Label="Hidden" @bind-Value="_resource.Hidden" />

            <SiteFormSection Title="Translations">
                <SiteTranslationTabs Locales="@_locales"
                    ActiveLocale="@_activeLocale"
                    ActiveLocaleChanged="@((string locale) => _activeLocale = locale)"
                    IdPrefix="finding-translation">
                    <Panel Context="locale">
                        @if (locale == "en")
                        {
                            <CascadingValue Value="_enEditContext"
                                TValue="EditContext"
                                IsFixed="true">
                                <DataAnnotationsValidator />

                                <SiteFormField Label="Title"
                                    For="title-en"
                                    HelpText="Leave blank to skip saving the English translation.">
                                    <SiteTextInput Id="title-en"
                                        @bind-Value="_translationEn.Title" />
                                </SiteFormField>

                                <SiteFormField Label="Alternative title" For="alternative-title-en">
                                    <SiteTextInput Id="alternative-title-en"
                                        Value="@(_translationEn.AlternativeTitle ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.AlternativeTitle = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Description" For="description-en">
                                    <SiteTextAreaInput Id="description-en"
                                        Rows="3"
                                        Value="@(_translationEn.Description ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Description = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Personal note" For="personal-note-en">
                                    <SiteTextAreaInput Id="personal-note-en"
                                        Rows="3"
                                        Value="@(_translationEn.PersonalNote ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.PersonalNote = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Reason found" For="reason-found-en">
                                    <SiteTextAreaInput Id="reason-found-en"
                                        Rows="3"
                                        Value="@(_translationEn.ReasonFound ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.ReasonFound = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="SEO"
                                    For="seo-en"
                                    HelpText="Standard meta fields for this page; add any extra tag under other fields. Leave empty if not applicable.">
                                    <SitePageFieldsInput Id="seo-en"
                                        Slug="PageFieldSlug.Seo"
                                        Locale="en"
                                        Value="@(_translationEn.Seo ?? string.Empty)"
                                        ValueChanged="@(value => _translationEn.Seo = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationEn.Seo)" />
                                </SiteFormField>
                            </CascadingValue>
                        }
                        else
                        {
                            <CascadingValue Value="_ptEditContext"
                                TValue="EditContext"
                                IsFixed="true">
                                <DataAnnotationsValidator />

                                <SiteFormField Label="Título"
                                    For="title-pt"
                                    HelpText="Deixe em branco para não salvar a tradução em português.">
                                    <SiteTextInput Id="title-pt"
                                        @bind-Value="_translationPtBr.Title" />
                                </SiteFormField>

                                <SiteFormField Label="Título alternativo"
                                    For="alternative-title-pt">
                                    <SiteTextInput Id="alternative-title-pt"
                                        Value="@(_translationPtBr.AlternativeTitle ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.AlternativeTitle = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Descrição" For="description-pt">
                                    <SiteTextAreaInput Id="description-pt"
                                        Rows="3"
                                        Value="@(_translationPtBr.Description ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Description = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Nota pessoal" For="personal-note-pt">
                                    <SiteTextAreaInput Id="personal-note-pt"
                                        Rows="3"
                                        Value="@(_translationPtBr.PersonalNote ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.PersonalNote = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="Motivo de ter encontrado"
                                    For="reason-found-pt">
                                    <SiteTextAreaInput Id="reason-found-pt"
                                        Rows="3"
                                        Value="@(_translationPtBr.ReasonFound ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.ReasonFound = NullIfBlank(value))" />
                                </SiteFormField>

                                <SiteFormField Label="SEO"
                                    For="seo-pt"
                                    HelpText="Campos meta padrão desta página; tags extras entram em outros campos. Deixe vazio se não for aplicável.">
                                    <SitePageFieldsInput Id="seo-pt"
                                        Slug="PageFieldSlug.Seo"
                                        Locale="pt-BR"
                                        Value="@(_translationPtBr.Seo ?? string.Empty)"
                                        ValueChanged="@(value => _translationPtBr.Seo = NullIfBlank(value))" />
                                    <SiteValidationMessage For="@(() => _translationPtBr.Seo)" />
                                </SiteFormField>
                            </CascadingValue>
                        }
                    </Panel>
                </SiteTranslationTabs>
            </SiteFormSection>

            <SiteFormSection Title="Links">
                <SiteRepeatableItems TItem="ResourceLinkFormModel"
                    Items="@_links"
                    ItemTitle="@((link, index) => $"Link {index + 1}")"
                    AddLabel="Add link"
                    RemoveLabel="Remove"
                    OnAdd="HandleAddLink"
                    OnRemove="HandleRemoveLink">
                    <ItemTemplate Context="linkContext">
                        <SiteFormField Label="URL"
                            For="@($"link-url-{linkContext.Index}")"
                            Required="true">
                            <SiteTextInput Id="@($"link-url-{linkContext.Index}")"
                                Value="@linkContext.Item.Url"
                                ValueChanged="@(value => linkContext.Item.Url = value)" />
                        </SiteFormField>

                        <SiteFormField Label="Label" For="@($"link-label-{linkContext.Index}")">
                            <SiteTextInput Id="@($"link-label-{linkContext.Index}")"
                                Value="@(linkContext.Item.Label ?? string.Empty)"
                                ValueChanged="@(value => linkContext.Item.Label = NullIfBlank(value))" />
                        </SiteFormField>

                        <SiteFormField Label="Platform"
                            For="@($"link-platform-{linkContext.Index}")">
                            <SiteSelectWithCustom Id="@($"link-platform-{linkContext.Index}")"
                                Value="@(linkContext.Item.Platform ?? string.Empty)"
                                ValueChanged="@(value => linkContext.Item.Platform = NullIfBlank(value))"
                                Choices="@LinkPlatforms"
                                Placeholder="No platform" />
                        </SiteFormField>

                        <SiteFormField Label="Purpose"
                            For="@($"link-purpose-{linkContext.Index}")">
                            <SiteSelectWithCustom Id="@($"link-purpose-{linkContext.Index}")"
                                Value="@(linkContext.Item.Purpose ?? string.Empty)"
                                ValueChanged="@(value => linkContext.Item.Purpose = NullIfBlank(value))"
                                Choices="@LinkPurposes"
                                Placeholder="No purpose" />
                        </SiteFormField>

                        <SiteFormField Label="Language"
                            For="@($"link-language-{linkContext.Index}")">
                            <SiteSelect Id="@($"link-language-{linkContext.Index}")"
                                @bind-Value="linkContext.Item.LanguageIdText"
                                Options="LanguageOptions"
                                Clearable="true"
                                Placeholder="No language" />
                        </SiteFormField>

                        <SiteInline Gap="SiteSpace.Lg">
                            <SiteCheckbox Label="Primary"
                                Value="@linkContext.Item.IsPrimary"
                                ValueChanged="@(value => linkContext.Item.IsPrimary = value)" />
                            <SiteCheckbox Label="Free"
                                Value="@linkContext.Item.IsFree"
                                ValueChanged="@(value => linkContext.Item.IsFree = value)" />
                        </SiteInline>
                    </ItemTemplate>
                </SiteRepeatableItems>
            </SiteFormSection>

            <SiteFormSection Title="Identifiers"
                Description="@(_knownIdentifierKinds.Count > 0 ? $"Existing kinds in use: {string.Join(", ", _knownIdentifierKinds)}." : "Free text, e.g. \"isbn\", \"doi\", \"youtube\".")">
                <SiteRepeatableItems TItem="ResourceIdentifierFormModel"
                    Items="@_identifiers"
                    ItemTitle="@((identifier, index) => $"Identifier {index + 1}")"
                    AddLabel="Add identifier"
                    RemoveLabel="Remove"
                    OnAdd="HandleAddIdentifier"
                    OnRemove="HandleRemoveIdentifier">
                    <ItemTemplate Context="identifierContext">
                        <SiteFormField Label="Kind"
                            For="@($"identifier-kind-{identifierContext.Index}")"
                            Required="true">
                            <SiteTextInput Id="@($"identifier-kind-{identifierContext.Index}")"
                                Value="@identifierContext.Item.Kind"
                                ValueChanged="@(value => identifierContext.Item.Kind = value)" />
                        </SiteFormField>

                        <SiteFormField Label="Value"
                            For="@($"identifier-value-{identifierContext.Index}")"
                            Required="true">
                            <SiteTextInput Id="@($"identifier-value-{identifierContext.Index}")"
                                Value="@identifierContext.Item.Value"
                                ValueChanged="@(value => identifierContext.Item.Value = value)" />
                        </SiteFormField>
                    </ItemTemplate>
                </SiteRepeatableItems>
            </SiteFormSection>

            <SiteFormSection Title="Topics">
                <SiteEntityChecklist TItem="Topic"
                    Items="_allTopics"
                    Key="@(topic => topic.Id)"
                    Label="@TopicDisplayName"
                    Selected="_selectedTopicIds"
                    SelectedChanged="HandleSelectedTopicsChanged"
                    SearchPlaceholder="Search topics…"
                    EmptyText="@(search => $"No topics match \"{search}\".")" />
            </SiteFormSection>
        </SiteStack>

        <SiteSaveBar Saving="@IsSaving" CancelHref="/admin/findings" />
    </SiteForm>
</SiteFormShell>
