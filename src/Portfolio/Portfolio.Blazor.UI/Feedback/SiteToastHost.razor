@implements IDisposable
@inject SiteToastService Toasts

<div class="site-toast-host" data-slot="toast-host" aria-live="polite" aria-atomic="false">
    @foreach (var toast in Toasts.Toasts)
    {
        <SiteNotice Tone="@toast.Tone" Class="site-toast" AdditionalAttributes="@ToastAttributes">
            <span>@toast.Message</span>
            <SiteButton
                Variant="SiteButtonVariant.Ghost"
                Size="SiteButtonSize.IconXs"
                aria-label="@DismissLabel"
                OnClick="@(() => Toasts.Dismiss(toast.Id))"
            >
                <SiteIcon Name="x" Size="12" />
            </SiteButton>
        </SiteNotice>
    }
</div>
