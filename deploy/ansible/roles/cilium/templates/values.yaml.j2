kubeProxyReplacement: true
k8sServiceHost: {{ ansible_host }}
k8sServicePort: "6443"
routingMode: tunnel
tunnelProtocol: vxlan
# IMPORTANT: this node's only network interface is Wi-Fi (wlan0); Cilium's
# automatic device detection was flapping (repeated "Fallback node addresses
# updated" log spam, device shown as the wildcard "*") instead of settling on
# it, which left Service routing broken. Declaring it explicitly stops that.
devices: wlan0
# IMPORTANT: cilium-envoy (both the standalone DaemonSet and the version
# embedded in the agent binary) crashes on this hardware with a tcmalloc
# mmap failure; l7Proxy pulls in the embedded one even with envoy.enabled
# false, and its crash loop was blocking the agent's own service routing.
l7Proxy: false
ipam:
  operator:
    clusterPoolIPv4PodCIDRList:
      - 10.42.0.0/16
operator:
  replicas: 1
envoy:
  enabled: false
