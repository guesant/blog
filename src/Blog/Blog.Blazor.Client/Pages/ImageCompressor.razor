@inherits LocalizedComponentBase
@page "/tools/image-compressor"
@page "/pt-BR/tools/image-compressor"
@using Microsoft.JSInterop
@inject IJSRuntime JS

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteCard Class="site-block" Label="@Title">
        <SiteStack data-tool="image-compressor">
        <SiteFormField Label="@FileLabel"
            For="image-compressor-input"><SiteFileInput type="file"
                accept="image/*"
                data-image-compressor-input
                id="image-compressor-input" /></SiteFormField>
        <SiteFormActions>
            <SiteFormField Label="@FormatLabel"
                For="image-compressor-format"><SiteNativeSelect data-image-compressor-format
                    id="image-compressor-format"><option value="image/jpeg">@JpegLabel</option>
                        <option value="image/webp">@WebpLabel</option>
                    </SiteNativeSelect>
                    </SiteFormField>
                <SiteFormField Label="@QualityLabel"
                    For="image-compressor-quality"><SiteRangeInput min="1"
                        max="100"
                        value="80"
                        Class="tool-range"
                        data-image-compressor-quality
                        id="image-compressor-quality" /><SiteText Variant="SiteTextVariant.Meta"
                            data-image-compressor-quality-value>80</SiteText>%</SiteFormField>
            </SiteFormActions>
        <canvas data-image-compressor-canvas id="image-compressor-canvas" hidden>
        </canvas>
        <SiteStats Grid="true">
            <SiteStatItem Label="@OriginalSizeLabel">
                <SiteText Variant="SiteTextVariant.Meta"
                    data-image-compressor-original-size>0 kb</SiteText>
            </SiteStatItem>
                <SiteStatItem Label="@CompressedSizeLabel">
                    <SiteText Variant="SiteTextVariant.Meta"
                        data-image-compressor-compressed-size>0 kb</SiteText>
                </SiteStatItem>
                    <SiteStatItem Label="@ReductionLabel">
                        <SiteText Variant="SiteTextVariant.Meta"
                            data-image-compressor-reduction>0%</SiteText>
                    </SiteStatItem>
                </SiteStats>
        <SiteButton data-image-compressor-download
            Disabled
            Variant="SiteButtonVariant.Default"
            Class="tool-action-btn"><SiteIcon Name="download"
                Size="14" />@DownloadLabel</SiteButton>
    </SiteStack>
    </SiteCard>
</ToolPage>
