@page "/admin/topics/create"
@page "/admin/topics/{Id:int}"
@inherits AdminEditPageBase<Topic>
@layout AdminLayout

<PageTitle>@(IsEditing ? "Edit topic" : "New topic")</PageTitle>

<SiteFormShell Title="@(IsEditing ? "Edit topic" : "New topic")"
    Error="@SaveError"
    Loading="@IsLoading">
    <SiteForm EditContext="@_topicEditContext" OnValidSubmit="HandleSaveAsync">
        <SiteStack Gap="SiteSpace.Lg">
            <SiteFormField Label="Slug"
                For="slug"
                Required="true"
                HelpText="Used in the public /topics/{slug} URL.">
                <SiteTextInput Id="slug" @bind-Value="_topic.Slug" />
                <SiteValidationMessage For="@(() => _topic.Slug)" />
            </SiteFormField>


            <SiteFormSection Title="Translations">
                <SiteTranslationTabs Locales="@_locales"
                    ActiveLocale="@_activeLocale"
                    ActiveLocaleChanged="@((string locale) => _activeLocale = locale)"
                    IdPrefix="topic-translation">
                    <Panel Context="locale">
                        @if (locale == "en")
                        {
                            <CascadingValue Value="_enEditContext"
                                TValue="EditContext"
                                IsFixed="true">
                                <DataAnnotationsValidator />
                                <SiteFormField Label="Name"
                                    For="name-en"
                                    HelpText="Leave blank to skip saving the English translation.">
                                    <SiteTextInput Id="name-en" @bind-Value="_translationEn.Name" />
                                </SiteFormField>
                            </CascadingValue>
                        }
                        else
                        {
                            <CascadingValue Value="_ptEditContext"
                                TValue="EditContext"
                                IsFixed="true">
                                <DataAnnotationsValidator />
                                <SiteFormField Label="Nome"
                                    For="name-pt"
                                    HelpText="Deixe em branco para não salvar a tradução em português.">
                                    <SiteTextInput Id="name-pt"
                                        @bind-Value="_translationPtBr.Name" />
                                </SiteFormField>
                            </CascadingValue>
                        }
                    </Panel>
                </SiteTranslationTabs>
            </SiteFormSection>
        </SiteStack>

        <SiteSaveBar Saving="@IsSaving" CancelHref="/admin/topics" />
    </SiteForm>
</SiteFormShell>
