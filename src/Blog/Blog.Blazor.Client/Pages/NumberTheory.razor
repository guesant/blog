@inherits LocalizedComponentBase
@implements IDisposable
@page "/tools/number-theory"
@page "/pt-BR/tools/number-theory"
@using System.Globalization
@using Blog.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action"
        SubmitLabel="@SubmitLabel"
        Submit="SiteToolFormSubmit.StaticOnly"
        OnSubmit="HandleSubmit"
        AriaLabel="@InputLabel">
        <SiteFormField Label="a"
            For="number-theory-a"><SiteInput Id="number-theory-a"
                Name="a"
                Type="number"
                Value="@AText"
                ValueChanged="@(v => AText = v)" /></SiteFormField>
        <SiteFormField Label="b"
            For="number-theory-b"><SiteInput Id="number-theory-b"
                Name="b"
                Type="number"
                Value="@BText"
                ValueChanged="@(v => BText = v)" /></SiteFormField>
        <SiteFormField Label="@SieveLimitLabel"
            For="number-theory-limit"><SiteInput Id="number-theory-limit"
                Name="limit"
                Type="number"
                min="2"
                max="100000"
                Value="@LimitText"
                ValueChanged="@(v => LimitText = v)" /></SiteFormField>
    </SiteToolForm>

    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (!Summary.IsValid)
        {
            <SiteErrorMessage>@ErrorMessage</SiteErrorMessage>
        }
        else
        {
            <SiteStats>
                <SiteStatItem Label="@GcdLabel">@Summary.GreatestCommonDivisor</SiteStatItem>
                <SiteStatItem Label="@LcmLabel">@Summary.LeastCommonMultiple</SiteStatItem>
                <SiteStatItem Label="@PrimeALabel">@BooleanLabel(Summary.IsPrimeA)</SiteStatItem>
                <SiteStatItem Label="@PrimeBLabel">@BooleanLabel(Summary.IsPrimeB)</SiteStatItem>
            </SiteStats>
            <SiteCard Class="site-block" Label="@FactorsLabel">
                <SiteStack Gap="SiteSpace.Xs">
                    <SiteText Variant="SiteTextVariant.Body">a = @Factorization(Summary.FactorsA)</SiteText>
                    <SiteText Variant="SiteTextVariant.Body">b = @Factorization(Summary.FactorsB)</SiteText>
                    <SiteText Variant="SiteTextVariant.Body">@PrimesLabel: @string.Join(", ", Summary.Primes)</SiteText>
                </SiteStack>
            </SiteCard>
        }
    </SiteLiveRegion>
</ToolPage>
