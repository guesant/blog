@inherits LocalizedComponentBase
@page "/tools/image-to-base64"
@page "/pt-BR/tools/image-to-base64"
@using Microsoft.JSInterop
@inject IJSRuntime JS

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
<SiteCard Class="site-block" Label="@Title">
    <SiteStack data-tool="image-to-base64">
        <SiteFormField For="image-to-base64-input"
            Label="@FileLabel"><SiteFileInput type="file"
                accept="image/*"
                data-image-to-base64-input
                id="image-to-base64-input" /></SiteFormField>
            <SiteStats Grid="true">
                <SiteStatItem Label="@CharCountLabel">
                    <SiteText Variant="SiteTextVariant.Meta"
                        data-image-to-base64-char-count>0</SiteText>
                </SiteStatItem>
                    <SiteStatItem Label="@ApproxSizeLabel">
                        <SiteText Variant="SiteTextVariant.Meta"
                            data-image-to-base64-approx-size>0 kb</SiteText>
                    </SiteStatItem>
                </SiteStats>
                    <SiteFormField For="image-to-base64-output"
                        Label="@OutputLabel"><SiteTextAreaInput data-image-to-base64-output
                            id="image-to-base64-output"
                            Class="tool-textarea"
                            rows="10"
                            readonly></SiteTextAreaInput>
                            </SiteFormField>
                            <SiteButton Variant="SiteButtonVariant.Default"
                                Class="tool-action-btn"
                                data-image-to-base64-copy><SiteText Variant="SiteTextVariant.Meta"
                                    data-image-to-base64-copy-label
                                    data-copy-label="@CopyLabel"
                                    data-copied-label="@CopiedLabel">@CopyLabel</SiteText>
                                    </SiteButton>
                                    </SiteStack>
                </SiteCard>
            </ToolPage>
