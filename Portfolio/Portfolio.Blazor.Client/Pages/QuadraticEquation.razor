@inherits LocalizedComponentBase
@implements IDisposable
@page "/tools/quadratic-equation"
@page "/pt-BR/tools/quadratic-equation"
@using System.Globalization
@using Portfolio.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action"
        SubmitLabel="@SubmitLabel"
        Submit="SiteToolFormSubmit.StaticOnly"
        OnSubmit="HandleSubmit">
        <SiteFormField Label="a" For="quadratic-a">
            <SiteInput Id="quadratic-a"
                Name="a"
                Type="number"
                step="any"
                Value="@AText"
                ValueChanged="@(v => AText = v)" />
        </SiteFormField>
        <SiteFormField Label="b" For="quadratic-b">
            <SiteInput Id="quadratic-b"
                Name="b"
                Type="number"
                step="any"
                Value="@BText"
                ValueChanged="@(v => BText = v)" />
        </SiteFormField>
        <SiteFormField Label="c" For="quadratic-c">
            <SiteInput Id="quadratic-c"
                Name="c"
                Type="number"
                step="any"
                Value="@CText"
                ValueChanged="@(v => CText = v)" />
        </SiteFormField>
    </SiteToolForm>

    <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
        @if (!Result.IsValid)
        {
            <SiteErrorMessage>@ErrorMessage</SiteErrorMessage>
        }
        else
        {
            <SiteCard Class="site-block" Label="@ExplanationLabel">
                <SiteText Variant="SiteTextVariant.Body">Δ = b² − 4ac = @Format(Result.Discriminant)</SiteText>
                @if (Result.HasRealRoots)
                {
                    <SiteText Variant="SiteTextVariant.Body">@RootsLabel: x₁ = @Format(Result.Root1.Real), x₂ = @Format(Result.Root2.Real)</SiteText>
                }
                else
                {
                    <SiteText Variant="SiteTextVariant.Body">@ComplexRootsLabel: x₁ = @FormatComplex(Result.Root1), x₂ = @FormatComplex(Result.Root2)</SiteText>
                }
                <SiteList Variant="SiteListVariant.Steps" Ordered="true">
                    @foreach (var step in Steps)
                    {
                        <SiteListItem>@step</SiteListItem>
                    }
                </SiteList>
            </SiteCard>
            <SiteCard Class="site-block" Label="@ChartLabel">
                @if (RendererInfo.IsInteractive)
                {
                    <SiteChart ChartJsConfig="@ChartConfig" AriaLabel="@ChartLabel" />
                }
                else
                {
                    <SiteList Variant="SiteListVariant.Boxed" AriaLabel="@ChartLabel">
                        @foreach (var point in ChartPoints.Where((_, index) => index % 8 == 0))
                        {
                            <SiteListItem Class="site-text-list-item">f(@Format(point.X)) = @Format(point.Y)</SiteListItem>
                        }
                    </SiteList>
                }
            </SiteCard>
        }
    </SiteLiveRegion>
</ToolPage>
