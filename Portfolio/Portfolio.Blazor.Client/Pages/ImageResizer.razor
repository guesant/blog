@inherits LocalizedComponentBase
@page "/tools/image-resizer"
@page "/pt-BR/tools/image-resizer"
@using Microsoft.JSInterop
@inject IJSRuntime JS

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
<SiteCard Class="site-block" Label="@Title">
    <SiteStack data-tool="image-resizer">
        <SiteFormField Label="@FileLabel"
            For="image-resizer-input"><SiteFileInput type="file"
                accept="image/*"
                data-image-resizer-input
                id="image-resizer-input" /></SiteFormField>
            <SiteFormActions>
                <SiteFormField Label="@WidthLabel"
                    For="image-resizer-width"><SiteInput type="number"
                        min="1"
                        data-image-resizer-width
                        id="image-resizer-width" /></SiteFormField>
                    <SiteFormField Label="@HeightLabel"
                        For="image-resizer-height"><SiteInput type="number"
                            min="1"
                            data-image-resizer-height
                            id="image-resizer-height" /></SiteFormField>
                                <SiteCheckbox Label="@KeepRatioLabel"
                                Id="image-resizer-keep-ratio"
                                Value="true"
                                data-image-resizer-keep-ratio /></SiteFormActions>
                                    <canvas data-image-resizer-canvas
                                    id="image-resizer-canvas"
                                    hidden></canvas>
                                        <SiteButton Variant="SiteButtonVariant.Default"
                                        Class="tool-action-btn"
                                        data-image-resizer-download
                                        Disabled><SiteIcon Name="download"
                                            Size="14" />@DownloadLabel</SiteButton>
                                        </SiteStack>
                </SiteCard>
            </ToolPage>
@code {
    private string CanonicalPath => RequestPath;  private string Title => L["legacy_ad87a29a6f4b"]; private string Description => L["legacy_69fe66124643"]; private string FileLabel => L["legacy_6320d8841a37"]; private string WidthLabel => L["legacy_d62fe4abf513"]; private string HeightLabel => L["legacy_13d945a301ce"]; private string KeepRatioLabel => L["legacy_2dbc91a80289"]; private string DownloadLabel => L["legacy_c36a12636bbd"]; protected override async Task OnAfterRenderAsync(bool firstRender) { if (firstRender) await JS.InvokeVoidAsync("import", "/image-resizer.js"); } }
