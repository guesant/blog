@inherits LocalizedComponentBase
@page "/tools/color-wheel"
@page "/pt-BR/tools/color-wheel"
@using Microsoft.JSInterop
@inject IJSRuntime JS

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteCard Class="site-block" Label="@Title">
        <SiteFormActions>
            <SiteFormField Label="@RuleLabel"
                For="tool-color-wheel-rule"><SiteNativeSelect class="form-select tool-select"
                    data-color-wheel-rule
                    id="tool-color-wheel-rule"><option value="complementary">@RuleText("complementary")</option>
                        <option value="analogous">@RuleText("analogous")</option>
                            <option value="monochromatic">@RuleText("monochromatic")</option>
                                <option value="triad">@RuleText("triad")</option>
                                    <option value="split-complementary">@RuleText("split-complementary")</option>
                                        <option value="double-split-complementary">@RuleText("double-split-complementary")</option>
                                            <option value="square">@RuleText("square")</option>
                                                <option value="compound">@RuleText("compound")</option>
                                                    <option value="shades">@RuleText("shades")</option>
                                                        <option value="custom">@RuleText("custom")</option>
                                                    </SiteNativeSelect>
                                                </SiteFormField>
            <SiteFormField Label="@ModelLabel"
                For="tool-color-wheel-model"><SiteNativeSelect class="form-select tool-select"
                    data-color-wheel-model
                    id="tool-color-wheel-model"><option value="rgb">RGB</option>
                        <option value="hsb">HSB</option>
                            <option value="hsl">HSL</option>
                                <option value="cmyk">CMYK</option>
                                    <option value="lab">LAB</option>
                                </SiteNativeSelect>
                            </SiteFormField>
            <SiteButton data-color-wheel-random
                Variant="SiteButtonVariant.Default"
                Class="tool-action-btn"><SiteIcon Name="dices" Size="14" />@RandomLabel</SiteButton>
                    <SiteButton data-color-wheel-undo
                    Variant="SiteButtonVariant.Default"
                    Class="tool-action-btn"><SiteIcon Name="undo-2"
                        Size="14" />@UndoLabel</SiteButton>
                        <SiteButton data-color-wheel-redo
                        Variant="SiteButtonVariant.Default"
                        Class="tool-action-btn"><SiteIcon Name="redo-2"
                            Size="14" />@RedoLabel</SiteButton>
        </SiteFormActions>
        <div class="tool-wheel-layout">
            <div class="tool-wheel-wrap"
                data-color-wheel-wrap><canvas data-color-wheel-canvas
                    class="tool-wheel-canvas"></canvas>
                        <svg data-color-wheel-lines
                        class="tool-wheel-lines"
                        viewBox="0 0 260 260"></svg>
                            <div data-color-wheel-markers
                            data-marker-label="@MarkerLabel"
                            class="tool-wheel-markers">
        </div>
        </div>
        <div class="tool-wheel-side">
            <SiteFormField For="tool-color-wheel-brightness"
                Label="@BrightnessLabel"><SiteRangeInput min="0"
                    max="100"
                    class="form-range tool-range"
                    data-color-wheel-brightness
                    id="tool-color-wheel-brightness" /></SiteFormField>
                <SiteFormField For="tool-color-wheel-hex"
                    Label="HEX"><SiteInput class="form-control"
                        type="text"
                        data-color-wheel-hex-input
                        id="tool-color-wheel-hex"
                        autocomplete="off"
                        spellcheck="false" /></SiteFormField>
                            <SiteErrorMessage data-color-wheel-hex-error
                            data-invalid-label="@InvalidHexLabel"
                            hidden></SiteErrorMessage>
                                <div data-color-wheel-channels class="tool-channel-editor">
            </div>
            <SiteErrorMessage data-color-wheel-channel-error
                data-invalid-label="@InvalidChannelLabel"
                hidden></SiteErrorMessage>
                </div>
        </div>
        <p class="section-label">@PaletteLabel</p>
            <div data-color-wheel-palette
                data-select-label="@SelectLabel"
                data-lock-label="@LockLabel"
                data-locked-label="@LockedLabel"
                data-copy-hex-label="hex"
                data-copy-rgb-label="rgb"
                data-copied-label="@CopiedLabel"
                class="tool-swatch-grid">
        </div>
        <SiteFormActions>
            <SiteButton data-color-wheel-export-json
                Variant="SiteButtonVariant.Default"
                Class="tool-action-btn">
                <SiteIcon Name="file-down" Size="14" />@ExportJsonLabel</SiteButton>
                    <SiteButton data-color-wheel-export-css
                        Variant="SiteButtonVariant.Default"
                        Class="tool-action-btn">
                        <SiteIcon Name="file-down" Size="14" />@ExportCssLabel</SiteButton>
                            <SiteButton data-color-wheel-export-png
                                Variant="SiteButtonVariant.Default"
                                Class="tool-action-btn">
                                <SiteIcon Name="file-down" Size="14" />@ExportPngLabel</SiteButton>
                            </SiteFormActions>
        <p class="section-label">@ContrastLabel</p>
            <SiteList data-color-wheel-contrast
                data-pass-label="@PassLabel"
                data-fail-label="@FailLabel"
                AriaLabel="@ContrastLabel">
        </SiteList>
        <p class="section-label">@ColorblindLabel</p>
            <div data-color-wheel-colorblind
                data-protanopia-label="protanopia"
                data-deuteranopia-label="deuteranopia"
                data-tritanopia-label="tritanopia"
                class="tool-simulation-grid">
        </div>
        <p class="section-label">@ExtractLabel</p>
            <SiteFormActions>
                <SiteFormField For="tool-color-wheel-extract-file"
                    Label="@ExtractFileLabel"><SiteFileInput class="form-control"
                        type="file"
                        accept="image/*"
                        data-color-wheel-extract-file
                        id="tool-color-wheel-extract-file" /></SiteFormField>
                    <SiteFormField For="tool-color-wheel-extract-count"
                        Label="@ExtractCountLabel"><SiteNativeSelect class="form-select tool-select"
                            data-color-wheel-extract-count
                            id="tool-color-wheel-extract-count"><option value="4">4</option>
                                <option value="5" selected>5</option>
                                    <option value="6">6</option>
                                        <option value="7">7</option>
                                            <option value="8">8</option>
                                        </SiteNativeSelect>
                                    </SiteFormField>
                </SiteFormActions>
        <p class="section-label">@SaveLabel</p>
            <SiteFormActions>
                <SiteFormField For="tool-color-wheel-save-name"
                    Label="@SaveNameLabel"><SiteInput class="form-control"
                        type="text"
                        data-color-wheel-save-name
                        id="tool-color-wheel-save-name"
                        autocomplete="off" /></SiteFormField>
                    <SiteFormField For="tool-color-wheel-save-tags"
                        Label="@SaveTagsLabel"><SiteInput class="form-control"
                            type="text"
                            data-color-wheel-save-tags
                            id="tool-color-wheel-save-tags"
                            autocomplete="off"
                            placeholder="@SaveTagsPlaceholder" /></SiteFormField>
                                <SiteButton data-color-wheel-save-btn
                                Variant="SiteButtonVariant.Default"
                                Class="tool-action-btn"><SiteIcon Name="save"
                                    Size="14" />@SaveButtonLabel</SiteButton>
                                </SiteFormActions>
        <p class="section-label">@SavedLabel</p>
            <SiteFormField For="tool-color-wheel-search"
                Label="@SearchLabel"><SiteInput class="form-control"
                    type="text"
                    data-color-wheel-search
                    id="tool-color-wheel-search"
                    autocomplete="off" /></SiteFormField>
                <SiteList data-color-wheel-saved-list
                    data-delete-label="@DeleteLabel"
                    AriaLabel="@SavedLabel">
            </SiteList>
                <SiteNotice data-color-wheel-saved-empty>@NoSavedLabel</SiteNotice>
    </SiteCard>
</ToolPage>
