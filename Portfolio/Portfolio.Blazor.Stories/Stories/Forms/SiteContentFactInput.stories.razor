@using Portfolio.Blazor.Core
@attribute [Stories("Forms/SiteContentFactInput")]

<Stories TComponent="SiteContentFactInput">

    <Story Name="Book">
        <Template>
            <SiteStack Gap="SiteSpace.Md">
                <SiteContentFactInput Id="book-demo"
                    ContentType="ContentFactContentType.Book"
                    Value="@_bookValue"
                    ValueChanged="@(value => { _bookValue = value; _bookEmitted = value; })" />
                <SiteText Variant="SiteTextVariant.Meta">emitted: @(_bookEmitted ?? "(no changes yet)")</SiteText>
            </SiteStack>
        </Template>
    </Story>

    <Story Name="Repo">
        <Template>
            <SiteStack Gap="SiteSpace.Md">
                <SiteContentFactInput Id="repo-demo"
                    ContentType="ContentFactContentType.Repo"
                    Value="@_repoValue"
                    ValueChanged="@(value => { _repoValue = value; _repoEmitted = value; })" />
                <SiteText Variant="SiteTextVariant.Meta">emitted: @(_repoEmitted ?? "(no changes yet)")</SiteText>
            </SiteStack>
        </Template>
    </Story>

    <Story Name="Paper">
        <Template>
            <SiteStack Gap="SiteSpace.Md">
                <SiteContentFactInput Id="paper-demo"
                    ContentType="ContentFactContentType.Paper"
                    Value="@_paperValue"
                    ValueChanged="@(value => { _paperValue = value; _paperEmitted = value; })" />
                <SiteText Variant="SiteTextVariant.Meta">emitted: @(_paperEmitted ?? "(no changes yet)")</SiteText>
            </SiteStack>
        </Template>
    </Story>

    <Story Name="Video">
        <Template>
            <SiteStack Gap="SiteSpace.Md">
                <SiteContentFactInput Id="video-demo"
                    ContentType="ContentFactContentType.Video"
                    Value="@_videoValue"
                    ValueChanged="@(value => { _videoValue = value; _videoEmitted = value; })" />
                <SiteText Variant="SiteTextVariant.Meta">emitted: @(_videoEmitted ?? "(no changes yet)")</SiteText>
            </SiteStack>
        </Template>
    </Story>

    <Story Name="ArticleUnmappedType">
        <Template>
            <SiteStack Gap="SiteSpace.Md">
                <SiteText Variant="SiteTextVariant.Meta">"article" has no catalog entry, so every field stays free-form.</SiteText>
                <SiteContentFactInput Id="article-demo"
                    ContentType="ContentFactContentType.None"
                    Value="@_articleValue"
                    ValueChanged="@(value => _articleValue = value)" />
            </SiteStack>
        </Template>
    </Story>

    <Story Name="TypeSwitchDataSafety">
        <Template>
            <SiteStack Gap="SiteSpace.Md">
                <SiteText Variant="SiteTextVariant.Meta">Switch the type below and confirm the isbn/publisher values keep showing up (now as free-form fields) instead of disappearing.</SiteText>
                <SiteInline Gap="SiteSpace.Sm">
                    <SiteButton Variant="SiteButtonVariant.Outline"
                        @onclick="@(() => _switchType = ContentFactContentType.Book)">Book</SiteButton>
                    <SiteButton Variant="SiteButtonVariant.Outline"
                        @onclick="@(() => _switchType = ContentFactContentType.Repo)">Repo</SiteButton>
                    <SiteButton Variant="SiteButtonVariant.Outline"
                        @onclick="@(() => _switchType = ContentFactContentType.None)">Article (none)</SiteButton>
                </SiteInline>
                <SiteText Variant="SiteTextVariant.Meta">current type: @_switchType</SiteText>
                <SiteContentFactInput Id="type-switch-demo"
                    ContentType="@_switchType"
                    Value="@_switchValue"
                    ValueChanged="@(value => _switchValue = value)" />
                <SiteText Variant="SiteTextVariant.Meta">raw json: @_switchValue</SiteText>
            </SiteStack>
        </Template>
    </Story>

</Stories>
