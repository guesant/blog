# Absolute public URL used by canonical tags, Open Graph URLs, robots.txt and sitemap.xml.
# Set this to the preferred production origin, including the canonical hostname.
NEXT_PUBLIC_SITE_URL=https://www.guesant.net

# Laravel public content API endpoint used by the Next.js server.
PORTFOLIO_CONTENT_API_URL=http://localhost:8001/api/v1/public-site

# Use Google Tag Manager OR Google Analytics directly, not both.
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Google Search Console HTML tag verification token.
GOOGLE_SITE_VERIFICATION=
