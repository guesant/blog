@inherits LocalizedComponentBase
@page "/tools/moles-calculator"
@page "/pt-BR/tools/moles-calculator"
@using System.Globalization
@using Blog.Blazor.Core

<ToolPage Title="@Title" Description="@Description" CanonicalPath="@CanonicalPath">
    <SiteToolForm Action="@Action"
        SubmitLabel="@SubmitLabel"
        Submit="SiteToolFormSubmit.StaticOnly"
        OnSubmit="Calculate"
        AriaLabel="@MassLabel">
        <SiteFormField Label="@MassLabel" For="amount-mass">
            <SiteInput Id="amount-mass"
                Name="mass"
                Type="number"
                min="0"
                step="any"
                Value="@MassText"
                ValueChanged="@(v => MassText = v)" />
        </SiteFormField>
        <SiteFormField Label="@MolarMassLabel" For="amount-molar-mass">
            <SiteInput Id="amount-molar-mass"
                Name="molar-mass"
                Type="number"
                min="0"
                step="any"
                Value="@MolarMassText"
                ValueChanged="@(v => MolarMassText = v)" />
        </SiteFormField>
    </SiteToolForm>

    @if (!Result.IsValid)
    {
        <SiteErrorMessage>@ErrorLabel</SiteErrorMessage>
    }
    else
    {
        <SiteLiveRegion Politeness="SiteLivePoliteness.Polite">
            <SiteStats>
                <SiteStatItem Label="@MolesLabel">@Format(Result.Moles) mol</SiteStatItem>
                <SiteStatItem Label="@ParticlesLabel">@Format(Result.Particles)</SiteStatItem>
            </SiteStats>
        </SiteLiveRegion>
    }
</ToolPage>
