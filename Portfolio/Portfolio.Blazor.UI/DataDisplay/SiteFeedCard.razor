<article class="site-feed-card" data-slot="feed-card">
    <div class="site-feed-card-meta">
        <span class="site-feed-card-kind">@KindLabel</span>
        @if (!string.IsNullOrWhiteSpace(Date))
        {
            <SiteCardMetaItem Icon="calendar">@Date</SiteCardMetaItem>
        }
        @if (!string.IsNullOrWhiteSpace(ReadingTime))
        {
            <SiteCardMetaItem Icon="clock">@ReadingTime</SiteCardMetaItem>
        }
        @MetaItems
        @if (!string.IsNullOrWhiteSpace(ExternalUrl))
        {
            <SiteLink Variant="SiteButtonVariant.Link"
                Class="site-feed-card-external"
                Href="@ExternalUrl"
                target="_blank"
                rel="noopener noreferrer">
                <SiteIcon Name="arrow-up-right" Size="12" />
                @ExternalLabel
            </SiteLink>
        }
    </div>
    <h2 class="site-feed-card-title">
        @if (string.IsNullOrWhiteSpace(Href))
        {
            <span>@Title</span>
        }
        else
        {
            <SiteLink Variant="SiteButtonVariant.Link"
                Href="@Href"
                target="@(External ? "_blank" : null)"
                rel="@(External ? "noopener noreferrer" : null)">@Title</SiteLink>
        }
    </h2>
    @if (!string.IsNullOrWhiteSpace(Preview))
    {
        <p class="site-feed-card-preview">
            @Preview@if (Truncated)
            {
                <span class="site-feed-card-ellipsis" aria-hidden="true">…</span>
            }
        </p>
        @if (!string.IsNullOrWhiteSpace(Href) && !string.IsNullOrWhiteSpace(ViewLabel))
        {
            <SiteLink Variant="SiteButtonVariant.Link"
                Class="site-feed-card-more"
                Href="@Href"
                target="@(External ? "_blank" : null)"
                rel="@(External ? "noopener noreferrer" : null)"
                aria-label="@($"{ViewLabel}: {Title}")">
                @ViewLabel
                <SiteIcon Name="@(External ? "arrow-up-right" : "arrow-right")" Size="14" />
            </SiteLink>
        }
    }
    @if (Tags is not null)
    {
        <div class="site-feed-card-tags">@Tags</div>
    }
</article>
