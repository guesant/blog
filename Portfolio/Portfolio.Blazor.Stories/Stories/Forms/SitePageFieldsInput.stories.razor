@using Portfolio.Blazor.Core
@attribute [Stories("Forms/SitePageFieldsInput")]

<Stories TComponent="SitePageFieldsInput">

    <Story Name="Home">
        <Template>
            <SiteStack Gap="SiteSpace.Md">
                <SitePageFieldsInput Id="home-demo"
                    Slug="PageFieldSlug.Home"
                    Locale="en"
                    Value="@_homeValue"
                    ValueChanged="@(value => { _homeValue = value; _homeEmitted = value; })" />
                <SiteText Variant="SiteTextVariant.Meta">emitted: @(_homeEmitted ?? "(no changes yet)")</SiteText>
            </SiteStack>
        </Template>
    </Story>

    <Story Name="About">
        <Template>
            <SiteStack Gap="SiteSpace.Md">
                <SitePageFieldsInput Id="about-demo"
                    Slug="PageFieldSlug.About"
                    Locale="pt-BR"
                    Value="@_aboutValue"
                    ValueChanged="@(value => { _aboutValue = value; _aboutEmitted = value; })" />
                <SiteText Variant="SiteTextVariant.Meta">emitted: @(_aboutEmitted ?? "(no changes yet)")</SiteText>
            </SiteStack>
        </Template>
    </Story>

    <Story Name="UnmappedSlug">
        <Template>
            <SiteStack Gap="SiteSpace.Md">
                <SiteText Variant="SiteTextVariant.Meta">"now" has no catalog entry, so every field stays free-form.</SiteText>
                <SitePageFieldsInput Id="unmapped-demo"
                    Slug="PageFieldSlug.None"
                    Locale="en"
                    Value="@_unmappedValue"
                    ValueChanged="@(value => _unmappedValue = value)" />
            </SiteStack>
        </Template>
    </Story>

    <Story Name="SlugSwitchDataSafety">
        <Template>
            <SiteStack Gap="SiteSpace.Md">
                <SiteText Variant="SiteTextVariant.Meta">Switch the slug below and confirm the heroIdentity/title values keep showing up (now as free-form fields) instead of disappearing.</SiteText>
                <SiteInline Gap="SiteSpace.Sm">
                    <SiteButton Variant="SiteButtonVariant.Outline"
                        @onclick="@(() => _switchSlug = PageFieldSlug.Home)">Home</SiteButton>
                    <SiteButton Variant="SiteButtonVariant.Outline"
                        @onclick="@(() => _switchSlug = PageFieldSlug.Credits)">Credits</SiteButton>
                    <SiteButton Variant="SiteButtonVariant.Outline"
                        @onclick="@(() => _switchSlug = PageFieldSlug.None)">Unmapped slug</SiteButton>
                </SiteInline>
                <SiteText Variant="SiteTextVariant.Meta">current slug: @_switchSlug</SiteText>
                <SitePageFieldsInput Id="slug-switch-demo"
                    Slug="@_switchSlug"
                    Locale="en"
                    Value="@_switchValue"
                    ValueChanged="@(value => _switchValue = value)" />
                <SiteText Variant="SiteTextVariant.Meta">raw json: @_switchValue</SiteText>
            </SiteStack>
        </Template>
    </Story>

</Stories>
