@attribute [Stories("Feedback/SiteConfirmDialog")]
@inject SiteDialogService Dialogs

<Stories TComponent="SiteConfirmDialog">

    <Story Name="Default">
        <Template>
            <SiteInline>
                <SiteButton OnClick="AskAsync">ask</SiteButton>
                <SiteButton Variant="SiteButtonVariant.Destructive" OnClick="AskDestructiveAsync">
                    ask destructive
                </SiteButton>
            </SiteInline>
            <SiteText id="confirm-dialog-answer">@_answer</SiteText>
            <SiteConfirmDialog />
        </Template>
    </Story>

</Stories>
